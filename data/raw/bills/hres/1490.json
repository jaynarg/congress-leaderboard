,"introducedDate":"2026-08-27","latestAction":{"actionDate":"2026-09-01","actionTime":"17:48:38","text":"Motion to reconsider laid on the table Agreed to without objection."},"laws":[],"number":"1490","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"C001137","district":5,"fullName":"Rep. Crank, Jeff [R-CO-5]","party":"R","state":"CO"}],"summaries":[{"actionDate":"2026-08-27","actionDesc":"Introduced in House","text":"<p>This resolution states that the House of Representatives</p><ul><li>condemns and denounces socialism in all its forms, including the Democratic Socialists of America, and opposes the implementation of socialist policies in the United States;</li><li>reaffirms its support for free, fair, and secure elections and calls for enactment of the SAVE America Act;</li><li>reiterates that American elections are for American citizens only; and</li><li>recommits itself to upholding the U.S. Constitution.</li></ul>","updateDate":"2026-08-29T01:22:53Z","versionCode":"00"}],"title":"Providing for the condemnation and denouncement of socialism in all its forms, and for other purposes.","type":"hres","updateDate":"2026-09-22T15:21:06Z","updateDateIncludingText":"2026-09-22T15:21:06Z"}
