"},{"bioguideId":"N000002","fullName":"Rep. Nadler, Jerrold [D-NY-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"N000188","fullName":"Rep. Norcross, Donald [D-NJ-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"J000298","fullName":"Rep. Jayapal, Pramila [D-WA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"G000559","fullName":"Rep. Garamendi, John [D-CA-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"W000831","fullName":"Rep. Walkinshaw, James R. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-23","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-20T15:45:47+00:00","id":"hres23-119","introducedDate":"2025-01-09","latestAction":{"actionDate":"2025-01-09","text":"Referred to the House Committee on Rules."},"laws":[],"number":"23","originChamber":"House","policyArea":"Congress","sponsors":[{"bioguideId":"P000620","district":7,"fullName":"Rep. Pettersen, Brittany [D-CO-7]","party":"D","state":"CO"}],"summaries":[{"actionDate":"2025-01-09","actionDesc":"Introduced in House","text":"<p><strong>Proxy Voting for New Parents Resolution</strong></p><p>This resolution authorizes proxy voting in the House of Representatives for a Member who has given birth or whose spouse has given birth and pregnant Members who are unable to travel safely or have a serious medical condition.</p><p>Under the resolution, a qualifying Member may designate a proxy to cast a vote in a committee, the Committee of the Whole, or on the House floor; however, proxies will not be counted for purposes of establishing a quorum. The proxy designation is valid for up to 12 weeks.</p><p>To designate a proxy for House and Committee of the Whole votes, the Member must submit a signed and dated letter to the Clerk stating the Member’s qualifying circumstances and the name and state of the Member who has agreed to be designated as proxy. A Member who has designated a proxy according to these requirements may also designate a proxy for committee votes. To designate a proxy for committee votes, the Member must provide the committee chair and ranking minority member with a signed and dated letter specifying another member of the committee to cast a proxy vote.&nbsp;</p><p>The resolution&nbsp;further provides that a Member may revoke the proxy authorization by (1) casting the Member’s own vote; (2) recording the Member’s own presence in the House or in the Committee of the Whole; or (3) in a committee, by submitting a signed letter to the chair and ranking minority member.</p>","updateDate":"2025-01-24T14:56:25Z","versionCode":"00"}],"title":"Proxy Voting for New Parents Resolution","type":"hres","updateDate":"2026-09-19T23:22:03Z","updateDateIncludingText":"2026-09-19T23:22:03Z"}
