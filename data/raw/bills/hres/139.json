hdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-09-26T14:06:10+00:00","id":"hres139-119","introducedDate":"2025-02-14","latestAction":{"actionDate":"2025-02-14","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"139","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"T000478","district":24,"fullName":"Rep. Tenney, Claudia [R-NY-24]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-02-14","actionDesc":"Introduced in House","text":"<p>The resolution urges the E3 (the United Kingdom, France, and Germany) to invoke the snapback of United Nations (UN) sanctions against Iran under UN Security Council Resolution 2231 before the option expires on October 18, 2025.&nbsp;</p><p>This resolution also (1) recognizes that Iran's possession of a nuclear weapon would threaten U.S. and global security, (2) condemns Iran's repeated violations of certain international commitments related to nuclear weapons, and (3) reaffirms that the United States maintains the right to prevent Iran from acquiring nuclear weapons.</p>","updateDate":"2025-03-17T18:43:03Z","versionCode":"00"}],"title":"Calling on the United Kingdom, France, and Germany (E3) to initiate the snapback of sanctions on Iran under United Nations Security Council Resolution 2231 (2015).","type":"hres","updateDate":"2026-09-25T16:25:05Z","updateDateIncludingText":"2026-09-25T16:25:05Z"}
