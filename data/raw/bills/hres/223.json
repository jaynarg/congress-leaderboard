:null,"state":"MI"},{"bioguideId":"M001237","fullName":"Rep. McDonald Rivet, Kristen [D-MI-8]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-14","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S001215","fullName":"Rep. Stevens, Haley M. [D-MI-11]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-14","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"W000798","fullName":"Rep. Walberg, Tim [R-MI-5]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-03-14","sponsorshipWithdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-09-17T15:57:44+00:00","id":"hres223-119","introducedDate":"2025-03-14","latestAction":{"actionDate":"2025-03-14","text":"Referred to the House Committee on Armed Services."},"laws":[],"number":"223","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"J000307","district":10,"fullName":"Rep. James, John [R-MI-10]","party":"R","state":"MI"}],"summaries":[{"actionDate":"2025-03-14","actionDesc":"Introduced in House","text":"<p>This resolution honors Selfridge Air National Guard Base in Harrison Township, Michigan, on its 108th anniversary, commends the thousands of men and women who have worked and trained at the base, and reinforces the commitment of the Armed Forces to the base as a facility that is key to national security. The resolution also encourages continued cooperation and dialogue with the Department of Defense in support of the base and acknowledges Michigan's ongoing investments in its defense assets and workforce.</p>","updateDate":"2025-09-03T19:09:53Z","versionCode":"00"}],"title":"Honoring the 108th anniversary of Selfridge Air National Guard Base and the contributions of Selfridge Air National Guard Base to the military and national security of the United States.","type":"hres","updateDate":"2025-12-05T22:01:27Z","updateDateIncludingText":"2025-12-05T22:01:27Z"}
