awnDate":null,"state":"OH"}],"fetchedAt":"2026-09-17T15:58:05+00:00","id":"hres230-119","introducedDate":"2025-03-18","latestAction":{"actionDate":"2025-03-18","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"230","originChamber":"House","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"J000301","district":null,"fullName":"Rep. Johnson, Dusty [R-SD-At Large]","party":"R","state":"SD"}],"summaries":[{"actionDate":"2025-03-18","actionDesc":"Introduced in House","text":"<p>This resolution expresses the sense of Congress that Congress and the Administration must work together to pursue effective food and agricultural trade policies that include specified components. Among others, these components include (1) a renewed commitment to secure market access and maintain global competitiveness for the U.S. food and agriculture industries; and (2) consideration of comprehensive trade agreements, enforcement of existing trade agreements, and elimination of certain&nbsp;nontariff trade barriers.</p>","updateDate":"2025-09-09T12:52:10Z","versionCode":"00"}],"title":"Expressing the sense that Congress and the administration must work together, with urgency, to pursue effective food and agricultural trade policies.","type":"hres","updateDate":"2025-09-09T12:53:15Z","updateDateIncludingText":"2025-09-09T12:53:15Z"}
