{"actions":[{"actionCode":"H11100","actionDate":"2025-02-25","source":"House floor actions","text":"Referred to the House Committee on Education and Workforce.","type":"IntroReferral"},{"actionCode":"H12100","actionDate":"2025-02-25","source":"Library of Congress","text":"Submitted in House","type":"Committee"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-resolution/163","cosponsors":[{"bioguideId":"M001194","fullName":"Rep. Moolenaar, John R. [R-MI-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"D000624","fullName":"Rep. Dingell, Debbie [D-MI-6]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"M001237","fullName":"Rep. McDonald Rivet, Kristen [D-MI-8]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S001221","fullName":"Rep. Scholten, Hillary J. [D-MI-3]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"J000307","fullName":"Rep. James, John [R-MI-10]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"B001301","fullName":"Rep. Bergman, Jack [R-MI-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"B001321","fullName":"Rep. Barrett, Tom [R-MI-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"K000401","fullName":"Rep. Kiley, Kevin [R-CA-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-04","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-17T15:55:04+00:00","id":"hres163-119","introducedDate":"2025-02-25","latestAction":{"actionDate":"2025-02-25","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"163","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"H001058","district":4,"fullName":"Rep. Huizenga, Bill [R-MI-4]","party":"R","state":"MI"}],"summaries":[{"actionDate":"2025-02-25","actionDesc":"Introduced in House","text":"<p>This resolution recognizes the goal of education in U.S. schools as that of ensuring that&nbsp;virtually every student achieves grade-level reading proficiency. It also encourages state and local governments, including educational agencies, to collaborate with private organizations that offer proven literacy programs to (1) identify and implement effective solutions to address illiteracy, and (2) create adult literacy initiatives for adults with reading skills below an 8th grade level.</p>","updateDate":"2025-08-12T21:18:04Z","versionCode":"00"}],"title":"Expressing the sense of the House of Representatives that the goal of education in schools across America shall be that virtually every student in the United States achieves grade-level reading proficiency, providing them with the foundation to develop the skills and knowledge needed for success in school, work, and life.","type":"hres","updateDate":"2025-09-05T08:05:59Z","updateDateIncludingText":"2025-09-05T08:05:59Z"}
