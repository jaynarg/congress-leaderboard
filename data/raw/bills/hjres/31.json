nsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-17T15:27:44+00:00","id":"hjres31-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"31","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"P000048","district":11,"fullName":"Rep. Pfluger, August [R-TX-11]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p>This joint resolution proposes a constitutional amendment prohibiting persons who are not U.S. citizens, nationals, or lawful permanent residents from voting in elections.&nbsp;Specifically, the joint resolution prohibits such a person from voting in any election for federal, state, tribal, or local office, including offices in the District of Columbia or in any of the territories or possessions of the United States.</p>","updateDate":"2025-05-06T13:39:38Z","versionCode":"00"}],"title":"Proposing an amendment to the Constitution of the United States to prohibit persons who are not citizens, nationals, or lawful permanent residents of the United States from voting in elections.","type":"hjres","updateDate":"2025-06-13T18:36:08Z","updateDateIncludingText":"2025-06-13T18:36:08Z"}
