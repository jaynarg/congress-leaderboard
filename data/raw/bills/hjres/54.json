-19","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"P000597","fullName":"Rep. Pingree, Chellie [D-ME-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"L000601","fullName":"Rep. Landsman, Greg [D-OH-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-03","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"T000472","fullName":"Rep. Takano, Mark [D-CA-39]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"S000510","fullName":"Rep. Smith, Adam [D-WA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-14","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-24","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"S001218","fullName":"Rep. Stansbury, Melanie A. [D-NM-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"B001300","fullName":"Rep. Barragán, Nanette Diaz [D-CA-44]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T15:43:58+00:00","id":"hjres54-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2025-02-12","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"54","originChamber":"House","policyArea":"Civil Rights and Liberties, Minority Issues","sponsors":[{"bioguideId":"J000298","district":7,"fullName":"Rep. Jayapal, Pramila [D-WA-7]","party":"D","state":"WA"}],"summaries":[{"actionDate":"2025-02-12","actionDesc":"Introduced in House","text":"<p>This joint resolution proposes a constitutional amendment providing that the rights protected and extended by the Constitution are the rights of natural persons only. Artificial entities, such as corporations, shall have no rights under the Constitution and are subject to regulation.</p> <p>The amendment requires federal, state, and local governments to (1) regulate, limit, or prohibit election contributions and expenditures, including a candidate's own contributions and expenditures, to ensure equal access of citizens to the political process, regardless of economic status; and (2) require that any permissible contributions and expenditures be publicly disclosed. </p> <p>Additionally, the judiciary is prohibited from construing the spending of money to influence elections to be speech under the First Amendment. </p>","updateDate":"2025-09-05T14:33:53Z","versionCode":"00"}],"title":"Proposing an amendment to the Constitution of the United States providing that the rights protected and extended by the Constitution are the rights of natural persons only.","type":"hjres","updateDate":"2026-09-19T23:40:59Z","updateDateIncludingText":"2026-09-19T23:40:59Z"}
