sorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"V000128","fullName":"Sen. Van Hollen, Chris [D-MD]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"W000805","fullName":"Sen. Warner, Mark R. [D-VA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"B001277","fullName":"Sen. Blumenthal, Richard [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"M001169","fullName":"Sen. Murphy, Christopher [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"W000800","fullName":"Sen. Welch, Peter [D-VT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000394","fullName":"Sen. Kim, Andy [D-NJ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"L000570","fullName":"Sen. Luján, Ben Ray [D-NM]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"NM"}],"fetchedAt":"2026-09-17T05:55:32+00:00","id":"s959-119","introducedDate":"2025-03-11","latestAction":{"actionDate":"2025-03-11","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"959","originChamber":"Senate","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"A000382","district":null,"fullName":"Sen. Alsobrooks, Angela D. [D-MD]","party":"D","state":"MD"}],"summaries":[{"actionDate":"2025-03-11","actionDesc":"Introduced in Senate","text":"<p><strong>Tariff Transparency Act of 2025</strong></p><p>This bill requires the U.S. International Trade Commission to investigate and report to Congress on the impact of additional&nbsp;tariffs on imports from Canada and Mexico. (President Donald&nbsp;J. Trump issued executive orders on February 1, 2025, to impose an additional 25% tariff on most imports from Canada and Mexico. These tariffs applied to all imports, except for Canadian energy or energy resources, which have an additional 10% tariff.)</p><p>Specifically, the report must assess (1) the impact of these tariffs on consumer prices; (2) the impact of any retaliation (e.g., retaliatory tariffs and export restrictions) imposed by Canada and Mexico on U.S. consumers, small businesses, farmers, and ranchers; and (3) the impact of the threat of tariffs and associated uncertainty with respect to the trade relationship between the United States, Canada, and Mexico on U.S. businesses.</p>","updateDate":"2025-09-23T15:22:11Z","versionCode":"00"}],"title":"Tariff Transparency Act of 2025","type":"s","updateDate":"2025-09-23T15:23:06Z","updateDateIncludingText":"2025-09-23T15:23:06Z"}
