onsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"F000479","fullName":"Sen. Fetterman, John [D-PA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"S001227","fullName":"Sen. Schmitt, Eric [R-MO]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"D000622","fullName":"Sen. Duckworth, Tammy [D-IL]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M000934","fullName":"Sen. Moran, Jerry [R-KS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-21","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"H001079","fullName":"Sen. Hyde-Smith, Cindy [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-03","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"R000608","fullName":"Sen. Rosen, Jacky [D-NV]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-05","sponsorshipWithdrawnDate":null,"state":"NV"}],"fetchedAt":"2026-09-17T05:44:59+00:00","id":"s756-119","introducedDate":"2025-02-26","latestAction":{"actionDate":"2025-02-26","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"756","originChamber":"Senate","policyArea":"Taxation","sponsors":[{"bioguideId":"K000367","district":null,"fullName":"Sen. Klobuchar, Amy [D-MN]","party":"D","state":"MN"}],"summaries":[{"actionDate":"2025-02-26","actionDesc":"Introduced in Senate","text":"<p><strong>Freedom to Invest in Tomorrow’s Workforce Act</strong></p><p>This bill expands the expenses eligible for tax-free withdrawals from a qualified tuition program (known as a 529 plan) to include tuition, fees (including test fees), books, supplies, equipment, and other expenses related to the enrollment or attendance in a recognized&nbsp;postsecondary credentialing program.</p><p>Under the bill, a recognized&nbsp;postsecondary credentialing program includes certain programs identified by a state as providing training services, a program listed in the Web Enabled Approval Management System (WEAMS) maintained by the Department of Veterans Affairs, certain examinations required to obtain or maintain a credential, and other reputable credentialing programs.</p><p>Further, under the bill, such programs must be designed for an individual to obtain</p><ul><li>an industry-recognized postsecondary employment credential (e.g., project management professional certificate, advanced emergency medical technician certificate, and welding supervisor certificate),</li><li>a certificate of completion of a registered and certified apprenticeship,</li><li>an occupational or professional license issued or recognized by a state or the federal government (and any certification required for obtaining such license), or</li><li>an associate or baccalaureate degree.&nbsp;</li></ul>","updateDate":"2025-09-24T18:17:22Z","versionCode":"00"}],"title":"Freedom to Invest in Tomorrow’s Workforce Act","type":"s","updateDate":"2025-12-06T06:38:13Z","updateDateIncludingText":"2025-12-06T06:38:13Z"}
