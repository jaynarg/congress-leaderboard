{"actions":[{"actionCode":null,"actionDate":"2025-07-29","source":"Senate","text":"Read twice and referred to the Committee on Agriculture, Nutrition, and Forestry.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-07-29","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/2512","cosponsors":[{"bioguideId":"F000479","fullName":"Sen. Fetterman, John [D-PA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"B001277","fullName":"Sen. Blumenthal, Richard [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"S001208","fullName":"Sen. Slotkin, Elissa [D-MI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S000033","fullName":"Sen. Sanders, Bernard [I-VT]","isOriginalCosponsor":true,"party":"I","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"W000800","fullName":"Sen. Welch, Peter [D-VT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"P000145","fullName":"Sen. Padilla, Alex [D-CA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001288","fullName":"Sen. Booker, Cory A. [D-NJ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000779","fullName":"Sen. Wyden, Ron [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"S001181","fullName":"Sen. Shaheen, Jeanne [D-NH]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"B001230","fullName":"Sen. Baldwin, Tammy [D-WI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-31","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-17T07:06:27+00:00","id":"s2512-119","introducedDate":"2025-07-29","latestAction":{"actionDate":"2025-07-29","text":"Read twice and referred to the Committee on Agriculture, Nutrition, and Forestry."},"laws":[],"number":"2512","originChamber":"Senate","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"G000555","district":null,"fullName":"Sen. Gillibrand, Kirsten E. [D-NY]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-07-29","actionDesc":"Introduced in Senate","text":"<p><strong>Enhance Access To SNAP Act of&nbsp;2025 or the EATS Act of 2025</strong></p><p>This bill expands eligibility for the Supplemental Nutrition Assistance Program (SNAP) for certain students.</p><p>Specifically, the bill removes the restriction on SNAP eligibility for students to allow otherwise eligible students who are attending institutions of higher education (IHEs) at least half time to participate in SNAP. Under current law, students 18-49 years old are restricted from participating in SNAP, with exceptions (e.g., caring for a child under the age of 6 or employed for at least 20 hours a week). The Consolidated Appropriations Act, 2021 temporarily exempted some students from certain SNAP eligibility requirements; these temporary student exemptions expired after the end of the COVID-19 public health emergency on May 11, 2023.</p><p>Further, the bill provides that students enrolled at least half time in a recognized school, training program, or IHE constitute individual <em>households</em> (not <em>residents of</em> <em>institutions</em>) and may be eligible for SNAP benefits. (Participation in SNAP is limited to households.)</p>","updateDate":"2026-02-12T14:48:23Z","versionCode":"00"}],"title":"EATS Act of 2025","type":"s","updateDate":"2026-02-12T14:49:14Z","updateDateIncludingText":"2026-02-12T14:49:14Z"}
