uideId":"V000128","fullName":"Sen. Van Hollen, Chris [D-MD]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"K000394","fullName":"Sen. Kim, Andy [D-NJ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-28","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001208","fullName":"Sen. Slotkin, Elissa [D-MI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"F000463","fullName":"Sen. Fischer, Deb [R-NE]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-01","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"C001095","fullName":"Sen. Cotton, Tom [R-AR]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-02","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"W000817","fullName":"Sen. Warren, Elizabeth [D-MA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-09","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"B001267","fullName":"Sen. Bennet, Michael F. [D-CO]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-15","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"B001236","fullName":"Sen. Boozman, John [R-AR]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-15","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"B001303","fullName":"Sen. Blunt Rochester, Lisa [D-DE]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-08","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"B001261","fullName":"Sen. Barrasso, John [R-WY]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-28","sponsorshipWithdrawnDate":null,"state":"WY"},{"bioguideId":"J000312","fullName":"Sen. Justice, James C. [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-03","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-17T06:34:45+00:00","id":"s1748-119","introducedDate":"2025-05-14","latestAction":{"actionDate":"2026-08-05","text":"Committee on Commerce, Science, and Transportation. Ordered to be reported with an amendment in the nature of a substitute favorably."},"laws":[],"number":"1748","originChamber":"Senate","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"B001243","district":null,"fullName":"Sen. Blackburn, Marsha [R-TN]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-05-14","actionDesc":"Introduced in Senate","text":"<p><strong>Kids Online Safety Act</strong></p><p>This bill requires covered online platforms, including social media platforms, to implement tools and safeguards to protect users and visitors under the age of 17. <em>Covered platforms</em> are online platforms, video games, messaging applications, or video streaming services used or likely to be used by individuals under the age of 17, with specified exceptions.&nbsp;</p><p>The bill generally requires covered platforms to exercise reasonable care in the design and use of features that increase minors’ online activity in order to prevent and mitigate harm to minors (e.g., mental health disorders and severe harassment). &nbsp;</p><p>Covered platforms are also required to provide certain safeguards to minors, such as protections for minors’ data; tools for parents of minors, such as access to minors’ privacy settings; and a mechanism for account&nbsp;holders and visitors to report harm to minors on the platform.&nbsp;</p><p>Covered platforms are prohibited from conducting market or product research on children under the age of 13, and may only conduct such research on those under the age of 17 with parental consent.&nbsp;</p><p>The bill provides for enforcement through the Federal Trade Commission and states.&nbsp;</p><p>The bill also requires online platforms to meet certain requirements before using algorithms that select, order, or prioritize information presented to users based on user-specific data not provided for that purpose. Specifically, such platforms must (1) provide users with notice of the use of such algorithms, and (2) permit users to switch to an algorithm&nbsp;that does not rely on such user-specific data.&nbsp;</p>","updateDate":"2025-08-05T16:35:06Z","versionCode":"00"}],"title":"Kids Online Safety Act","type":"s","updateDate":"2026-09-08T18:03:40Z","updateDateIncludingText":"2026-09-08T18:03:40Z"}
