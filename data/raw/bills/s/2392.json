ithdrawnDate":null,"state":"IN"},{"bioguideId":"D000622","fullName":"Sen. Duckworth, Tammy [D-IL]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"S001208","fullName":"Sen. Slotkin, Elissa [D-MI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"C001113","fullName":"Sen. Cortez Masto, Catherine [D-NV]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-30","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"B001267","fullName":"Sen. Bennet, Michael F. [D-CO]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-02","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"B001303","fullName":"Sen. Blunt Rochester, Lisa [D-DE]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"K000377","fullName":"Sen. Kelly, Mark [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"W000790","fullName":"Sen. Warnock, Raphael G. [D-GA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-15","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"B001288","fullName":"Sen. Booker, Cory A. [D-NJ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-20","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"H001046","fullName":"Sen. Heinrich, Martin [D-NM]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"NM"}],"fetchedAt":"2026-09-17T07:01:34+00:00","id":"s2392-119","introducedDate":"2025-07-23","latestAction":{"actionDate":"2025-11-25","text":"Became Public Law No: 119-42."},"laws":[{"number":"119-42","type":"Public Law"}],"number":"2392","originChamber":"Senate","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"M000934","district":null,"fullName":"Sen. Moran, Jerry [R-KS]","party":"R","state":"KS"}],"summaries":[{"actionDate":"2025-07-23","actionDesc":"Introduced in Senate","text":"<p><strong>Veterans' Compensation Cost-of-Living Adjustment Act of 2025</strong><strong></strong></p><p>This bill requires the Department of Veterans Affairs (VA) to increase the amounts payable for wartime disability compensation, additional compensation for dependents, the clothing allowance for certain disabled veterans, and dependency and indemnity compensation for surviving spouses and children. Specifically, the VA must increase the amounts by the same percentage as the cost-of-living increase in benefits for Social Security recipients that is effective on December 1, 2025. The bill requires the VA to publish the amounts payable, as increased, in the Federal Register.</p><p>The VA is authorized to make a similar adjustment to the rates of disability compensation payable to persons who have not received compensation for service-connected disability or death.</p>","updateDate":"2025-11-13T21:20:34Z","versionCode":"00"},{"actionDate":"2025-12-25","actionDesc":"Public Law","text":"<p><strong>Veterans' Compensation Cost-of-Living Adjustment Act of 2025</strong></p><p>This act requires the Department of Veterans Affairs (VA) to increase the amounts payable for wartime disability compensation, additional compensation for dependents, the clothing allowance for certain disabled veterans, and dependency and indemnity compensation for surviving spouses and children. Specifically, the VA must increase the amounts by the same percentage as the cost-of-living increase in benefits for Social Security recipients that is effective on December 1, 2025. The act requires the VA to publish the amounts payable, as increased, in the Federal Register.</p><p>The VA is authorized to make a similar adjustment to the rates of disability compensation payable to persons who have not received compensation for service-connected disability or death.</p>","updateDate":"2026-04-10T12:55:01Z","versionCode":"49"}],"title":"Veterans’ Compensation Cost-of-Living Adjustment Act of 2025","type":"s","updateDate":"2026-07-27T16:20:36Z","updateDateIncludingText":"2026-07-27T16:20:36Z"}
