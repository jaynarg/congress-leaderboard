awnDate":null,"state":"KS"},{"bioguideId":"C001075","fullName":"Sen. Cassidy, Bill [R-LA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"B001236","fullName":"Sen. Boozman, John [R-AR]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"R000605","fullName":"Sen. Rounds, Mike [R-SD]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"SD"},{"bioguideId":"F000463","fullName":"Sen. Fischer, Deb [R-NE]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-17","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"H001061","fullName":"Sen. Hoeven, John [R-ND]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"T000250","fullName":"Sen. Thune, John [R-SD]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"SD"},{"bioguideId":"T000476","fullName":"Sen. Tillis, Thomas [R-NC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"H001104","fullName":"Sen. Husted, Jon [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-04","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-09-17T05:13:27+00:00","id":"s145-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-01-16","text":"Read twice and referred to the Committee on Foreign Relations."},"laws":[],"number":"145","originChamber":"Senate","policyArea":"International Affairs","sponsors":[{"bioguideId":"R000584","district":null,"fullName":"Sen. Risch, James E. [R-ID]","party":"R","state":"ID"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in Senate","text":"<p><strong>Dismantle Iran’s Proxy Act of 2025</strong></p><p>This bill requires the President to take actions against Ansarallah, the Iran-backed movement in Yemen also known as the Houthis.</p><p>Specifically, the bill requires the President to designate Ansarallah as a foreign terrorist organization. (Among other things, such a designation allows the Department of the Treasury to require U.S. financial institutions to block transactions involving the organization.) &nbsp;</p><p>The President must also (1) impose property blocking sanctions on Ansarallah and any foreign person who is an official, agent, or affiliate of the organization; (2) submit to Congress a determination as to whether three specified individuals are officials, agents, or affiliates of Ansarallah; and (3) submit to Congress a strategy to degrade the offensive capabilities of Ansarallah and to restore freedom of navigation in the Red Sea and nearby waterways.</p>","updateDate":"2025-04-02T17:02:53Z","versionCode":"00"}],"title":"Dismantle Iran’s Proxy Act of 2025","type":"s","updateDate":"2025-04-05T11:03:16Z","updateDateIncludingText":"2026-07-18T20:49:58Z"}
