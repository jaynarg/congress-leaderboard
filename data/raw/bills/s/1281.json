{"actions":[{"actionCode":null,"actionDate":"2025-04-03","source":"Senate","text":"Read twice and referred to the Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-04-03","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/1281","cosponsors":[{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-04-03","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"S001203","fullName":"Sen. Smith, Tina [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-04-03","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"C001035","fullName":"Sen. Collins, Susan M. [R-ME]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-15","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"K000383","fullName":"Sen. King, Angus S., Jr. [I-ME]","isOriginalCosponsor":false,"party":"I","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"S001181","fullName":"Sen. Shaheen, Jeanne [D-NH]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-07","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"H001079","fullName":"Sen. Hyde-Smith, Cindy [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-26","sponsorshipWithdrawnDate":null,"state":"MS"}],"fetchedAt":"2026-09-17T06:13:20+00:00","id":"s1281-119","introducedDate":"2025-04-03","latestAction":{"actionDate":"2025-04-03","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"1281","originChamber":"Senate","policyArea":"Immigration","sponsors":[{"bioguideId":"T000476","district":null,"fullName":"Sen. Tillis, Thomas [R-NC]","party":"R","state":"NC"}],"summaries":[{"actionDate":"2025-04-03","actionDesc":"Introduced in Senate","text":"<p><strong>Restoring Industry Development in Entertainment Act or the RIDE Act</strong></p><p>This bill makes certain workers with a traveling carnival or circus eligible for P visas (nonimmigrant visas for athletes, artists, and entertainers).</p><p>Such visas shall be available for workers who perform functions that are integral and essential to the carnival or circus, such as transporting and assembling relevant structures and equipment.</p><p>Such visas shall only be available for a position if (1) there are not sufficient U.S. workers available, and (2) employing a non-U.S. national (<em>alien</em> under federal law) will not adversely affect the wages and working conditions of similarly employed U.S. workers.</p>","updateDate":"2026-02-20T21:02:45Z","versionCode":"00"}],"title":"RIDE Act","type":"s","updateDate":"2026-08-10T11:51:27Z","updateDateIncludingText":"2026-08-10T11:58:34Z"}
