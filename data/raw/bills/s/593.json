5-02-13","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"E000295","fullName":"Sen. Ernst, Joni [R-IA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"B001230","fullName":"Sen. Baldwin, Tammy [D-WI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"S001203","fullName":"Sen. Smith, Tina [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"R000605","fullName":"Sen. Rounds, Mike [R-SD]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"SD"},{"bioguideId":"W000437","fullName":"Sen. Wicker, Roger F. [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-19","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"H001061","fullName":"Sen. Hoeven, John [R-ND]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"S001208","fullName":"Sen. Slotkin, Elissa [D-MI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"P000595","fullName":"Sen. Peters, Gary C. [D-MI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-12","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"J000312","fullName":"Sen. Justice, James C. [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-06","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"M000355","fullName":"Sen. McConnell, Mitch [R-KY]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"B001299","fullName":"Sen. Banks, Jim [R-IN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-14","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"H001089","fullName":"Sen. Hawley, Josh [R-MO]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"MO"}],"fetchedAt":"2026-09-17T05:36:46+00:00","id":"s593-119","introducedDate":"2025-02-13","latestAction":{"actionDate":"2025-02-13","text":"Read twice and referred to the Committee on Environment and Public Works."},"laws":[],"number":"593","originChamber":"Senate","policyArea":"Environmental Protection","sponsors":[{"bioguideId":"F000463","district":null,"fullName":"Sen. Fischer, Deb [R-NE]","party":"R","state":"NE"}],"summaries":[{"actionDate":"2025-02-13","actionDesc":"Introduced in Senate","text":"<p><strong>Nationwide Consumer and Fuel Retailer Choice Act of 2025</strong></p><p>This bill amends the Clean Air Act to address the limitations on Reid Vapor Pressure (a measure of gasoline's volatility) that are placed on gasoline during the summer ozone season. Specifically, the bill applies the waiver for Reid Vapor Pressure requirements that is applicable to gasoline blended with 10% ethanol (E10) to gasoline blended with up to 15% ethanol (E15). This change allows gasoline that is blended with 10% to 15% ethanol to be sold year-round.</p><p>Currently, states may be excluded from the waiver for Reid Vapor Pressure requirements by submitting documentation supporting that the waiver would increase air pollution. The bill nullifies existing state exclusions, but states may submit documentation after enactment of the bill to be excluded going forward.</p><p>The bill also modifies the Renewable Fuel Standard Program, which requires transportation fuel sold or introduced into commerce in the United States to contain minimum volumes of renewable fuel. Under the existing program, obligated parties, such as small refineries, must satisfy the volume obligations by either blending renewable fuels into their gasoline or diesel fuel products or by acquiring credits that represent the required renewable fuel volume. The bill directs the Environmental Protection Agency to return compliance credits to small refineries under certain circumstances.</p>","updateDate":"2025-05-07T23:40:02Z","versionCode":"00"}],"title":"Nationwide Consumer and Fuel Retailer Choice Act of 2025","type":"s","updateDate":"2026-09-08T18:12:22Z","updateDateIncludingText":"2026-09-08T18:17:04Z"}
