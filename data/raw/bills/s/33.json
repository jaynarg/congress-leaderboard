{"actions":[{"actionCode":null,"actionDate":"2025-01-08","source":"Senate","text":"Read twice and referred to the Committee on Homeland Security and Governmental Affairs.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-01-08","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/33","cosponsors":[{"bioguideId":"C001098","fullName":"Sen. Cruz, Ted [R-TX]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001096","fullName":"Sen. Cramer, Kevin [R-ND]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"P000603","fullName":"Sen. Paul, Rand [R-KY]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"E000295","fullName":"Sen. Ernst, Joni [R-IA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"B001305","fullName":"Sen. Budd, Ted [R-NC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"H000601","fullName":"Sen. Hagerty, Bill [R-TN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-08","sponsorshipWithdrawnDate":null,"state":"TN"}],"fetchedAt":"2026-09-17T05:07:37+00:00","id":"s33-119","introducedDate":"2025-01-08","latestAction":{"actionDate":"2025-01-08","text":"Read twice and referred to the Committee on Homeland Security and Governmental Affairs."},"laws":[],"number":"33","originChamber":"Senate","policyArea":"Law","sponsors":[{"bioguideId":"S001227","district":null,"fullName":"Sen. Schmitt, Eric [R-MO]","party":"R","state":"MO"}],"summaries":[{"actionDate":"2025-01-08","actionDesc":"Introduced in Senate","text":"<p><strong>Separation of Powers Restoration Act</strong> <strong>of 2025 or SOPRA</strong></p><p>This bill modifies the scope of judicial review of agency actions to authorize courts reviewing agency actions to decide de novo (i.e., without giving deference to the agency's interpretation) all relevant questions of law, including the interpretation of (1) constitutional and statutory provisions, (2) rules made by agencies, (3) interpretative rules, (4) general statements of policy, and (5) all other agency guidance documents.</p><p>No law may exempt a civil action from the standard of review required by this bill except by specific reference to such provision.</p>","updateDate":"2025-05-02T13:37:51Z","versionCode":"00"}],"title":"SOPRA","type":"s","updateDate":"2025-05-07T12:45:28Z","updateDateIncludingText":"2025-05-07T12:45:28Z"}
