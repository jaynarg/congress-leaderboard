e":"GA"},{"bioguideId":"C000127","fullName":"Sen. Cantwell, Maria [D-WA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-10","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"K000377","fullName":"Sen. Kelly, Mark [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-01","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"M001153","fullName":"Sen. Murkowski, Lisa [R-AK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-21","sponsorshipWithdrawnDate":null,"state":"MN"}],"fetchedAt":"2026-09-17T06:20:58+00:00","id":"s1441-119","introducedDate":"2025-04-10","latestAction":{"actionDate":"2026-02-24","text":"Placed on Senate Legislative Calendar under General Orders. Calendar No. 342."},"laws":[],"number":"1441","originChamber":"Senate","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"T000476","district":null,"fullName":"Sen. Tillis, Thomas [R-NC]","party":"R","state":"NC"}],"summaries":[{"actionDate":"2026-02-24","actionDesc":"Reported to Senate","text":"<p><strong>Service Dogs Assisting Veterans Act of 2025 or the SAVES Act of 2025</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to establish a five-year pilot program to award grants on a competitive basis to nonprofit entities to provide service dogs to veterans who have certain disabilities, conditions, or diagnoses (e.g., a visual impairment).</p><p>Under the program, the VA may provide up to $2 million to a nonprofit entity in a fiscal year.</p><p>The VA must provide a veterinary insurance policy to veterans who receive a service dog through a grant under the program.&nbsp;</p>","updateDate":"2026-06-28T21:56:11Z","versionCode":"25"}],"title":"SAVES Act of 2025","type":"s","updateDate":"2026-07-22T11:03:20Z",