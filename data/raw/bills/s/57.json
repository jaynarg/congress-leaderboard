{"actions":[{"actionCode":null,"actionDate":"2025-01-09","source":"Senate","text":"Read twice and referred to the Committee on Agriculture, Nutrition, and Forestry.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-01-09","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/57","cosponsors":[{"bioguideId":"C001035","fullName":"Sen. Collins, Susan M. [R-ME]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"S000148","fullName":"Sen. Schumer, Charles E. [D-NY]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S000033","fullName":"Sen. Sanders, Bernard [I-VT]","isOriginalCosponsor":true,"party":"I","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"K000383","fullName":"Sen. King, Angus S., Jr. [I-ME]","isOriginalCosponsor":true,"party":"I","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"G000555","fullName":"Sen. Gillibrand, Kirsten E. [D-NY]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-17T05:08:52+00:00","id":"s57-119","introducedDate":"2025-01-09","latestAction":{"actionDate":"2025-01-09","text":"Read twice and referred to the Committee on Agriculture, Nutrition, and Forestry."},"laws":[],"number":"57","originChamber":"Senate","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"W000800","district":null,"fullName":"Sen. Welch, Peter [D-VT]","party":"D","state":"VT"}],"summaries":[{"actionDate":"2025-01-09","actionDesc":"Introduced in Senate","text":"<p><strong>Making Agricultural Products Locally Essential Act or the&nbsp;MAPLE Act</strong></p><p>This bill includes maple syrup as one of the eligible&nbsp;foods under the&nbsp;Senior Farmers' Market Nutrition Program (SFMNP).&nbsp;</p><p>As background, the Department of Agriculture's&nbsp;SFMNP provides grants to participating states to provide low-income seniors with coupons/vouchers that&nbsp;may be used at farmers’ markets, roadside stands, and community supported agriculture programs to purchase eligible foods (i.e., fresh, nutritious, unprepared, locally-grown fruits, vegetables, herbs, and honey).</p>","updateDate":"2025-02-21T11:50:23Z","versionCode":"00"}],"title":"MAPLE Act","type":"s","updateDate":"2025-02-21T12:06:20Z","updateDateIncludingText":"2025-02-21T12:06:20Z"}
