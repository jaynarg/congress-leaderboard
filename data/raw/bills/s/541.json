te":null,"state":"IA"},{"bioguideId":"C001075","fullName":"Sen. Cassidy, Bill [R-LA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"M001198","fullName":"Sen. Marshall, Roger [R-KS]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"T000476","fullName":"Sen. Tillis, Thomas [R-NC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"H001061","fullName":"Sen. Hoeven, John [R-ND]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"S001217","fullName":"Sen. Scott, Rick [R-FL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-17T05:34:06+00:00","id":"s541-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2025-02-12","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"541","originChamber":"Senate","policyArea":"Taxation","sponsors":[{"bioguideId":"B001261","district":null,"fullName":"Sen. Barrasso, John [R-WY]","party":"R","state":"WY"}],"summaries":[{"actionDate":"2025-02-12","actionDesc":"Introduced in Senate","text":"<p><strong>Eliminate Lavish Incentives To Electric Vehicles Act or the ELITE Vehicles Act</strong></p><p>This bill eliminates federal tax credits for the purchase of certain clean vehicles (generally electric vehicles and plug-in hybrid vehicles) and electric&nbsp;vehicle recharging stations.</p><p>Specifically, the bill repeals the federal tax credits for</p><ul><li>the purchase of a qualified used clean vehicle (tax credit of up to $4,000 for the purchase of a previously-owned clean vehicle before 2033),</li><li>the purchase of a qualified new clean vehicle (tax credit of up to $7,500 for the purchase of a new clean vehicle before 2033),</li><li>the purchase of a qualified commercial clean vehicle (business tax credit of up to $40,000 for the purchase of a commercial clean vehicle before 2033), and</li><li>alternative fuel vehicle refueling property used to recharge electric vehicles (tax credit of up to $1,000 for individuals or up to $100,000 for businesses for the installation of property before 2033 that is used to recharge electric vehicles).</li></ul>","updateDate":"2025-09-23T13:47:38Z","versionCode":"00"}],"title":"ELITE Vehicles Act","type":"s","updateDate":"2025-12-05T21:54:45Z","updateDateIncludingText":"2025-12-05T21:54:45Z"}
