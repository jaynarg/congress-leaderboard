WithdrawnDate":null,"state":"MT"},{"bioguideId":"L000570","fullName":"Sen. Luján, Ben Ray [D-NM]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-11","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"C001047","fullName":"Sen. Capito, Shelley Moore [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-11","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"H000273","fullName":"Sen. Hickenlooper, John W. [D-CO]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"CO"}],"fetchedAt":"2026-09-17T07:06:41+00:00","id":"s2518-119","introducedDate":"2025-07-29","latestAction":{"actionDate":"2025-07-29","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"2518","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"B001267","district":null,"fullName":"Sen. Bennet, Michael F. [D-CO]","party":"D","state":"CO"}],"summaries":[{"actionDate":"2025-07-29","actionDesc":"Introduced in Senate","text":"<p><strong>Protecting Air Ambulance Services for Americans Act of 2025</strong></p><p>This bill authorizes payment changes under Medicare for air ambulance services based on certain collected data and requires additional reporting from providers of these services.</p><p>Current law requires providers of air ambulance services to report certain information regarding general costs and utilization to the Department of Health and Human Services; private health insurers are also required to report information relating to coverage of these services. The bill authorizes the Centers for Medicare &amp; Medicaid Services to revise payment rates under Medicare for air ambulance services based on this data, and it requires providers of air ambulance services to specifically report information relating to costs and utilization under Medicare.</p><p>The bill also requires the Government Accountability Office to report on the data that is collected under current law requirements and to recommend changes to Medicare payment rates accordingly.</p>","updateDate":"2025-12-02T16:48:00Z","versionCode":"00"}],"title":"Protecting Air Ambulance Services for Americans Act of 2025","type":"s","updateDate":"2026-06-25T12:18:23Z","updateDateIncludingText":"2026-06-25T12:18:23Z"}
