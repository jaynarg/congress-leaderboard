{"actions":[{"actionCode":null,"actionDate":"2025-04-03","source":"Senate","text":"Read twice and referred to the Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-04-03","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/1283","cosponsors":[{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-04-03","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"L000571","fullName":"Sen. Lummis, Cynthia M. [R-WY]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"WY"},{"bioguideId":"C001096","fullName":"Sen. Cramer, Kevin [R-ND]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"L000577","fullName":"Sen. Lee, Mike [R-UT]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-16","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001244","fullName":"Sen. Moody, Ashley [R-FL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-08","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"J000312","fullName":"Sen. Justice, James C. [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-04","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"T000476","fullName":"Sen. Tillis, Thomas [R-NC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-17","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"C001047","fullName":"Sen. Capito, Shelley Moore [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-24","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"C001095","fullName":"Sen. Cotton, Tom [R-AR]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-25","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"S001227","fullName":"Sen. Schmitt, Eric [R-MO]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-16","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-21","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"C000880","fullName":"Sen. Crapo, Mike [R-ID]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-22","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"TN"}],"fetchedAt":"2026-09-17T06:13:26+00:00","id":"s1283-119","introducedDate":"2025-04-03","latestAction":{"actionDate":"2025-04-03","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"1283","originChamber":"Senate","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"H000601","district":null,"fullName":"Sen. Hagerty, Bill [R-TN]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-04-03","actionDesc":"Introduced in Senate","text":"<p><strong>Innovate to De-Escalate Modernization Act</strong></p><p>This bill removes less-than-lethal projectile devices (e.g., certain TASERs) from regulation under the Gun Control Act.</p><p>The term <em>less-than-lethal projectile device</em> means a device that (1) is not designed or intended to expel (and may not be readily converted to discharge) commonly used ammunition or projectiles exceeding a velocity of 500 feet per second; (2) is designed and intended to be used in a manner not likely to cause death or serious bodily injury; and (3) does not accept (and cannot be readily modified to accept) an ammunition feeding device.</p><p>The bill also requires the Bureau of Alcohol, Tobacco, Firearms and Explosives to determine whether a device satisfies the definition of a <em>less-than-lethal projectile device</em> within 90 days of a request.</p>","updateDate":"2026-04-06T16:39:39Z","versionCode":"00"}],"title":"Innovate to De-Escalate Modernization Act","type":"s","updateDate":"2026-08-10T11:51:27Z","updateDateIncludingText":"2026-08-10T11:58:36Z"}
