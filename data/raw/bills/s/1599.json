{"actions":[{"actionCode":null,"actionDate":"2025-05-05","source":"Senate","text":"Read twice and referred to the Committee on Health, Education, Labor, and Pensions.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-05-05","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/1599","cosponsors":[{"bioguideId":"M001153","fullName":"Sen. Murkowski, Lisa [R-AK]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"K000377","fullName":"Sen. Kelly, Mark [D-AZ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-18","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-10-28T16:26:21+00:00","id":"s1599-119","introducedDate":"2025-05-05","latestAction":{"actionDate":"2025-05-05","text":"Read twice and referred to the Committee on Health, Education, Labor, and Pensions."},"laws":[],"number":"1599","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"L000570","district":null,"fullName":"Sen. Luján, Ben Ray [D-NM]","party":"D","state":"NM"}],"summaries":[{"actionDate":"2025-05-05","actionDesc":"Introduced in Senate","text":"<p><strong>Midwives for Maximizing Optimal Maternity Services Act of 2025 or the Midwives for MOMS Act of 2025</strong></p><p>This bill establishes grants within the Health Resources and Services Administration (HRSA) for establishing or expanding midwifery programs at institutions of higher education and nursing schools. In awarding grants, HRSA must give special consideration to institutions that focus on increasing the number of midwife professionals from underrepresented groups and promote practicing in areas with limited access to professional health care.</p>","updateDate":"2026-10-27T15:53:37Z","versionCode":"00"}],"title":"Midwives for MOMS Act of 2025","type":"s","updateDate":"2026-10-27T15:54:03Z","updateDateIncludingText":"2026-10-27T15:54:03Z"}
