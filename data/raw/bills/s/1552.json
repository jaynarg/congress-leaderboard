026-06-17","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"W000437","fullName":"Sen. Wicker, Roger F. [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"F000479","fullName":"Sen. Fetterman, John [D-PA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-17T06:26:13+00:00","id":"s1552-119","introducedDate":"2025-05-01","latestAction":{"actionDate":"2026-03-11","text":"Placed on Senate Legislative Calendar under General Orders. Calendar No. 352."},"laws":[],"number":"1552","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"C001095","district":null,"fullName":"Sen. Cotton, Tom [R-AR]","party":"R","state":"AR"}],"summaries":[{"actionDate":"2025-05-01","actionDesc":"Introduced in Senate","text":"<p><strong>Living Donor Protection Act of </strong><strong>2025</strong></p><p>This bill prohibits life insurance, disability insurance, and long-term insurance&nbsp;carriers from denying or otherwise restricting coverage for&nbsp;living organ donors.</p><p>Specifically, carriers may not deny, cancel, vary premiums, or otherwise impose conditions on policies based on an individual's status as a living organ donor.</p><p>The bill also expressly specifies that recovery from organ-donation surgery constitutes a serious health condition that entitles eligible employees to job-protected medical leave.</p><p>In addition, the Department of Health and Human Services must update educational materials on living organ donation to include information about the benefits and risks of living organ donation and the impact of donation on insurance access, particularly with respect to the bill's changes.</p>","updateDate":"2026-02-26T23:06:33Z","versionCode":"00"}],"title":"Living Donor Protection Act of 2025","type":"s","updateDate":"2026-07-14T11:00:20Z","updateDateIncludingText":"2026-07-14T11:00:20Z"}
