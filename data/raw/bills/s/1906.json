{"actions":[{"actionCode":null,"actionDate":"2025-05-22","source":"Senate","text":"Read twice and referred to the Committee on Agriculture, Nutrition, and Forestry.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-05-22","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/1906","cosponsors":[{"bioguideId":"B001230","fullName":"Sen. Baldwin, Tammy [D-WI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-05-22","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"M000934","fullName":"Sen. Moran, Jerry [R-KS]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-05-22","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"B001267","fullName":"Sen. Bennet, Michael F. [D-CO]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-05-22","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"G000386","fullName":"Sen. Grassley, Chuck [R-IA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-05-22","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"K000383","fullName":"Sen. King, Angus S., Jr. [I-ME]","isOriginalCosponsor":true,"party":"I","sponsorshipDate":"2025-05-22","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-05-22","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"C001035","fullName":"Sen. Collins, Susan M. [R-ME]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-05","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"B001305","fullName":"Sen. Budd, Ted [R-NC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001208","fullName":"Sen. Slotkin, Elissa [D-MI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-09-17T06:41:28+00:00","id":"s1906-119","introducedDate":"2025-05-22","latestAction":{"actionDate":"2025-05-22","text":"Read twice and referred to the Committee on Agriculture, Nutrition, and Forestry."},"laws":[],"number":"1906","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"M001198","district":null,"fullName":"Sen. Marshall, Roger [R-KS]","party":"R","state":"KS"}],"summaries":[{"actionDate":"2025-05-22","actionDesc":"Introduced in Senate","text":"<p><strong>Innovative Feed Enhancement and Economic Development Act of 2025 or the Innovative FEED Act of 2025</strong></p><p>This bill provides for the regulation of zootechnical animal food substances as food additives.</p><p>The bill defines&nbsp;<em>zootechnical animal food substance&nbsp;</em>as a substance that is added to the food or drinking water of animals and that affects only the animal's gastrointestinal tract, with the intended purpose of affecting the byproducts of the animal's digestion, reducing foodborne pathogens, or altering the animal's gastrointestinal biome.</p><p>The definition does not include substances&nbsp;that are used to&nbsp;treat or prevent diseases in animals, hormones, or active ingredients of animal drugs. Labels for zootechnical animal food substances must include a disclaimer that the substance may not be used to treat or prevent diseases in animals.&nbsp;</p>","updateDate":"2026-04-08T15:23:19Z","versionCode":"00"}],"title":"Innovative FEED Act of 2025","type":"s","updateDate":"2026-08-04T11:03:20Z","updateDateIncludingText":"2026-08-04T11:03:20Z"}
