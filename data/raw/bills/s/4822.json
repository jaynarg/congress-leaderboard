{"actions":[{"actionCode":"H15000","actionDate":"2026-06-18","source":"House floor actions","text":"Held at the desk.","type":"Floor"},{"actionCode":"H14000","actionDate":"2026-06-18","source":"House floor actions","text":"Received in the House.","type":"Floor"},{"actionCode":null,"actionDate":"2026-06-18","source":"Senate","text":"Message on Senate action sent to the House.","type":"Floor"},{"actionCode":null,"actionDate":"2026-06-17","source":"Senate","text":"Introduced in the Senate, read twice, considered, read the third time, and passed without amendment by Voice Vote. (consideration: CR S2885-2886; text: CR S2885-2886)","type":"Floor"},{"actionCode":"17000","actionDate":"2026-06-17","source":"Library of Congress","text":"Passed/agreed to in Senate: Introduced in the Senate, read twice, considered, read the third time, and passed without amendment by Voice Vote.","type":"Floor"},{"actionCode":"10000","actionDate":"2026-06-17","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/4822","cosponsors":[{"bioguideId":"S001198","fullName":"Sen. Sullivan, Dan [R-AK]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"C000127","fullName":"Sen. Cantwell, Maria [D-WA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"W000779","fullName":"Sen. Wyden, Ron [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"M001111","fullName":"Sen. Murray, Patty [D-WA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"R000122","fullName":"Sen. Reed, Jack [D-RI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"B001230","fullName":"Sen. Baldwin, Tammy [D-WI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"V000128","fullName":"Sen. Van Hollen, Chris [D-MD]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"M000133","fullName":"Sen. Markey, Edward J. [D-MA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"W000817","fullName":"Sen. Warren, Elizabeth [D-MA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"MA"}],"fetchedAt":"2026-09-17T15:02:44+00:00","id":"s4822-119","introducedDate":"2026-06-17","latestAction":{"actionDate":"2026-06-18","actionTime":"10:12:37","text":"Held at the desk."},"laws":[],"number":"4822","originChamber":"Senate","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"M001153","district":null,"fullName":"Sen. Murkowski, Lisa [R-AK]","party":"R","state":"AK"}],"summaries":[{"actionDate":"2026-06-17","actionDesc":"Passed Senate","text":"<p><strong>Saving the OOI Act of 2026</strong></p><p>This bill prohibits the National Science Foundation (NSF) from using federal funds to decommission or descope Ocean Observatories Initiative (OOI) instruments until a thorough review of OOI is completed.</p><p>OOI measures and observes ocean conditions using a series of in-water instruments that gather physical, chemical, geological, and biological data. On May 21, 2026, NSF announced that it would remove all in-water infrastructure from four of the five active OOI arrays.</p><p>Under the bill, NSF must conduct a thorough review of OOI with engagement from the scientific and coastal communities before decommissioning or descoping specified OOI instruments. This includes OOI instruments anchored off of Oregon, Washington, Alaska, and North Carolina, as well as instruments anchored in the Irminger Sea. NSF is required to maintain full and consistent OOI operations, including monitoring in states where instruments have already been decommissioned, until the review is complete.</p>","updateDate":"2026-07-14T18:00:55Z","versionCode":"55"}],"title":"Saving the OOI Act of 2026","type":"s","updateDate":"2026-07-17T20:09:31Z","updateDateIncludingText":"2026-07-30T16:27:18Z"}
