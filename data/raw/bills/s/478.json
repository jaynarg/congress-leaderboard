eId":"C001095","fullName":"Sen. Cotton, Tom [R-AR]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-24","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"S001198","fullName":"Sen. Sullivan, Dan [R-AK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-17","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M001242","fullName":"Sen. Moreno, Bernie [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-20","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"W000437","fullName":"Sen. Wicker, Roger F. [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-18","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"L000571","fullName":"Sen. Lummis, Cynthia M. [R-WY]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-17","sponsorshipWithdrawnDate":null,"state":"WY"},{"bioguideId":"G000608","fullName":"Sen. Graham, Darline [R-SC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-27","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"H001061","fullName":"Sen. Hoeven, John [R-ND]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"F000463","fullName":"Sen. Fischer, Deb [R-NE]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"Y000064","fullName":"Sen. Young, Todd [R-IN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"IN"}],"fetchedAt":"2026-09-17T14:50:18+00:00","id":"s478-119","introducedDate":"2025-02-06","latestAction":{"actionDate":"2025-03-11","text":"Committee on Veterans' Affairs. Hearings held. Hearings printed: S.Hrg. 119-35."},"laws":[],"number":"478","originChamber":"Senate","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"K000393","district":null,"fullName":"Sen. Kennedy, John [R-LA]","party":"R","state":"LA"}],"summaries":[{"actionDate":"2025-02-06","actionDesc":"Introduced in Senate","text":"<p><strong>Veterans 2nd Amendment Protection Act of 2025</strong></p><p>This bill prohibits the Department of Veterans Affairs (VA) from transmitting certain information to the National Instant Criminal Background Check System (NICS) utilized by licensed importers or dealers of firearms.</p><p>Specifically, the bill prohibits the VA from transmitting personally identifying information of a veteran or a beneficiary to the NICS solely on the basis that such veteran or beneficiary has an appointed fiduciary to manage their benefits, unless there is an order or finding of a judicial authority that such veteran or beneficiary is a danger to themselves or others.</p>","updateDate":"2025-03-24T17:42:48Z","versionCode":"00"}],"title":"Veterans 2nd Amendment Protection Act of 2025","type":"s","updateDate":"2026-09-17T11:03:28Z","updateDateIncludingText":"2026-09-17T11:03:28Z"}
