te":null,"state":"FL"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-26","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-17T06:14:33+00:00","id":"s1308-119","introducedDate":"2025-04-04","latestAction":{"actionDate":"2025-04-04","text":"Read twice and referred to the Committee on Veterans' Affairs."},"laws":[],"number":"1308","originChamber":"Senate","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"T000476","district":null,"fullName":"Sen. Tillis, Thomas [R-NC]","party":"R","state":"NC"}],"summaries":[{"actionDate":"2025-04-04","actionDesc":"Introduced in Senate","text":"<p><strong>Veterans Education and Technical Skills Opportunity Act of 2025 or the VETS Opportunity Act of 2025</strong></p><p>This bill modifies which independent study programs are covered under veterans’ educational assistance benefits.</p><p>The bill requires independent study programs that lead to a certificate that reflects graduation from a course of study to include regular and substantive interaction between students and instructors.</p><p>The bill allows such independent study programs to be offered by any institutions of higher education, including for-profit institutions, that are approved to participate in the Department of Education’s financial assistance programs.</p>","updateDate":"2026-03-27T01:21:34Z","versionCode":"00"}],"title":"VETS Opportunity Act of 2025","type":"s","updateDate":"2026-08-04T11:03:19Z","updateDateIncludingText":"2026-08-04T11:03:19Z"}
