{"actions":[{"actionCode":null,"actionDate":"2025-04-09","source":"Senate","text":"Read twice and referred to the Committee on Finance.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-04-09","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/1384","cosponsors":[{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"Y000064","fullName":"Sen. Young, Todd [R-IN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"B001305","fullName":"Sen. Budd, Ted [R-NC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"D000618","fullName":"Sen. Daines, Steve [R-MT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"R000584","fullName":"Sen. Risch, James E. [R-ID]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"C001098","fullName":"Sen. Cruz, Ted [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001056","fullName":"Sen. Cornyn, John [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-01","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-29","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-17T06:18:23+00:00","id":"s1384-119","introducedDate":"2025-04-09","latestAction":{"actionDate":"2025-04-09","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"1384","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"B001299","district":null,"fullName":"Sen. Banks, Jim [R-IN]","party":"R","state":"IN"}],"summaries":[{"actionDate":"2025-04-09","actionDesc":"Introduced in Senate","text":"<p><strong>Abortion Funding Awareness Act of 2025</strong></p><p>This bill establishes reporting requirements for states regarding certain Medicaid payments to abortion providers.</p><p>Specifically, the bill requires states that make Medicaid payments using&nbsp;federal funds for any items or services furnished by an abortion provider to annually (1) submit a report to the Centers for Medicare &amp; Medicaid Services on all such payments, and (2) publish the report on the state's website. The report must include specified information, including the number of abortions performed by the providers and the gestational age with respect to each such abortion. (Current law restricts the use of federal funds for abortions to cases of rape, incest, or life endangerment of the woman. States may use their own funds to cover abortions in other cases.)</p>","updateDate":"2025-05-21T20:46:34Z","versionCode":"00"}],"title":"Abortion Funding Awareness Act of 2025","type":"s","updateDate":"2026-04-30T11:03:19Z","updateDateIncludingText":"2026-04-30T11:03:19Z"}
