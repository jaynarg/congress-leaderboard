tate":"NV"},{"bioguideId":"R000608","fullName":"Sen. Rosen, Jacky [D-NV]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"B001236","fullName":"Sen. Boozman, John [R-AR]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-18","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"W000817","fullName":"Sen. Warren, Elizabeth [D-MA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"C000880","fullName":"Sen. Crapo, Mike [R-ID]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"O000174","fullName":"Sen. Ossoff, Jon [D-GA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"K000393","fullName":"Sen. Kennedy, John [R-LA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-12","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-13","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M001244","fullName":"Sen. Moody, Ashley [R-FL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-27","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000555","fullName":"Sen. Gillibrand, Kirsten E. [D-NY]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"K000394","fullName":"Sen. Kim, Andy [D-NJ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-20","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-17T05:22:18+00:00","id":"s315-119","introducedDate":"2025-01-29","latestAction":{"actionDate":"2025-04-03","text":"Placed on Senate Legislative Calendar under General Orders. Calendar No. 39."},"laws":[],"number":"315","originChamber":"Senate","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"M000133","district":null,"fullName":"Sen. Markey, Edward J. [D-MA]","party":"D","state":"MA"}],"summaries":[{"actionDate":"2025-01-29","actionDesc":"Introduced in Senate","text":"<p><strong>AM Radio for Every Vehicle Act of 2025</strong></p><p>This bill requires the Department of Transportation (DOT) to issue a rule requiring AM radio capabilities to be standard in all new passenger&nbsp;vehicles. (AM radio is often used to deliver emergency alerts and news and entertainment programming; some newer vehicles do not include AM equipment.)</p><p>Specifically, this bill applies to passenger&nbsp;vehicles (1) manufactured in the United States for sale in the United States, imported into the United States, or shipped in interstate commerce; and (2) manufactured&nbsp;after the rule's effective date.&nbsp;The rule must require all such vehicles to have devices that can receive signals and play content transmitted by AM stations or digital audio AM stations installed as standard equipment and made easily accessible to drivers.</p><p>Prior to the rule's effective date, manufacturers that do not include devices that can access AM radio as standard equipment (1) must inform purchasers of this fact through clear and conspicuous labeling, and (2)&nbsp;may not charge an additional or separate fee&nbsp;for AM radio access.</p><p>DOT may assess civil penalties for any violation of the rule. The Department of Justice may also bring a civil action to enjoin a violation.</p><p>DOT’s authority to issue the rule expires 10 years after the bill’s enactment.&nbsp;</p><p>Further, the Government Accountability Office must study and report on the dissemination of emergency alerts to the public, including by conducting an assessment of AM broadcast stations relative to other Integrated Public Alert and Warning System communication technologies.</p><p>&nbsp;</p>","updateDate":"2025-03-06T16:50:01Z","versionCode":"00"}],"title":"AM Radio for Every Vehicle Act of 2025","type":"s","updateDate":"2026-09-08T18:03:40Z","updateDateIncludingText":"2026-09-08T18:03:40Z"}
