{"actions":[{"actionCode":null,"actionDate":"2025-12-11","source":"Senate","text":"Read twice and referred to the Committee on Finance.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-12-11","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/3442","cosponsors":[{"bioguideId":"M001153","fullName":"Sen. Murkowski, Lisa [R-AK]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-12-11","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"R000605","fullName":"Sen. Rounds, Mike [R-SD]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-28","sponsorshipWithdrawnDate":null,"state":"SD"},{"bioguideId":"G000555","fullName":"Sen. Gillibrand, Kirsten E. [D-NY]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-28","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-04","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"C001047","fullName":"Sen. Capito, Shelley Moore [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-04","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"A000382","fullName":"Sen. Alsobrooks, Angela D. [D-MD]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"C001035","fullName":"Sen. Collins, Susan M. [R-ME]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"ME"}],"fetchedAt":"2026-09-17T07:44:14+00:00","id":"s3442-119","introducedDate":"2025-12-11","latestAction":{"actionDate":"2025-12-11","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"3442","originChamber":"Senate","policyArea":"Social Welfare","sponsors":[{"bioguideId":"M001169","district":null,"fullName":"Sen. Murphy, Christopher [D-CT]","party":"D","state":"CT"}],"summaries":[{"actionDate":"2025-12-11","actionDesc":"Introduced in Senate","text":"<p><strong>Metastatic Breast Cancer Access to Care Act</strong></p> <p>This bill expedites payment of Social Security Disability Insurance (SSDI) benefits and eligibility for Medicare coverage for those with metastatic breast cancer (i.e., breast cancer that has spread to other sites in the body).</p> <p>Specifically, the bill eliminates the 5-month waiting period for SSDI benefits and the subsequent 24-month waiting period for Medicare coverage for individuals with metastatic breast cancer. Under current law, individuals generally must wait 5 months after the onset of disability to begin receiving SSDI benefits and an additional 24 months to become eligible for Medicare.</p>","updateDate":"2026-04-03T19:32:20Z","versionCode":"00"}],"title":"Metastatic Breast Cancer Access to Care Act","type":"s","updateDate":"2026-05-13T11:03:32Z","updateDateIncludingText":"2026-05-13T11:03:32Z"}
