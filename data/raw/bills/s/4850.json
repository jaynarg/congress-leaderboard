{"actions":[{"actionCode":"H15000","actionDate":"2026-08-10","source":"House floor actions","text":"Held at the desk.","type":"Floor"},{"actionCode":"H14000","actionDate":"2026-08-10","source":"House floor actions","text":"Received in the House.","type":"Floor"},{"actionCode":null,"actionDate":"2026-08-10","source":"Senate","text":"Message on Senate action sent to the House.","type":"Floor"},{"actionCode":null,"actionDate":"2026-08-07","source":"Senate","text":"Passed Senate without amendment by Unanimous Consent. (consideration: CR S4550-4551; text: CR S4551)","type":"Floor"},{"actionCode":"17000","actionDate":"2026-08-07","source":"Library of Congress","text":"Passed/agreed to in Senate: Passed Senate without amendment by Unanimous Consent.","type":"Floor"},{"actionCode":null,"actionDate":"2026-08-07","source":"Senate","text":"Senate Committee on the Judiciary discharged by Unanimous Consent.","type":"Discharge"},{"actionCode":"14500","actionDate":"2026-08-07","source":"Library of Congress","text":"Senate Committee on the Judiciary discharged by Unanimous Consent.","type":"Committee"},{"actionCode":null,"actionDate":"2026-06-22","source":"Senate","text":"Read twice and referred to the Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2026-06-22","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/4850","cosponsors":[{"bioguideId":"C001088","fullName":"Sen. Coons, Christopher A. [D-DE]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-22","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"C001098","fullName":"Sen. Cruz, Ted [R-TX]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-06-22","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-22","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"D000563","fullName":"Sen. Durbin, Richard J. [D-IL]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-27","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-10-01T16:55:59+00:00","id":"s4850-119","introducedDate":"2026-06-22","latestAction":{"actionDate":"2026-08-10","actionTime":"11:11:39","text":"Held at the desk."},"laws":[],"number":"4850","originChamber":"Senate","policyArea":"Law","sponsors":[{"bioguideId":"K000393","district":null,"fullName":"Sen. Kennedy, John [R-LA]","party":"R","state":"LA"}],"summaries":[{"actionDate":"2026-08-07","actionDesc":"Passed Senate","text":"<p><strong>Diversity Jurisdiction Inflation Adjustment Act</strong></p><p>This bill raises the minimum amount in controversy for federal diversity jurisdiction.</p><p>Under current law, federal courts have jurisdiction over civil cases in which the monetary amount in controversy exceeds $75,000 and there is diversity of citizenship among the parties (e.g., the parties are citizens of different states).</p><p>This bill raises the minimum amount in controversy from $75,000 to $150,000 and adjusts the amount for inflation every 10 years beginning in 2030.</p>","updateDate":"2026-09-30T15:48:23Z","versionCode":"55"}],"title":"Diversity Jurisdiction Inflation Adjustment Act","type":"s","updateDate":"2026-09-30T15:49:27Z","updateDateIncludingText":"2026-09-30T15:49:27Z"}
