ate":null,"state":"CT"},{"bioguideId":"H001104","fullName":"Sen. Husted, Jon [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-03","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"D000622","fullName":"Sen. Duckworth, Tammy [D-IL]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-19","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"M001198","fullName":"Sen. Marshall, Roger [R-KS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-19","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"H001042","fullName":"Sen. Hirono, Mazie K. [D-HI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"HI"}],"fetchedAt":"2026-09-17T05:30:36+00:00","id":"s475-119","introducedDate":"2025-02-06","latestAction":{"actionDate":"2025-02-06","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"475","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"T000476","district":null,"fullName":"Sen. Tillis, Thomas [R-NC]","party":"R","state":"NC"}],"summaries":[{"actionDate":"2025-02-06","actionDesc":"Introduced in Senate","text":"<p><strong>Alternatives to Prevent Addiction In the Nation Act or the Alternatives to PAIN Act</strong></p><p>This bill reduces&nbsp;cost-sharing and prohibits the imposition of certain utilization requirements under the Medicare prescription drug benefit for certain non-opioid pain management drugs.</p><p>Specifically, the bill requires such drugs to be covered without a deductible and to be placed on the lowest cost-sharing tier (if any). The bill also prohibits the imposition of prior authorization requirements (i.e., requiring prior approval from a plan) or step therapy requirements (i.e., requiring the use of alternative drugs before a drug is covered under a plan) with respect to such drugs.</p>","updateDate":"2025-05-08T21:04:40Z","versionCode":"00"}],"title":"Alternatives to PAIN Act","type":"s","updateDate":"2026-05-21T11:03:37Z","updateDateIncludingText":"2026-05-21T11:03:37Z"}
