party":"D","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"H000273","fullName":"Sen. Hickenlooper, John W. [D-CO]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-21","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"P000595","fullName":"Sen. Peters, Gary C. [D-MI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-23","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"K000377","fullName":"Sen. Kelly, Mark [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-28","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"H001079","fullName":"Sen. Hyde-Smith, Cindy [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-28","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"P000145","fullName":"Sen. Padilla, Alex [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-28","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"R000608","fullName":"Sen. Rosen, Jacky [D-NV]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-29","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"B001261","fullName":"Sen. Barrasso, John [R-WY]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-29","sponsorshipWithdrawnDate":null,"state":"WY"},{"bioguideId":"H001076","fullName":"Sen. Hassan, Margaret Wood [D-NH]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"H001046","fullName":"Sen. Heinrich, Martin [D-NM]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-04","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"A000383","fullName":"Sen. Armstrong, Alan [R-OK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-04","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"C001088","fullName":"Sen. Coons, Christopher A. [D-DE]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"B001277","fullName":"Sen. Blumenthal, Richard [D-CT]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"CT"}],"fetchedAt":"2026-09-17T08:26:06+00:00","id":"s4429-119","introducedDate":"2026-04-29","latestAction":{"actionDate":"2026-07-22","text":"Committee on Commerce, Science, and Transportation. Ordered to be reported with an amendment in the nature of a substitute favorably."},"laws":[],"number":"4429","originChamber":"Senate","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"M001242","district":null,"fullName":"Sen. Moreno, Bernie [R-OH]","party":"R","state":"OH"}],"summaries":[{"actionDate":"2026-04-29","actionDesc":"Introduced in Senate","text":"<p><strong>Connected Vehicle Security Act of 2026</strong></p><p>This bill prohibits the importation, manufacture, sale, resale, or introduction into U.S. interstate commerce of connected vehicles and related software and hardware components associated with China, Russia, Iran, or North Korea.</p><p><em>Connected vehicle</em> means a vehicle that (1) integrates onboard networked hardware with automotive software systems to communicate&nbsp;with any other network or device using certain methods (e.g., wireless spectrum connectivity); or (2) is designed, manufactured, or originally equipped to communicate via such methods, regardless of whether such capability is enabled, disabled, or removed at the time the vehicle enters the United States.</p><p><a href=\"https://www.federalregister.gov/documents/2025/01/16/2025-00592/securing-the-information-and-communications-technology-and-services-supply-chain-connected-vehicles\">Current regulations</a> administered by the Department of Commerce's Bureau of Industry and Security (BIS) prohibit transactions involving vehicle connectivity system hardware and covered software designed, developed, manufactured, or supplied by persons owned by, controlled by, or subject to the jurisdiction or direction of China or Russia.</p><p>The bill expands the&nbsp;BIS regulatory framework, including by (1) expanding the countries covered by the prohibition to include China, Russia, Iran, and North Korea (Current BIS regulations apply only to China and Russia.); and (2) specifying that certain artificial intelligence components are covered by the prohibition.</p><p>By January 1, 2027, BIS must publish a list of items that are authorized for the importation, manufacture, sale, resale, or introduction into U.S. interstate commerce and would otherwise be subject to the bill's prohibition.</p><p>The bill also includes enforcement mechanisms, including that BIS must assess civil penalties for violations of the prohibition.</p>","updateDate":"2026-08-31T16:53:17Z","versionCode":"00"}],"title":"Connected Vehicle Security Act of 2026","type":"s","updateDate":"2026-09-15T11:03:30Z","updateDateIncludingText":"2026-09-15T11:03:30Z"}
