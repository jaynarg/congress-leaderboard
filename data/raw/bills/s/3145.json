{"actions":[{"actionCode":null,"actionDate":"2025-11-06","source":"Senate","text":"Read twice and referred to the Committee on Finance. (Sponsor introductory remarks on measure: CR S7964)","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-11-06","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/3145","cosponsors":[{"bioguideId":"W000800","fullName":"Sen. Welch, Peter [D-VT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-06","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-08","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"C001075","fullName":"Sen. Cassidy, Bill [R-LA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-08","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"J000312","fullName":"Sen. Justice, James C. [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"K000394","fullName":"Sen. Kim, Andy [D-NJ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-05","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"C001047","fullName":"Sen. Capito, Shelley Moore [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-05","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"C001088","fullName":"Sen. Coons, Christopher A. [D-DE]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-29","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"H001079","fullName":"Sen. Hyde-Smith, Cindy [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-29","sponsorshipWithdrawnDate":null,"state":"MS"}],"fetchedAt":"2026-09-17T07:32:11+00:00","id":"s3145-119","introducedDate":"2025-11-06","latestAction":{"actionDate":"2025-11-06","text":"Read twice and referred to the Committee on Finance. (Sponsor introductory remarks on measure: CR S7964)"},"laws":[],"number":"3145","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"C001035","district":null,"fullName":"Sen. Collins, Susan M. [R-ME]","party":"R","state":"ME"}],"summaries":[{"actionDate":"2025-11-06","actionDesc":"Introduced in Senate","text":"<p><strong>Comprehensive Alternative Response for Emergencies Act of 2025 or the CARE Act of 2025</strong></p><p>This bill requires the Center for Medicare and Medicaid Innovation (CMMI) to test a five-year model that provides for Medicare payment for ground ambulance services that do not result in the transport of the patient.&nbsp;</p><p>Under the model, Medicare payment may be furnished for ground ambulance services when an ambulance is dispatched in response to an emergency medical call but the ambulance does not end up transporting the patient. Payment rates under the model must generally align with the payment rates that apply when there is an actual transport.&nbsp;</p><p>The Government Accountability Office must report on the general access of Medicare beneficiaries to emergency medical services, including the impact of the model on beneficiary access and outcomes.</p>","updateDate":"2026-07-24T22:19:11Z","versionCode":"00"}],"title":"CARE Act of 2025","type":"s","updateDate":"2026-07-24T22:19:46Z","updateDateIncludingText":"2026-07-24T22:19:46Z"}
