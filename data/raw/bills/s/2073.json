awnDate":null,"state":"MN"},{"bioguideId":"M001169","fullName":"Sen. Murphy, Christopher [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"B001288","fullName":"Sen. Booker, Cory A. [D-NJ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"D000563","fullName":"Sen. Durbin, Richard J. [D-IL]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"H001046","fullName":"Sen. Heinrich, Martin [D-NM]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"H001042","fullName":"Sen. Hirono, Mazie K. [D-HI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"HI"}],"fetchedAt":"2026-09-17T06:48:18+00:00","id":"s2073-119","introducedDate":"2025-06-12","latestAction":{"actionDate":"2025-06-12","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"2073","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"S001194","district":null,"fullName":"Sen. Schatz, Brian [D-HI]","party":"D","state":"HI"}],"summaries":[{"actionDate":"2025-06-12","actionDesc":"Introduced in Senate","text":"<p><strong>State Public Option Act</strong></p><p>This bill allows residents who are&nbsp;not already eligible for Medicaid&nbsp;and not concurrently enrolled in other health insurance coverage to&nbsp;buy into&nbsp;a state&nbsp;Medicaid plan&nbsp;beginning January 1, 2026, at the option of the state. State Medicaid programs may set premiums and cost-sharing requirements for such coverage in accordance with specified limitations.</p><p>The bill also (1) provides the enhanced Federal Medical Assistance Percentage (i.e., federal matching rate) to every state that expands Medicaid coverage for individuals who are newly eligible under the Patient Protection and Affordable Care Act, regardless of when such expansion takes place; and (2) requires state Medicaid programs to cover comprehensive sexual and&nbsp;reproductive health care services, including abortion services.</p>","updateDate":"2025-07-24T20:16:36Z","versionCode":"00"}],"title":"State Public Option Act","type":"s","updateDate":"2026-06-11T23:26:34Z","updateDateIncludingText":"2026-06-11T23:26:34Z"}
