025-09-04","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"G000386","fullName":"Sen. Grassley, Chuck [R-IA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-09-04","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"H001089","fullName":"Sen. Hawley, Josh [R-MO]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-10","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"R000618","fullName":"Sen. Ricketts, Pete [R-NE]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"M001244","fullName":"Sen. Moody, Ashley [R-FL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001198","fullName":"Sen. Sullivan, Dan [R-AK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-24","sponsorshipWithdrawnDate":null,"state":"AK"}],"fetchedAt":"2026-09-17T07:14:59+00:00","id":"s2721-119","introducedDate":"2025-09-04","latestAction":{"actionDate":"2025-09-04","text":"Read twice and referred to the Committee on Homeland Security and Governmental Affairs."},"laws":[],"number":"2721","originChamber":"Senate","policyArea":"Economics and Public Finance","sponsors":[{"bioguideId":"L000575","district":null,"fullName":"Sen. Lankford, James [R-OK]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2025-09-04","actionDesc":"Introduced in Senate","text":"<p><strong>Prevent Government Shutdowns Act of 2025</strong></p><p>This bill provides continuing appropriations to prevent a government shutdown if the appropriations bills for a fiscal year have not been enacted before the fiscal year begins and continuing appropriations are not in effect.</p><p>Specifically, the bill provides appropriations at the rate of operations that was provided for the prior fiscal year to continue programs, projects, and activities that were funded in the preceding fiscal year.</p><p>The bill also limits official travel, congressional recesses or adjournments, and the consideration of legislation that is unrelated to appropriations after the beginning of a fiscal year if the appropriations process has not been completed.</p>","updateDate":"2025-10-06T14:01:23Z","versionCode":"00"}],"title":"Prevent Government Shutdowns Act of 2025","type":"s","updateDate":"2026-06-05T15:29:03Z","updateDateIncludingText":"2026-06-05T15:29:03Z"}
