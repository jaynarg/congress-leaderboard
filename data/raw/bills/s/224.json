:null,"state":"WY"},{"bioguideId":"M000934","fullName":"Sen. Moran, Jerry [R-KS]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"S001232","fullName":"Sen. Sheehy, Tim [R-MT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"R000584","fullName":"Sen. Risch, James E. [R-ID]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"S001198","fullName":"Sen. Sullivan, Dan [R-AK]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"C001056","fullName":"Sen. Cornyn, John [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001242","fullName":"Sen. Moreno, Bernie [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-13","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"L000577","fullName":"Sen. Lee, Mike [R-UT]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-26","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"H001061","fullName":"Sen. Hoeven, John [R-ND]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-21","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"H001104","fullName":"Sen. Husted, Jon [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-21","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-10-30T16:34:50+00:00","id":"s224-119","introducedDate":"2025-01-23","latestAction":{"actionDate":"2025-01-23","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"224","originChamber":"Senate","policyArea":"Taxation","sponsors":[{"bioguideId":"L000575","district":null,"fullName":"Sen. Lankford, James [R-OK]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2025-01-23","actionDesc":"Introduced in Senate","text":"<p><strong>Promoting Domestic Energy Production Act</strong></p><p>This bill allows corporations to reduce their adjusted financial statement income to account for certain intangible costs related to oil, gas, or geothermal well drilling and development for purposes of calculating the corporate alternative minimum tax.</p><p>Under current law, a&nbsp;15% corporate alternative minimum tax is imposed on a corporation with adjusted financial statement income exceeding an average of $1 billion for a consecutive three-year period (or an average of $100 million for a U.S. corporation that is part of a foreign parent multinational group if the adjusted financial statement income of such group exceeds an average of $1 billion for a consecutive three-year period). Adjusted financial statement income generally is the net income or loss reported on the corporation’s applicable financial statement for a tax year, with adjustments for specific items.</p><p>This bill expands the reductions that may be made to a corporation’s adjusted financial statement income to include (1) intangible drilling and development costs incurred by an operator of a domestic oil, gas, or geothermal well that are allowed as a deduction in the current tax year when computing regular taxable income; and (2) any depletion expenses related to the intangible oil, gas, or geothermal well drilling and development costs.</p>","updateDate":"2026-10-30T15:55:24Z","versionCode":"00"}],"title":"Promoting Domestic Energy Production Act","type":"s","updateDate":"2026-10-30T15:56:34Z","updateDateIncludingText":"2026-10-30T15:56:34Z"}
