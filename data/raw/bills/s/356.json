ioguideId":"P000145","fullName":"Sen. Padilla, Alex [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C000127","fullName":"Sen. Cantwell, Maria [D-WA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-04","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-14","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"H000273","fullName":"Sen. Hickenlooper, John W. [D-CO]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-15","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"S001208","fullName":"Sen. Slotkin, Elissa [D-MI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-09-17T05:24:25+00:00","id":"s356-119","introducedDate":"2025-02-03","latestAction":{"actionDate":"2025-12-18","text":"Became Public Law No: 119-58."},"laws":[{"number":"119-58","type":"Public Law"}],"number":"356","originChamber":"Senate","policyArea":"Public Lands and Natural Resources","sponsors":[{"bioguideId":"C000880","district":null,"fullName":"Sen. Crapo, Mike [R-ID]","party":"R","state":"ID"}],"summaries":[{"actionDate":"2025-02-03","actionDesc":"Introduced in Senate","text":"<p><strong>Secure Rural Schools Reauthorization Act of 2025</strong></p><p>This bill extends and modifies the Secure Rural Schools and Community Self-Determination Act of 2000, including by</p><ul><li>extending payments made to states and counties containing federal land through FY2026,</li><li>providing for payments for FY2024 and FY2025,</li><li>extending the authority of counties to initiate projects using such funds through FY2028, and</li><li>extending the authority to initiate projects proposed by resource advisory committees through FY2028.</li></ul>","updateDate":"2025-12-08T16:57:09Z","versionCode":"00"},{"actionDate":"2025-12-18","actionDesc":"Public Law","text":"<p><strong>Secure Rural Schools Reauthorization Act of 2025</strong></p><p>This act extends and modifies the Secure Rural Schools (SRS) program, under which states and counties containing certain federal land&nbsp;may receive payments from the Forest&nbsp;Service or the Bureau of Land Management (BLM) for schools, roads, and certain other municipal services.</p><p>The act modifies the SRS program, including by</p><ul><li>extending payments made to states and counties containing federal land through FY2026,</li><li>providing lapsed payments&nbsp;for FY2024 and FY2025,</li><li>extending&nbsp;the authority of counties to initiate projects using such funds through FY2028, and</li><li>extending the authority to initiate projects proposed by resource advisory committees through FY2028.</li></ul>","updateDate":"2026-07-15T20:15:48Z","versionCode":"49"}],"title":"Secure Rural Schools Reauthorization Act of 2025","type":"s","updateDate":"2026-09-08T18:09:59Z","updateDateIncludingText":"2026-09-08T18:19:09Z"}
