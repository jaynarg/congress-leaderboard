nDate":null,"state":"MO"},{"bioguideId":"C001056","fullName":"Sen. Cornyn, John [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-30","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001098","fullName":"Sen. Cruz, Ted [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-12","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-10-03T14:33:52+00:00","id":"s3650-119","introducedDate":"2026-01-15","latestAction":{"actionDate":"2026-01-15","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"3650","originChamber":"Senate","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"M001244","district":null,"fullName":"Sen. Moody, Ashley [R-FL]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2026-01-15","actionDesc":"Introduced in Senate","text":"<p><strong>Child Interstate Abortion Notification Act&nbsp;</strong></p><p>This bill creates new federal crimes related to transporting a minor across state lines for an abortion.</p><p>Specifically, the bill makes it a crime to knowingly transport a minor across a state line to obtain an abortion without satisfying the requirements of a parental involvement law in the minor's resident state. A parental involvement law requires parental consent or notification, or judicial authorization, for a minor to obtain an abortion.</p><p>The bill prohibits an individual who has committed incest with a minor from knowingly transporting the minor across a state line to receive an abortion.</p><p>Finally, the bill makes it a crime for a physician to knowingly perform or induce an abortion on an out-of-state minor without first notifying the minor's parent.</p>","updateDate":"2026-10-02T21:56:07Z","versionCode":"00"}],"title":"Child Interstate Abortion Notification Act","type":"s","updateDate":"2026-10-02T21:56:49Z","updateDateIncludingText":"2026-10-02T21:56:49Z"}
