-01-23","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"F000463","fullName":"Sen. Fischer, Deb [R-NE]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"H001089","fullName":"Sen. Hawley, Josh [R-MO]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"S001232","fullName":"Sen. Sheehy, Tim [R-MT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"MT"}],"fetchedAt":"2026-09-17T05:16:44+00:00","id":"s207-119","introducedDate":"2025-01-23","latestAction":{"actionDate":"2025-01-23","text":"Read twice and referred to the Committee on Health, Education, Labor, and Pensions."},"laws":[],"number":"207","originChamber":"Senate","policyArea":"Education","sponsors":[{"bioguideId":"D000618","district":null,"fullName":"Sen. Daines, Steve [R-MT]","party":"R","state":"MT"}],"summaries":[{"actionDate":"2025-01-23","actionDesc":"Introduced in Senate","text":"<p><strong>Protecting Life on College Campus Act of </strong><strong>2025</strong></p><p>This bill prohibits the award of federal funds to an institution of higher education (IHE) that hosts or is affiliated with a school-based service site that provides abortion drugs or abortions to its students or to employees of the IHE or the site. An IHE that hosts or is affiliated with a site must, in order to remain eligible for federal funds, annually certify that the site does not provide abortion drugs or abortions to students or employees.</p>","updateDate":"2025-03-17T21:58:48Z","versionCode":"00"}],"title":"Protecting Life on College Campus Act of 2025","type":"s","updateDate":"2025-04-21T12:24:17Z","updateDateIncludingText":"2025-04-21T12:24:17Z"}
