nsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"A000382","fullName":"Sen. Alsobrooks, Angela D. [D-MD]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-05","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"D000622","fullName":"Sen. Duckworth, Tammy [D-IL]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-23","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-17T06:44:21+00:00","id":"s1973-119","introducedDate":"2025-06-05","latestAction":{"actionDate":"2025-06-05","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"1973","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"C001075","district":null,"fullName":"Sen. Cassidy, Bill [R-LA]","party":"R","state":"LA"}],"summaries":[{"actionDate":"2025-06-05","actionDesc":"Introduced in Senate","text":"<p><strong>Treat and Reduce Obesity Act of </strong><strong>2025</strong></p><p>This bill expands Medicare coverage of intensive behavioral therapy for obesity. Specifically, the bill allows coverage for therapy that is provided by (1) a physician who is not a primary care physician; or&nbsp;(2) other health care providers (e.g., physician assistants and nurse practitioners) and approved counseling programs, if provided upon a referral from, and in coordination with, a physician or primary care practitioner. Currently, such therapy is covered only if provided by a primary care practitioner.</p><p>The bill also allows coverage under Medicare's prescription drug benefit of drugs used for the treatment of obesity or for weight loss management for individuals who are overweight.</p>","updateDate":"2025-07-25T15:48:53Z","versionCode":"00"}],"title":"Treat and Reduce Obesity Act of 2025","type":"s","updateDate":"2026-02-24T12:03:19Z","updateDateIncludingText":"2026-02-24T12:03:19Z"}
