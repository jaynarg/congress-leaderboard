{"actions":[{"actionCode":null,"actionDate":"2025-02-05","source":"Senate","text":"Read twice and referred to the Committee on Commerce, Science, and Transportation.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-02-05","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/405","cosponsors":[{"bioguideId":"L000577","fullName":"Sen. Lee, Mike [R-UT]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"C001096","fullName":"Sen. Cramer, Kevin [R-ND]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-19","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"J000312","fullName":"Sen. Justice, James C. [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-08","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"B001299","fullName":"Sen. Banks, Jim [R-IN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-14","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"C001047","fullName":"Sen. Capito, Shelley Moore [R-WV]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-28","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"D000618","fullName":"Sen. Daines, Steve [R-MT]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-28","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"S001217","fullName":"Sen. Scott, Rick [R-FL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-11","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000608","fullName":"Sen. Graham, Darline [R-SC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-04","sponsorshipWithdrawnDate":null,"state":"SC"}],"fetchedAt":"2026-09-17T05:26:48+00:00","id":"s405-119","introducedDate":"2025-02-05","latestAction":{"actionDate":"2025-02-05","text":"Read twice and referred to the Committee on Commerce, Science, and Transportation."},"laws":[],"number":"405","originChamber":"Senate","policyArea":"Sports and Recreation","sponsors":[{"bioguideId":"T000278","district":null,"fullName":"Sen. Tuberville, Tommy [R-AL]","party":"R","state":"AL"}],"summaries":[{"actionDate":"2025-02-05","actionDesc":"Introduced in Senate","text":"<p><strong>Protection of Women in Olympic and Amateur Sports Act</strong></p><p>This bill requires certified national governing bodies (NGBs) of amateur sports (e.g., USA Gymnastics)&nbsp;to prohibit a person whose sex is male from participating in an amateur athletic competition that is designated for females, women, or girls.</p><p>Under the bill, <em>male</em>&nbsp;means an individual who has, had, will have—or would have, but for a developmental or genetic anomaly or historical accident—the reproductive system that at some point produces, transports, and utilizes sperm for fertilization.</p>","updateDate":"2025-07-24T13:34:26Z","versionCode":"00"}],"title":"Protection of Women in Olympic and Amateur Sports Act","type":"s","updateDate":"2026-09-08T18:03:40Z","updateDateIncludingText":"2026-09-08T18:09:57Z"}
