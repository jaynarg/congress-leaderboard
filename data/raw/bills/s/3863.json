hipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-05","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-11-04T17:43:16+00:00","id":"s3863-119","introducedDate":"2026-02-12","latestAction":{"actionDate":"2026-02-12","text":"Read twice and referred to the Committee on Finance. (text: CR S611)"},"laws":[],"number":"3863","originChamber":"Senate","policyArea":"Taxation","sponsors":[{"bioguideId":"B001261","district":null,"fullName":"Sen. Barrasso, John [R-WY]","party":"R","state":"WY"}],"summaries":[{"actionDate":"2026-02-12","actionDesc":"Introduced in Senate","text":"<p><strong>Pay Less at the Pump Act of 2026</strong></p><p>This bill eliminates the excise tax on domestic crude oil and imported petroleum products (known as the petroleum Superfund tax rate) beginning on January 1, 2026. The bill also eliminates the authority for advances to the Hazardous Substance Superfund from the General Fund of the U.S. Treasury.</p><p>Under current law, the petroleum Superfund tax rate imposed is 27 cents per barrel (in 2026 and indexed annually for inflation). Amounts collected from this tax are deposited into the Hazardous Substance Superfund, which finances the remediation of certain environmentally contaminated sites. &nbsp;</p><p>Further, under current law, the authority for advances to be appropriated to the Hazardous Substance Superfund extends through 2032.</p>","updateDate":"2026-11-03T17:30:36Z","versionCode":"00"}],"title":"Pay Less at the Pump Act of 2026","type":"s","updateDate":"2026-11-03T17:31:19Z","updateDateIncludingText":"2026-11-03T17:31:19Z"}
