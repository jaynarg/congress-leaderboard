shipWithdrawnDate":null,"state":"NM"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-21","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M001153","fullName":"Sen. Murkowski, Lisa [R-AK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"P000145","fullName":"Sen. Padilla, Alex [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000393","fullName":"Sen. Kennedy, John [R-LA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"L000571","fullName":"Sen. Lummis, Cynthia M. [R-WY]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"WY"},{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-09-17T07:46:42+00:00","id":"s3492-119","introducedDate":"2025-12-16","latestAction":{"actionDate":"2025-12-16","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"3492","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"B001277","district":null,"fullName":"Sen. Blumenthal, Richard [D-CT]","party":"D","state":"CT"}],"summaries":[{"actionDate":"2025-12-16","actionDesc":"Introduced in Senate","text":"<p><strong>Essential Caregivers Act of 2025</strong>&nbsp;</p><p>This bill prohibits certain health care facilities from limiting the access of essential caregivers to residents of those facilities, including during designated emergency periods. <em></em>&nbsp;</p><p>Specifically, the bill generally prohibits Medicare skilled nursing facilities, Medicaid nursing facilities, Medicaid intermediate care facilities, and associated inpatient rehabilitation facilities from restricting the access of essential caregivers to residents of the facilities, including during emergency periods in which visitation rights are otherwise restricted. During emergency periods, facilities may restrict access for an initial period of up to seven days and for one additional maximum seven-day period (if the additional period is approved by the state health department). Facilities may restrict access for a total of 7 days (or 14 days with the approval of the state health department) during an emergency period.</p><p>Essential caregivers must agree to comply with any safety protocols set by the facility, which may be no more stringent for caregivers compared to those for staff. Caregivers who fail to comply with these requirements may be denied access, subject to an appeals process.</p>","updateDate":"2026-01-26T16:46:52Z","versionCode":"00"}],"title":"Essential Caregivers Act of 2025","type":"s","updateDate":"2026-06-09T11:03:22Z","updateDateIncludingText":"2026-06-09T11:03:22Z"}
