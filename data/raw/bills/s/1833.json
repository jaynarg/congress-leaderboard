{"actions":[{"actionCode":null,"actionDate":"2025-05-21","source":"Senate","text":"Read twice and referred to the Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-05-21","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/1833","cosponsors":[{"bioguideId":"W000800","fullName":"Sen. Welch, Peter [D-VT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-05-21","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001088","fullName":"Sen. Coons, Christopher A. [D-DE]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-27","sponsorshipWithdrawnDate":null,"state":"DE"}],"fetchedAt":"2026-09-17T06:38:25+00:00","id":"s1833-119","introducedDate":"2025-05-21","latestAction":{"actionDate":"2025-05-21","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"1833","originChamber":"Senate","policyArea":"Commerce","sponsors":[{"bioguideId":"B001243","district":null,"fullName":"Sen. Blackburn, Marsha [R-TN]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-05-21","actionDesc":"Introduced in Senate","text":"<p><strong>Leadership in Critical and Emerging Technologies Act or the Leadership in CET Act</strong></p><p>This bill directs the U.S. Patent and Trademark Office (USPTO) to establish and carry out a pilot program to expedite the patent examination process for patents involving critical or emerging technologies (i.e., artificial intelligence, semiconductor design, or quantum