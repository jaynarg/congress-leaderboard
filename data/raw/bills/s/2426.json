ponsorshipDate":"2026-06-16","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"C001056","fullName":"Sen. Cornyn, John [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-24T14:37:52+00:00","id":"s2426-119","introducedDate":"2025-07-24","latestAction":{"actionDate":"2025-07-24","text":"Read twice and referred to the Committee on Finance. (text: CR S4701)"},"laws":[],"number":"2426","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"T000250","district":null,"fullName":"Sen. Thune, John [R-SD]","party":"R","state":"SD"}],"summaries":[{"actionDate":"2025-07-24","actionDesc":"Introduced in Senate","text":"<p><strong>Equitable&nbsp;Community Access to Pharmacist Services Act</strong></p><p>This bill provides for permanent coverage under Medicare of certain pharmacist services.</p><p>Specifically, the bill provides for permanent coverage of testing and treatment services provided by pharmacists relating to (1) COVID-19, influenza, respiratory syncytial virus (RSV), and streptococcal pharyngitis (strep throat); and (2) other public health needs in relation to a declared public health emergency. (Similar authorities were temporarily granted during the COVID-19 public health emergency.) Such services must be provided in accordance with the applicable state laws governing pharmacists' scope of practice.</p>","updateDate":"2026-08-24T16:46:41Z","versionCode":"00"}],"title":"Equitable Community Access to Pharmacist Services Act","type":"s","updateDate":"2026-09-24T11:03:21Z","updateDateIncludingText":"2026-09-24T11:03:21Z"}
