drawnDate":null,"state":"VA"},{"bioguideId":"M001169","fullName":"Sen. Murphy, Christopher [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"F000479","fullName":"Sen. Fetterman, John [D-PA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001303","fullName":"Sen. Blunt Rochester, Lisa [D-DE]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"A000382","fullName":"Sen. Alsobrooks, Angela D. [D-MD]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"MD"}],"fetchedAt":"2026-09-17T14:57:46+00:00","id":"s4701-119","introducedDate":"2026-06-08","latestAction":{"actionDate":"2026-06-08","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"4701","originChamber":"Senate","policyArea":"Civil Rights and Liberties, Minority Issues","sponsors":[{"bioguideId":"C001113","district":null,"fullName":"Sen. Cortez Masto, Catherine [D-NV]","party":"D","state":"NV"}],"summaries":[{"actionDate":"2026-06-08","actionDesc":"Introduced in Senate","text":"<p><strong>Freedom to Travel for Health Care Act of </strong><strong>2026</strong></p><p>This bill prohibits anyone from interfering with a person's ability to access out-of-state reproductive health care. (<em>Reproductive health care </em>is defined as medical, surgical, counseling, or referral services and care related to pregnancy, including the prevention or termination of a pregnancy, and other reproductive care.)</p><p>Specifically, the bill prohibits anyone from restricting, discriminating against, or otherwise disadvantaging anyone who receives, provides, or assists with out-of-state reproductive health care that is legal in the state in which it is provided.</p><p>The bill allows the Department of Justice to bring a civil action and establishes a private right of action for violations. The bill specifically waives any applicable governmental immunity and preempts any contravening state laws.</p>","updateDate":"2026-07-15T16:30:42Z","versionCode":"00"}],"title":"Freedom to Travel for Health Care Act of 2026","type":"s","updateDate":"2026-08-10T11:51:27Z","updateDateIncludingText":"2026-08-10T11:51:27Z"}
