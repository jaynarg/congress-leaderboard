5-10-14","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"S000148","fullName":"Sen. Schumer, Charles E. [D-NY]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-22","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"K000394","fullName":"Sen. Kim, Andy [D-NJ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-22","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"R000122","fullName":"Sen. Reed, Jack [D-RI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-22","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"C001113","fullName":"Sen. Cortez Masto, Catherine [D-NV]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-22","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"H001046","fullName":"Sen. Heinrich, Martin [D-NM]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"A000382","fullName":"Sen. Alsobrooks, Angela D. [D-MD]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"R000608","fullName":"Sen. Rosen, Jacky [D-NV]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"D000622","fullName":"Sen. Duckworth, Tammy [D-IL]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"W000790","fullName":"Sen. Warnock, Raphael G. [D-GA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-30","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-17T07:24:41+00:00","id":"s2965-119","introducedDate":"2025-10-01","latestAction":{"actionDate":"2025-10-01","text":"Read twice and referred to the Committee on Banking, Housing, and Urban Affairs."},"laws":[],"number":"2965","originChamber":"Senate","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"W000817","district":null,"fullName":"Sen. Warren, Elizabeth [D-MA]","party":"D","state":"MA"}],"summaries":[{"actionDate":"2025-10-01","actionDesc":"Introduced in Senate","text":"<p><strong>No Argentina Bailout Act</strong></p><p>This bill prohibits the use of the Exchange Stabilization Fund (ESF) to provide financial support to Argentina. (The ESF is an emergency reserve fund of the Department of the Treasury originally used for the purpose of maintaining the fixed dollar exchange rate.&nbsp;In October 2025, Treasury announced U.S. financial support for Argentina, including a $20 billion currency swap line financed through the&nbsp;ESF.)</p><p>Specifically, the bill prohibits the use of the ESF to provide&nbsp;direct or indirect financial support to Argentina, including through the establishment of currency swap lines, the purchase of pesos or sovereign debt of Argentina, or the extension of any credit instrument. This prohibition terminates on December 10, 2027.</p><p>Any financial contract or instrument that was entered into before the bill's enactment and violates the prohibition must be sold or terminated&nbsp;within seven days of the bill's enactment.</p>","updateDate":"2026-08-05T13:37:26Z","versionCode":"00"}],"title":"No Argentina Bailout Act","type":"s","updateDate":"2026-08-05T13:38:41Z","updateDateIncludingText":"2026-08-05T13:38:41Z"}
