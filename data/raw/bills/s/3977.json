{"actions":[{"actionCode":"H15000","actionDate":"2026-08-10","source":"House floor actions","text":"Held at the desk.","type":"Floor"},{"actionCode":"H14000","actionDate":"2026-08-10","source":"House floor actions","text":"Received in the House.","type":"Floor"},{"actionCode":null,"actionDate":"2026-08-10","source":"Senate","text":"Message on Senate action sent to the House.","type":"Floor"},{"actionCode":null,"actionDate":"2026-08-03","source":"Senate","text":"Passed Senate without amendment by Unanimous Consent. (consideration: CR S4412; text: CR S4412)","type":"Floor"},{"actionCode":"17000","actionDate":"2026-08-03","source":"Library of Congress","text":"Passed/agreed to in Senate: Passed Senate without amendment by Unanimous Consent.","type":"Floor"},{"actionCode":null,"actionDate":"2026-03-04","source":"Senate","text":"Read the second time. Placed on Senate Legislative Calendar under General Orders. Calendar No. 347.","type":"Calendars"},{"actionCode":null,"actionDate":"2026-03-03","source":"Senate","text":"Introduced in the Senate. Read the first time. Placed on Senate Legislative Calendar under Read the First Time.","type":"Calendars"},{"actionCode":"10000","actionDate":"2026-03-03","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/3977","cosponsors":[{"bioguideId":"D000563","fullName":"Sen. Durbin, Richard J. [D-IL]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"C001056","fullName":"Sen. Cornyn, John [R-TX]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"G000359","fullName":"Sen. Graham, Lindsey [R-SC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"C001088","fullName":"Sen. Coons, Christopher A. [D-DE]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"DE"}],"fetchedAt":"2026-09-17T08:08:16+00:00","id":"s3977-119","introducedDate":"2026-03-03","latestAction":{"actionDate":"2026-08-10","actionTime":"11:11:26","text":"Held at the desk."},"laws":[],"number":"3977","originChamber":"Senate","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"G000386","district":null,"fullName":"Sen. Grassley, Chuck [R-IA]","party":"R","state":"IA"}],"summaries":[{"actionDate":"2026-08-03","actionDesc":"Passed Senate","text":"<p><strong>Bankruptcy Threshold Adjustment Act of 2026</strong></p><p>This bill restores changes that expired in 2024 applicable to debt limits for Subchapter V (small business reorganization) and Chapter 13 (the wage earner's plan) bankruptcies.</p><p>Specifically, the bill increases the debt limit under Subchapter&nbsp;V from approximately $3.4 million to $7.5 million and increases the cumulative debt limit under Chapter 13 from approximately $2.1 million to $2.75 million.</p><p>The bill also applies both secured and unsecured debt towards the Chapter 13 limit. (Currently, separate limits apply to secured and unsecured debt under Chapter 13 bankruptcy.)</p>","updateDate":"2026-08-26T21:47:56Z","versionCode":"55"}],"title":"Bankruptcy Threshold Adjustment Act of 2026","type":"s","updateDate":"2026-08-28T08:05:48Z","updateDateIncludingText":"2026-08-28T08:05:48Z"}
