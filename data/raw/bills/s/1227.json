nsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"R000618","fullName":"Sen. Ricketts, Pete [R-NE]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-11","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"C001113","fullName":"Sen. Cortez Masto, Catherine [D-NV]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-18","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"C001035","fullName":"Sen. Collins, Susan M. [R-ME]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-18","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"K000394","fullName":"Sen. Kim, Andy [D-NJ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-18","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"M001153","fullName":"Sen. Murkowski, Lisa [R-AK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"G000555","fullName":"Sen. Gillibrand, Kirsten E. [D-NY]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-17T06:10:46+00:00","id":"s1227-119","introducedDate":"2025-04-01","latestAction":{"actionDate":"2025-04-01","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"1227","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"M000133","district":null,"fullName":"Sen. Markey, Edward J. [D-MA]","party":"D","state":"MA"}],"summaries":[{"actionDate":"2025-04-01","actionDesc":"Introduced in Senate","text":"<p><strong>Alleviating Barriers for Caregivers Act or the ABC Act</strong></p><p>This bill requires federal agencies to review and modify the administrative&nbsp;processes related to Medicare, Medicaid, the Children's Health Insurance Program (CHIP), and Social Security programs in order to streamline these processes for family caregivers.</p><p>Specifically, the Centers for Medicare &amp; Medicaid Services (CMS) and the Social Security Administration (SSA) must review processes related to eligibility determinations, applications, forms, and communications for these programs and identify ways to simplify and streamline these processes for family caregivers (e.g., reducing the need for family caregivers to submit the same information for multiple programs). The CMS and SSA must solicit input from family caregivers and state and regional organizations, implement any identified improvements, and report on these efforts to Congress.</p><p>In addition, the CMS must issue a letter to state Medicaid and CHIP programs that encourages states to conduct a similar review and that provides potential improvements.</p>","updateDate":"2026-07-24T22:16:55Z","versionCode":"00"}],"title":"ABC Act","type":"s","updateDate":"2026-07-31T11:03:21Z","updateDateIncludingText":"2026-07-31T11:03:21Z"}
