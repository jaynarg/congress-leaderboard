sorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"B001277","fullName":"Sen. Blumenthal, Richard [D-CT]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-24","sponsorshipWithdrawnDate":null,"state":"CT"}],"fetchedAt":"2026-09-25T15:24:21+00:00","id":"s3258-119","introducedDate":"2025-11-20","latestAction":{"actionDate":"2026-09-24","text":"Passed Senate with an amendment by Unanimous Consent."},"laws":[],"number":"3258","originChamber":"Senate","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"D000622","district":null,"fullName":"Sen. Duckworth, Tammy [D-IL]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-11-20","actionDesc":"Introduced in Senate","text":"<p><strong>Aviation Medication Transparency Act of 2025</strong></p><p>This bill directs the Federal Aviation Administration (FAA) to compile, publish, and annually update a list of medications that may be safely prescribed to pilots and air traffic controllers for the purposes of issuing a medical certification. The list must be publicly available on the FAA website and distributed to those seeking a license and medical&nbsp;certification.</p><p>Currently, the FAA does not have a list of approved medications. However, the FAA does have lists for Aviation Medical Examiners of <em>Do Not Issue</em> medications and <em>Do Not Fly</em> medications.</p>","updateDate":"2026-07-23T20:55:14Z","versionCode":"00"}],"title":"Aviation Medication Transparency Act of 2026","type":"s","updateDate":"2026-09-25T13:35:24Z","updateDateIncludingText":"2026-09-25T13:35:24Z"}
