ponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"S001232","fullName":"Sen. Sheehy, Tim [R-MT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"K000383","fullName":"Sen. King, Angus S., Jr. [I-ME]","isOriginalCosponsor":true,"party":"I","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"D000622","fullName":"Sen. Duckworth, Tammy [D-IL]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"S001208","fullName":"Sen. Slotkin, Elissa [D-MI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"TN"}],"fetchedAt":"2026-09-17T08:28:26+00:00","id":"s4487-119","introducedDate":"2026-05-11","latestAction":{"actionDate":"2026-05-11","text":"Read twice and referred to the Committee on Veterans' Affairs."},"laws":[],"number":"4487","originChamber":"Senate","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"M000934","district":null,"fullName":"Sen. Moran, Jerry [R-KS]","party":"R","state":"KS"}],"summaries":[{"actionDate":"2026-05-11","actionDesc":"Introduced in Senate","text":"<p><strong>Veterans' Compensation Cost-of-Living Adjustment Act of 2026</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to increase the amounts payable for wartime disability compensation, additional compensation for dependents, the clothing allowance for certain disabled veterans, and dependency and indemnity compensation for surviving spouses and children. Specifically, the VA must increase the amounts by the same percentage as the cost-of-living increase in benefits for Social Security recipients that is effective on December 1, 2026. The act requires the VA to publish the amounts payable, as increased, in the Federal Register.</p><p>The VA is authorized to make a similar adjustment to the rates of disability compensation payable to persons who have not received compensation for service-connected disability or death.</p>","updateDate":"2026-05-18T13:55:47Z","versionCode":"00"}],"title":"Veterans’ Compensation Cost-of-Living Adjustment Act of 2026","type":"s","updateDate":"2026-05-18T13:55:58Z","updateDateIncludingText":"2026-05-18T13:55:58Z"}
