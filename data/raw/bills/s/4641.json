{"actions":[{"actionCode":null,"actionDate":"2026-05-21","source":"Senate","text":"Read twice and referred to the Committee on Finance.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2026-05-21","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/4641","cosponsors":[{"bioguideId":"W000800","fullName":"Sen. Welch, Peter [D-VT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"C001047","fullName":"Sen. Capito, Shelley Moore [R-WV]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-15","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001088","fullName":"Sen. Coons, Christopher A. [D-DE]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-28","sponsorshipWithdrawnDate":null,"state":"DE"}],"fetchedAt":"2026-09-17T14:55:26+00:00","id":"s4641-119","introducedDate":"2026-05-21","latestAction":{"actionDate":"2026-05-21","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"4641","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"C001035","district":null,"fullName":"Sen. Collins, Susan M. [R-ME]","party":"R","state":"ME"}],"summaries":[{"actionDate":"2026-05-21","actionDesc":"Introduced in Senate","text":"<p><strong>Improving Access to Medicare Coverage Act of </strong><strong>2026</strong></p><p>This bill deems an individual receiving outpatient observation services in a hospital as an inpatient for purposes of satisfying the three-day inpatient hospital-stay requirement&nbsp;with respect to&nbsp;Medicare coverage of skilled nursing facility (SNF) services. (Generally, individuals must have been an inpatient at a hospital for at least three days in order to qualify for SNF services. An individual's time spent under observation at a hospital for purposes of determining whether the individual should be admitted does not count towards this requirement.)</p>","updateDate":"2026-06-29T19:32:38Z","versionCode":"00"}],"title":"Improving Access to Medicare Coverage Act of 2026","type":"s","updateDate":"2026-07-29T11:03:25Z","updateDateIncludingText":"2026-07-29T11:03:25Z"}
