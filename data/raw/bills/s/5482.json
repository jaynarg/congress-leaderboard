{"actions":[{"actionCode":null,"actionDate":"2026-09-23","source":"Senate","text":"Read twice and referred to the Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2026-09-23","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/5482","cosponsors":[{"bioguideId":"B001277","fullName":"Sen. Blumenthal, Richard [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"B001288","fullName":"Sen. Booker, Cory A. [D-NJ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"D000563","fullName":"Sen. Durbin, Richard J. [D-IL]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"F000479","fullName":"Sen. Fetterman, John [D-PA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"K000383","fullName":"Sen. King, Angus S., Jr. [I-ME]","isOriginalCosponsor":true,"party":"I","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"K000367","fullName":"Sen. Klobuchar, Amy [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"P000145","fullName":"Sen. Padilla, Alex [D-CA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001150","fullName":"Sen. Schiff, Adam B. [D-CA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001203","fullName":"Sen. Smith, Tina [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"V000128","fullName":"Sen. Van Hollen, Chris [D-MD]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"W000779","fullName":"Sen. Wyden, Ron [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-09-23","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"W000800","fullName":"Sen. Welch, Peter [D-VT]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-24","sponsorshipWithdrawnDate":null,"state":"VT"}],"fetchedAt":"2026-11-24T20:33:15+00:00","id":"s5482-119","introducedDate":"2026-09-23","latestAction":{"actionDate":"2026-09-23","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"5482","originChamber":"Senate","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"S001194","district":null,"fullName":"Sen. Schatz, Brian [D-HI]","party":"D","state":"HI"}],"summaries":[{"actionDate":"2026-09-23","actionDesc":"Introduced in Senate","text":"<p><strong>Promoting Reentry through Education in Prisons Act of 2026 or the PREP Act</strong></p><p>This bill expands educational opportunities for individuals who are incarcerated in federal and state correctional facilities.</p><p>Specifically, the bill creates an Office of Prison Education within the Bureau of Prisons (BOP). Under the bill, the office must establish and implement a Federal Prison Education Program to provide quality educational services to individuals who are incarcerated in federal correctional facilities. The office must also establish and maintain a clearinghouse for research, policies, and best practices on quality education programs in prison.</p><p>Additionally, the bill requires the office to provide training and technical assistance to state correctional institutions on developing and implementing policies and procedures for quality education programs in prison.</p><p>Finally, the bill requires the Department of Veterans Affairs, in coordination with&nbsp;BOP and state correctional agencies, to conduct outreach to incarcerated veterans about potential eligibility for educational assistance and connect veterans to quality education programs in prison.</p>","updateDate":"2026-11-24T20:21:12Z","versionCode":"00"}],"title":"PREP Act","type":"s","updateDate":"2026-11-24T20:21:51Z","updateDateIncludingText":"2026-11-24T20:21:51Z"}
