sponsorshipWithdrawnDate":null,"state":"ND"}],"fetchedAt":"2026-09-17T06:31:32+00:00","id":"s1670-119","introducedDate":"2025-05-08","latestAction":{"actionDate":"2025-05-08","text":"Read twice and referred to the Committee on Banking, Housing, and Urban Affairs."},"laws":[],"number":"1670","originChamber":"Senate","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"S001198","district":null,"fullName":"Sen. Sullivan, Dan [R-AK]","party":"R","state":"AK"}],"summaries":[{"actionDate":"2025-05-08","actionDesc":"Introduced in Senate","text":"<p><strong>INvestor Democracy is EXpected Act or the INDEX Act </strong></p><p>This bill establishes guidelines for passively managed funds (e.g., index funds) that vote shares on behalf of fund investors in proxy shareholder votes. Under the bill, these funds generally must vote shares on a proportional basis according to instructions from fund investors.</p><p>The bill establishes an exemption for routine matters and matters requiring approval of a majority of outstanding securities. Additionally, the bill establishes a safe harbor from these requirements for investment advisers. &nbsp;</p>","updateDate":"2026-04-30T18:34:14Z","versionCode":"00"}],"title":"INDEX Act","type":"s","updateDate":"2026-04-30T18:36:00Z","updateDateIncludingText":"2026-04-30T18:36:00Z"}
