":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"T000476","fullName":"Sen. Tillis, Thomas [R-NC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001277","fullName":"Sen. Blumenthal, Richard [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"C001047","fullName":"Sen. Capito, Shelley Moore [R-WV]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"H001042","fullName":"Sen. Hirono, Mazie K. [D-HI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"L000575","fullName":"Sen. Lankford, James [R-OK]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"B001236","fullName":"Sen. Boozman, John [R-AR]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-02","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"W000790","fullName":"Sen. Warnock, Raphael G. [D-GA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-09","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-17T05:33:27+00:00","id":"s527-119","introducedDate":"2025-02-11","latestAction":{"actionDate":"2025-04-10","text":"Placed on Senate Legislative Calendar under General Orders. Calendar No. 42."},"laws":[],"number":"527","originChamber":"Senate","policyArea":"Commerce","sponsors":[{"bioguideId":"G000386","district":null,"fullName":"Sen. Grassley, Chuck [R-IA]","party":"R","state":"IA"}],"summaries":[{"actionDate":"2025-02-11","actionDesc":"Introduced in Senate","text":"<p><strong>Prescription Pricing for the People Act of 20</strong><strong>25</strong><br/><br/>This bill requires the Federal Trade Commission (FTC) to report about anticompetitive practices and other trends within the pharmaceutical supply chain that may impact the cost of prescription drugs.</p><p>The report must address whether pharmacy benefit managers (PBMs) (1)&nbsp;reimburse pharmacies owned by the PBM at a higher price than other pharmacies, and (2) implement formulary designs to increase the market share of higher-cost prescription drugs or depress the market share of lower-cost prescription drugs.</p><p>The FTC also must provide recommendations to increase transparency in the supply chain, prevent anticompetitive practices, and ensure that consumers benefit from cost savings or efficiencies that result from mergers and consolidations.</p><p>Additionally, the FTC must report&nbsp;the number and nature of complaints the FTC receives relating to an allegation of anticompetitive conduct by a manufacturer of a sole-source drug.</p>","updateDate":"2026-07-01T15:11:53Z","versionCode":"00"}],"title":"Prescription Pricing for the People Act of 2025","type":"s","updateDate":"2026-08-10T11:51:27Z","updateDateIncludingText":"2026-08-10T11:51:27Z"}
