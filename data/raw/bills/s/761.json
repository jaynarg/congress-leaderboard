":"D","sponsorshipDate":"2025-02-27","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"L000570","fullName":"Sen. Luján, Ben Ray [D-NM]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"H001042","fullName":"Sen. Hirono, Mazie K. [D-HI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"M000133","fullName":"Sen. Markey, Edward J. [D-MA]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"B001230","fullName":"Sen. Baldwin, Tammy [D-WI]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-04","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"S001181","fullName":"Sen. Shaheen, Jeanne [D-NH]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"D000563","fullName":"Sen. Durbin, Richard J. [D-IL]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"A000382","fullName":"Sen. Alsobrooks, Angela D. [D-MD]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"W000779","fullName":"Sen. Wyden, Ron [D-OR]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"G000574","fullName":"Sen. Gallego, Ruben [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-11","sponsorshipWithdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-09-17T05:45:35+00:00","id":"s761-119","introducedDate":"2025-02-26","latestAction":{"actionDate":"2025-07-31","text":"Placed on Senate Legislative Calendar under General Orders. Calendar No. 139."},"laws":[],"number":"761","originChamber":"Senate","policyArea":"Native Americans","sponsors":[{"bioguideId":"M001153","district":null,"fullName":"Sen. Murkowski, Lisa [R-AK]","party":"R","state":"AK"}],"summaries":[{"actionDate":"2025-02-26","actionDesc":"Introduced in Senate","text":"<p><strong>Truth and Healing Commission on Indian Boarding School Policies Act of 2025</strong></p><p>This bill establishes the Truth and Healing Commission on Indian Boarding School Policies in the United States within the legislative branch and sets forth its powers, duties, and membership.</p><p>Among other duties, the commission must investigate the impacts and ongoing effects of the Indian Boarding School Policies (federal policies under which American Indian, Alaska Native, and Native Hawaiian children were forcibly removed from their family homes and placed in boarding schools).</p><p>Further, the commission must develop recommendations on ways to (1) protect unmarked graves and accompanying land protections; (2) support repatriation and identify the tribal nations from which children were taken; and (3) discontinue the removal of American Indian, Alaska Native, and Native Hawaiian children from their families and tribal communities by state social service departments, foster care agencies, and adoption agencies.</p>","updateDate":"2025-03-17T19:11:32Z","versionCode":"00"}],"title":"Truth and Healing Commission on Indian Boarding School Policies Act of 2025","type":"s","updateDate":"2026-02-13T18:26:14Z","updateDateIncludingText":"2026-02-13T18:26:14Z"}
