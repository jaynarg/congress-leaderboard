ate":null,"state":"ND"},{"bioguideId":"M001153","fullName":"Sen. Murkowski, Lisa [R-AK]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"S001217","fullName":"Sen. Scott, Rick [R-FL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001305","fullName":"Sen. Budd, Ted [R-NC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M000934","fullName":"Sen. Moran, Jerry [R-KS]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"M000355","fullName":"Sen. McConnell, Mitch [R-KY]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"D000618","fullName":"Sen. Daines, Steve [R-MT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"T000250","fullName":"Sen. Thune, John [R-SD]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"SD"},{"bioguideId":"H000601","fullName":"Sen. Hagerty, Bill [R-TN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-21","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"M001242","fullName":"Sen. Moreno, Bernie [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-06","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-09-17T15:10:41+00:00","id":"s5025-119","introducedDate":"2026-07-16","latestAction":{"actionDate":"2026-07-16","text":"Read twice and referred to the Committee on Banking, Housing, and Urban Affairs."},"laws":[],"number":"5025","originChamber":"Senate","policyArea":"International Affairs","sponsors":[{"bioguideId":"G000608","district":null,"fullName":"Sen. Graham, Darline [R-SC]","party":"R","state":"SC"}],"summaries":[{"actionDate":"2026-07-16","actionDesc":"Introduced in Senate","text":"<p><strong>Lindsey O. Graham Sanctioning Russia Act of 2026</strong></p><p>This bill imposes a variety of sanctions, tariffs, and prohibitions related to Russia.</p><p>For example, under the bill, the President must&nbsp;</p><ul><li>impose visa- and property-blocking sanctions on specified persons&nbsp;(individuals and entities) such as the Russian president, certain Russian military commanders, and any foreign person that knowingly provides goods or services relating to Russia's defense industrial base;</li><li>increase&nbsp;the rate of duty on all goods imported into the United States from Russia to a rate of&nbsp;up to 500% ad valorem (i.e., relative to the value);</li><li>increase&nbsp;the rate of duty up to 100% ad valorem on all goods imported into the United States from a country that was among the&nbsp;five largest importers of Russian-origin crude oil or natural gas if such country knowingly makes new purchases of such products after enactment of the bill;</li><li>impose&nbsp;property-blocking sanctions on financial institutions organized under Russian law and owned wholly or partly by Russia; and&nbsp;</li><li>impose&nbsp;property-blocking sanctions on foreign vessels that knowingly transport certain products of Russian origin, including crude oil, uranium, and coal.&nbsp;</li></ul><p>The bill prohibits (1)&nbsp;the export, reexport, or in-country transfer to or in Russia of U.S.-produced energy or energy product; (2) U.S. persons from making&nbsp;new investments in Russia or purchasing Russian sovereign debt; and (3) trading the securities of Russian government-owned, -controlled, or -affiliated entities on U.S. national securities exchanges.</p><p>The President may waive requirements of the bill by certifying it is in the national interest.</p>","updateDate":"2026-08-31T14:27:58Z","versionCode":"00"}],"title":"Lindsey O. Graham Sanctioning Russia Act of 2026","type":"s","updateDate":"2026-08-31T14:28:06Z","updateDateIncludingText":"2026-08-31T14:28:06Z"}
