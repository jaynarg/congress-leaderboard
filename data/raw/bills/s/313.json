{"actions":[{"actionCode":null,"actionDate":"2025-01-29","source":"Senate","text":"Read twice and referred to the Committee on Foreign Relations.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-01-29","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/313","cosponsors":[{"bioguideId":"C001095","fullName":"Sen. Cotton, Tom [R-AR]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"C001075","fullName":"Sen. Cassidy, Bill [R-LA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"S001217","fullName":"Sen. Scott, Rick [R-FL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"C001098","fullName":"Sen. Cruz, Ted [R-TX]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"T000476","fullName":"Sen. Tillis, Thomas [R-NC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001184","fullName":"Sen. Scott, Tim [R-SC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"E000295","fullName":"Sen. Ernst, Joni [R-IA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"B001305","fullName":"Sen. Budd, Ted [R-NC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-17T05:22:11+00:00","id":"s313-119","introducedDate":"2025-01-29","latestAction":{"actionDate":"2025-01-29","text":"Read twice and referred to the Committee on Foreign Relations."},"laws":[],"number":"313","originChamber":"Senate","policyArea":"International Affairs","sponsors":[{"bioguideId":"C001047","district":null,"fullName":"Sen. Capito, Shelley Moore [R-WV]","party":"R","state":"WV"}],"summaries":[{"actionDate":"2025-01-29","actionDesc":"Introduced in Senate","text":"<p><strong>Stop Funding Global Terrorists Act of 2025</strong></p><p>This bill prohibits the United States from making any voluntary or assessed contributions to the United Nations (UN) for assistance to Afghanistan until the Department of State certifies to Congress that (1) no U.S. funds are used in cash shipments by the UN to Afghanistan, and (2) terrorist organizations do not receive funds as a result of such cash shipments. If the State Department later determines such a certification is inaccurate, it must revoke the certification and notify Congress.</p>","updateDate":"2025-04-03T20:22:22Z","versionCode":"00"}],"title":"Stop Funding Global Terrorists Act of 2025","type":"s","updateDate":"2025-04-03T20:22:53Z","updateDateIncludingText":"2025-04-03T20:22:53Z"}
