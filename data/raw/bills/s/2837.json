onsorshipDate":"2025-09-17","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"W000790","fullName":"Sen. Warnock, Raphael G. [D-GA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-09-17","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"W000817","fullName":"Sen. Warren, Elizabeth [D-MA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-09-17","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"W000800","fullName":"Sen. Welch, Peter [D-VT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-09-17","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"W000802","fullName":"Sen. Whitehouse, Sheldon [D-RI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-09-17","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"W000779","fullName":"Sen. Wyden, Ron [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-09-17","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"C001035","fullName":"Sen. Collins, Susan M. [R-ME]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-11","sponsorshipWithdrawnDate":null,"state":"ME"}],"fetchedAt":"2026-09-17T07:19:35+00:00","id":"s2837-119","introducedDate":"2025-09-17","latestAction":{"actionDate":"2025-09-17","text":"Read twice and referred to the Committee on Homeland Security and Governmental Affairs."},"laws":[],"number":"2837","originChamber":"Senate","policyArea":"Labor and Employment","sponsors":[{"bioguideId":"W000805","district":null,"fullName":"Sen. Warner, Mark R. [D-VA]","party":"D","state":"VA"}],"summaries":[{"actionDate":"2025-09-17","actionDesc":"Introduced in Senate","text":"<p><strong>Protect America's Workforce Act</strong></p><p>This bill nullifies two executive orders: <em>Exclusions from Federal Labor-Management Relations Programs </em>(issued on March 27, 2025) and <em>Further Exclusions From the Federal Labor- Management Relations Program</em> (issued on August 28, 2025).&nbsp;The executive orders exclude specified executive branch&nbsp;agencies and subdivisions from the Federal Service Labor-Management Relations Statute and the&nbsp;Foreign Service Labor-Management Relations Statute. The statutes authorize federal employees' participation in collective bargaining and enforce collective bargaining rights.&nbsp;</p><p>The bill also&nbsp;specifies that a&nbsp;collective&nbsp;bargaining agreement that is&nbsp;in place as of March 26, 2025, and is between an executive branch agency and any labor organization that is an exclusive representative of federal employees, shall have full force and effect through the stated term of the agreement.</p>","updateDate":"2026-01-16T15:24:03Z","versionCode":"00"}],"title":"Protect America’s Workforce Act","type":"s","updateDate":"2026-01-16T15:25:47Z","updateDateIncludingText":"2026-01-16T15:25:47Z"}
