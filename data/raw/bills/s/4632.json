onsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"K000377","fullName":"Sen. Kelly, Mark [D-AZ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"S001198","fullName":"Sen. Sullivan, Dan [R-AK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"T000476","fullName":"Sen. Tillis, Thomas [R-NC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"C001056","fullName":"Sen. Cornyn, John [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"A000383","fullName":"Sen. Armstrong, Alan [R-OK]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"OK"}],"fetchedAt":"2026-09-17T14:55:04+00:00","id":"s4632-119","introducedDate":"2026-05-21","latestAction":{"actionDate":"2026-06-01","text":"Read the second time. Placed on Senate Legislative Calendar under General Orders. Calendar No. 424."},"laws":[],"number":"4632","originChamber":"Senate","policyArea":"Economics and Public Finance","sponsors":[{"bioguideId":"L000575","district":null,"fullName":"Sen. Lankford, James [R-OK]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2026-05-21","actionDesc":"Introduced in Senate","text":"<p><strong>Prevent Government Shutdowns Act of 2026</strong></p><p>This bill provides continuing appropriations to prevent a government shutdown if the appropriations bills for a fiscal year have not been enacted before the fiscal year begins and continuing appropriations are not in effect.</p><p>Specifically, the bill provides appropriations at the rate of operations that was provided for the prior fiscal year to continue programs, projects, and activities that were funded in the preceding fiscal year.</p><p>The bill also limits official travel, congressional recesses or adjournments, and the consideration of legislation that is unrelated to appropriations after the beginning of a fiscal year if the appropriations process has not been completed.</p>","updateDate":"2026-06-08T12:12:41Z","versionCode":"00"}],"title":"Prevent Government Shutdowns Act of 2026","type":"s","updateDate":"2026-07-21T11:03:20Z","updateDateIncludingText":"2026-07-21T11:03:20Z"}
