eId":"R000605","fullName":"Sen. Rounds, Mike [R-SD]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"SD"},{"bioguideId":"M001244","fullName":"Sen. Moody, Ashley [R-FL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-27","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"C001075","fullName":"Sen. Cassidy, Bill [R-LA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"C001098","fullName":"Sen. Cruz, Ted [R-TX]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"F000463","fullName":"Sen. Fischer, Deb [R-NE]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"G000608","fullName":"Sen. Graham, Darline [R-SC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-04","sponsorshipWithdrawnDate":null,"state":"SC"}],"fetchedAt":"2026-09-17T05:06:58+00:00","id":"s9-119","introducedDate":"2025-01-07","latestAction":{"actionDate":"2025-03-03","text":"Cloture on the motion to proceed to the measure not invoked in Senate by Yea-Nay Vote. 51 - 45. Record Vote Number: 100. (CR S1455-1456)"},"laws":[],"number":"9","originChamber":"Senate","policyArea":"Sports and Recreation","sponsors":[{"bioguideId":"T000278","district":null,"fullName":"Sen. Tuberville, Tommy [R-AL]","party":"R","state":"AL"}],"summaries":[{"actionDate":"2025-01-07","actionDesc":"Introduced in Senate","text":"<p><strong>Protection of Women and Girls in Sports Act of 2025</strong></p><p>This bill generally prohibits school athletic programs from allowing individuals whose biological sex at birth was male to participate in programs that are for women or girls.</p><p>Specifically, the bill provides that it is a violation of Title IX of the Education Amendments of 1972 for federally funded education programs or activities to operate, sponsor, or facilitate athletic programs or activities that allow individuals of the male sex to participate in programs or activities that are designated for women or girls. (Title IX prohibits discrimination on the basis of sex in federally funded education programs or activities, including in public elementary and secondary schools and in colleges and universities.) Under the bill,<em> sex</em> is based on an individual's reproductive biology and genetics at birth.</p>","updateDate":"2025-01-30T22:43:48Z","versionCode":"00"}],"title":"Protection of Women and Girls in Sports Act of 2025","type":"s","updateDate":"2026-08-05T11:03:18Z","updateDateIncludingText":"2026-08-05T11:03:18Z"}
