{"actions":[{"actionCode":null,"actionDate":"2026-07-30","source":"Senate","text":"Read twice and referred to the Committee on Armed Services.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2026-07-30","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/5185","cosponsors":[{"bioguideId":"G000386","fullName":"Sen. Grassley, Chuck [R-IA]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"W000779","fullName":"Sen. Wyden, Ron [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"V000128","fullName":"Sen. Van Hollen, Chris [D-MD]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"W000817","fullName":"Sen. Warren, Elizabeth [D-MA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"B001288","fullName":"Sen. Booker, Cory A. [D-NJ]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"S001203","fullName":"Sen. Smith, Tina [D-MN]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M000133","fullName":"Sen. Markey, Edward J. [D-MA]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"L000577","fullName":"Sen. Lee, Mike [R-UT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001176","fullName":"Sen. Merkley, Jeff [D-OR]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"P000603","fullName":"Sen. Paul, Rand [R-KY]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"M001169","fullName":"Sen. Murphy, Christopher [D-CT]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"B001230","fullName":"Sen. Baldwin, Tammy [D-WI]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"K000377","fullName":"Sen. Kelly, Mark [D-AZ]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-07","sponsorshipWithdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-10-06T16:38:49+00:00","id":"s5185-119","introducedDate":"2026-07-30","latestAction":{"actionDate":"2026-07-30","text":"Read twice and referred to the Committee on Armed Services."},"laws":[],"number":"5185","originChamber":"Senate","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"S000033","district":null,"fullName":"Sen. Sanders, Bernard [I-VT]","party":"I","state":"VT"}],"summaries":[{"actionDate":"2026-07-30","actionDesc":"Introduced in Senate","text":"<p><strong>Audit the Pentagon Act</strong></p><p>This bill requires the Department of Defense (DOD) to reduce spending for any department, agency, or other DOD element that DOD determines has not achieved an unqualified opinion on its full financial statements for the calendar year ending during that fiscal year.&nbsp;(An <em>unqualified opinio</em><em>n</em> or <em>clean audit</em> means an auditor has determined the financial statements are presented fairly and provide a true view of an entity’s financial position.)</p><p>Specifically, the amount available to such department, agency, or element for the fiscal year when the determination is made must be&nbsp;reduced by 2%. Amounts unavailable to such department, agency, or element must be applied on a pro rata basis against each program, project, and activity.</p><p>DOD must deposit such unavailable amounts in the general fund of the Department of the Treasury for purposes of deficit reduction.</p>","updateDate":"2026-10-06T15:26:58Z","versionCode":"00"}],"title":"Audit the Pentagon Act","type":"s","updateDate":"2026-10-06T15:28:14Z","updateDateIncludingText":"2026-10-06T15:28:14Z"}
