isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"Y000064","fullName":"Sen. Young, Todd [R-IN]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"M001242","fullName":"Sen. Moreno, Bernie [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-03","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-14","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"H001104","fullName":"Sen. Husted, Jon [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"M001244","fullName":"Sen. Moody, Ashley [R-FL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-16","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000608","fullName":"Sen. Graham, Darline [R-SC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-22","sponsorshipWithdrawnDate":null,"state":"SC"}],"fetchedAt":"2026-09-17T05:15:40+00:00","id":"s186-119","introducedDate":"2025-01-22","latestAction":{"actionDate":"2025-01-22","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"186","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"W000437","district":null,"fullName":"Sen. Wicker, Roger F. [R-MS]","party":"R","state":"MS"}],"summaries":[{"actionDate":"2025-01-22","actionDesc":"Introduced in Senate","text":"<p><strong>No Taxpayer Funding for Abortion and Abortion Insurance Full Disclosure Act of 2025</strong></p><p>This bill modifies provisions relating to federal funding for, and health insurance coverage of, abortions.</p><p>Specifically, the bill prohibits the use of federal funds for abortions or for health coverage that includes abortions. Such restrictions extend to the use of funds in the budget of the District of Columbia. Additionally, abortions may not be provided in a federal health care facility or by a federal employee.</p><p>Historically, language has been included in annual appropriations bills for the Department of Health and Human Services (HHS) that prohibits the use of federal funds for abortions—such language is commonly referred to as the Hyde Amendment. Similar language is also frequently included in appropriations bills for other federal agencies and the District of Columbia. The bill makes these restrictions permanent and extends the restrictions to all federal funds (rather than specific agencies).</p><p>The bill's restrictions regarding the use of federal funds do not apply in cases of rape, incest, or where a physical disorder, injury, or illness endangers a woman's life unless an abortion is performed. The Hyde Amendment provides the same exceptions.</p><p>The bill also prohibits qualified health plans from including coverage for abortions. Currently, qualified health plans may cover abortion, but the portion of the premium attributable to abortion coverage is not eligible for subsidies.</p>","updateDate":"2025-04-30T21:10:15Z","versionCode":"00"}],"title":"No Taxpayer Funding for Abortion and Abortion Insurance Full Disclosure Act of 2025","type":"s","updateDate":"2026-07-23T11:03:17Z","updateDateIncludingText":"2026-07-23T11:03:17Z"}
