"V000128","fullName":"Sen. Van Hollen, Chris [D-MD]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-10","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"M001244","fullName":"Sen. Moody, Ashley [R-FL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-12","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001243","fullName":"Sen. McCormick, David [R-PA]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-17","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"K000383","fullName":"Sen. King, Angus S., Jr. [I-ME]","isOriginalCosponsor":false,"party":"I","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"B001303","fullName":"Sen. Blunt Rochester, Lisa [D-DE]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"DE"}],"fetchedAt":"2026-09-17T06:37:38+00:00","id":"s1816-119","introducedDate":"2025-05-20","latestAction":{"actionDate":"2025-05-20","text":"Read twice and referred to the Committee on Finance."},"laws":[],"number":"1816","originChamber":"Senate","policyArea":"Health","sponsors":[{"bioguideId":"M001198","district":null,"fullName":"Sen. Marshall, Roger [R-KS]","party":"R","state":"KS"}],"summaries":[{"actionDate":"2025-05-20","actionDesc":"Introduced in Senate","text":"<p><strong>Improving Seniors' Timely Access to Care Act of </strong><strong>2025</strong></p><p>This bill establishes several requirements and standards relating to prior authorization processes under Medicare Advantage (MA) plans.</p><p>Specifically, MA plans must (1) establish an electronic prior authorization program that meets specified standards; (2) annually submit to the CMS for publication specified prior authorization information, including the percentage of requests approved and the average response time; and (3) meet other standards, as set by the Centers for Medicare &amp; Medicaid Services (CMS), relating to the quality and timeliness of prior authorization determinations.</p><p>The CMS and the&nbsp;Office of the National Coordinator for Health Information Technology must publish on the CMS' website a report that analyzes the information received from MA plans, the feasibility of implementing real-time decision making with respect to prior authorization requests, and the impact of decisions that are made using artificial intelligence on patient access.&nbsp;</p>","updateDate":"2026-08-24T16:46:05Z","versionCode":"00"}],"title":"Improving Seniors’ Timely Access to Care Act of 2025","type":"s","updateDate":"2026-08-24T16:46:21Z","updateDateIncludingText":"2026-08-24T16:46:21Z"}
