{"actions":[{"actionCode":null,"actionDate":"2025-01-29","source":"Senate","text":"Read twice and referred to the Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-01-29","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/304","cosponsors":[{"bioguideId":"C001098","fullName":"Sen. Cruz, Ted [R-TX]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001319","fullName":"Sen. Britt, Katie Boyd [R-AL]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-29","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"L000577","fullName":"Sen. Lee, Mike [R-UT]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"B001243","fullName":"Sen. Blackburn, Marsha [R-TN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"B001305","fullName":"Sen. Budd, Ted [R-NC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-12","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001242","fullName":"Sen. Moreno, Bernie [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-19","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"B001299","fullName":"Sen. Banks, Jim [R-IN]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-02","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"S001232","fullName":"Sen. Sheehy, Tim [R-MT]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"R000618","fullName":"Sen. Ricketts, Pete [R-NE]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-14","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"G000608","fullName":"Sen. Graham, Darline [R-SC]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-23","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"T000278","fullName":"Sen. Tuberville, Tommy [R-AL]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-06","sponsorshipWithdrawnDate":null,"state":"AL"}],"fetchedAt":"2026-09-17T05:21:44+00:00","id":"s304-119","introducedDate":"2025-01-29","latestAction":{"actionDate":"2025-01-29","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"304","originChamber":"Senate","policyArea":"Immigration","sponsors":[{"bioguideId":"G000359","district":null,"fullName":"Sen. Graham, Lindsey [R-SC]","party":"R","state":"SC"}],"summaries":[{"actionDate":"2025-01-29","actionDesc":"Introduced in Senate","text":"<p><strong>Birthright Citizenship Act of 2025 </strong></p><p>This bill limits birthright citizenship by redefining what it means to be <em>subject to the jurisdiction</em> of the United States.</p><p>Currently, a person born in the United States and subject to U.S. jurisdiction is entitled to citizenship. Under the bill, a person is subject to U.S. jurisdiction if he or she is born to a parent who is (1) a U.S. citizen or national, (2) a lawful permanent resident residing in the United States, or (3) a non-U.S. national (<em>alien </em>under federal law)&nbsp;in lawful status who is performing active service in the Armed Forces.</p><p>The bill does not affect the citizenship or nationality status of any person born before the bill's enactment date.</p>","updateDate":"2025-05-23T19:37:08Z","versionCode":"00"}],"title":"Birthright Citizenship Act of 2025","type":"s","updateDate":"2026-08-10T11:51:27Z","updateDateIncludingText":"2026-08-10T11:58:38Z"}
