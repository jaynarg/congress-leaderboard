{"actions":[{"actionCode":null,"actionDate":"2025-01-16","source":"Senate","text":"Read twice and referred to the Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"10000","actionDate":"2025-01-16","source":"Library of Congress","text":"Introduced in Senate","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/senate-bill/112","cosponsors":[{"bioguideId":"D000618","fullName":"Sen. Daines, Steve [R-MT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"R000584","fullName":"Sen. Risch, James E. [R-ID]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"S001232","fullName":"Sen. Sheehy, Tim [R-MT]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"C000880","fullName":"Sen. Crapo, Mike [R-ID]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"R000605","fullName":"Sen. Rounds, Mike [R-SD]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"SD"},{"bioguideId":"M000934","fullName":"Sen. Moran, Jerry [R-KS]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"T000476","fullName":"Sen. Tillis, Thomas [R-NC]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001242","fullName":"Sen. Moreno, Bernie [R-OH]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"H001079","fullName":"Sen. Hyde-Smith, Cindy [R-MS]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"MS"}],"fetchedAt":"2026-09-17T05:11:41+00:00","id":"s112-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-01-16","text":"Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"112","originChamber":"Senate","policyArea":"Immigration","sponsors":[{"bioguideId":"B001243","district":null,"fullName":"Sen. Blackburn, Marsha [R-TN]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in Senate","text":"<p><strong>Make the Migrant Protection Protocols Mandatory Act of 2025</strong></p><p>This bill requires the Department of Justice (DOJ) to remove certain non-U.S. nationals (<em>aliens</em> under federal law) from the United States while such an individual's application for admission is pending.</p><p>Specifically, if such an individual arrived by land from a foreign country bordering the United States and the individual is not clearly and beyond a doubt entitled to admission into the United States, DOJ must return that individual to that bordering foreign country while the individual's application for admission is pending. (Currently, DOJ may choose to detain such an individual or return the individual to the bordering foreign country while the application for admission is pending.)</p>","updateDate":"2025-04-16T20:07:43Z","versionCode":"00"}],"title":"Make the Migrant Protection Protocols Mandatory Act of 2025","type":"s","updateDate":"2026-08-10T11:51:27Z","updateDateIncludingText":"2026-08-10T11:51:27Z"}
