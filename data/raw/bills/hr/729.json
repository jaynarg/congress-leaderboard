hdrawnDate":null,"state":"OH"},{"bioguideId":"O000177","fullName":"Rep. Onder, Robert [R-MO-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"S001224","fullName":"Rep. Self, Keith [R-TX-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"W000814","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001212","fullName":"Rep. Moore, Barry [R-AL-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M000871","fullName":"Rep. Mann, Tracey [R-KS-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"H001101","fullName":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001302","fullName":"Rep. Biggs, Andy [R-AZ-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"H001067","fullName":"Rep. Hudson, Richard [R-NC-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001325","fullName":"Rep. Biggs, Sheri [R-SC-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"L000566","fullName":"Rep. Latta, Robert E. [R-OH-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-25","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-09-16T19:17:27+00:00","id":"hr729-119","introducedDate":"2025-01-24","latestAction":{"actionDate":"2025-01-24","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"729","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"H001102","district":8,"fullName":"Rep. Harris, Mark [R-NC-8]","party":"R","state":"NC"}],"summaries":[{"actionDate":"2025-01-24","actionDesc":"Introduced in House","text":"<p><strong>Teleabortion Prevention Act of 2025</strong></p><p>This bill restricts the use of telehealth for chemical abortions (also known as medication abortions).</p><p>Specifically, it requires a provider who dispenses or prescribes medication for a chemical abortion to physically examine the patient, be physically present at the location of the chemical abortion, and schedule a follow-up visit for the patient. The bill provides an exception for a chemical abortion that is necessary to save the life of a mother whose life is endangered by a physical disorder, illness, injury, or condition.</p><p>The bill establishes criminal penalties—a fine, a prison term of up to two years, or both—for a provider who does not comply with the requirements.</p><p>A patient who undergoes a chemical abortion may not be prosecuted.</p>","updateDate":"2025-05-02T18:53:40Z","versionCode":"00"}],"title":"Teleabortion Prevention Act of 2025","type":"hr","updateDate":"2026-03-26T08:06:31Z","updateDateIncludingText":"2026-03-26T08:06:31Z"}
