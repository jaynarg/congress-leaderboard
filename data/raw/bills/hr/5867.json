onsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"E000296","fullName":"Rep. Evans, Dwight [D-PA-3]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-10-28","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"C001080","fullName":"Rep. Chu, Judy [D-CA-28]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-12","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001230","fullName":"Rep. Subramanyam, Suhas [D-VA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"F000483","fullName":"Rep. Friedman, Laura [D-CA-30]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"E000299","fullName":"Rep. Escobar, Veronica [D-TX-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-08","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"W000822","fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-08","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"G000599","fullName":"Rep. Goldman, Daniel S. [D-NY-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"W000808","fullName":"Rep. Wilson, Frederica S. [D-FL-24]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-14","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"O000173","fullName":"Rep. Omar, Ilhan [D-MN-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M000312","fullName":"Rep. McGovern, James P. [D-MA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"MA"}],"fetchedAt":"2026-10-22T14:47:21+00:00","id":"hr5867-119","introducedDate":"2025-10-28","latestAction":{"actionDate":"2025-10-28","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"5867","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"V000081","district":7,"fullName":"Rep. Velázquez, Nydia M. [D-NY-7]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-10-28","actionDesc":"Introduced in House","text":"<p><strong>Plant-Powered School Meals Pilot Act</strong></p><p>This bill establishes pilot programs for providing 100% plant-based food and milk options in school meals and expands access to nondairy beverages in school meals.</p><p>Specifically, the Department of Agriculture (USDA) must carry out a pilot program to award grants for purposes such as training food service personnel on serving 100% plant-based food options and covering additional costs of buying plant-based foods. USDA&nbsp;must give priority in awarding pilot program grants to school food authorities that will use the funds to serve a high proportion of children who are eligible for free or reduced-price meals.</p><p>The bill also requires a school participating in the school lunch program to substitute a nondairy beverage that is nutritionally equivalent to fluid milk, and meets USDA-established standards, if the student's parent or legal guardian submits a written request for such substitution. Further, a school has the option to offer each student a nondairy beverage as a substitute for fluid milk if it meets these same standards.</p><p>USDA must also establish a pilot program to reimburse eligible schools for the cost of providing a nondairy beverage as a substitute for fluid milk. Eligible schools are those where at least 50% of the students served are eligible for free or reduced-price meals.</p>","updateDate":"2026-10-22T13:45:53Z","versionCode":"00"}],"title":"Plant-Powered School Meals Pilot Act","type":"hr","updateDate":"2026-10-22T13:45:58Z","updateDateIncludingText":"2026-10-22T13:45:58Z"}
