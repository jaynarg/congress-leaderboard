{"actions":[{"actionCode":"H11100","actionDate":"2026-03-04","source":"House floor actions","text":"Referred to the House Committee on Education and Workforce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2026-03-04","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2026-03-04","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/7798","cosponsors":[{"bioguideId":"S001221","fullName":"Rep. Scholten, Hillary J. [D-MI-3]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"G000587","fullName":"Rep. Garcia, Sylvia R. [D-TX-29]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"E000299","fullName":"Rep. Escobar, Veronica [D-TX-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-13","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-17T03:21:20+00:00","id":"hr7798-119","introducedDate":"2026-03-04","latestAction":{"actionDate":"2026-03-04","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"7798","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"M001160","district":4,"fullName":"Rep. Moore, Gwen [D-WI-4]","party":"D","state":"WI"}],"summaries":[{"actionDate":"2026-03-04","actionDesc":"Introduced in House","text":"<p><strong>School Social Workers Improving Student Success Act</strong></p> <p>This bill provides certain resources to increase the number of social workers in elementary and secondary schools. </p> <p>Specifically, the bill directs the Department of Education to award grants to high-need local educational agencies to retain or hire school social workers.</p> <p>The bill also establishes a national technical assistance center for school social work to, among other duties, develop strategies for improving the effectiveness of the school social work workforce.</p>","updateDate":"2026-03-30T20:26:48Z","versionCode":"00"}],"title":"School Social Workers Improving Student Success Act","type":"hr","updateDate":"2026-07-17T23:52:03Z","updateDateIncludingText":"2026-07-17T23:52:03Z"}
