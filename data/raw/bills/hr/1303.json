ponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"R000612","fullName":"Rep. Rose, John W. [R-TN-6]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"N000190","fullName":"Rep. Norman, Ralph [R-SC-5]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"Y000067","fullName":"Rep. Yakym, Rudy [R-IN-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"G000591","fullName":"Rep. Guest, Michael [R-MS-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"M000871","fullName":"Rep. Mann, Tracey [R-KS-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"H001091","fullName":"Rep. Hinson, Ashley [R-IA-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"S001172","fullName":"Rep. Smith, Adrian [R-NE-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"S000250","fullName":"Rep. Sessions, Pete [R-TX-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"G000592","fullName":"Rep. Golden, Jared F. [D-ME-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-08","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"K000398","fullName":"Rep. Kean, Thomas H. [R-NJ-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-16","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-16T19:46:04+00:00","id":"hr1303-119","introducedDate":"2025-02-13","latestAction":{"actionDate":"2025-02-13","text":"Referred to the Committee on Ways and Means, and in addition to the Committee on Energy and Commerce, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"1303","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"F000470","district":7,"fullName":"Rep. Fischbach, Michelle [R-MN-7]","party":"R","state":"MN"}],"summaries":[{"actionDate":"2025-02-13","actionDesc":"Introduced in House","text":"<p><strong>Protecting America’s Seniors’ Access to Care Act</strong></p><p>This bill prohibits administration, implementation, or enforcement of the rule titled&nbsp;<em>Medicare and Medicaid Programs; Minimum Staffing Standards for Long-Term Care Facilities and Medicaid Institutional Payment Transparency Reporting</em>, which was issued by the Centers for Medicare &amp; Medicaid Services on May 10, 2024.&nbsp;</p><p>Specifically, the bill prohibits administration, implementation, or enforcement of provisions that, among other changes, (1) establish minimum staffing standards for nurses in Medicare and Medicaid long-term care facilities, including requiring a nurse to be onsite 24/7 and requiring a minimum of 3.48 total nurse staffing hours per resident per day; and (2) require state Medicaid programs to report on payments to direct care workers and support staff of nursing facilities and intermediate care facilities for individuals with intellectual disabilities.&nbsp;</p>","updateDate":"2025-08-14T15:44:40Z","versionCode":"00"}],"title":"Protecting America’s Seniors’ Access to Care Act","type":"hr","updateDate":"2026-08-03T21:18:15Z","updateDateIncludingText":"2026-08-03T21:18:15Z"}
