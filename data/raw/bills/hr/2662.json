ull,"state":"TX"},{"bioguideId":"B001295","fullName":"Rep. Bost, Mike [R-IL-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-16T20:50:23+00:00","id":"hr2662-119","introducedDate":"2025-04-07","latestAction":{"actionDate":"2025-04-07","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"2662","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"C001129","district":10,"fullName":"Rep. Collins, Mike [R-GA-10]","party":"R","state":"GA"}],"summaries":[{"actionDate":"2025-04-07","actionDesc":"Introduced in House","text":"<p><strong>Staged Accident Fraud Prevention Act of 2025 </strong></p><p>This bill makes staging a collision with a commercial motor vehicle a federal crime.</p><p>Specifically, a person who is operating a motor vehicle and intentionally causes a collision&nbsp;with a commercial motor vehicle (or arranges for another person to cause such a collision) is subject to a fine, a prison term of up to 20 years, or both. If the collision results in serious bodily injury or death, the prison term may not be less than 20 years.</p>","updateDate":"2025-09-26T13:39:13Z","versionCode":"00"}],"title":"Staged Accident Fraud Prevention Act of 2025","type":"hr","updateDate":"2026-09-02T08:06:42Z","updateDateIncludingText":"2026-09-02T08:06:42Z"}
