{"actions":[{"actionCode":"H11100","actionDate":"2025-03-06","source":"House floor actions","text":"Referred to the House Committee on Rules.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-03-06","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-03-06","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1950","cosponsors":[{"bioguideId":"D000399","fullName":"Rep. Doggett, Lloyd [D-TX-37]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-06","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"F000476","fullName":"Rep. Frost, Maxwell [D-FL-10]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-06","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"T000481","fullName":"Rep. Tlaib, Rashida [D-MI-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-26","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"J000298","fullName":"Rep. Jayapal, Pramila [D-WA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-26","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-26","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"O000173","fullName":"Rep. Omar, Ilhan [D-MN-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"T000487","fullName":"Rep. Tokuda, Jill N. [D-HI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"HI"}],"fetchedAt":"2026-09-16T20:17:49+00:00","id":"hr1950-119","introducedDate":"2025-03-06","latestAction":{"actionDate":"2025-03-06","text":"Referred to the House Committee on Rules."},"laws":[],"number":"1950","originChamber":"House","policyArea":"Social Welfare","sponsors":[{"bioguideId":"P000607","district":2,"fullName":"Rep. Pocan, Mark [D-WI-2]","party":"D","state":"WI"}],"summaries":[{"actionDate":"2025-03-06","actionDesc":"Introduced in House","text":"<p><strong>Protect Social Security and Medicare Act</strong></p><p>This bill requires a two-thirds vote before Congress may consider legislation that would reduce retirement, health, or other benefits administered by the Social Security Administration or the Centers for Medicare &amp; Medicaid Services.</p><p>Specifically, such legislation may not be considered in either chamber of Congress until two-thirds of Members present and voting agree to a motion to consider the legislation. However, this restriction does not apply to legislation that reduces payments to Medicare Advantage plans so long as it also increases, in an amount equal to or greater than the reduction, payments made for other purposes under Medicare.</p>","updateDate":"2025-06-11T15:38:34Z","versionCode":"00"}],"title":"Protect Social Security and Medicare Act","type":"hr","updateDate":"2025-06-11T15:39:20Z","updateDateIncludingText":"2025-06-11T15:39:20Z"}
