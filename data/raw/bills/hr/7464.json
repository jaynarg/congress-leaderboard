ipDate":"2026-03-26","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"C001066","fullName":"Rep. Castor, Kathy [D-FL-14]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-09","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"K000398","fullName":"Rep. Kean, Thomas H. [R-NJ-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-22","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-17T00:09:48+00:00","id":"hr7464-119","introducedDate":"2026-02-10","latestAction":{"actionDate":"2026-03-20","text":"Referred to the Subcommittee on General Farm Commodities, Risk Management, and Credit."},"laws":[],"number":"7464","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"F000472","district":18,"fullName":"Rep. Franklin, Scott [R-FL-18]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2026-02-10","actionDesc":"Introduced in House","text":"<p><strong>Temperature Event Mitigation Policy Act or the</strong> <strong>TEMP Act </strong></p><p>This bill directs the federal crop insurance program to provide for research and development regarding a temperature-based index policy to insure crops (including&nbsp;tomatoes, peppers, sugarcane, strawberries, melons, citrus, peaches, and blueberries) on a nationally-available basis against losses due to a frost or cold weather event.</p><p>The research and development must (1) evaluate the effectiveness of risk management tools with respect to low frequency and catastrophic loss weather events, and (2) result in a policy that provides protection for production loss or revenue loss.&nbsp;</p><p>The term <em>policy</em> means an insurance policy, plan of insurance, provision of a policy or plan of insurance, and related materials.&nbsp;Under an index policy, claim payments are generally triggered based on a predetermined index that is entirely independent of the individual farm operation (e.g., temperature level). Under such a policy, the payments are automatically triggered when the index reaches a certain level rather than when an insured farmer files a claim.&nbsp;</p>","updateDate":"2026-04-03T14:27:08Z","versionCode":"00"}],"title":"TEMP Act","type":"hr","updateDate":"2026-07-23T08:08:08Z","updateDateIncludingText":"2026-07-23T08:08:08Z"}
