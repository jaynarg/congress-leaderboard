edAt":"2026-09-16T19:28:47+00:00","id":"hr953-119","introducedDate":"2025-02-04","latestAction":{"actionDate":"2025-02-04","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"953","originChamber":"House","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"M001205","district":1,"fullName":"Rep. Miller, Carol D. [R-WV-1]","party":"R","state":"WV"}],"summaries":[{"actionDate":"2025-02-04","actionDesc":"Introduced in House","text":"<p><strong>United States Trade Leadership in the Indo-Pacific Act</strong></p><p>This bill requires certain actions related to trade in the Indo-Pacific region.</p><p>Specifically, the bill directs the U.S. International Trade Commission to investigate the effects of existing Indo-Pacific regional trade agreements (e.g., the Regional Comprehensive Economic Partnership and the Comprehensive and Progressive Agreement for Trans-Pacific Partnership) on U.S. exporters and competitiveness in the region.</p><p>Additionally, the bill establishes the Indo-Pacific Trade Strategy Commission to develop findings and recommendations for a comprehensive trade strategy for the Indo-Pacific region.</p>","updateDate":"2025-06-16T10:40:16Z","versionCode":"00"}],"title":"United States Trade Leadership in the Indo-Pacific Act","type":"hr","updateDate":"2026-04-09T15:15:14Z","updateDateIncludingText":"2026-04-09T15:15:14Z"}
