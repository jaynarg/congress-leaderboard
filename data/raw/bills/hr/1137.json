19","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001321","fullName":"Rep. Barrett, Tom [R-MI-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"J000304","fullName":"Rep. Jackson, Ronny [R-TX-13]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"H001086","fullName":"Rep. Harshbarger, Diana [R-TN-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"M001235","fullName":"Rep. Moore, Riley M. [R-WV-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"S001199","fullName":"Rep. Smucker, Lloyd [R-PA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-20T14:05:29+00:00","id":"hr1137-119","introducedDate":"2025-02-07","latestAction":{"actionDate":"2025-02-07","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1137","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"P000605","district":10,"fullName":"Rep. Perry, Scott [R-PA-10]","party":"R","state":"PA"}],"summaries":[{"actionDate":"2025-02-07","actionDesc":"Introduced in House","text":"<p><strong>No Kill Switches in Cars Act</strong></p><p>This bill repeals a requirement that the National Highway Traffic Safety Administration&nbsp;prescribe a federal motor vehicle safety standard that requires certain passenger vehicles to be equipped with advanced drunk and impaired driving prevention technology.&nbsp;Currently, there is no federal motor vehicle safety standard that requires the technology.</p><p>In general, <em>advanced drunk and impaired driving prevention technology</em> is a passive system that (1) monitors a driver's performance to identify driver impairment, or (2) accurately detects whether a driver's blood alcohol concentration is equal to or greater than 0.08%. The system must also prevent or limit vehicle operation if the system determines the driver may be intoxicated or impaired.</p>","updateDate":"2025-04-11T14:49:50Z","versionCode":"00"}],"title":"No Kill Switches in Cars Act","type":"hr","updateDate":"2026-09-19T23:40:57Z","updateDateIncludingText":"2026-09-19T23:40:57Z"}
