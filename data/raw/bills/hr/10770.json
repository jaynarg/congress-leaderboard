Date":null,"state":"GA"},{"bioguideId":"M001231","fullName":"Rep. Mannion, John W. [D-NY-22]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001328","fullName":"Rep. Blair, Everton [D-GA-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"J000309","fullName":"Rep. Jackson, Jonathan L. [D-IL-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"S001225","fullName":"Rep. Sorensen, Eric [D-IL-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"C001121","fullName":"Rep. Crow, Jason [D-CO-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"E000246","fullName":"Rep. Edwards, Chuck [R-NC-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"G000604","fullName":"Rep. Goodlander, Maggie [D-NH-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"D000617","fullName":"Rep. DelBene, Suzan K. [D-WA-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-22","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"L000562","fullName":"Rep. Lynch, Stephen F. [D-MA-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-29","sponsorshipWithdrawnDate":null,"state":"MA"}],"fetchedAt":"2026-11-03T17:34:28+00:00","id":"hr10770-119","introducedDate":"2026-10-09","latestAction":{"actionDate":"2026-10-09","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"10770","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"B001327","district":8,"fullName":"Rep. Bresnahan, Robert P. [R-PA-8]","party":"R","state":"PA"}],"summaries":[{"actionDate":"2026-10-09","actionDesc":"Introduced in House","text":"<p><strong>340B Rebate Model Delay Act</strong><br/><br/>This bill temporarily limits the use of rebates for prescription drugs under the 340B program and delays the implementation of the 340B Rebate Model Pilot Program.<br/><br/>Under current law, the&nbsp;340B program generally limits the maximum price drug manufacturers participating in Medicaid or Medicare can charge eligible health care organizations for covered outpatient drugs. Beginning on January 1, 2027, and ending on December 31, 2028, the bill prohibits drug manufacturers from entering agreements with 340B organizations that require the organization to pay more than the allowable ceiling price for a covered outpatient drug at the time of purchase and subsequently receive a rebate to comply with&nbsp;the maximum price requirements.</p><p>The bill also delays until January 1, 2029, the implementation of the 340B Rebate Model Pilot Program. The pilot program allows approved drug manufacturers to charge 340B organizations full price for certain high-impact drugs and provide a rebate that reduces the amount paid to the allowable ceiling price&nbsp;after the drug is dispensed. Under the pilot program, the rebates are verified and issued on a claim-by-claim basis.</p>","updateDate":"2026-11-02T18:47:41Z","versionCode":"00"}],"title":"340B Rebate Model Delay Act","type":"hr","updateDate":"2026-11-02T18:47:48Z","updateDateIncludingText":"2026-11-02T18:47:48Z"}
