drawnDate":null,"state":"FL"},{"bioguideId":"M001210","fullName":"Rep. Murphy, Gregory F. [R-NC-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001212","fullName":"Rep. Stauber, Pete [R-MN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M001236","fullName":"Rep. Moore, Tim [R-NC-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-10","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"P000609","fullName":"Rep. Palmer, Gary J. [R-AL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M001230","fullName":"Rep. Mackenzie, Ryan [R-PA-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001314","fullName":"Rep. Bean, Aaron [R-FL-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001101","fullName":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-27","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"H001091","fullName":"Rep. Hinson, Ashley [R-IA-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"T000478","fullName":"Rep. Tenney, Claudia [R-NY-24]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-14","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001212","fullName":"Rep. Moore, Barry [R-AL-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"L000583","fullName":"Rep. Loudermilk, Barry [R-GA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-15","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-16T18:37:52+00:00","id":"hr32-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-01-03","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"32","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"L000598","district":1,"fullName":"Rep. LaLota, Nick [R-NY-1]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>No Bailout for Sanctuary Cities Act</strong></p><p>This bill makes a state or political subdivision of a state ineligible for any federal funds that the jurisdiction intends to use to benefit non-U.S. nationals (i.e., <em>aliens </em>under federal law) who are unlawfully present if the jurisdiction withholds information about citizenship or immigration status or does not cooperate with immigration detainers.</p><p>Specifically, such funds are denied to any jurisdiction that has a law, policy, or practice that prohibits or restricts any government entity from</p><ul><li>maintaining, sending, or receiving information regarding the citizenship or immigration status of any individual;</li><li>exchanging information regarding an individual's citizenship or immigration status with a federal, state, or local government entity;&nbsp;</li><li>complying with a valid immigration detainer from the Department of Homeland Security (DHS); or&nbsp;</li><li>notifying DHS about an individual's release from custody.</li></ul><p>The funding restriction does not apply&nbsp;to a law, policy, or practice that only applies to an individual who comes forward as a victim of or a witness to a criminal offense.</p><p>DHS must annually provide to specified congressional committees a list of jurisdictions that have failed to comply with a DHS detainer or have failed to notify DHS of an individual’s release.</p><p>The funding restriction begins 60 days after the bill's enactment or on the first day of&nbsp;the fiscal year following&nbsp;the bill's enactment, whichever is earlier.</p>","updateDate":"2025-02-07T22:34:55Z","versionCode":"00"}],"title":"No Bailout for Sanctuary Cities Act","type":"hr","updateDate":"2026-07-18T00:03:28Z","updateDateIncludingText":"2026-07-18T00:03:28Z"}
