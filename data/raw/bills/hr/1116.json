{"actions":[{"actionCode":"H11000","actionDate":"2025-03-14","source":"House committee actions","text":"Referred to the Subcommittee on Conservation, Research, and Biotechnology.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-02-07","source":"House floor actions","text":"Referred to the House Committee on Agriculture.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1116","cosponsors":[{"bioguideId":"N000026","fullName":"Rep. Nehls, Troy E. [R-TX-22]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-07","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001307","fullName":"Rep. Baird, James R. [R-IN-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-07","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"S001224","fullName":"Rep. Self, Keith [R-TX-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-10","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"G000603","fullName":"Rep. Gill, Brandon [R-TX-26]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-10","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"T000480","fullName":"Rep. Timmons, William R. [R-SC-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-10","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"C001132","fullName":"Rep. Crane, Elijah [R-AZ-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-09-16T19:36:51+00:00","id":"hr1116-119","introducedDate":"2025-02-07","latestAction":{"actionDate":"2025-03-14","text":"Referred to the Subcommittee on Conservation, Research, and Biotechnology."},"laws":[],"number":"1116","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"D000626","district":8,"fullName":"Rep. Davidson, Warren [R-OH-8]","party":"R","state":"OH"}],"summaries":[{"actionDate":"2025-02-07","actionDesc":"Introduced in House","text":"<p><strong>Right to Eat Authentic and Legitimate Meat Act of 2025 or the REAL Meat Act of 2025</strong></p><p>This bill prohibits the use of federal funds to support, directly or indirectly, the production, advancement, or enhancement of cell-cultured meat. Under the bill,&nbsp;<em>cell-cultured meat</em> means meat that is sourced from the cells of animals and artificially produced in a laboratory.</p><p>The bill includes an exemption for federal funds of the National Aeronautics and Space Administration (NASA)&nbsp;that are used for activities related to cell-cultured meat that is intended for off-planet consumption.</p>","updateDate":"2025-03-27T15:36:00Z","versionCode":"00"}],"title":"REAL Meat Act of 2025","type":"hr","updateDate":"2025-10-09T03:26:20Z","updateDateIncludingText":"2025-10-09T03:26:20Z"}
