{"actions":[{"actionCode":"H11100","actionDate":"2026-03-09","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2026-03-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2026-03-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/7880","cosponsors":[{"bioguideId":"P000597","fullName":"Rep. Pingree, Chellie [D-ME-1]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"D000626","fullName":"Rep. Davidson, Warren [R-OH-8]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"G000576","fullName":"Rep. Grothman, Glenn [R-WI-6]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"H001077","fullName":"Rep. Higgins, Clay [R-LA-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"P000605","fullName":"Rep. Perry, Scott [R-PA-10]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"R000614","fullName":"Rep. Roy, Chip [R-TX-21]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001199","fullName":"Rep. Smucker, Lloyd [R-PA-11]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B000825","fullName":"Rep. Boebert, Lauren [R-CO-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"M000194","fullName":"Rep. Mace, Nancy [R-SC-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"SC"}],"fetchedAt":"2026-09-17T03:24:32+00:00","id":"hr7880-119","introducedDate":"2026-03-09","latestAction":{"actionDate":"2026-03-09","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"7880","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"M001184","district":4,"fullName":"Rep. Massie, Thomas [R-KY-4]","party":"R","state":"KY"}],"summaries":[{"actionDate":"2026-03-09","actionDesc":"Introduced in House","text":"<p><strong>Interstate Milk Freedom Act of 2026 </strong><br/><br/>This bill prohibits federal regulation of the interstate traffic of unpasteurized milk or milk products packaged for direct human consumption under specified circumstances.</p><p>Specifically, the prohibition applies if such products (1) would be considered in violation of federal law solely because they are unpasteurized; (2) are allowed by the state of origin to be distributed for direct human consumption by any means; (3) are produced, packaged, and moved in compliance with the laws of such state; and (4) are moved from the state of origin with the intent to transport them to another state that allows the distribution of such products for direct human consumption.</p>","updateDate":"2026-04-07T16:10:46Z","versionCode":"00"}],"title":"Interstate Milk Freedom Act of 2026","type":"hr","updateDate":"2026-04-07T16:12:18Z","updateDateIncludingText":"2026-04-07T16:12:18Z"}
