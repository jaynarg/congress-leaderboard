":"LA"},{"bioguideId":"W000804","fullName":"Rep. Wittman, Robert J. [R-VA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"S000522","fullName":"Rep. Smith, Christopher H. [R-NJ-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-25","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"G000568","fullName":"Rep. Griffith, H. Morgan [R-VA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-03","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-23T14:32:35+00:00","id":"hr3474-119","introducedDate":"2025-05-15","latestAction":{"actionDate":"2026-02-04","text":"Placed on the Union Calendar, Calendar No. 411."},"laws":[],"number":"3474","originChamber":"House","policyArea":"Energy","sponsors":[{"bioguideId":"W000814","district":14,"fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2026-02-04","actionDesc":"Reported to House","text":"<p><strong>Federal Mechanical Insulation Act</strong></p><p>The bill directs federal agencies to identify energy saving and water saving measures, such as the installation of mechanical insulation property, in certain annual energy and water evaluations of federal buildings. Thus, the bill allows the installation of<em> </em>mechanical insulation property (e.g., thermal insulation) to be considered&nbsp;an energy or water efficiency measure that may be used in federal buildings under the National Energy Conservation Policy Act.</p>","updateDate":"2026-09-23T12:35:12Z","versionCode":"07"}],"title":"Federal Mechanical Insulation Act","type":"hr","updateDate":"2026-09-23T12:44:10Z","updateDateIncludingText":"2026-09-23T12:44:10Z"}
