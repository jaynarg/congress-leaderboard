state":"MT"},{"bioguideId":"V000129","fullName":"Rep. Valadao, David G. [R-CA-22]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001302","fullName":"Rep. Biggs, Andy [R-AZ-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"L000578","fullName":"Rep. LaMalfa, Doug [R-CA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"W000830","fullName":"Rep. Whitesides, George [D-CA-27]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-21","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T19:28:54+00:00","id":"hr956-119","introducedDate":"2025-02-04","latestAction":{"actionDate":"2025-03-07","text":"Referred to the Subcommittee on Forestry and Horticulture."},"laws":[],"number":"956","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"N000189","district":4,"fullName":"Rep. Newhouse, Dan [R-WA-4]","party":"R","state":"WA"}],"summaries":[{"actionDate":"2025-02-04","actionDesc":"Introduced in House","text":"<p><strong>Aerial Firefighting Enhancement Act of 2025</strong></p><p>This bill reauthorizes the Department of Defense to sell its excess aircraft and aircraft parts that are acceptable for commercial sale for wildfire suppression purposes. Such authority begins October 1, 2025, and ends October 1, 2035.</p><p>The bill also provides that such aircraft may be used to deliver water by air in order to suppress wildfire (the previous authority only provided for the delivery of fire retardant).</p><p>The bill removes the previous limitation on providing international wildfire suppression assistance with such purchased aircraft.</p>","updateDate":"2025-03-24T19:40:57Z","versionCode":"00"}],"title":"Aerial Firefighting Enhancement Act of 2025","type":"hr","updateDate":"2026-07-07T20:45:13Z","updateDateIncludingText":"2026-07-07T20:45:13Z"}
