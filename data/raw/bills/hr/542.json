{"actions":[{"actionCode":"H11100","actionDate":"2025-01-16","source":"House floor actions","text":"Referred to the House Committee on Education and Workforce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-16","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-16","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/542","cosponsors":[{"bioguideId":"G000597","fullName":"Rep. Garbarino, Andrew R. [R-NY-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"V000133","fullName":"Rep. Van Drew, Jefferson [R-NJ-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-02","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-26","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-16T19:08:11+00:00","id":"hr542-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-01-16","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"542","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"T000486","district":15,"fullName":"Rep. Torres, Ritchie [D-NY-15]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in House","text":"<p><strong>No Foreign Gifts Act of 2025</strong></p><p>This bill prohibits an institution of higher education (IHE) from receiving federal education funds if the&nbsp;IHE&nbsp;receives gifts from certain countries.</p><p>Specifically, the bill prohibits an IHE from receiving a gift from (1) China, Russia, North Korea, or Iran; or (2) a country that has provided material support to a foreign terrorist organization, as determined by the Department of State.</p><p>The bill also requires an IHE, as a condition of eligibility for federal education funds, to report any offer of a gift from such a foreign country.</p>","updateDate":"2025-03-14T17:45:15Z","versionCode":"00"}],"title":"No Foreign Gifts Act of 2025","type":"hr","updateDate":"2025-08-27T08:05:20Z","updateDateIncludingText":"2025-08-27T08:05:20Z"}
