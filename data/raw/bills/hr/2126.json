nalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001236","fullName":"Rep. Moore, Tim [R-NC-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"J000307","fullName":"Rep. James, John [R-MI-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-11","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001211","fullName":"Rep. Miller, Mary E. [R-IL-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"L000491","fullName":"Rep. Lucas, Frank D. [R-OK-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-25","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"F000446","fullName":"Rep. Feenstra, Randy [R-IA-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-26","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"C001137","fullName":"Rep. Crank, Jeff [R-CO-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-27","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"F000484","fullName":"Rep. Fine, Randy [R-FL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001240","fullName":"Rep. McDowell, Addison P. [R-NC-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"R000612","fullName":"Rep. Rose, John W. [R-TN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-14","sponsorshipWithdrawnDate":null,"state":"TN"}],"fetchedAt":"2026-09-16T20:25:50+00:00","id":"hr2126-119","introducedDate":"2025-03-14","latestAction":{"actionDate":"2025-03-14","text":"Referred to the House Committee on Oversight and Government Reform."},"laws":[],"number":"2126","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"H001077","district":3,"fullName":"Rep. Higgins, Clay [R-LA-3]","party":"R","state":"LA"}],"summaries":[{"actionDate":"2025-03-14","actionDesc":"Introduced in House","text":"<p><strong>Fair and Open Competition Act of 2025 </strong><strong>or the FOCA Act of 2025</strong></p><p>This bill requires that federal contracts for construction projects neither require nor prohibit a bidder, offeror, contractor, or subcontractor from entering into agreements with one or more labor organizations with respect to such projects or related projects.</p><p>Under the bill, the&nbsp;controlling documents for federal construction contracts (such as bid specifications and project agreements) may not require or prohibit a bidder, offeror, contractor, or subcontractor from entering into or adhering to such labor agreements. Additionally, the controlling documents may not discriminate against or give preference to a bidder, offeror, contractor, or subcontractor who signs or refuses to sign such a labor agreement.</p><p>These requirements also apply to any (1) construction manager acting on behalf of the federal government with respect to such contract, (2) recipient of a federal grant or financial assistance for construction projects or construction manager acting on the recipient's behalf, and (3) party to a federal cooperative agreement for construction projects or construction managers acting on the party's behalf.</p><p>An agency may exempt a project from this prohibition to avert an imminent threat to public health or safety or to serve the national security.</p>","updateDate":"2026-08-03T19:02:30Z","versionCode":"00"}],"title":"FOCA Act of 2025","type":"hr","updateDate":"2026-08-03T19:02:37Z","updateDateIncludingText":"2026-08-03T19:02:37Z"}
