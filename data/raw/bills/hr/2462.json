ame":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S000250","fullName":"Rep. Sessions, Pete [R-TX-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001103","fullName":"Rep. Carter, Earl L. \"Buddy\" [R-GA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"L000491","fullName":"Rep. Lucas, Frank D. [R-OK-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"C001129","fullName":"Rep. Collins, Mike [R-GA-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-01","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"K000392","fullName":"Rep. Kustoff, David [R-TN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"K000405","fullName":"Rep. Knott, Brad [R-NC-13]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001184","fullName":"Rep. Massie, Thomas [R-KY-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"C001053","fullName":"Rep. Cole, Tom [R-OK-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-01","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"M001222","fullName":"Rep. Miller, Max L. [R-OH-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-08","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"Y000067","fullName":"Rep. Yakym, Rudy [R-IN-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-13","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"H001072","fullName":"Rep. Hill, J. French [R-AR-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"AR"}],"fetchedAt":"2026-09-16T20:40:46+00:00","id":"hr2462-119","introducedDate":"2025-03-27","latestAction":{"actionDate":"2025-10-03","text":"Placed on the Union Calendar, Calendar No. 286."},"laws":[],"number":"2462","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"R000612","district":6,"fullName":"Rep. Rose, John W. [R-TN-6]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-03-27","actionDesc":"Introduced in House","text":"<p><strong>Black Vulture Relief Act of 2025</strong></p><p>This bill allows livestock producers and their employees to take certain actions against black vultures to protect livestock. (Black vultures are protected under the Migratory Bird Treaty Act.)</p><p>Specifically, livestock producers and their employees may (1) take (i.e., capture, kill, or disperse, or transport the carcass of) a black vulture that they reasonably believe will cause death, injury, or destruction to livestock; or (2) in the course of taking or attempting to take the black vulture, cause injury to the bird. However, they may not take or attempt to take a black vulture through the use of poison.</p><p>Livestock producers and their employees must submit an annual report to the U.S. Fish and Wildlife Service (FWS) on black vultures taken under this bill. The FWS must develop a reporting form and&nbsp;make this reporting form available on its website.</p><p>Currently, the FWS has a permit process under the Migratory Bird Treaty Act for the taking of black vultures.</p>","updateDate":"2025-05-09T18:35:52Z","versionCode":"00"}],"title":"Black Vulture Relief Act","type":"hr","updateDate":"2026-02-04T05:06:17Z","updateDateIncludingText":"2026-02-04T05:06:17Z"}
