ull,"state":"IA"},{"bioguideId":"W000804","fullName":"Rep. Wittman, Robert J. [R-VA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"M001233","fullName":"Rep. Messmer, Mark B. [R-IN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"S001213","fullName":"Rep. Steil, Bryan [R-WI-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"D000626","fullName":"Rep. Davidson, Warren [R-OH-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"M001204","fullName":"Rep. Meuser, Daniel [R-PA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"A000372","fullName":"Rep. Allen, Rick W. [R-GA-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"S001229","fullName":"Rep. Shreve, Jefferson [R-IN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-28","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-31","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-11","sponsorshipWithdrawnDate":null,"state":"NE"}],"fetchedAt":"2026-09-16T23:02:06+00:00","id":"hr5801-119","introducedDate":"2025-10-21","latestAction":{"actionDate":"2025-10-21","text":"Referred to the House Committee on Appropriations."},"laws":[],"number":"5801","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"J000301","district":null,"fullName":"Rep. Johnson, Dusty [R-SD-At Large]","party":"R","state":"SD"}],"summaries":[{"actionDate":"2025-10-21","actionDesc":"Introduced in House","text":"<p><strong>Shutdown Fairness Act</strong></p><p>This bill provides appropriations to pay federal employees who work during a government shutdown.</p><p>Specifically, the bill provides appropriations for federal agencies to provide standard rates of pay, allowances, pay differentials, benefits, and other payments to excepted employees for work performed during any period in which interim continuing appropriations or full-year appropriations are not in effect for a fiscal year (i.e., a government shutdown). An excepted employee is an employee who is required to work during a government shutdown.</p><p>Under current law, excepted employees are not paid until the government shutdown is over. This bill provides appropriations to pay excepted employees during a government shutdown. The bill also specifies that the term&nbsp;<em>excepted employee </em>includes certain contractors who support federal employees during a government shutdown and members of the Armed Forces who are on active duty.&nbsp;</p><p>A federal agency may not use the funds provided by this bill during any period in which continuing appropriations are in effect for the purpose of paying&nbsp;excepted employees of the agency.</p><p>The bill must take effect as if it had been enacted on September 30, 2025.&nbsp;</p>","updateDate":"2025-10-24T13:43:26Z","versionCode":"00"}],"title":"Shutdown Fairness Act","type":"hr","updateDate":"2026-03-30T18:55:22Z","updateDateIncludingText":"2026-03-30T18:55:22Z"}
