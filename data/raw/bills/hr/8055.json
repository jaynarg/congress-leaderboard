rty":"D","sponsorshipDate":"2026-03-30","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"R000305","fullName":"Rep. Ross, Deborah K. [D-NC-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-30","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-30","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000797","fullName":"Rep. Wasserman Schultz, Debbie [D-FL-25]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"E000296","fullName":"Rep. Evans, Dwight [D-PA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-22","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"C001125","fullName":"Rep. Carter, Troy A. [D-LA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"LA"}],"fetchedAt":"2026-09-17T03:31:36+00:00","id":"hr8055-119","introducedDate":"2026-03-24","latestAction":{"actionDate":"2026-03-24","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"8055","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"M001208","district":6,"fullName":"Rep. McBath, Lucy [D-GA-6]","party":"D","state":"GA"}],"summaries":[{"actionDate":"2026-03-24","actionDesc":"Introduced in House","text":"<p><strong>Extending WIC for New Moms Act</strong></p><p>This bill amends the Special Supplemental Nutrition Program for Women, Infants, and Children (WIC) to&nbsp;extend the eligibility periods for breastfeeding&nbsp;and postpartum women.</p><p>Specifically, a state program may elect to certify a breastfeeding woman for up to 24 months (currently 1 year) postpartum. The bill also expands the eligibility period for postpartum women<em> </em>to up to 24 months after termination of pregnancy (currently 6 months).</p><p>The Department of Agriculture must submit a report to Congress evaluating the effect of these changes to the program on (1) maternal and infant health outcomes, (2) breastfeeding rates, and (3) qualitative evaluations of family experiences under&nbsp;WIC.&nbsp;</p>","updateDate":"2026-04-16T17:01:06Z","versionCode":"00"}],"title":"Extending WIC for New Moms Act","type":"hr","updateDate":"2026-08-21T19:29:35Z","updateDateIncludingText":"2026-08-21T19:29:35Z"}
