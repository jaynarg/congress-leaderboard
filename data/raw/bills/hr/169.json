te":null,"state":"NY"},{"bioguideId":"B001327","fullName":"Rep. Bresnahan, Robert P. [R-PA-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-17","sponsorshipWithdrawnDate":null,"state":"DC"}],"fetchedAt":"2026-09-16T18:44:43+00:00","id":"hr169-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-01-03","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"169","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"L000593","district":49,"fullName":"Rep. Levin, Mike [D-CA-49]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>Prevent Family Fire Act of 2025 </strong></p><p>This bill establishes a new business tax credit on the sale of a safe firearm storage device on or before December 31, 2032.&nbsp;</p><p>The amount of the tax credit is 10% of the retail sales price (up to a maximum price of $400 and excluding separately stated sales tax) of a safe firearm storage device. The tax credit is allowed only on the first retail sale of a safe firearm storage device for a use other than resale or long-term lease.</p><p>The bill defines <em>safe firearm storage device</em> as a device that is (1) designed and marketed to deny unauthorized access to a firearm or ammunition or render such items inoperable;&nbsp;and (2) is secured by a combination lock, key lock, or lock based on biometric information.</p><p>&nbsp;</p>","updateDate":"2025-02-14T14:51:55Z","versionCode":"00"}],"title":"Prevent Family Fire Act of 2025","type":"hr","updateDate":"2026-02-18T09:05:49Z","updateDateIncludingText":"2026-02-18T09:05:49Z"}
