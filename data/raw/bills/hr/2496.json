nDate":null,"state":"UT"},{"bioguideId":"M000871","fullName":"Rep. Mann, Tracey [R-KS-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"T000478","fullName":"Rep. Tenney, Claudia [R-NY-24]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001233","fullName":"Rep. Messmer, Mark B. [R-IN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"B001327","fullName":"Rep. Bresnahan, Robert P. [R-PA-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"G000605","fullName":"Rep. Gray, Adam [D-CA-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-09","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T20:42:22+00:00","id":"hr2496-119","introducedDate":"2025-03-31","latestAction":{"actionDate":"2025-04-18","text":"Referred to the Subcommittee on Livestock, Dairy, and Poultry."},"laws":[],"number":"2496","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"C001059","district":21,"fullName":"Rep. Costa, Jim [D-CA-21]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-03-31","actionDesc":"Introduced in House","text":"<p><strong>Dairy Nutrition Incentive Program Act of 2025</strong></p><p>This bill directs the Department of Agriculture (USDA) to establish a dairy nutrition incentive program to develop and test methods to increase the purchase and consumption of dairy under the Supplemental Nutrition Assistance Program (SNAP).</p><p>Specifically, the program must provide an incentive to SNAP benefit recipients for the purchase of naturally nutrient-rich dairy, which the bill defines to include fluid milk, yogurt, and cheese made from cow's milk. To carry out the program, USDA must enter into cooperative agreements with, or provide competitive grants to, state or local governments and nonprofit organizations for projects. The bill provides funding for the program for each fiscal year.</p><p>USDA must provide for an independent evaluation of each project that measures, to the maximum extent practicable, the effect of incentives on purchases of naturally nutrient-rich dairy by SNAP recipients.</p><p>Projects currently carried out by the USDA Healthy Fluid Milk Incentives (HFMI) program must be transitioned to the new dairy nutrition incentive program; the bill repeals the HFMI program one year after USDA certifies that the transition is complete.</p>","updateDate":"2025-05-12T13:41:04Z","versionCode":"00"}],"title":"Dairy Nutrition Incentive Program Act of 2025","type":"hr","updateDate":"2026-04-10T08:05:42Z","updateDateIncludingText":"2026-04-10T08:05:42Z"}
