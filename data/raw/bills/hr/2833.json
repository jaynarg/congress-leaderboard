Date":null,"state":"PA"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-29","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-03","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"S001212","fullName":"Rep. Stauber, Pete [R-MN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-03","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"P000607","fullName":"Rep. Pocan, Mark [D-WI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"WI"}],"fetchedAt":"2026-09-16T20:57:27+00:00","id":"hr2833-119","introducedDate":"2025-04-10","latestAction":{"actionDate":"2025-04-10","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"2833","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"D000096","district":7,"fullName":"Rep. Davis, Danny K. [D-IL-7]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-04-10","actionDesc":"Introduced in House","text":"<p><strong>Adoption Tax Credit Refundability Act of 2025</strong></p><p>This bill makes the federal adoption tax credit&nbsp;refundable. The bill also requires the Internal Revenue Service to provide for a standardized third-party affidavit for purposes of verifying a legal adoption.</p><p>As background, individuals may claim a tax credit for qualified expenses to adopt a child. The maximum amount of the tax credit is $17,280 per child for 2025, which is adjusted annually for inflation. Income limitations apply. Under current law, the adoption tax credit is not refundable but may be carried forward for up to five subsequent tax years to reduce taxable income in those years.</p>","updateDate":"2026-03-17T16:15:02Z","versionCode":"00"}],"title":"Adoption Tax Credit Refundability Act of 2025","type":"hr","updateDate":"2026-03-17T16:15:51Z","updateDateIncludingText":"2026-03-17T16:15:51Z"}
