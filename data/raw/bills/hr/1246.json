arty":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001232","fullName":"Rep. McClain Delaney, April [D-MD-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"B001307","fullName":"Rep. Baird, James R. [R-IN-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"A000379","fullName":"Rep. Alford, Mark [R-MO-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"C001039","fullName":"Rep. Cammack, Kat [R-FL-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001103","fullName":"Rescom. Hernández, Pablo Jose [D-PR-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-15","sponsorshipWithdrawnDate":null,"state":"PR"},{"bioguideId":"M001237","fullName":"Rep. McDonald Rivet, Kristen [D-MI-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"M001216","fullName":"Rep. Mills, Cory [R-FL-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-12","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001257","fullName":"Rep. Bilirakis, Gus M. [R-FL-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-05","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"F000484","fullName":"Rep. Fine, Randy [R-FL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-16T19:43:12+00:00","id":"hr1246-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2025-03-20","text":"Referred to the Subcommittee on Commodity Markets, Digital Assets, and Rural Development."},"laws":[],"number":"1246","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"F000470","district":7,"fullName":"Rep. Fischbach, Michelle [R-MN-7]","party":"R","state":"MN"}],"summaries":[{"actionDate":"2025-02-12","actionDesc":"Introduced in House","text":"<p><strong>Investing in Rural America Act of 2025</strong></p><p>This bill allows Farm Credit System (FCS) institutions to make and participate in loans and commitments (and extend other technical and financial assistance) for essential community facility&nbsp;projects as part of the Department of Agriculture's&nbsp;Community Facilities Direct Loan &amp; Grant Program. This program provides funding to develop essential community facilities in rural areas.</p><p>The&nbsp;FCS financing and technical assistance&nbsp;may be provided in order to make capital available to develop, build, maintain, improve, or provide related equipment or&nbsp;other support for essential community facilities in rural communities (e.g., certain facilities that provide healthcare, community support, public safety, educational, or utility services).</p><p>Under the bill, the&nbsp;financing provided by an FCS institution may not&nbsp;exceed 15% of the total of all outstanding loans of the institution.&nbsp;Further, an FCS institution must (1) offer at least one non-FCS lending institution an interest in the financing under reasonable terms and conditions acceptable to the borrower, and (2) report the offer to the&nbsp;Farm Credit Administration (FCA).</p><p>The FCA must submit an annual report to Congress on the activities undertaken by FCS institutions under this bill, including through the partnerships between FCS institutions and other lending institutions. The FCA must post the report on the administration's website.</p>","updateDate":"2025-05-14T13:35:00Z","versionCode":"00"}],"title":"Investing in Rural America Act of 2025","type":"hr","updateDate":"2026-03-10T08:05:45Z","updateDateIncludingText":"2026-03-10T08:05:45Z"}
