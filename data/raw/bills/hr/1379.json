te":"OH"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-05","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001223","fullName":"Rep. Sykes, Emilia Strong [D-OH-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-14","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"D000032","fullName":"Rep. Donalds, Byron [R-FL-19]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"B001323","fullName":"Rep. Begich, Nicholas [R-AK-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"K000401","fullName":"Rep. Kiley, Kevin [R-CA-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"R000305","fullName":"Rep. Ross, Deborah K. [D-NC-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-07","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"H001095","fullName":"Rep. Hunt, Wesley [R-TX-38]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-20","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-10-02T16:02:38+00:00","id":"hr1379-119","introducedDate":"2025-02-14","latestAction":{"actionDate":"2025-02-14","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"1379","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"F000478","district":7,"fullName":"Rep. Fry, Russell [R-SC-7]","party":"R","state":"SC"}],"summaries":[{"actionDate":"2025-02-14","actionDesc":"Introduced in House","text":"<p><strong>Trafficking Survivors Relief Act of 2025&nbsp;</strong></p><p>This bill establishes a process to vacate convictions and expunge arrest records for certain criminal offenses committed by victims of human trafficking that directly result from or relate to having been a trafficking victim.</p><p>It defines the offenses eligible to be vacated or expunged and sets forth procedures for filing a motion.</p><p>The Government Accountability Office must assess the impact of this process, including the number of human trafficking survivors who file motions to vacate convictions or expunge records.</p><p>The bill permits certain grants for legal representation to be used to seek post-conviction relief.</p><p>Finally, the bill creates a rebuttable presumption that a defendant committed certain offenses under duress if the defendant establishes by clear and convincing evidence that he or she was a victim of human trafficking at the time of the offense.</p>","updateDate":"2026-10-01T16:14:58Z","versionCode":"00"}],"title":"Trafficking Survivors Relief Act of 2025","type":"hr","updateDate":"2026-10-01T16:15:12Z","updateDateIncludingText":"2026-10-01T16:15:12Z"}
