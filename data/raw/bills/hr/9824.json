nDate":null,"state":"AZ"},{"bioguideId":"T000472","fullName":"Rep. Takano, Mark [D-CA-39]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-27","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"C001080","fullName":"Rep. Chu, Judy [D-CA-28]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"D000623","fullName":"Rep. DeSaulnier, Mark [D-CA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001226","fullName":"Rep. Salinas, Andrea [D-OR-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"OR"}],"fetchedAt":"2026-09-17T04:45:33+00:00","id":"hr9824-119","introducedDate":"2026-07-22","latestAction":{"actionDate":"2026-07-23","text":"Referred to the Subcommittee on Border Security and Enforcement."},"laws":[],"number":"9824","originChamber":"House","policyArea":"Economics and Public Finance","sponsors":[{"bioguideId":"B001278","district":1,"fullName":"Rep. Bonamici, Suzanne [D-OR-1]","party":"D","state":"OR"}],"summaries":[{"actionDate":"2026-07-22","actionDesc":"Introduced in House","text":"<p><strong>Daycare Not Detentions Act of 2026</strong></p><p>This bill rescinds funding that was provided to U.S. Immigration and Customs Enforcement (ICE) and U.S. Customs and Border Protection (CBP) and reallocates the funding to the Administration for Children and Families (ACF) for federal child care programs.</p><p>Specifically, the bill rescinds $70 billion in funding that was&nbsp;provided to ICE and CBP by the Secure America Act.</p><p>The bill also provides a total of $70 billion to&nbsp;ACF for federal child care programs, including&nbsp;</p><ul><li>$25.5 billion for the Child Care and Development Block Grant,</li><li>$20 billion for the Child Care Entitlement to States,</li><li>$24 billion for Head Start, and</li><li>$500 million for Preschool Development Grants.</li></ul><p>The funds provided to ACF are&nbsp;available through FY2029.&nbsp;</p>","updateDate":"2026-08-05T13:25:28Z","versionCode":"00"}],"title":"Daycare Not Detentions Act of 2026","type":"hr","updateDate":"2026-09-03T08:06:37Z","updateDateIncludingText":"2026-09-03T08:06:37Z"}
