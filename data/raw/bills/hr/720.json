{"actions":[{"actionCode":"H11100","actionDate":"2025-01-24","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-24","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-24","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/720","cosponsors":[{"bioguideId":"W000806","fullName":"Rep. Webster, Daniel [R-FL-11]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001211","fullName":"Rep. Miller, Mary E. [R-IL-15]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"H001077","fullName":"Rep. Higgins, Clay [R-LA-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"C001120","fullName":"Rep. Crenshaw, Dan [R-TX-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"O000175","fullName":"Rep. Ogles, Andrew [R-TN-5]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"H001086","fullName":"Rep. Harshbarger, Diana [R-TN-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-24","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"G000565","fullName":"Rep. Gosar, Paul A. [R-AZ-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001188","fullName":"Rep. Stutzman, Marlin A. [R-IN-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"IN"}],"fetchedAt":"2026-09-16T19:17:00+00:00","id":"hr720-119","introducedDate":"2025-01-24","latestAction":{"actionDate":"2025-01-24","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"720","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"B001317","district":2,"fullName":"Rep. Brecheen, Josh [R-OK-2]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2025-01-24","actionDesc":"Introduced in House","text":"<p><strong>Protecting Life in Health Savings Accounts Act</strong></p><p>This bill excludes expenses paid for an abortion from qualified medical expenses eligible for reimbursement from certain tax-exempt savings accounts. (Some exceptions apply.)</p><p>Under the bill, amounts paid for an abortion, other than an excluded abortion, are not qualified medical expenses eligible for reimbursement from a health savings account, Archer medical savings account, health flexible spending arrangement, health reimbursement arrangement, or retiree health account.</p><p>The bill defines <em>excluded abortion</em> as any abortion (1) related to a pregnancy that is the result of rape or incest; or (2)&nbsp;performed because a woman is suffering from a physical disorder, injury, or illness (including a life-endangering physical condition caused by or arising from the pregnancy itself) that would, as certified by a physician, place the woman in danger of death if an abortion were not performed.</p>","updateDate":"2025-04-24T12:54:01Z","versionCode":"00"}],"title":"Protecting Life in Health Savings Accounts Act","type":"hr","updateDate":"2025-12-05T21:59:04Z","updateDateIncludingText":"2025-12-05T21:59:04Z"}
