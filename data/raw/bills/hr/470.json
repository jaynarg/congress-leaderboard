onsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001216","fullName":"Rep. Mills, Cory [R-FL-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001214","fullName":"Rep. Steube, W. Gregory [R-FL-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001217","fullName":"Rep. Moskowitz, Jared [D-FL-23]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001260","fullName":"Rep. Buchanan, Vern [R-FL-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001099","fullName":"Rep. Haridopolos, Mike [R-FL-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-17","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001240","fullName":"Rep. McDowell, Addison [R-NC-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-17","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"F000484","fullName":"Rep. Fine, Randy [R-FL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-09","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-16T19:04:27+00:00","id":"hr470-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-01-16","text":"Referred to the House Committee on Natural Resources."},"laws":[],"number":"470","originChamber":"House","policyArea":"Public Lands and Natural Resources","sponsors":[{"bioguideId":"R000609","district":5,"fullName":"Rep. Rutherford, John H. [R-FL-5]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in House","text":"<p><strong>Red Snapper Act of 2025</strong></p><p>This bill prohibits the National Oceanic and Atmospheric Administration (NOAA) from restricting certain fishing activities in the South Atlantic until data from the South Atlantic Great Red Snapper Count study is integrated into the next South Atlantic red snapper Southeast&nbsp;Data, Assessment, and Review (SEDAR) stock assessment.&nbsp;</p><p>The bill provides that NOAA may not issue an interim rule,&nbsp;final rule, or Secretarial Amendment&nbsp;establishing an area closure or a bottom fishing closure for specified species&nbsp;until (1) the study is complete; and (2) the study data is integrated into the first South Atlantic red snapper SEDAR stock assessment&nbsp;that is carried out after the bill's enactment.&nbsp;The limitation applies to fishing for species managed under the Fishery Management Plan for the Snapper-Grouper Fishery of the South Atlantic Region, including red snapper, grouper, and porgy.</p><p>(Closures generally&nbsp;restrict&nbsp;recreational and commercial fishing to prevent overfishing and for other conservation purposes.)</p>","updateDate":"2025-07-30T18:48:50Z","versionCode":"00"}],"title":"Red Snapper Act of 2025","type":"hr","updateDate":"2025-12-05T22:03:02Z","updateDateIncludingText":"2025-12-05T22:03:02Z"}
