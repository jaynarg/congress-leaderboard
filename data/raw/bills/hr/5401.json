sOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"B001307","fullName":"Rep. Baird, James R. [R-IN-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"F000480","fullName":"Rep. Fong, Vince [R-CA-20]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000480","fullName":"Rep. Timmons, William R. [R-SC-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-12","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001213","fullName":"Rep. Moore, Blake D. [R-UT-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"F000482","fullName":"Rep. Fedorchak, Julie [R-ND-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-09","sponsorshipWithdrawnDate":null,"state":"ND"}],"fetchedAt":"2026-09-16T22:45:40+00:00","id":"hr5401-119","introducedDate":"2025-09-16","latestAction":{"actionDate":"2025-09-16","text":"Referred to the House Committee on Appropriations."},"laws":[],"number":"5401","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"K000399","district":2,"fullName":"Rep. Kiggans, Jennifer A. [R-VA-2]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2025-09-16","actionDesc":"Introduced in House","text":"<p><strong>Pay Our Troops Act of 2026</strong></p><p>This bill provides continuing appropriations for military pay for any period during which interim or full-year appropriations for FY2026 are not in effect (i.e., a government shutdown).</p><p>Specifically, the bill provides FY2026 continuing appropriations for the pay and allowances of (1) members of the Armed Forces, including reserve components, who perform active service during the period; and (2) civilian personnel and contractors of the Department of Defense (and the Department of Homeland Security in the case of the Coast Guard) who are providing support to such members of the Armed Forces.</p><p>If a government shutdown occurs, the bill provides the continuing appropriations until the earlier of (1) the enactment into law of specified appropriations legislation, or (2) January 1, 2027.&nbsp;</p>","updateDate":"2025-10-09T20:08:55Z","versionCode":"00"}],"title":"Pay Our Troops Act of 2026","type":"hr","updateDate":"2026-04-10T08:06:11Z","updateDateIncludingText":"2026-04-10T08:06:11Z"}
