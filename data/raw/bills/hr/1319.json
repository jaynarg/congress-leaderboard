shipWithdrawnDate":null,"state":"IL"},{"bioguideId":"L000595","fullName":"Rep. Letlow, Julia [R-LA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-21","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"C001103","fullName":"Rep. Carter, Earl L. \"Buddy\" [R-GA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"A000375","fullName":"Rep. Arrington, Jodey C. [R-TX-19]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001214","fullName":"Rep. Steube, W. Gregory [R-FL-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000603","fullName":"Rep. Gill, Brandon [R-TX-26]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-07","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001210","fullName":"Rep. Murphy, Gregory F. [R-NC-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"D000032","fullName":"Rep. Donalds, Byron [R-FL-19]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001291","fullName":"Rep. Babin, Brian [R-TX-36]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-23","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"F000450","fullName":"Rep. Foxx, Virginia [R-NC-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-02","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-16T19:46:47+00:00","id":"hr1319-119","introducedDate":"2025-02-13","latestAction":{"actionDate":"2026-02-20","text":"Placed on the Union Calendar, Calendar No. 431."},"laws":[],"number":"1319","originChamber":"House","policyArea":"Labor and Employment","sponsors":[{"bioguideId":"K000401","district":3,"fullName":"Rep. Kiley, Kevin [R-CA-3]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-02-13","actionDesc":"Introduced in House","text":"<p>This bill specifies a legal standard for determining whether an individual is considered an <em>independent contractor </em>rather than an <em>employee</em> for the purposes of federal labor laws that address issues such as the federal minimum wage, overtime compensation, and collective bargaining. The rights and protections provided by these laws exclusively apply to employees.</p><p>Under the bill, an individual is considered an independent contractor if (1) another individual or entity does not exercise significant control over the details of how the individual's work is performed, without regard to any control the other individual or entity may exercise over the final result of the work performed; and (2) while performing such work, the individual has opportunities and risks inherent with entrepreneurship (for example, the discretion to exercise professional judgment).</p><p>The bill also sets forth factors that may not be used to determine whether an individual is an employee. Specifically, factors such as whether another individual or entity requires the individual to meet certain legal, health and safety, insurance, or performance requirements may not be used to make such a determination.</p>","updateDate":"2025-07-29T15:15:23Z","versionCode":"00"}],"title":"Modern Worker Empowerment Act","type":"hr","updateDate":"2026-06-11T23:26:41Z","updateDateIncludingText":"2026-06-11T23:26:41Z"}
