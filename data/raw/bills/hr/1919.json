llName":"Rep. Edwards, Chuck [R-NC-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"J000311","fullName":"Rep. Jack, Brian [R-GA-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"M001211","fullName":"Rep. Miller, Mary E. [R-IL-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"S001214","fullName":"Rep. Steube, W. Gregory [R-FL-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"R000619","fullName":"Rep. Rulli, Michael A. [R-OH-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-09-20T14:12:14+00:00","id":"hr1919-119","introducedDate":"2025-03-06","latestAction":{"actionDate":"2025-07-17","actionTime":"16:02:03","text":"Motion to reconsider laid on the table Agreed to without objection."},"laws":[],"number":"1919","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"E000294","district":6,"fullName":"Rep. Emmer, Tom [R-MN-6]","party":"R","state":"MN"}],"summaries":[{"actionDate":"2025-03-06","actionDesc":"Introduced in House","text":"<p><strong>Anti-CBDC Surveillance State Act&nbsp; </strong></p><p>This bill prohibits a Federal Reserve bank from offering products or services directly to an individual, maintaining an account on behalf of an individual, or issuing a central bank digital currency (i.e., a digital dollar). Further, the Board of Governors of the Federal Reserve System is prohibited from using a central bank digital currency to implement monetary policy or from testing, studying, creating, or implementing a central bank digital currency, with exceptions as provided by the bill.</p>","updateDate":"2025-07-11T16:23:08Z","versionCode":"00"}],"title":"Anti-CBDC Surveillance State Act","type":"hr","updateDate":"2026-09-19T23:27:02Z","updateDateIncludingText":"2026-09-19T23:27:02Z"}
