thdrawnDate":null,"state":"WA"}],"fetchedAt":"2026-09-20T14:06:03+00:00","id":"hr1227-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2025-02-12","text":"Referred to the Committee on Energy and Commerce, and in addition to the Committee on Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"1227","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"M001215","district":1,"fullName":"Rep. Miller-Meeks, Mariannette [R-IA-1]","party":"R","state":"IA"}],"summaries":[{"actionDate":"2025-02-12","actionDesc":"Introduced in House","text":"<p><strong>Alternatives to Prevent Addiction In the Nation Act or the Alternatives to PAIN Act</strong></p><p>This bill reduces&nbsp;cost-sharing and prohibits the imposition of certain utilization requirements under the Medicare prescription drug benefit for certain non-opioid pain management drugs.</p><p>Specifically, the bill requires such drugs to be covered without a deductible and to be placed on the lowest cost-sharing tier (if any). The bill also prohibits the imposition of prior authorization requirements (i.e., requiring prior approval from a plan) or step therapy requirements (i.e., requiring the use of alternative drugs before a drug is covered under a plan) with respect to such drugs.</p>","updateDate":"2025-05-21T20:34:14Z","versionCode":"00"}],"title":"Alternatives to PAIN Act","type":"hr","updateDate":"2026-09-19T23:35:23Z","updateDateIncludingText":"2026-09-19T23:35:23Z"}
