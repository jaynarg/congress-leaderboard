ty":"D","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"V000134","fullName":"Rep. Van Duyne, Beth [R-TX-24]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"L000595","fullName":"Rep. Letlow, Julia [R-LA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"C001059","fullName":"Rep. Costa, Jim [D-CA-21]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"D000096","fullName":"Rep. Davis, Danny K. [D-IL-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-25","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-09","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-16T18:48:00+00:00","id":"hr227-119","introducedDate":"2025-01-07","latestAction":{"actionDate":"2026-04-28","text":"Received in the Senate and Read twice and referred to the Committee on Finance."},"laws":[],"number":"227","originChamber":"House","policyArea":"Social Welfare","sponsors":[{"bioguideId":"F000480","district":20,"fullName":"Rep. Fong, Vince [R-CA-20]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-01-07","actionDesc":"Introduced in House","text":"<p><strong>Clergy Act</strong></p><p>This bill establishes a two-year window for certain members of the clergy and Christian Science practitioners to revoke their exemption from Social Security and Medicare taxes on ministerial earnings. Under current law, such individuals who object to participation in public insurance programs on religious or conscientious grounds may apply to the Internal Revenue Service (IRS) for an irrevocable exemption and will not receive Social Security or Medicare benefits in retirement unless they have qualifying credits from other employment.</p><p>The IRS must develop a plan to inform members of the clergy and Christian Science practitioners of their eligibility to revoke prior exemptions, pursuant to the bill's changes.</p>","updateDate":"2025-02-20T20:14:51Z","versionCode":"00"}],"title":"Clergy Act","type":"hr","updateDate":"2026-07-18T00:02:53Z","updateDateIncludingText":"2026-07-18T00:02:53Z"}
