bioguideId":"J000304","fullName":"Rep. Jackson, Ronny [R-TX-13]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001118","fullName":"Rep. Cline, Ben [R-VA-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"F000246","fullName":"Rep. Fallon, Pat [R-TX-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"L000600","fullName":"Rep. Langworthy, Nicholas A. [R-NY-23]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001291","fullName":"Rep. Babin, Brian [R-TX-36]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"S001212","fullName":"Rep. Stauber, Pete [R-MN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"D000032","fullName":"Rep. Donalds, Byron [R-FL-19]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"W000806","fullName":"Rep. Webster, Daniel [R-FL-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"G000603","fullName":"Rep. Gill, Brandon [R-TX-26]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001196","fullName":"Rep. Stefanik, Elise M. [R-NY-21]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"H001098","fullName":"Rep. Hamadeh, Abraham J. [R-AZ-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-15","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"W000816","fullName":"Rep. Williams, Roger [R-TX-25]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-03","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001295","fullName":"Rep. Bost, Mike [R-IL-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-16T19:12:09+00:00","id":"hr624-119","introducedDate":"2025-01-22","latestAction":{"actionDate":"2025-01-22","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"624","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"M000871","district":1,"fullName":"Rep. Mann, Tracey [R-KS-1]","party":"R","state":"KS"}],"summaries":[{"actionDate":"2025-01-22","actionDesc":"Introduced in House","text":"<p><strong>Reining In Federal Licensing Enforcement Act of 2025 or the RIFLE Act of 2025</strong><br/>&nbsp;<br/>This bill revises the federal statutory framework governing the licensing, inspection, and enforcement of federally licensed dealers, importers, and manufacturers of firearms (i.e., federal firearms licensees, or FFLs) by the Bureau of Alcohol, Tobacco, Firearms and Explosives (ATF).&nbsp;<br/>&nbsp;<br/>With respect to an application for a license, this bill requires the ATF to make a preliminary determination, provide notice of a proposed denial, and allow the applicant to request a hearing.&nbsp;</p><p>With respect to inspections, this bill requires the ATF to establish standards for how it inspects, examines, or investigates FFLs for possible violations.</p><p>With respect to the enforcement of violations, this bill establishes a new framework. The new framework establishes a presumption that a violation by an FFL is not willful and requires&nbsp;the ATF to provide notice of and work with an FFL to rectify a violation.</p><p>In the case of a violation that is willful, the&nbsp;ATF has the burden of proving by clear and convincing evidence that the violation was committed willfully. The term <em>willfully</em> means that the person had actual knowledge of a legal duty, understood the obligation imposed by the legal duty, and deliberately disregarded the legal duty. The&nbsp;ATF may pursue revocation of an FFL’s license, but only after (1) providing notice and an opportunity to comply; and (2) finding that a lesser administrative action (e.g., warning, warning letter, or warning conference) is not likely to lead to future compliance.</p>","updateDate":"2026-01-15T20:11:53Z","versionCode":"00"}],"title":"RIFLE Act of 2025","type":"hr","updateDate":"2026-01-15T20:13:18Z","updateDateIncludingText":"2026-01-15T20:13:18Z"}
