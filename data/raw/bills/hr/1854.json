{"actions":[{"actionCode":"H11000","actionDate":"2025-03-28","source":"House committee actions","text":"Referred to the Subcommittee on Conservation, Research, and Biotechnology.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-03-05","source":"House floor actions","text":"Referred to the House Committee on Agriculture.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-03-05","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-03-05","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1854","cosponsors":[{"bioguideId":"C001066","fullName":"Rep. Castor, Kathy [D-FL-14]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-05","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001226","fullName":"Rep. Salinas, Andrea [D-OR-6]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-05","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"S001218","fullName":"Rep. Stansbury, Melanie A. [D-NM-1]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-05","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"T000487","fullName":"Rep. Tokuda, Jill N. [D-HI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-01","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-29","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-20","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"J000298","fullName":"Rep. Jayapal, Pramila [D-WA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-22","sponsorshipWithdrawnDate":null,"state":"WA"}],"fetchedAt":"2026-09-16T20:13:21+00:00","id":"hr1854-119","introducedDate":"2025-03-05","latestAction":{"actionDate":"2025-03-28","text":"Referred to the Subcommittee on Conservation, Research, and Biotechnology."},"laws":[],"number":"1854","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"B001285","district":26,"fullName":"Rep. Brownley, Julia [D-CA-26]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-03-05","actionDesc":"Introduced in House","text":"<p><strong>Climate Agricultural Conservation Practices Act</strong></p><p>This bill requires the Natural Resources Conservation Service (NRCS) to consider climate benefits in reviews or revisions of its conservation practice standards. Climate benefits include&nbsp;a reduction in agricultural greenhouse gas emissions, an increase in carbon sequestration, or&nbsp;mitigation against (or adaptation to) increased weather volatility.</p><p>As background, NRCS&nbsp;administers most of the Department of Agriculture conservation programs, which assist producers and landowners who wish to practice conservation on agricultural lands. The NRCS conservation practice standards&nbsp;provide guidance and set out minimum quality criteria for implementing federally funded conservation practices.</p>","updateDate":"2025-06-16T18:28:12Z","versionCode":"00"}],"title":"Climate Agricultural Conservation Practices Act","type":"hr","updateDate":"2026-07-17T23:37:55Z","updateDateIncludingText":"2026-07-17T23:37:55Z"}
