{"actions":[{"actionCode":"H11100","actionDate":"2025-01-22","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-22","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-22","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/640","cosponsors":[{"bioguideId":"C001126","fullName":"Rep. Carey, Mike [R-OH-15]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"L000585","fullName":"Rep. LaHood, Darin [R-IL-16]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"M001205","fullName":"Rep. Miller, Carol D. [R-WV-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"H001082","fullName":"Rep. Hern, Kevin [R-OK-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"W000814","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"T000478","fullName":"Rep. Tenney, Claudia [R-NY-24]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"K000392","fullName":"Rep. Kustoff, David [R-TN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"M001224","fullName":"Rep. Moran, Nathaniel [R-TX-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-10","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"E000300","fullName":"Rep. Evans, Gabe [R-CO-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-15","sponsorshipWithdrawnDate":null,"state":"CO"}],"fetchedAt":"2026-09-16T19:12:56+00:00","id":"hr640-119","introducedDate":"2025-01-22","latestAction":{"actionDate":"2025-01-22","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"640","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"V000134","district":24,"fullName":"Rep. Van Duyne, Beth [R-TX-24]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-01-22","actionDesc":"Introduced in House","text":"<p><strong>Chemical Tax Repeal Act </strong></p><p>This bill repeals the Hazardous Substance Superfund excise tax imposed on certain chemicals and chemical substances.</p><p>Under current law, an excise tax is imposed through December 31, 2031, on taxable chemicals&nbsp;and taxable chemical substances that are (1) manufactured or produced in the United States, or (2) imported into the United States. The excise tax rate varies between 44 cents per ton to $9.74 per ton, depending on the chemical and certain other variables. (There are 42 listed taxable chemicals and 151 listed taxable chemical substances.)</p><p>Further, under current law, amounts collected from the excise tax on taxable chemicals and taxable chemical substances are deposited into the Hazardous Substance Superfund, which finances the remediation of certain environmentally contaminated sites.</p>","updateDate":"2026-06-09T12:44:40Z","versionCode":"00"}],"title":"Chemical Tax Repeal Act","type":"hr","updateDate":"2026-06-09T12:50:49Z","updateDateIncludingText":"2026-06-09T12:50:49Z"}
