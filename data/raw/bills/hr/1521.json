thdrawnDate":null,"state":"WI"},{"bioguideId":"G000591","fullName":"Rep. Guest, Michael [R-MS-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"V000139","fullName":"Rep. Van Epps, Matt [R-TN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-04","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"G000586","fullName":"Rep. García, Jesús G. \"Chuy\" [D-IL-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"D000624","fullName":"Rep. Dingell, Debbie [D-MI-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S001145","fullName":"Rep. Schakowsky, Janice D. [D-IL-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-15","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-16T19:57:04+00:00","id":"hr1521-119","introducedDate":"2025-02-24","latestAction":{"actionDate":"2025-02-24","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1521","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"C001103","district":1,"fullName":"Rep. Carter, Earl L. \"Buddy\" [R-GA-1]","party":"R","state":"GA"}],"summaries":[{"actionDate":"2025-02-24","actionDesc":"Introduced in House","text":"<p><strong>Dentist and Optometric Care Access Act of 2025 or the DOC Access Act</strong> <strong>of 20</strong><strong>25</strong></p><p>This bill prohibits private health insurance plans from setting rates for items and services, except for dental cleanings, provided by a doctor of optometry, of dental surgery, or of dental medicine&nbsp;(or an employer of such a doctor) for which the plan does not pay a substantial amount.</p><p>Additionally, an agreement between a plan and such a doctor for limited scope dental or vision benefits may last longer than two years only with the prior acceptance of the doctor for each term extension. Plans also may not restrict such a doctor's choice of laboratories or suppliers.</p><p>Such doctors may elect to waive the application of the payment amount and choice of laboratories provisions of this bill.</p><p>The bill does not supersede state laws regarding health insurers and dental or vision benefit plans.</p>","updateDate":"2026-03-05T02:01:09Z","versionCode":"00"}],"title":"DOC Access Act of 2025","type":"hr","updateDate":"2026-09-16T08:09:37Z","updateDateIncludingText":"2026-09-16T08:09:37Z"}
