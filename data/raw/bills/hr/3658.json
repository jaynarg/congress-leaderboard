ipWithdrawnDate":null,"state":"HI"},{"bioguideId":"W000822","fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-24","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-10-17T13:22:04+00:00","id":"hr3658-119","introducedDate":"2025-05-29","latestAction":{"actionDate":"2025-05-29","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"3658","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"S000510","district":9,"fullName":"Rep. Smith, Adam [D-WA-9]","party":"D","state":"WA"}],"summaries":[{"actionDate":"2025-05-29","actionDesc":"Introduced in House","text":"<p><strong>911 Community Crisis Responders Act of 2025</strong></p><p>This bill authorizes grants to dispatch unarmed, specialized health care or social service providers to respond to nonviolent emergency calls instead of law enforcement officers.</p><p>The Substance Abuse and Mental Health Services Administration may award such grants to state, territorial, local, and tribal governments (including consortia of tribal governments). Recipients may use the grants for hiring and training necessary staff, working with 9-1-1 dispatchers and 9-8-8 call centers to appropriately dispatch services in response to nonviolent emergency calls, and connecting individuals with local health and social service providers. (The 9-8-8 system provides callers with mental health or suicide crisis support and resources.)</p>","updateDate":"2026-10-16T19:02:52Z","versionCode":"00"}],"title":"911 Community Crisis Responders Act of 2025","type":"hr","updateDate":"2026-10-16T19:03:58Z","updateDateIncludingText":"2026-10-16T19:03:58Z"}
