oguideId":"P000617","fullName":"Rep. Pressley, Ayanna [D-MA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-15","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"R000620","fullName":"Rep. Rivas, Luz M. [D-CA-29]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000483","fullName":"Rep. Friedman, Laura [D-CA-30]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001225","fullName":"Rep. Mullin, Kevin [D-CA-15]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001188","fullName":"Rep. Meng, Grace [D-NY-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-21","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"J000309","fullName":"Rep. Jackson, Jonathan L. [D-IL-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-20","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"R000621","fullName":"Rep. Randall, Emily [D-WA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"B001328","fullName":"Rep. Blair, Everton [D-GA-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-15","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"M001245","fullName":"Rep. Menefee, Christian D. [D-TX-18]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-21","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-22T14:17:40+00:00","id":"hr3543-119","introducedDate":"2025-05-21","latestAction":{"actionDate":"2025-05-21","text":"Referred to the Committee on Education and Workforce, and in addition to the Committees on Ways and Means, and the Budget, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"3543","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"J000298","district":7,"fullName":"Rep. Jayapal, Pramila [D-WA-7]","party":"D","state":"WA"}],"summaries":[{"actionDate":"2025-05-21","actionDesc":"Introduced in House","text":"<p><strong>College for All Act of </strong><strong>2025</strong></p><p>This bill establishes measures to expand access to higher education, including by eliminating tuition and required fees for eligible students, revising the Federal Pell Grant program, and reauthorizing certain programs to assist students from disadvantaged backgrounds.</p><p>Specifically, the bill provides funding to enable states and tribal colleges and universities, through a federal-state partnership, to eliminate tuition and required fees for (1) all students at community colleges and two-year tribal colleges and universities, and (2) working- and middle-class students at four-year public institutions of higher education and tribal colleges and universities.</p><p>The bill provides funding to enable private, nonprofit historically Black colleges and universities and minority-serving institutions to eliminate tuition and required fees for eligible students.</p><p>The bill permanently reauthorizes and otherwise revises the Federal Pell Grant program by</p><ul><li>providing funding to increase the maximum award for each eligible student,</li><li>increasing the duration limit for the use of Pell Grants,</li><li>allowing students to use their awards to cover living and nontuition expenses, and</li><li>expanding eligibility to Dreamer students (i.e., students who have been granted Deferred Action for Childhood Arrivals status and who entered the United States before the age of 16) and students with other immigration statuses.</li></ul><p>Further, the bill requires the Department of Education to award grants to eligible states and tribal colleges and universities for improving student outcomes.</p><p>The bill reauthorizes through FY2035 the Federal TRIO Programs and reauthorizes through FY2029 the Gaining Early Awareness and Readiness for Undergraduate Programs.</p>","updateDate":"2025-12-16T21:35:52Z","versionCode":"00"}],"title":"College for All Act of 2025","type":"hr","updateDate":"2026-09-22T08:05:36Z","updateDateIncludingText":"2026-09-22T08:05:36Z"}
