awnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T21:25:48+00:00","id":"hr3491-119","introducedDate":"2025-05-19","latestAction":{"actionDate":"2026-07-21","text":"Received in the Senate and Read twice and referred to the Committee on Health, Education, Labor, and Pensions."},"laws":[],"number":"3491","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"D000197","district":1,"fullName":"Rep. DeGette, Diana [D-CO-1]","party":"D","state":"CO"}],"summaries":[{"actionDate":"2026-07-02","actionDesc":"Reported to House","text":"<p><strong>DeOndra Dixon INCLUDE Project Act of 2025</strong></p><p>This bill provides statutory authority for a program of the National Institutes of Health (NIH) that carries out research and training relating to Down syndrome, including with respect to&nbsp;co-occurring conditions and improving the quality of life of affected individuals. The NIH must implement the program in consultation with relevant stakeholders and avoid duplicating existing NIH Down syndrome research.</p><p>Biennially, the&nbsp;NIH must submit to Congress a report cataloging the research, including results that may be used in medical care or clinical research.</p>","updateDate":"2026-07-15T20:48:51Z","versionCode":"07"}],"title":"DeOndra Dixon INCLUDE Project Act of 2025","type":"hr","updateDate":"2026-08-20T22:41:38Z","updateDateIncludingText":"2026-08-20T22:41:38Z"}
