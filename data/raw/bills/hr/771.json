{"actions":[{"actionCode":"H11100","actionDate":"2025-01-28","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-28","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-28","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/771","cosponsors":[{"bioguideId":"T000467","fullName":"Rep. Thompson, Glenn [R-PA-15]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"J000304","fullName":"Rep. Jackson, Ronny [R-TX-13]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001211","fullName":"Rep. Miller, Mary E. [R-IL-15]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"T000487","fullName":"Rep. Tokuda, Jill N. [D-HI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-06","sponsorshipWithdrawnDate":null,"state":"HI"}],"fetchedAt":"2026-09-16T19:19:33+00:00","id":"hr771-119","introducedDate":"2025-01-28","latestAction":{"actionDate":"2025-01-28","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"771","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"G000590","district":7,"fullName":"Rep. Green, Mark E. [R-TN-7]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-01-28","actionDesc":"Introduced in House","text":"<p><strong>Rural Health Care Access Act of 2025</strong><strong></strong></p><p>This bill eliminates certain criteria that hospitals must meet in order to qualify as critical access hospitals that receive special payment under Medicare.</p><p>Specifically, the bill eliminates the requirement that a hospital must either (1) be located more than 35 miles (15 miles in mountainous regions or areas with only secondary roads) from another hospital, or (2) have been certified prior to January 1, 2006, by the state as a necessary provider of services in the area.</p>","updateDate":"2025-03-10T18:04:29Z","versionCode":"00"}],"title":"Rural Health Care Access Act of 2025","type":"hr","updateDate":"2025-06-07T08:06:13Z","updateDateIncludingText":"2025-06-07T08:06:13Z"}
