ate":"MI"},{"bioguideId":"B001292","fullName":"Rep. Beyer, Donald S. [D-VA-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-06","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"G000600","fullName":"Rep. Perez, Marie Gluesenkamp [D-WA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-17","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"D000230","fullName":"Rep. Davis, Donald G. [D-NC-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-17","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001246","fullName":"Rep. Mejia, Analilia [D-NJ-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-17","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"R000622","fullName":"Rep. Riley, Josh [D-NY-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-20","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"W000187","fullName":"Rep. Waters, Maxine [D-CA-43]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-27","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"H001066","fullName":"Rep. Horsford, Steven [D-NV-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"M001220","fullName":"Rep. McGarvey, Morgan [D-KY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"C001101","fullName":"Rep. Clark, Katherine M. [D-MA-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"R000620","fullName":"Rep. Rivas, Luz M. [D-CA-29]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T15:09:02+00:00","id":"hr7802-119","introducedDate":"2026-03-04","latestAction":{"actionDate":"2026-03-04","text":"Referred to the Committee on House Administration, and in addition to the Committees on Ways and Means, and the Judiciary, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"7802","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"P000614","district":1,"fullName":"Rep. Pappas, Chris [D-NH-1]","party":"D","state":"NH"}],"summaries":[{"actionDate":"2026-03-04","actionDesc":"Introduced in House","text":"<p><strong>Democracy Is Strengthened by Casting Light On Spending in Elections Act of 2026 or the DISCLOSE Act of </strong><strong>2026</strong></p><p>This bill addresses campaign finance, including by expanding the prohibition on campaign spending by foreign nationals, requiring additional disclosures of campaign expenditures, and requiring additional disclosures regarding certain political advertisements.</p><p>Specifically, the bill expands existing foreign money prohibitions to include disbursements for paid web-based or digital communications and federal judicial nomination communications. It also prohibits foreign nationals from contributing to campaigns related to ballot initiatives and referenda.</p><p>The Government Accountability Office must, for each four-year election cycle, study and report on the incidence of illicit foreign money in federal elections.</p><p>Next, the bill makes it unlawful to establish or use a corporation, company, or other entity with the intent to conceal an election contribution or donation by a foreign national. A violator is subject to criminal penalties—a fine, a prison term of up to five years, or both.</p><p>Covered organizations (e.g., corporations, labor organizations, and political organizations) must, within 24 hours, file reports with the Federal Election Commission to disclose campaign expenditures of more than $10,000 during an election cycle.</p><p>The bill also requires organizations to provide additional disclosures regarding political advertisements, including the donors who contributed the most money to that organization in the last year.</p>","updateDate":"2026-04-27T16:12:00Z","versionCode":"00"}],"title":"DISCLOSE Act of 2026","type":"hr","updateDate":"2026-09-19T23:26:49Z","updateDateIncludingText":"2026-09-19T23:26:49Z"}
