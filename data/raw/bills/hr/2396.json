-31","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"C001125","fullName":"Rep. Carter, Troy A. [D-LA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"D000629","fullName":"Rep. Davids, Sharice [D-KS-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"R000579","fullName":"Rep. Ryan, Patrick [D-NY-18]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"C001059","fullName":"Rep. Costa, Jim [D-CA-21]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"L000397","fullName":"Rep. Lofgren, Zoe [D-CA-18]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-11","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000469","fullName":"Rep. Tonko, Paul [D-NY-20]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-15","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T20:37:50+00:00","id":"hr2396-119","introducedDate":"2025-03-27","latestAction":{"actionDate":"2025-04-18","text":"Referred to the Subcommittee on General Farm Commodities, Risk Management, and Credit."},"laws":[],"number":"2396","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"V000136","district":2,"fullName":"Rep. Vasquez, Gabe [D-NM-2]","party":"D","state":"NM"}],"summaries":[{"actionDate":"2025-03-27","actionDesc":"Introduced in House","text":"<p><strong>Honor Farmer Contracts Act</strong></p><p>This bill requires the Department of Agriculture (USDA) to unfreeze funding for agreements and contracts and&nbsp;prohibits USDA from closing certain offices and service centers without notifying Congress in advance.</p><p>Specifically, USDA must (1) unfreeze funding for, and implement, all agreements and contracts entered into by USDA prior to the bill's enactment; and (2) pay all related past due amounts owed by USDA as rapidly as possible.</p><p>Further, the bill prohibits USDA from canceling a signed agreement or contract with a farmer or an entity providing assistance to farmers (unless the farmer or entity is not in compliance with the terms and conditions of the contract).</p><p>Finally, the bill prohibits USDA from closing Farm Service Agency county offices, Natural Resources Conservation Service field offices, or Rural Development Service Centers without providing written notice and a justification to Congress at least 60 days before the closure.</p>","updateDate":"2025-06-25T17:58:30Z","versionCode":"00"}],"title":"Honor Farmer Contracts Act","type":"hr","updateDate":"2025-07-17T11:31:10Z","updateDateIncludingText":"2025-07-17T11:31:10Z"}
