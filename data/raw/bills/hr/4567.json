thdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-09-16T22:11:43+00:00","id":"hr4567-119","introducedDate":"2025-07-21","latestAction":{"actionDate":"2025-07-21","text":"Referred to the House Committee on House Administration."},"laws":[],"number":"4567","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"L000597","district":15,"fullName":"Rep. Lee, Laurel M. [R-FL-15]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-07-21","actionDesc":"Introduced in House","text":"<p><b>Supporting Military Voters Act</b></p> <p>This bill requires the Government Accountability Office (GAO) to study and report on access to voting for uniformed services voters.</p> <p>Specifically, the GAO must</p> <ul> <li>analyze the effectiveness of the federal government in carrying out the Uniformed and Overseas Citizens Absentee Voting Act to promote access to voting for absent uniformed services voters, and</li> <li>study ways to improve access to voter registration information and assistance for members of the Armed Forces and their family members.</li> </ul>","updateDate":"2026-03-31T12:29:22Z","versionCode":"00"}],"title":"Supporting Military Voters Act","type":"hr","updateDate":"2026-03-31T12:29:27Z","updateDateIncludingText":"2026-03-31T12:29:27Z"}
