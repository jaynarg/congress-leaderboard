:[],"number":"669","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"L000582","district":36,"fullName":"Rep. Lieu, Ted [D-CA-36]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-01-23","actionDesc":"Introduced in House","text":"<p><strong>Restricting First Use of Nuclear Weapons Act of 2025 </strong></p><p>This bill prohibits using federal funds to conduct a first-use nuclear strike unless Congress expressly authorizes such a strike pursuant to a declaration of war. A first-use nuclear strike is an attack using nuclear weapons against an enemy without confirming that there has been a nuclear strike against the United States, its territories, or its allies.</p>","updateDate":"2025-03-05T19:08:57Z","versionCode":"00"}],"title":"Restricting First Use of Nuclear Weapons Act of 2025","type":"hr","updateDate":"2026-07-17T23:39:31Z","updateDateIncludingText":"2026-07-17T23:39:31Z"}
