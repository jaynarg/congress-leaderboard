{"actions":[{"actionCode":"H11100","actionDate":"2025-02-26","source":"House floor actions","text":"Referred to the House Committee on Science, Space, and Technology.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-26","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-26","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1610","cosponsors":[{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"G000602","fullName":"Rep. Gillen, Laura [D-NY-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"G000585","fullName":"Rep. Gomez, Jimmy [D-CA-34]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000375","fullName":"Rep. Keating, William R. [D-MA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-20","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"E000300","fullName":"Rep. Evans, Gabe [R-CO-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"CO"}],"fetchedAt":"2026-09-16T20:01:51+00:00","id":"hr1610-119","introducedDate":"2025-02-26","latestAction":{"actionDate":"2025-02-26","text":"Referred to the House Committee on Science, Space, and Technology."},"laws":[],"number":"1610","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"G000583","district":5,"fullName":"Rep. Gottheimer, Josh [D-NJ-5]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2025-02-26","actionDesc":"Introduced in House","text":"<p><strong>Firefighter Investments to Recognize Exposure to Cancer Act of 2025 or the FIRE Cancer Act of 2025</strong></p><p>This bill expands the Federal Emergency Management Agency's (FEMA's) Assistance to Firefighters Grant program for fire departments and emergency medical services organizations to include cancer prevention programs (e.g., multi-cancer early detection testing)&nbsp;for firefighting personnel. It also establishes a joint cancer research program between FEMA and the Centers for Disease Control and Prevention (CDC)&nbsp;through which firefighting personnel may voluntarily share the anonymized results of preventative cancer testing so the CDC can study trends or causes of cancer in such personnel.</p>","updateDate":"2025-08-14T15:20:42Z","versionCode":"00"}],"title":"FIRE Cancer Act of 2025","type":"hr","updateDate":"2026-08-20T21:12:47Z","updateDateIncludingText":"2026-08-20T21:12:47Z"}
