shipWithdrawnDate":null,"state":"MI"},{"bioguideId":"F000484","fullName":"Rep. Fine, Randy [R-FL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"K000399","fullName":"Rep. Kiggans, Jennifer A. [R-VA-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"N000188","fullName":"Rep. Norcross, Donald [D-NJ-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-23T14:32:20+00:00","id":"hr3170-119","introducedDate":"2025-05-01","latestAction":{"actionDate":"2025-12-04","text":"Placed on the Union Calendar, Calendar No. 343."},"laws":[],"number":"3170","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"W000798","district":5,"fullName":"Rep. Walberg, Tim [R-MI-5]","party":"R","state":"MI"}],"summaries":[{"actionDate":"2025-12-04","actionDesc":"Reported to House","text":"<p><strong>Improving Access to Workers' Compensation for Injured Federal Workers Act&nbsp;of 2025</strong></p><p>This bill expands the role of nurse practitioners and physician assistants in providing services to injured federal workers under the federal workers' compensation program.</p><p>Specifically, under the program, nurse practitioners and physician assistants acting within the scope of their practice may (1) prescribe or recommend treatment for injured federal workers; (2) certify the nature of an injury and probable extent of disability; (3) provide prescribed treatment for injured federal workers; and (4) participate, with a physician designated by the Department of Labor, in a mandatory workers' compensation examination of an injured worker. In general, only physicians may fulfill these roles under current law.</p>","updateDate":"2026-04-07T20:22:56Z","versionCode":"07"}],"title":"Improving Access 