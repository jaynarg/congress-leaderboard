{"actions":[{"actionCode":"H11100","actionDate":"2026-04-14","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2026-04-14","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2026-04-14","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/8273","cosponsors":[{"bioguideId":"S000168","fullName":"Rep. Salazar, Maria Elvira [R-FL-27]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"D000629","fullName":"Rep. Davids, Sharice [D-KS-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-25","sponsorshipWithdrawnDate":null,"state":"KS"}],"fetchedAt":"2026-11-03T17:32:37+00:00","id":"hr8273-119","introducedDate":"2026-04-14","latestAction":{"actionDate":"2026-04-14","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"8273","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"P000620","district":7,"fullName":"Rep. Pettersen, Brittany [D-CO-7]","party":"D","state":"CO"}],"summaries":[{"actionDate":"2026-04-14","actionDesc":"Introduced in House","text":"<p><strong>Catching Up Family Caregivers Act of 2026</strong></p><p>This bill allows qualified family caregivers to make catch-up contributions to a retirement account for up to five years. A <em>qualified family caregiver</em> is an unemployed or severely underemployed adult who provides 500 hours or more of in-home care, monitoring, management, supervision, or treatment of an adult with special needs or a child during