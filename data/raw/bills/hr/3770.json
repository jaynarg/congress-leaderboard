sorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-25","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"F000470","fullName":"Rep. Fischbach, Michelle [R-MN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"MN"}],"fetchedAt":"2026-09-17T14:37:47+00:00","id":"hr3770-119","introducedDate":"2025-06-05","latestAction":{"actionDate":"2025-09-10","text":"Ordered to be Reported (Amended) by the Yeas and Nays: 15 - 8."},"laws":[],"number":"3770","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"I000056","district":48,"fullName":"Rep. Issa, Darrell [R-CA-48]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-06-05","actionDesc":"Introduced in House","text":"<p><strong>Fighting Irrational Regulatory Enforcement to Avert Retailers’ Misfortune Act or the FIREARM Act</strong></p><p>This bill prohibits the Bureau of Alcohol, Tobacco, Firearms and Explosives (ATF) from bringing an enforcement action to revoke or deny renewal of a federal firearms license on the basis of a self-reported violation that is correctable, so long as the violation did not involve the transfer of a firearm to a prohibited person.</p><p>The term <em>self-reported violation</em> means a violation of a statutory provision or implementing regulation by a federal firearms licensee (e.g., a gun dealer) that the licensee reports to the&nbsp;ATF before it is discovered during a compliance inspection.</p><p>The bill applies retroactively.</p>","updateDate":"2025-09-10T15:09:58Z","versionCode":"00"}],"title":"FIREARM Act","type":"hr","updateDate":"2026-09-17T08:07:43Z","updateDateIncludingText":"2026-09-17T08:07:43Z"}
