{"actions":[{"actionCode":"H11100","actionDate":"2025-01-15","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-15","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-15","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/409","cosponsors":[{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M000312","fullName":"Rep. McGovern, James P. [D-MA-2]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"W000822","fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"L000606","fullName":"Rep. Latimer, George [D-NY-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-27","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"K000402","fullName":"Rep. Kennedy, Timothy M. [D-NY-26]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-01","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-20T13:58:03+00:00","id":"hr409-119","introducedDate":"2025-01-15","latestAction":{"actionDate":"2025-01-15","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"409","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"A000148","district":4,"fullName":"Rep. Auchincloss, Jake [D-MA-4]","party":"D","state":"MA"}],"summaries":[{"actionDate":"2025-01-15","actionDesc":"Introduced in House","text":"<p><strong>Supporting Transit Commutes Act&nbsp;</strong></p><p>This bill provides employers a tax deduction for certain transportation fringe benefits given to employees.</p><p>Under the bill, employers may deduct costs for providing employees transportation in a commuter highway vehicle (e.g., van pool) between the employee’s home and place of work or a transit pass. The amount of the deduction cannot exceed the aggregate exclusion amount for such fringe benefits ($325 per month per employee in 2025 and adjusted annually). Further, under the bill, the deduction cannot exceed 50% of such amount for transportation fringe benefits provided under a salary reduction agreement.</p>","updateDate":"2025-04-14T18:36:36Z","versionCode":"00"}],"title":"Supporting Transit Commutes Act","type":"hr","updateDate":"2026-09-19T23:07:48Z","updateDateIncludingText":"2026-09-19T23:07:48Z"}
