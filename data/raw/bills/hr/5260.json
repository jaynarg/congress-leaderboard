Date":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"O000177","fullName":"Rep. Onder, Robert F. [R-MO-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"G000602","fullName":"Rep. Gillen, Laura [D-NY-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-28","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T22:40:05+00:00","id":"hr5260-119","introducedDate":"2025-09-10","latestAction":{"actionDate":"2025-09-10","text":"Referred to the House Committee on Appropriations."},"laws":[],"number":"5260","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"D000594","district":15,"fullName":"Rep. De La Cruz, Monica [R-TX-15]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-09-10","actionDesc":"Introduced in House","text":"<p><strong>Pay Our Border Patrol and Customs Agents Act</strong></p><p>This bill provides FY2026 appropriations for the salaries and expenses of certain U.S. Customs and Border Protection (CBP) employees who are required to work during a lapse in appropriations (i.e., government shutdown) in FY2026.</p><p>Specifically, the bill provides appropriations to CBP for the salaries and expenses of agents of the U.S. Border Patrol and officers of the Office of Field Operations who are excepted from furlough (i.e., required to work) during a lapse in discretionary appropriations in FY2026.&nbsp;</p>","updateDate":"2025-09-18T18:24:36Z","versionCode":"00"}],"title":"Pay Our Border Patrol and Customs Agents Act","type":"hr","updateDate":"2025-10-29T08:05:48Z","updateDateIncludingText":"2025-10-29T08:05:48Z"}
