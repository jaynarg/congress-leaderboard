{"actions":[{"actionCode":"H11100","actionDate":"2025-04-29","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-04-29","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-04-29","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/3079","cosponsors":[{"bioguideId":"V000131","fullName":"Rep. Veasey, Marc A. [D-TX-33]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001126","fullName":"Rep. Carey, Mike [R-OH-15]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"B000668","fullName":"Rep. Bentz, Cliff [R-OR-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-09","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T21:07:44+00:00","id":"hr3079-119","introducedDate":"2025-04-29","latestAction":{"actionDate":"2025-04-29","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"3079","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"R000619","district":6,"fullName":"Rep. Rulli, Michael A. [R-OH-6]","party":"R","state":"OH"}],"summaries":[{"actionDate":"2025-04-29","actionDesc":"Introduced in House","text":"<p><strong>Medicaid Empowerment Act of 2025</strong></p><p>This bill allows state Medicaid programs to renew home- and community-based services waivers (also known as Section 1915(c) waivers) in 10-year periods. Currently, these waivers