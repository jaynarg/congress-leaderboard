,"party":"R","sponsorshipDate":"2025-06-05","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"R000575","fullName":"Rep. Rogers, Mike D. [R-AL-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-05","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"H001068","fullName":"Rep. Huffman, Jared [D-CA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-26","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"E000246","fullName":"Rep. Edwards, Chuck [R-NC-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-26","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001240","fullName":"Rep. McDowell, Addison P. [R-NC-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"D000230","fullName":"Rep. Davis, Donald G. [D-NC-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-20","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"P000613","fullName":"Rep. Panetta, Jimmy [D-CA-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-20","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"L000593","fullName":"Rep. Levin, Mike [D-CA-49]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-25","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001241","fullName":"Rep. Min, Dave [D-CA-47]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-17","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000491","fullName":"Rep. Tran, Derek [D-CA-45]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"V000130","fullName":"Rep. Vargas, Juan [D-CA-52]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-22","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000589","fullName":"Rep. Gooden, Lance [R-TX-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"L000585","fullName":"Rep. LaHood, Darin [R-IL-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"G000607","fullName":"Rep. Gallagher, James [R-CA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-25","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"W000830","fullName":"Rep. Whitesides, George [D-CA-27]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T20:13:07+00:00","id":"hr1849-119","introducedDate":"2025-03-05","latestAction":{"actionDate":"2026-02-04","actionTime":"16:15:37","text":"ASSUMING FIRST SPONSORSHIP - Mr. Murphy asked unanimous consent that he may hereafter be considered as the first sponsor of H.R. 1849, a bill originally introduced by Representative LaMalfa, for the purpose of adding cosponsors and requesting reprintings pursuant to clause 7 of rule XII. Agreed to without objection."},"laws":[],"number":"1849","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"L000578","district":1,"fullName":"Rep. LaMalfa, Doug [R-CA-1]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-03-05","actionDesc":"Introduced in House","text":"<p><strong>Disaster Mitigation and Tax Parity Act of 2025</strong></p><p>This bill excludes from gross income, for federal income tax purposes, payments received from a state catastrophe loss mitigation program by an individual&nbsp;for the purpose of making improvements to the individual’s property that mitigate the impact of certain disasters.</p><p>Under current law, individuals may exclude from gross income, for federal income tax purposes, payments received under the Robert&nbsp;T. Stafford Disaster Relief and Emergency Assistance Act or the National Flood Insurance Act (as in effect on April 15, 2005) for hazard mitigation. (Some exceptions apply.) Further, under current law, such payments do not increase the basis of the property for which the payments are made.</p><p>The bill allows a similar exclusion from gross income for certain payments received by an individual from a program established by</p><ul><li>a state (or any political subdivision or instrumentality of the state),</li><li>a joint powers authority, or</li><li>an entity that was established by the state to provide essential or basic property insurance and is regulated by the state.</li></ul><p>Under the bill, such payments must be for making improvements to the individual’s property for the sole purpose of reducing damage that would be done to the property by a windstorm, earthquake, flood, or wildfire.</p><p>Finally, the bill provides that such payments from a state catastrophe loss mitigation program do not increase the basis of the property for which the payments are made.</p>","updateDate":"2025-07-09T12:52:01Z","versionCode":"00"}],"title":"Disaster Mitigation and Tax Parity Act of 2025","type":"hr","updateDate":"2026-09-01T08:05:37Z","updateDateIncludingText":"2026-09-01T08:05:37Z"}
