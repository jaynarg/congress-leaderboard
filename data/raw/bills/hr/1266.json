guideId":"G000601","fullName":"Rep. Goldman, Craig A. [R-TX-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"D000594","fullName":"Rep. De La Cruz, Monica [R-TX-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-30","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"P000608","fullName":"Rep. Peters, Scott H. [D-CA-50]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-30","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000468","fullName":"Rep. Titus, Dina [D-NV-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-21","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"G000604","fullName":"Rep. Goodlander, Maggie [D-NH-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-24","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"H001066","fullName":"Rep. Horsford, Steven [D-NV-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"NV"}],"fetchedAt":"2026-09-16T19:44:09+00:00","id":"hr1266-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2026-09-15","actionTime":"19:24:44","text":"Motion to reconsider laid on the table Agreed to without objection."},"laws":[],"number":"1266","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"P000613","district":19,"fullName":"Rep. Panetta, Jimmy [D-CA-19]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-02-12","actionDesc":"Introduced in House","text":"<p><strong>Combating Illicit Xylazine Act</strong></p><p>This bill regulates xylazine under the Controlled Substances Act (CSA).</p><p>Xylazine, also known as <em>tranq</em>, is a nonopioid sedative and pain reliever that is approved for use in animals. Recently, the Drug Enforcement Administration (DEA) has reported an increase in trafficking of fentanyl mixed with xylazine.</p><p>This bill adds xylazine, including its salts, isomers, and salts of isomers, to schedule III of the CSA. Schedule III controlled substances, including anabolic steroids, buprenorphine, and ketamine, have less potential for abuse than a schedule I or II substance, have a currently accepted medical use, and have low or moderate risk of dependence if abused.</p><p>Under the bill, manufacturing, distributing, or dispensing xylazine, or possessing with intent to manufacture, distribute, or dispense xylazine for illicit use is subject to criminal penalties under the&nbsp;CSA. The bill also requires xylazine transactions&nbsp;to be tracked in the&nbsp;drug reporting system maintained by the DEA.</p><p>The bill exempts from&nbsp;registration under&nbsp;the CSA&nbsp;persons and entities that possess xylazine (1) lawfully dispensed by a veterinarian or pharmacy and (2) for an animal or for use in certain animal-control or wildlife programs.</p><p>The bill also exempts xylazine manufacturers from the&nbsp;CSA's physical security requirements.</p><p>Finally, the bill requires the DEA, in coordination with the&nbsp;Food and Drug Administration, to report on (1) the prevalence and impact of&nbsp;illicit xylazine use in the United States, and (2) updated information on the prevalence and proliferation of&nbsp;xylazine trafficking and misuse in the United States.</p>","updateDate":"2026-08-27T16:34:41Z","versionCode":"00"}],"title":"Combating Illicit Xylazine Act","type":"hr","updateDate":"2026-09-16T15:24:21Z","updateDateIncludingText":"2026-09-16T15:24:21Z"}
