ate":"OH"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-19","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-25","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"H001068","fullName":"Rep. Huffman, Jared [D-CA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-12","sponsorshipWithdrawnDate":null,"state":"KY"}],"fetchedAt":"2026-09-16T20:03:48+00:00","id":"hr1648-119","introducedDate":"2025-02-27","latestAction":{"actionDate":"2025-03-28","text":"Referred to the Subcommittee on Livestock, Dairy, and Poultry."},"laws":[],"number":"1648","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"A000379","district":4,"fullName":"Rep. Alford, Mark [R-MO-4]","party":"R","state":"MO"}],"summaries":[{"actionDate":"2025-02-27","actionDesc":"Introduced in House","text":"<p><strong>Amplifying Processing of Livestock in the United States Act or the A–PLUS Act</strong></p><p>This bill directs the Department of Agriculture&nbsp;(USDA) to revise its regulations to allow certain packers to hold an ownership interest in, finance, or participate in the management or operation of a market agency selling livestock on a commission basis.</p><p>The bill applies to packers that have a cumulative slaughter capacity of (1) less than 2,000 animals per day or 700,000 animals per year with respect to cattle or sheep, and (2) less than 10,000 animals per day or 3 million animals per year with respect to hogs.</p><p>In addition,&nbsp;USDA must revise its regulations to&nbsp;include a disclosure requirement for a market agency that has an ownership interest in, finances, or participates in the management or operation of a packer. Specifically, the market agency must disclose the existence of such ownership interest, financial relationship, or participation.</p>","updateDate":"2025-05-09T13:52:35Z","versionCode":"00"}],"title":"A–PLUS Act","type":"hr","updateDate":"2026-03-13T08:05:35Z","updateDateIncludingText":"2026-03-13T08:05:35Z"}
