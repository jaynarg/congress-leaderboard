orshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"F000446","fullName":"Rep. Feenstra, Randy [R-IA-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-21","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"V000135","fullName":"Rep. Van Orden, Derrick [R-WI-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-28","sponsorshipWithdrawnDate":null,"state":"WI"}],"fetchedAt":"2026-11-13T17:27:47+00:00","id":"hr2596-119","introducedDate":"2025-04-02","latestAction":{"actionDate":"2025-04-02","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"2596","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"F000466","district":1,"fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","party":"R","state":"PA"}],"summaries":[{"actionDate":"2025-04-02","actionDesc":"Introduced in House","text":"<p><strong>Renewable Natural Gas Incentive Act of 2025</strong></p><p>This bill establishes a federal tax credit, through 2035, equal to $1 for each gallon of renewable natural gas (compressed or liquified gas derived from biomass)&nbsp;or gasoline gallon equivalent of a nonliquid renewable natural gas&nbsp;used or sold for use as a fuel in a motor vehicle, a motorboat, or in aviation. Under the bill, a <em>gasoline gallon equivalent&nbsp;</em>of a nonliquid renewable natural gas&nbsp;is the amount of the fuel that has a Btu content of 124,800 (higher heating value). Specific registration and other conditions apply.</p>","updateDate":"2026-11-12T20:42:24Z","versionCode":"00"}],"title":"Renewable Natural Gas Incentive Act of 2025","type":"hr","updateDate":"2026-11-12T20:44:35Z","updateDateIncludingText":"2026-11-12T20:44:35Z"}
