sorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"P000613","fullName":"Rep. Panetta, Jimmy [D-CA-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-04","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000478","fullName":"Rep. Tenney, Claudia [R-NY-24]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-07","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"M001222","fullName":"Rep. Miller, Max L. [R-OH-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-08","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"V000133","fullName":"Rep. Van Drew, Jefferson [R-NJ-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"M000871","fullName":"Rep. Mann, Tracey [R-KS-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-19","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-24","sponsorshipWithdrawnDate":null,"state":"KY"}],"fetchedAt":"2026-09-16T19:39:54+00:00","id":"hr1177-119","introducedDate":"2025-02-10","latestAction":{"actionDate":"2025-02-10","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"1177","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"S001199","district":11,"fullName":"Rep. Smucker, Lloyd [R-PA-11]","party":"R","state":"PA"}],"summaries":[{"actionDate":"2025-02-10","actionDesc":"Introduced in House","text":"<p><strong>Improve and Enhance the Work Opportunity Tax Credit Act </strong></p><p>This bill increases the work opportunity tax credit (WOTC) for wages paid during the first year of employment to certain employees. The bill also eliminates the maximum age limit applicable to Supplemental Nutrition Assistance Program (SNAP) benefit recipients for purposes of the WOTC.</p><p>Under current law, an employer generally may claim a WOTC in the amount of 40% of up to $6,000 (or of up to $24,000 for certain veterans, $3,000 for summer youth employees, and $10,000 for long-term family aid recipients) of qualified wages paid during the first year of employment to an employee who is a member of a targeted group. (Exceptions and limitations apply.)</p><p>The bill increases the WOTC to (1) 50% of up to $6,000 (or of up to $24,000 for certain veterans) of qualified first-year wages paid to an employee who is a member of a targeted group (other than a summer youth employee or recipient of long-term family aid), and (2) 50% of up to $12,000 (or of up to $48,000 for certain veterans) of qualified wages paid during the first year of employment to such employee if the employee works at least 400 hours during the year.</p><p>Finally, the bill eliminates the maximum age limit applicable to SNAP benefit recipients and, thus, allows an employer to claim the&nbsp;WOTC for qualified first-year wages paid to an employee who is at least 18 years old and&nbsp;receiving SNAP benefits for a certain period of time.</p>","updateDate":"2025-09-23T12:59:41Z","versionCode":"00"}],"title":"Improve and Enhance the Work Opportunity Tax Credit Act","type":"hr","updateDate":"2026-08-25T08:05:48Z","updateDateIncludingText":"2026-08-25T08:05:48Z"}
