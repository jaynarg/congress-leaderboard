":"TN"},{"bioguideId":"F000475","fullName":"Rep. Finstad, Brad [R-MN-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"C000059","fullName":"Rep. Calvert, Ken [R-CA-41]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000470","fullName":"Rep. Fischbach, Michelle [R-MN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"B001260","fullName":"Rep. Buchanan, Vern [R-FL-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"F000471","fullName":"Rep. Fitzgerald, Scott [R-WI-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"S001199","fullName":"Rep. Smucker, Lloyd [R-PA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-16T19:07:12+00:00","id":"hr523-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-01-16","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"523","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"M001222","district":7,"fullName":"Rep. Miller, Max L. [R-OH-7]","party":"R","state":"OH"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in House","text":"<p><strong>Permanent Tax Cuts for American Families Act of 2025 </strong></p><p>This bill makes permanent the increased standard tax deduction amounts enacted in 2017 as part of the Tax Cuts and Jobs Act. </p><p>Under current law, the standard tax deduction consists of a statutory base amount that is adjusted annually for inflation. For tax years 2018-2025, the Tax Cuts and Jobs Act increased the standard tax deduction statutory base amounts to $24,000 (from $6,000) for joint filers, $18,000 (from $4,400) for head-of-household filers, and $12,000 (from $3,000) for single filers, which almost doubled the inflation-adjusted standard tax deduction amount for most taxpayers.</p><p>Under the bill, the increased standard tax deduction statutory base amounts of $24,000 for joint filers, $18,000 for head-of-household filers, and $12,000 for single filers are made permanent. The bill also makes permanent the annual adjustments to such amounts for inflation.</p>","updateDate":"2025-04-09T16:44:13Z","versionCode":"00"}],"title":"Permanent Tax Cuts for American Families Act of 2025","type":"hr","updateDate":"2025-09-14T18:49:26Z","updateDateIncludingText":"2025-09-14T18:49:26Z"}
