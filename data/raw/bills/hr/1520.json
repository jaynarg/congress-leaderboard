orshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"H001086","fullName":"Rep. Harshbarger, Diana [R-TN-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"C001078","fullName":"Rep. Connolly, Gerald E. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"B000740","fullName":"Rep. Bice, Stephanie I. [R-OK-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-30","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-07","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000804","fullName":"Rep. Wittman, Robert J. [R-VA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-08","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"H001090","fullName":"Rep. Harder, Josh [D-CA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-13","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-13","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M001223","fullName":"Rep. Magaziner, Seth [D-RI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-13","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-13","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"G000597","fullName":"Rep. Garbarino, Andrew R. [R-NY-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-13","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T19:57:01+00:00","id":"hr1520-119","introducedDate":"2025-02-24","latestAction":{"actionDate":"2025-06-24","text":"Received in the Senate and Read twice and referred to the Committee on Health, Education, Labor, and Pensions."},"laws":[],"number":"1520","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"C001039","district":3,"fullName":"Rep. Cammack, Kat [R-FL-3]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-02-24","actionDesc":"Introduced in House","text":"<p><strong>Charlotte Woodward Organ Transplant Discrimination Prevention Act</strong></p><p>This bill expressly prohibits health care providers and other entities involved in matching donated organs with recipients from denying or restricting an individual's access to organ transplants solely on the basis of the individual's disability, except in limited circumstances.</p><p>Specifically, these entities may consider an individual's disability when making decisions about transplants only if a physician finds, based on an individualized evaluation, that the individual's physical or mental disability is medically significant to the provision of the transplant. A disability shall not be considered medically significant if the individual has an adequate support system in place to comply with transplant-related medical requirements.</p><p>These entities must also make reasonable changes to their policies to make transplants and related care more available to individuals with disabilities.</p><p>Aggrieved individuals may bring claims of discrimination to the Office of Civil Rights of the Department of Health and Human Services. The bill provides for expedited resolutions of these claims.</p><p>In addition, the board of directors of the Organ Procurement and Transplantation Network may not issue policies that prohibit or hinder access to an organ transplant based solely on the individual's disability. This network is a public-private partnership linking professionals involved in the U.S. organ donation and transplantation system.&nbsp;</p>","updateDate":"2025-06-18T18:11:02Z","versionCode":"00"}],"title":"Charlotte Woodward Organ Transplant Discrimination Prevention Act","type":"hr","updateDate":"2026-09-02T04:26:25Z","updateDateIncludingText":"2026-09-02T04:26:25Z"}
