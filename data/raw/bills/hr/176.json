lName":"Rep. LaMalfa, Doug [R-CA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-06","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"O000019","fullName":"Rep. Obernolte, Jay [R-CA-23]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-06","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"R000395","fullName":"Rep. Rogers, Harold [R-KY-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-07","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-07","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-07","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"G000576","fullName":"Rep. Grothman, Glenn [R-WI-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"S001224","fullName":"Rep. Self, Keith [R-TX-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M000871","fullName":"Rep. Mann, Tracey [R-KS-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-14","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"H001100","fullName":"Rep. Hurd, Jeff [R-CO-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"S001212","fullName":"Rep. Stauber, Pete [R-MN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"C001118","fullName":"Rep. Cline, Ben [R-VA-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-20T13:53:40+00:00","id":"hr176-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-12-02","text":"Received in the Senate and Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"176","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"M001177","district":5,"fullName":"Rep. McClintock, Tom [R-CA-5]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>No Immigration Benefits for Hamas Terrorists Act</strong></p><p>This bill imposes immigration-related penalties on certain non-U.S. nationals (<em>aliens</em> under federal law) who are involved with terrorism or attacks against Israel.</p><p>Under this bill, members of Palestinian Islamic Jihad or Hamas or individuals who participated in or otherwise facilitated the October 7, 2023, attacks on Israel may not be admitted into the United States.</p><p>The bill also expands an existing admissions bar against officers, representatives, and spokespersons of the Palestinian Liberation Organization (PLO). Under this bill, all PLO members are barred from admission into the United States.</p><p>The bill also prohibits any non-U.S. national who participated in or otherwise facilitated the October 7, 2023, attacks from seeking any immigration-related relief or protections, including (1) protection from being deported to a country where the individual's life or freedom would be threatened, or (2) asylum in the United States.</p><p>The Department of Homeland Security must annually report to Congress the number of individuals found to be inadmissible or deportable due to their participation in or facilitation of the attacks.</p>","updateDate":"2025-02-25T14:51:06Z","versionCode":"00"}],"title":"No Immigration Benefits for Hamas Terrorists Act of 2025","type":"hr","updateDate":"2026-09-19T23:07:45Z","updateDateIncludingText":"2026-09-19T23:07:45Z"}
