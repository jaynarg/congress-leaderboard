osponsor":false,"party":"R","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"I000058","fullName":"Rep. Ivey, Glenn [D-MD-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"E000300","fullName":"Rep. Evans, Gabe [R-CO-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-03","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"P000609","fullName":"Rep. Palmer, Gary J. [R-AL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-03","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"A000380","fullName":"Rep. Amo, Gabe [D-RI-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-04","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-10","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001241","fullName":"Rep. Min, Dave [D-CA-47]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000558","fullName":"Rep. Guthrie, Brett [R-KY-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-03","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"G000604","fullName":"Rep. Goodlander, Maggie [D-NH-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"NH"}],"fetchedAt":"2026-09-20T14:21:47+00:00","id":"hr2978-119","introducedDate":"2025-04-21","latestAction":{"actionDate":"2026-09-16","text":"Received in the Senate. Read twice. Placed on Senate Legislative Calendar under General Orders. Calendar No. 627."},"laws":[],"number":"2978","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"N000193","district":3,"fullName":"Rep. Nunn, Zachary [R-IA-3]","party":"R","state":"IA"}],"summaries":[{"actionDate":"2026-06-24","actionDesc":"Reported to House","text":"<p><strong>Guarding Unprotected Aging Retirees from Deception Act of 2026 or the GUARD Act of 2026<br/></strong></p><p>This bill allows state, local, and tribal law enforcement agencies and grantees that receive funds from certain law enforcement grant programs to use the funds to investigate general financial fraud, elder financial fraud, and pig butchering. <em>Pig butchering</em> refers to a confidence and investment fraud in which a victim is gradually lured into transferring increasing amounts of money, generally in the form of cryptocurrency, into a fake virtual investment.&nbsp;</p><p>The bill allows federal law enforcement agencies to assist state, local, and tribal law enforcement agencies and fusion centers in the use of tracing tools for blockchain and related technology tools.</p><p>Finally, the bill requires the Financial Crimes Enforcement Network (FinCEN) to report on efforts  to combat general financial fraud, elder financial fraud, pig butchering, and scams, including an evaluation of any legislative recommendations to improve the efforts. The bill also requires FinCEN to report on the state of&nbsp;general financial fraud, elder financial fraud, pig butchering, and scams in the United States, including trends in the crimes.</p>","updateDate":"2026-07-21T17:19:14Z","versionCode":"07"}],"title":"GUARD Act","type":"hr","updateDate":"2026-09-19T23:40:47Z","updateDateIncludingText":"2026-09-19T23:40:47Z"}
