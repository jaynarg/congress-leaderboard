{"actions":[{"actionCode":"H11100","actionDate":"2025-03-06","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-03-06","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-03-06","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1942","cosponsors":[{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-03-06","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"N000193","fullName":"Rep. Nunn, Zachary [R-IA-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-01","sponsorshipWithdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-11-09T20:18:08+00:00","id":"hr1942-119","introducedDate":"2025-03-06","latestAction":{"actionDate":"2025-03-06","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"1942","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"M001206","district":25,"fullName":"Rep. Morelle, Joseph D. [D-NY-25]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-03-06","actionDesc":"Introduced in House","text":"<p><strong>Delivering Elderly Lunches and Increasing Volunteer Engagement and Reimbursements Act of 2025 or the DELIVER Act of 2025</strong></p><p>This bill increases the standard mileage rate used in calculating the federal tax deduction for the charitable use of a passenger automobile to deliver meals to homebound individuals who are elderly, disabled, frail, or at risk. The bill increases the rate from the standard charitable rate of 14 cents per mile to the standard business mileage rate, which is 70 cents per mile for 2025.</p>","updateDate":"2026-11-09T15:10:15Z","versionCode":"00"}],"title":"DELIVER Act of 2025","type":"hr","updateDate":"2026-11-09T15:13:08Z","updateDateIncludingText":"2026-11-09T15:13:08Z"}
