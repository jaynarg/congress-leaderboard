orshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"L000566","fullName":"Rep. Latta, Robert E. [R-OH-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"V000131","fullName":"Rep. Veasey, Marc A. [D-TX-33]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-17","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"T000487","fullName":"Rep. Tokuda, Jill N. [D-HI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"N000002","fullName":"Rep. Nadler, Jerrold [D-NY-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-15","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-02","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T18:57:31+00:00","id":"hr330-119","introducedDate":"2025-01-09","latestAction":{"actionDate":"2025-01-09","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"330","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"W000804","district":1,"fullName":"Rep. Wittman, Robert J. [R-VA-1]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2025-01-09","actionDesc":"Introduced in House","text":"<p><strong>Organ Donation Referral Improvement Act</strong></p><p>This bill requires the&nbsp;Office of the Assistant Secretary for Planning and Evaluation (ASPE) in the&nbsp;Department of Health and Human Services to conduct a study on hospitals’ use of electronic automated referrals for organ donations. The bill defines <em>electronic automated referral</em> as an electronic system that uses electronic health records to identify patients who are potential organ donors and automatically refers those patients to organ procurement organizations.&nbsp;</p><p>The ASPE must include specified components in the study, including identifying benefits, reviewing best practices, and developing recommendations for the use of electronic automated referrals for organ donations. </p>","updateDate":"2025-03-13T19:06:30Z","versionCode":"00"}],"title":"Organ Donation Referral Improvement Act","type":"hr","updateDate":"2026-07-18T00:04:23Z","updateDateIncludingText":"2026-07-18T00:04:23Z"}
