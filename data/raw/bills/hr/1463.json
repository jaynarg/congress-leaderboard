{"actions":[{"actionCode":"H11100","actionDate":"2025-02-21","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-21","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-21","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1463","cosponsors":[{"bioguideId":"C001120","fullName":"Rep. Crenshaw, Dan [R-TX-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001215","fullName":"Rep. Miller-Meeks, Mariannette [R-IA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"W000814","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-27","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"P000048","fullName":"Rep. Pfluger, August [R-TX-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-04","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"D000628","fullName":"Rep. Dunn, Neal P. [R-FL-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-21","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-01","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"G000601","fullName":"Rep. Goldman, Craig A. [R-TX-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-08","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T19:54:20+00:00","id":"hr1463-119","introducedDate":"2025-02-21","latestAction":{"actionDate":"2025-02-21","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1463","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"F000475","district":1,"fullName":"Rep. Finstad, Brad [R-MN-1]","party":"R","state":"MN"}],"summaries":[{"actionDate":"2025-02-21","actionDesc":"Introduced in House","text":"<p>This bill prohibits the use of federal funds to implement, administer, or enforce the final rule issued by the Food and Drug Administration (FDA) titled <em>Medical Devices; Laboratory Developed Tests</em> and published on May 6, 2024, or any substantially similar rule.&nbsp;</p><p>The rule specifies that laboratory developed tests&nbsp;(medical screening tests developed by laboratories rather than medical device manufacturers) are medical devices subject to FDA regulation with limited exceptions. Prior to the rule, the FDA had exercised discretion as to whether to apply regulations for medical devices to laboratory developed tests.</p>","updateDate":"2025-05-07T19:34:56Z","versionCode":"00"}],"title":"To prohibit the use of Federal funds to implement, administer, or enforce a final rule of the Food and Drug Administration relating to \"Medical Devices; Laboratory Developed Tests\", and for other purposes.","type":"hr","updateDate":"2025-08-09T08:05:49Z","updateDateIncludingText":"2025-08-09T08:05:49Z"}
