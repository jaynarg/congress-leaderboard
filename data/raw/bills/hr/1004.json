D-MA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-15","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"D000197","fullName":"Rep. DeGette, Diana [D-CO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-15","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"H001091","fullName":"Rep. Hinson, Ashley [R-IA-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-15","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"M001231","fullName":"Rep. Mannion, John W. [D-NY-22]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"V000136","fullName":"Rep. Vasquez, Gabe [D-NM-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-17","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"H001099","fullName":"Rep. Haridopolos, Mike [R-FL-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-20","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"L000560","fullName":"Rep. Larsen, Rick [D-WA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"WA"}],"fetchedAt":"2026-09-16T19:31:27+00:00","id":"hr1004-119","introducedDate":"2025-02-05","latestAction":{"actionDate":"2026-03-26","text":"Forwarded by Subcommittee to Full Committee by Voice Vote."},"laws":[],"number":"1004","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"H001067","district":9,"fullName":"Rep. Hudson, Richard [R-NC-9]","party":"R","state":"NC"}],"summaries":[{"actionDate":"2025-02-05","actionDesc":"Introduced in House","text":"<p><strong>Love Lives On Act of 2025</strong></p><p>This bill extends entitlement for various benefit programs and services for surviving spouses of deceased members of the Armed Forces or veterans.</p><p>The bill provides that the remarriage of a surviving spouse must not bar the furnishing of dependency and indemnity compensation or special pension benefits to such spouse.</p><p>Additionally, the Department of Defense may not terminate the payment of an annuity for a surviving spouse under the Survivor Benefit Plan solely because the surviving spouse remarries.</p><p>The bill also expands the definition of a dependent under TRICARE to include a remarried widow or widower whose subsequent marriage has ended due to death, divorce, or annulment.</p>","updateDate":"2025-04-29T21:14:56Z","versionCode":"00"}],"title":"Love Lives On Act of 2025","type":"hr","updateDate":"2026-09-11T08:05:41Z","updateDateIncludingText":"2026-09-11T08:05:41Z"}
