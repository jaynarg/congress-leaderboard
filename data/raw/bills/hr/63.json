{"actions":[{"actionCode":"H11100","actionDate":"2025-01-03","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-03","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-03","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/63","cosponsors":[{"bioguideId":"C001132","fullName":"Rep. Crane, Elijah [R-AZ-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-03","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-03","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"L000596","fullName":"Rep. Luna, Anna Paulina [R-FL-13]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-03","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-16T18:39:39+00:00","id":"hr63-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-01-03","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"63","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"B001302","district":5,"fullName":"Rep. Biggs, Andy [R-AZ-5]","party":"R","state":"AZ"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>Accountability for Lawless Violence In our Neighborhoods Act or the ALVIN Act</strong></p><p>This bill prohibits federal funds from being awarded or otherwise made available to the Manhattan District Attorney’s Office in New York.&nbsp;</p><p>The bill also (1) rescinds any unobligated funds that were allocated for or otherwise made available to the office, and (2) directs the Department of Justice to require the