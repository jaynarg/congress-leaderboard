te":"TN"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-10","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"M001137","fullName":"Rep. Meeks, Gregory W. [D-NY-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"T000482","fullName":"Rep. Trahan, Lori [D-MA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"B001285","fullName":"Rep. Brownley, Julia [D-CA-26]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"N000002","fullName":"Rep. Nadler, Jerrold [D-NY-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"E000299","fullName":"Rep. Escobar, Veronica [D-TX-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-03","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-10-15T14:33:48+00:00","id":"hr2762-119","introducedDate":"2025-04-09","latestAction":{"actionDate":"2025-04-09","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"2762","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"D000629","district":3,"fullName":"Rep. Davids, Sharice [D-KS-3]","party":"D","state":"KS"}],"summaries":[{"actionDate":"2025-04-09","actionDesc":"Introduced in House","text":"<p><strong>Expanding Access to Family Planning Act</strong></p><p>This bill provides, subject to specified conditions, funding through FY2035 for federally funded family planning services and clinics.</p><p>In particular, the funds must be used for (1) grants and contracts that support the provision of family planning services, and (2) clinic infrastructure (e.g., construction and renovation of clinics).</p><p>Clinics that receive funding to provide family planning services must offer each patient with a positive pregnancy test the opportunity for nondirective counseling on (1) prenatal care and delivery; (2) infant care, foster care, and adoption; and (3) pregnancy termination. This counseling must include referrals if requested by a patient.</p><p>Additionally, if a funding recipient makes subawards for the provision of family planning services, the recipient may not prohibit an entity from participating in a subaward program for reasons other than the entity's inability to provide family planning services.</p>","updateDate":"2026-10-14T19:03:00Z","versionCode":"00"}],"title":"Expanding Access to Family Planning Act","type":"hr","updateDate":"2026-10-14T19:04:42Z","updateDateIncludingText":"2026-10-14T19:04:42Z"}
