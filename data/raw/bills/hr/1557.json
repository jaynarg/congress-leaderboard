{"actions":[{"actionCode":"H11100","actionDate":"2025-02-25","source":"House floor actions","text":"Referred to the House Committee on Education and Workforce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-25","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-25","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1557","cosponsors":[{"bioguideId":"F000462","fullName":"Rep. Frankel, Lois [D-FL-22]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001081","fullName":"Rep. Hayes, Jahana [D-CT-5]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"T000468","fullName":"Rep. Titus, Dina [D-NV-1]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-20","sponsorshipWithdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-09-16T19:58:45+00:00","id":"hr1557-119","introducedDate":"2025-02-25","latestAction":{"actionDate":"2025-02-25","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"1557","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"C001117","district":6,"fullName":"Rep. Casten, Sean [D-IL-6]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-02-25","actionDesc":"Introduced in House","text":"<p><strong>Stop Sexual Harassment in K-12 Act</strong></p><p>This bill outlines the role and duties of Title IX coordinators in elementary and secondary schools, including by requiring local educational agencies to increase the number of full-time employees designated to serve as a Title IX coordinator per specified student population. The bill also creates a grant program to train teachers and staff on how to respond to signs of sex-based&nbsp;harassment and assault of students and requires the Department of Education to develop a sex-based harassment&nbsp;survey.</p>","updateDate":"2025-05-07T19:05:50Z","versionCode":"00"}],"title":"Stop Sexual Harassment in K–12 Act","type":"hr","updateDate":"2026-07-17T23:34:37Z","updateDateIncludingText":"2026-07-17T23:34:37Z"}
