{"actions":[{"actionCode":"H11000","actionDate":"2026-04-27","source":"House committee actions","text":"Referred to the Subcommittee on Oversight and Investigations.","type":"Committee"},{"actionCode":"H11100","actionDate":"2026-04-06","source":"House floor actions","text":"Referred to the House Committee on Veterans' Affairs.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2026-04-06","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2026-04-06","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/8199","cosponsors":[{"bioguideId":"P000613","fullName":"Rep. Panetta, Jimmy [D-CA-19]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-06","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"P000622","fullName":"Rep. Patronis, Jimmy [R-FL-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-04-06","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001219","fullName":"Del. Moylan, James C. [R-GU-At Large]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-04-06","sponsorshipWithdrawnDate":null,"state":"GU"},{"bioguideId":"D000628","fullName":"Rep. Dunn, Neal P. [R-FL-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001220","fullName":"Rep. McGarvey, Morgan [D-KY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"R000609","fullName":"Rep. Rutherford, John H. [R-FL-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"W000830","fullName":"Rep. Whitesides, George [D-CA-27]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000565","fullName":"Rep. Gosar, Paul A. [R-AZ-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-14","sponsorshipWithdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-09-17T03:37:09+00:00","id":"hr8199-119","introducedDate":"2026-04-06","latestAction":{"actionDate":"2026-04-27","text":"Referred to the Subcommittee on Oversight and Investigations."},"laws":[],"number":"8199","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"F000472","district":18,"fullName":"Rep. Franklin, Scott [R-FL-18]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2026-04-06","actionDesc":"Introduced in House","text":"<p><strong>Scheduling for Community Health and Easy Data to Understand for Legislators to Evaluate Services Act of 2026 or the SCHEDULES Act of 2026</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to establish a standard for timing between the date on which a referral for VA care is entered into the VA's system and the date on which an appointment for care occurs, whether at a VA facility or through care in the community.</p><p>The VA must publish the standard in the Federal Register and on a publicly accessible VA website. Additionally, the VA must submit a report at least quarterly on the number and percentage of referrals that meet the new timing standard.</p>","updateDate":"2026-05-06T14:43:12Z","versionCode":"00"}],"title":"SCHEDULES Act of 2026","type":"hr","updateDate":"2026-07-17T23:53:35Z","updateDateIncludingText":"2026-07-17T23:53:35Z"}
