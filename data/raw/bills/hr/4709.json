{"actions":[{"actionCode":"H23000","actionDate":"2025-09-10","source":"House committee actions","text":"Forwarded by Subcommittee to Full Committee by Voice Vote.","type":"Committee"},{"actionCode":"H22000","actionDate":"2025-09-10","source":"House committee actions","text":"Subcommittee Consideration and Mark-up Session Held","type":"Committee"},{"actionCode":"H11000","actionDate":"2025-09-10","source":"House committee actions","text":"Referred to the Subcommittee on Health.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-07-23","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-07-23","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-07-23","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/4709","cosponsors":[{"bioguideId":"S001148","fullName":"Rep. Simpson, Michael K. [R-ID-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"S001216","fullName":"Rep. Schrier, Kim [D-WA-8]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"L000600","fullName":"Rep. Langworthy, Nicholas A. [R-NY-23]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001211","fullName":"Rep. Stanton, Greg [D-AZ-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-15","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-21","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"A000148","fullName":"Rep. Auchincloss, Jake [D-MA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"B001315","fullName":"Rep. Budzinski, Nikki [D-IL-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-20T14:35:32+00:00","id":"hr4709-119","introducedDate":"2025-07-23","latestAction":{"actionDate":"2025-09-10","text":"Forwarded by Subcommittee to Full Committee by Voice Vote."},"laws":[],"number":"4709","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"M001234","district":3,"fullName":"Rep. Morrison, Kelly [D-MN-3]","party":"D","state":"MN"}],"summaries":[{"actionDate":"2025-07-23","actionDesc":"Introduced in House","text":"<p><strong>Newborn Screening Saves Lives Reauthorization Act of 2025</strong></p><p>This bill reauthorizes through FY2030 and revises several programs and activities relating to newborn screening for certain conditions and  diseases.</p><p>Among its changes, the bill reauthorizes and makes mandatory</p><ul><li>the Hunter Kelly Research Program at the National Institutes of Health, and</li><li>national surveillance activities conducted by the Centers for Disease Control and Prevention.</li></ul><p>The bill also provides statutory authority for current regulations that exempt federally funded research on non-identified newborn blood spots (i.e., residual blood samples used to screen for serious conditions) from regulations that govern research on human subjects. </p>","updateDate":"2026-06-15T20:19:00Z","versionCode":"00"}],"title":"Newborn Screening Saves Lives Reauthorization Act of 2025","type":"hr","updateDate":"2026-09-19T23:10:32Z","updateDateIncludingText":"2026-09-19T23:10:32Z"}
