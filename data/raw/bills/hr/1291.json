ithdrawnDate":null,"state":"HI"},{"bioguideId":"H001047","fullName":"Rep. Himes, James A. [D-CT-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-19","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"T000468","fullName":"Rep. Titus, Dina [D-NV-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-08","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-19","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"L000590","fullName":"Rep. Lee, Susie [D-NV-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-23","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001260","fullName":"Rep. Buchanan, Vern [R-FL-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"F000477","fullName":"Rep. Foushee, Valerie P. [D-NC-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-13","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"F000481","fullName":"Rep. Figures, Shomari [D-AL-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-11","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"IN"}],"fetchedAt":"2026-10-07T17:06:43+00:00","id":"hr1291-119","introducedDate":"2025-02-13","latestAction":{"actionDate":"2025-02-13","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1291","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"C000059","district":41,"fullName":"Rep. Calvert, Ken [R-CA-41]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-02-13","actionDesc":"Introduced in House","text":"<p><strong>Humane and Existing Alternatives in Research and Testing Sciences Act of 2025 or the HEARTS Act of 2025</strong></p><p>This bill establishes a center within the National Institutes of Health (NIH) and requires other activities to promote alternatives to using animals in research and testing.</p><p>The duties of the center include developing nonanimal research models (e.g., advanced cell cultures, advanced imaging systems) and training scientists about the methods.</p><p>Additionally, if an agency or other entity conducting federally funded research uses animals for research and testing, it must develop and update a plan for reducing such use and periodically report to the center the number and types of animals it uses.</p><p>The NIH must also provide incentives for the use of nonanimal research and generally ensure that nonanimal alternatives are considered when reviewing research proposals. Further, applications for NIH research grants must include an assurance that nonanimal methods for carrying out the research are unavailable.</p><p>&nbsp;</p>","updateDate":"2026-10-06T19:55:19Z","versionCode":"00"}],"title":"HEARTS Act of 2025","type":"hr","updateDate":"2026-10-06T19:56:05Z","updateDateIncludingText":"2026-10-06T19:56:05Z"}
