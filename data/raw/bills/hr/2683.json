riginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"J000309","fullName":"Rep. Jackson, Jonathan L. [D-IL-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"T000478","fullName":"Rep. Tenney, Claudia [R-NY-24]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"K000397","fullName":"Rep. Kim, Young [R-CA-40]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001322","fullName":"Rep. Baumgartner, Michael [R-WA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-08","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-04","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"A000380","fullName":"Rep. Amo, Gabe [D-RI-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-15","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-10","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"L000590","fullName":"Rep. Lee, Susie [D-NV-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"S001224","fullName":"Rep. Self, Keith [R-TX-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T20:51:16+00:00","id":"hr2683-119","introducedDate":"2025-04-07","latestAction":{"actionDate":"2026-01-13","text":"Received in the Senate and Read twice and referred to the Committee on Banking, Housing, and Urban Affairs."},"laws":[],"number":"2683","originChamber":"House","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"L000599","district":17,"fullName":"Rep. Lawler, Michael [R-NY-17]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-04-07","actionDesc":"Introduced in House","text":"<p><strong>Remote Access Security Act</strong></p><p>This bill broadens the scope of the U.S. export control system to include remote access of items. <em>Remote access</em> means (1) access to an item subject to the jurisdiction of the United States by a foreign person through a network connection, including the internet or a cloud computing service, from a location other than where the item is physically located; or (2) any other form of access specified in regulations promulgated by the Department of Commerce.</p><p>The Export Control Reform Act of 2018 (ECRA), which is implemented through the Export Administration Regulations, provides a permanent statutory basis for controlling the export of dual-use goods (e.g., items with both civilian and military uses) and certain military&nbsp;parts and components. This bill applies export controls under&nbsp;ECRA to remote access of items, thereby allowing Commerce's Bureau of Industry and Security to issue licenses and impose penalties related to remote access of controlled items.</p>","updateDate":"2026-01-12T13:50:38Z","versionCode":"00"}],"title":"Remote Access Security Act","type":"hr","updateDate":"2026-01-15T04:08:18Z","updateDateIncludingText":"2026-07-13T20:09:53Z"}
