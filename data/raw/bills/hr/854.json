wnDate":null,"state":"TX"},{"bioguideId":"L000602","fullName":"Rep. Lee, Summer L. [D-PA-12]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"S001215","fullName":"Rep. Stevens, Haley M. [D-MI-11]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S001145","fullName":"Rep. Schakowsky, Janice D. [D-IL-9]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"E000296","fullName":"Rep. Evans, Dwight [D-PA-3]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"R000579","fullName":"Rep. Ryan, Patrick [D-NY-18]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"P000620","fullName":"Rep. Pettersen, Brittany [D-CO-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"L000582","fullName":"Rep. Lieu, Ted [D-CA-36]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"O000173","fullName":"Rep. Omar, Ilhan [D-MN-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"L000593","fullName":"Rep. Levin, Mike [D-CA-49]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T19:23:49+00:00","id":"hr854-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-02-01","text":"Referred to the Subcommittee on Railroads, Pipelines, and Hazardous Materials."},"laws":[],"number":"854","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"D000530","district":17,"fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","party":"D","state":"PA"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><strong>Decreasing Emergency Railroad Accident Instances Locally Act or the DERAIL Act</strong></p><p>This bill requires the Department of Transportation (DOT) to expand the definition of a high-hazard flammable train (HHFT), thereby subjecting more trains to additional safety requirements.</p><p>Specifically, DOT must expand the definition of <em>HHFT </em>to mean a train transporting one or more loaded tank cars of a Class 3 flammable liquid (e.g., benzene residue) or a Class 2 flammable gas (e.g., vinyl chloride) and other materials DOT determines necessary for safety. Current regulations define <em>HHFT </em>as a train transporting 20 or more loaded tank cars of a Class 3 flammable liquid in a continuous block or 35 or more loaded tank cars of a Class 3 flammable liquid dispersed throughout the train.</p><p>The bill also requires railway carriers to report a train derailment that involves a train carrying material toxic by inhalation within 24 hours of the derailment to the National Response Center (NRC), state and local officials, and tribal governments. As background, the NRC is a part of the federally established National Response System. Reports to the NRC activate&nbsp;the National Oil and Hazardous Substances Pollution Contingency Plan and the federal government's response capabilities.</p>","updateDate":"2025-03-25T13:10:55Z","versionCode":"00"}],"title":"DERAIL Act","type":"hr","updateDate":"2025-03-25T13:11:41Z","updateDateIncludingText":"2025-03-25T13:11:41Z"}
