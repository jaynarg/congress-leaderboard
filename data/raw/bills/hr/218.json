{"actions":[{"actionCode":"H11100","actionDate":"2025-01-07","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/218","cosponsors":[{"bioguideId":"M000194","fullName":"Rep. Mace, Nancy [R-SC-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-07","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"L000596","fullName":"Rep. Luna, Anna Paulina [R-FL-13]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-07","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-20","sponsorshipWithdrawnDate":null,"state":"OK"}],"fetchedAt":"2026-09-16T18:47:29+00:00","id":"hr218-119","introducedDate":"2025-01-07","latestAction":{"actionDate":"2025-01-07","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"218","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"B001302","district":5,"fullName":"Rep. Biggs, Andy [R-AZ-5]","party":"R","state":"AZ"}],"summaries":[{"actionDate":"2025-01-07","actionDesc":"Introduced in House","text":"<p><b>State Immigration Enforcement Act</b></p> <p>This bill authorizes state and local governments to enact and enforce laws that penalize conduct prohibited under federal immigration law. Such state and local laws may only impose civil and criminal penalties that do not exceed the penalties imposed by federal law.</p> <p>The bill also revokes a federal law that preempts (blocks) state and local laws that impose civil or criminal penalties for employing non-U.S. nationals who are not authorized to work in the United States.</p>","updateDate":"2025-02-25T17:28:22Z","versionCode":"00"}],"title":"State Immigration Enforcement Act","type":"hr","updateDate":"2025-11-21T12:04:26Z","updateDateIncludingText":"2025-11-21T12:04:26Z"}
