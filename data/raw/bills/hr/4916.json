hdrawnDate":null,"state":"MI"},{"bioguideId":"T000193","fullName":"Rep. Thompson, Bennie G. [D-MS-2]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-08-05","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"T000468","fullName":"Rep. Titus, Dina [D-NV-1]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-08-05","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"T000481","fullName":"Rep. Tlaib, Rashida [D-MI-12]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-08-05","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"T000469","fullName":"Rep. Tonko, Paul [D-NY-20]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-08-05","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"L000606","fullName":"Rep. Latimer, George [D-NY-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-03","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"M001223","fullName":"Rep. Magaziner, Seth [D-RI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"T000486","fullName":"Rep. Torres, Ritchie [D-NY-15]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-02","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T22:26:20+00:00","id":"hr4916-119","introducedDate":"2025-08-05","latestAction":{"actionDate":"2025-08-05","text":"Referred to the Committee on House Administration, and in addition to the Committee on the Judiciary, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"4916","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"W000788","district":5,"fullName":"Rep. Williams, Nikema [D-GA-5]","party":"D","state":"GA"}],"summaries":[{"actionDate":"2025-08-05","actionDesc":"Introduced in House","text":"<p><strong>Youth Voting Rights Act</strong></p><p>This bill expands voting access for youth.</p><p>Specifically, the bill establishes a private right of action to enforce the Twenty-Sixth Amendment, which prohibits denying or abridging the right to vote based on age. Further, the bill authorizes the Department of Justice to enforce the Twenty-Sixth Amendment against age-based restrictions for voting by mail.</p><p>Additionally, the bill directs each state to</p><ul><li>designate as voter registration agencies all offices within public institutions of higher education (IHEs) that provide assistance to students,</li><li>implement a preregistration process to allow minors&nbsp;who are 16 years&nbsp;or older&nbsp;to register to vote in federal elections that take place&nbsp;when or after&nbsp;the preregistered individual turns age 18, and</li><li>ensure the availability of polling places on campuses of IHEs (with the availability of waivers).</li></ul><p>The bill prohibits durational residency requirements for voting in all federal elections. Currently, this prohibition applies only to voting for the offices of President and Vice President.</p><p>States and local jurisdictions with voter identification requirements must treat IHE-issued student identification cards as voter identification.</p><p>The Election Assistance Commission (EAC) must make grants to states to increase the involvement of individuals under age 18 in public election activities.</p><p>The Government Accountability Office must report to Congress on trends related to voter registration, absentee voting, and provisional voting. The EAC must also collect and make publicly available certain data from states.</p>","updateDate":"2026-02-20T20:30:25Z","versionCode":"00"}],"title":"Youth Voting Rights Act","type":"hr","updateDate":"2026-02-20T20:30:29Z","updateDateIncludingText":"2026-02-20T20:30:29Z"}
