riginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-14","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"S001172","fullName":"Rep. Smith, Adrian [R-NE-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-14","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"Y000067","fullName":"Rep. Yakym, Rudy [R-IN-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"G000590","fullName":"Rep. Green, Mark E. [R-TN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"R000603","fullName":"Rep. Rouzer, David [R-NC-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"R000612","fullName":"Rep. Rose, John W. [R-TN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-10","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"V000133","fullName":"Rep. Van Drew, Jefferson [R-NJ-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-14","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"M001236","fullName":"Rep. Moore, Tim [R-NC-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-08","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-16T18:59:47+00:00","id":"hr377-119","introducedDate":"2025-01-14","latestAction":{"actionDate":"2025-01-14","text":"Referred to the Committee on Oversight and Government Reform, and in addition to the Committee on the Judiciary, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"377","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"B000740","district":5,"fullName":"Rep. Bice, Stephanie I. [R-OK-5]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2025-01-14","actionDesc":"Introduced in House","text":"<p><strong>Regulation Reduction Act of 2025</strong></p><p>This bill requires federal agencies to repeal certain existing rules prior to issuing a new rule.</p><p>Specifically, the bill prohibits an agency from issuing a rule that imposes a cost or responsibility on a nongovernmental person or a state or local government unless it repeals three or more related rules.</p><p>Additionally, an agency may not issue a major rule that imposes such a cost or responsibility unless (1) the agency has repealed three or more related rules, and (2) the cost of the new rule is less than or equal to the cost of the rules being repealed.&nbsp;A&nbsp;<em>major rule</em> is a rule that has resulted in or is likely to result in (1) an annual economic effect of at least $100 million; (2) a major increase in costs or prices for consumers, individual industries, government agencies, or geographic regions; or (3) significant adverse effects on competition, employment, investment, productivity, or innovation.</p><p>Any such repealed rule must be published in the Federal Register.</p><p>This bill does not apply to a rule or major rule that (1) relates to an internal agency policy&nbsp;or practice, (2) relates to&nbsp;procurement, or (3) is being revised to be less burdensome to decrease requirements imposed or compliance costs.</p><p>Additionally, each federal agency must submit to Congress and the Office of Management and Budget a report that includes a review of each rule of the agency and that identifies whether each rule is costly, ineffective, duplicative, or outdated.</p>","updateDate":"2025-04-01T16:23:12Z","versionCode":"00"}],"title":"Regulation Reduction Act of 2025","type":"hr","updateDate":"2026-07-18T00:04:48Z","updateDateIncludingText":"2026-07-18T00:04:48Z"}
