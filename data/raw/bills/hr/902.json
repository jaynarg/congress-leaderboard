,"state":"NY"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-22","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"F000484","fullName":"Rep. Fine, Randy [R-FL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-22","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001224","fullName":"Rep. Moran, Nathaniel [R-TX-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-08","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T19:26:09+00:00","id":"hr902-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"902","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"T000478","district":24,"fullName":"Rep. Tenney, Claudia [R-NY-24]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><strong>Retiring the Egregious Confusion Over the Genuine Name of Israel’s Zone of Influence by Necessitating Government-use of Judea and Samaria Act or the RECOGNIZING Judea and Samaria Act</strong></p><p>This bill prohibits the use of federal funds to prepare or promulgate certain materials (including any policy, guidance, regulation, executive order, or other work products) that refers to Judea and Samaria as the West Bank. The prohibition does not apply to U.S. obligations under international treaties or other agreements.</p><p>The bill also amends certain laws to replace the term <em>the West Bank</em> with <em>Judea and Samaria</em>.</p>","updateDate":"2025-07-12T21:01:17Z","versionCode":"00"}],"title":"RECOGNIZING Judea and Samaria Act","type":"hr","updateDate":"2026-07-17T23:59:44Z","updateDateIncludingText":"2026-07-17T23:59:44Z"}
