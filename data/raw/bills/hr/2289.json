","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"G000601","fullName":"Rep. Goldman, Craig A. [R-TX-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"D000628","fullName":"Rep. Dunn, Neal P. [R-FL-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"O000019","fullName":"Rep. Obernolte, Jay [R-CA-23]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001306","fullName":"Rep. Balderson, Troy [R-OH-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"B001257","fullName":"Rep. Bilirakis, Gus M. [R-FL-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"J000302","fullName":"Rep. Joyce, John [R-PA-13]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"H001086","fullName":"Rep. Harshbarger, Diana [R-TN-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"TN"}],"fetchedAt":"2026-09-16T20:33:08+00:00","id":"hr2289-119","introducedDate":"2025-03-24","latestAction":{"actionDate":"2026-04-15","text":"Placed on the Union Calendar, Calendar No. 532."},"laws":[],"number":"2289","originChamber":"House","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"C001103","district":1,"fullName":"Rep. Carter, Earl L. \"Buddy\" [R-GA-1]","party":"R","state":"GA"}],"summaries":[{"actionDate":"2025-03-24","actionDesc":"Introduced in House","text":"<p><strong>Proportional Reviews for Broadband Deployment Act</strong></p><p>This bill excludes certain requests to modify an existing wireless tower or base station&nbsp;from specified environmental and historic preservation review requirements. Specifically, the bill applies to&nbsp;certain requests to modify an existing wireless tower or base station by collocating, removing, or replacing transmission equipment.</p><p>In particular, the bill specifies that such projects are not considered <em>major federal&nbsp;actions</em> under the National Environmental Policy Act of 1969 or <em>undertakings</em> under the National Historic Preservation Act. This excludes the projects from relevant reviews required under those acts.</p>","updateDate":"2025-11-13T11:31:08Z","versionCode":"00"}],"title":"American Broadband Deployment Act of 2025","type":"hr","updateDate":"2026-07-17T23:29:55Z","updateDateIncludingText":"2026-07-17T23:29:55Z"}
