d":"M000871","fullName":"Rep. Mann, Tracey [R-KS-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"F000459","fullName":"Rep. Fleischmann, Charles J. \"Chuck\" [R-TN-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"S001229","fullName":"Rep. Shreve, Jefferson [R-IN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-12","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-20","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"F000482","fullName":"Rep. Fedorchak, Julie [R-ND-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-26","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"G000600","fullName":"Rep. Perez, Marie Gluesenkamp [D-WA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-04","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"C001103","fullName":"Rep. Carter, Earl L. \"Buddy\" [R-GA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"H001086","fullName":"Rep. Harshbarger, Diana [R-TN-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"C001125","fullName":"Rep. Carter, Troy A. [D-LA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"M001239","fullName":"Rep. McGuire, John J. [R-VA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"O000177","fullName":"Rep. Onder, Robert F. [R-MO-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"E000300","fullName":"Rep. Evans, Gabe [R-CO-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-30","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"H001093","fullName":"Rep. Houchin, Erin [R-IN-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"C000059","fullName":"Rep. Calvert, Ken [R-CA-41]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-11-07T16:02:57+00:00","id":"hr3978-119","introducedDate":"2025-06-12","latestAction":{"actionDate":"2026-11-05","text":"Placed on the Union Calendar, Calendar No. 768."},"laws":[],"number":"3978","originChamber":"House","policyArea":"Energy","sponsors":[{"bioguideId":"L000566","district":5,"fullName":"Rep. Latta, Robert E. [R-OH-5]","party":"R","state":"OH"}],"summaries":[{"actionDate":"2025-06-12","actionDesc":"Introduced in House","text":"<p><em>The following analysis is based on <a href=\"https://docs.house.gov/billsthisweek/20261109/H.R.%203978,%20Nuclear%20REFUEL%20Act.pdf\">draft bill text</a> that was made available by the House of Representatives and may differ from the bill text as introduced.</em></p><p><strong>Nuclear REFUEL (Recycling Efficient Fuels Utilizing Expedited Licensing) Act</strong></p><p>This bill directs the Nuclear Regulatory Commission (NRC) to license future recycling facilities that reprocess certain spent nuclear fuel&nbsp;(i.e., radioactive waste) under&nbsp;<a href=\"https://www.ecfr.gov/current/title-10/chapter-I/part-70\">regulations</a> for special nuclear material rather&nbsp;than <a href=\"https://www.ecfr.gov/current/title-10/chapter-I/part-50\">regulations</a> for production and utilization facilities. The bill applies to domestic facilities that reprocess spent nuclear fuel in a manner that does not isolate plutonium. Generally, such recycling facilities reprocess spent nuclear fuel into materials that may be reused as nuclear fuel for electricity.</p><p>While there are no commercial reprocessing facilities currently operating in the United States, the bill specifies which regulatory framework the NRC must use when issuing licenses to future facilities by excluding such facilities from the statutory definition of <em>production facility</em>. The licensing process under regulations for special nuclear material has&nbsp;fewer steps than the licensing process under regulations for production and utilization facilities.</p>","updateDate":"2026-11-04T20:13:02Z","versionCode":"00"}],"title":"Nuclear REFUEL (Recycling Efficient Fuels Utilizing Expedited Licensing) Act","type":"hr","updateDate":"2026-11-07T09:06:45Z","updateDateIncludingText":"2026-11-07T09:06:45Z"}
