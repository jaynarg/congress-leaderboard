nDate":null,"state":"MA"},{"bioguideId":"M001206","fullName":"Rep. Morelle, Joseph D. [D-NY-25]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"H000874","fullName":"Rep. Hoyer, Steny H. [D-MD-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-04","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001211","fullName":"Rep. Stanton, Greg [D-AZ-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-10","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"L000590","fullName":"Rep. Lee, Susie [D-NV-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-06","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T19:38:59+00:00","id":"hr1158-119","introducedDate":"2025-02-10","latestAction":{"actionDate":"2025-02-10","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"1158","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"W000795","district":2,"fullName":"Rep. Wilson, Joe [R-SC-2]","party":"R","state":"SC"}],"summaries":[{"actionDate":"2025-02-10","actionDesc":"Introduced in House","text":"<p><strong>Freedom First Lend&nbsp;Lease Act </strong></p><p>This bill temporarily waives certain requirements related to the President's authority to lend or lease defense articles if the defense articles are intended for Ukraine's government or the governments of other Eastern European countries affected by Russia's invasion of Ukraine.</p><p>For FY2026 and FY2027, an agreement to lend or lease defense articles under this bill shall not be subject to certain requirements and provisions that typically apply to such lend-lease agreements, including a requirement that generally prohibits a loan or lease period from exceeding five years.</p><p>The President must establish expedited procedures to ensure the timely delivery of defense articles loaned or leased to Ukraine under this bill.&nbsp;Laws concerning the return of, reimbursement, and repayment for defense articles loaned or leased to foreign governments shall apply to any loan or lease to Ukraine.</p>","updateDate":"2025-05-01T13:49:33Z","versionCode":"00"}],"title":"Freedom First Lend Lease Act","type":"hr","updateDate":"2025-10-25T08:05:46Z","updateDateIncludingText":"2025-10-25T08:05:46Z"}
