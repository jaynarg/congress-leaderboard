:"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-18","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"V000136","fullName":"Rep. Vasquez, Gabe [D-NM-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"M001219","fullName":"Del. Moylan, James C. [R-GU-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-02","sponsorshipWithdrawnDate":null,"state":"GU"},{"bioguideId":"S001211","fullName":"Rep. Stanton, Greg [D-AZ-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"C001067","fullName":"Rep. Clarke, Yvette D. [D-NY-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-10","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"W000808","fullName":"Rep. Wilson, Frederica S. [D-FL-24]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"D000197","fullName":"Rep. DeGette, Diana [D-CO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-10","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"D000631","fullName":"Rep. Dean, Madeleine [D-PA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-20","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"M001241","fullName":"Rep. Min, Dave [D-CA-47]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001246","fullName":"Rep. Mejia, Analilia [D-NJ-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"N000188","fullName":"Rep. Norcross, Donald [D-NJ-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-16T18:47:05+00:00","id":"hr210-119","introducedDate":"2025-01-06","latestAction":{"actionDate":"2026-05-20","text":"Committee Hearings Held"},"laws":[],"number":"210","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"B001285","district":26,"fullName":"Rep. Brownley, Julia [D-CA-26]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-01-06","actionDesc":"Introduced in House","text":"<p><b>Dental Care for Veterans Act</b></p> <p>This bill expands eligibility for veterans for dental care provided by the Department of Veterans Affairs (VA). Specifically, the bill makes all veterans who are enrolled in the VA health care system eligible for VA-provided dental services. Currently, only veterans who have a service-connected dental issue or meet other narrow criteria are eligible for certain dental services.</p> <p>The bill phases in eligibility over four years based upon existing eligibility, degree of service-connected disability or other disability, prisoner of war status, award of a Purple Heart, financial need, or VA health care eligibility.</p>","updateDate":"2025-02-03T17:11:34Z","versionCode":"00"}],"title":"Dental Care for Veterans Act","type":"hr","updateDate":"2026-09-11T08:05:30Z","updateDateIncludingText":"2026-09-11T08:05:30Z"}
