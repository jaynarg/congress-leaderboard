guideId":"B001326","fullName":"Rep. Bynum, Janelle S. [D-OR-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-29","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-15","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"D000631","fullName":"Rep. Dean, Madeleine [D-PA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"W000808","fullName":"Rep. Wilson, Frederica S. [D-FL-24]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-09","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"D000623","fullName":"Rep. DeSaulnier, Mark [D-CA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"J000298","fullName":"Rep. Jayapal, Pramila [D-WA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"WA"}],"fetchedAt":"2026-09-20T14:01:22+00:00","id":"hr491-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-09-16","actionTime":"17:15:04","text":"ASSUMING FIRST SPONSORSHIP - Mr. Walkinshaw asked unanimous consent that he may hereafter be considered as the first sponsor of H.R. 491, a bill originally introduced by Representative Connolly, for the purpose of adding cosponsors and requesting reprintings pursuant to clause 7 of rule XII. Agreed to without objection."},"laws":[],"number":"491","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"C001078","district":11,"fullName":"Rep. Connolly, Gerald E. [D-VA-11]","party":"D","state":"VA"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in House","text":"<p><strong>Equal COLA Act</strong></p><p>This bill applies a&nbsp;cost-of-living adjustment (COLA)&nbsp;for annuities paid under the Federal Employees Retirement System that is equal to the increase in inflation, regardless of the amount of&nbsp;the increase.</p><p>Specifically, for any year in which the Consumer Price Index (CPI) has increased over the previous year, the COLA amount shall be increased by the change in the CPI&nbsp;from the previous year.&nbsp;</p><p>Current law applies an adjustment equal to the change in CPI only if the change is 2% or less. If the change is between 2% and 3%, the adjustment is limited to 2%. If the change is more than 3%, the adjustment is limited to 1% less than the change.</p><p></p>","updateDate":"2025-06-30T16:19:36Z","versionCode":"00"}],"title":"Equal COLA Act","type":"hr","updateDate":"2026-09-19T23:18:49Z","updateDateIncludingText":"2026-09-19T23:18:49Z"}
