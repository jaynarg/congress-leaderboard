onsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"H001066","fullName":"Rep. Horsford, Steven [D-NV-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"H001047","fullName":"Rep. Himes, James A. [D-CT-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-03","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"K000375","fullName":"Rep. Keating, William R. [D-MA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-07","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"P000608","fullName":"Rep. Peters, Scott H. [D-CA-50]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"G000604","fullName":"Rep. Goodlander, Maggie [D-NH-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-27","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"W000831","fullName":"Rep. Walkinshaw, James R. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-27","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"B001278","fullName":"Rep. Bonamici, Suzanne [D-OR-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-13","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"J000310","fullName":"Rep. Johnson, Julie [D-TX-32]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"W000797","fullName":"Rep. Wasserman Schultz, Debbie [D-FL-25]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-16T20:19:31+00:00","id":"hr1987-119","introducedDate":"2025-03-10","latestAction":{"actionDate":"2025-05-12","text":"Referred to the Subcommittee on Oversight and Investigations."},"laws":[],"number":"1987","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"D000530","district":17,"fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","party":"D","state":"PA"}],"summaries":[{"actionDate":"2025-03-10","actionDesc":"Introduced in House","text":"<p><strong>Saving Our Veterans Lives Act of 2025</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to implement a program to provide, upon request, a firearm lockbox (or voucher for such item) to eligible individuals. Currently, there is a pilot program under which certain veterans may be prescribed a lockbox by a VA clinician.</p><p>The VA must also provide information with respect to the benefits of and options for secure firearm storage.</p><p>The VA must develop an informational video on the secure storage of firearms as a suicide prevention strategy and publish the video on its website. Additionally, the VA must publish information to inform individuals who participate in the lockbox program that such lockboxes are not for resale.</p><p>The VA must also implement a public education campaign to educate eligible individuals about the availability of lockboxes under the program and that participation in the program does not affect the rights of an individual with respect to the lawful ownership of a firearm.</p>","updateDate":"2026-03-13T20:27:55Z","versionCode":"00"}],"title":"Saving Our Veterans Lives Act of 2025","type":"hr","updateDate":"2026-08-04T08:07:42Z","updateDateIncludingText":"2026-08-04T08:07:42Z"}
