lse,"party":"D","sponsorshipDate":"2025-10-14","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"T000472","fullName":"Rep. Takano, Mark [D-CA-39]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001232","fullName":"Rep. McClain Delaney, April [D-MD-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"C001127","fullName":"Rep. Cherfilus-McCormick, Sheila [D-FL-20]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-28","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-16T22:58:42+00:00","id":"hr5720-119","introducedDate":"2025-10-08","latestAction":{"actionDate":"2025-10-08","text":"Referred to the House Committee on Oversight and Government Reform."},"laws":[],"number":"5720","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"O000173","district":5,"fullName":"Rep. Omar, Ilhan [D-MN-5]","party":"D","state":"MN"}],"summaries":[{"actionDate":"2025-10-08","actionDesc":"Introduced in House","text":"<p><strong>Federal Worker Childcare Protection Act of 2025</strong></p><p>This bill authorizes certain federal employees to be reimbursed for childcare expenses paid during the government shutdown that began on October 1, 2025.</p><p>Under the bill, any federal employee who was furloughed or worked without receiving a paycheck during the lapse in appropriations (i.e., government shutdown)&nbsp;that began on October 1, 2025, and paid for childcare during the lapse is eligible to be reimbursed for the childcare expenses if (1) appropriations are provided for this purpose, and (2) the employee submits a receipt from a childcare provider to the General Services Administration.&nbsp;</p>","updateDate":"2025-10-20T14:56:29Z","versionCode":"00"}],"title":"Federal Worker Childcare Protection Act of 2025","type":"hr","updateDate":"2025-10-29T08:05:47Z","updateDateIncludingText":"2025-10-29T08:05:47Z"}
