{"actions":[{"actionCode":"H11100","actionDate":"2025-02-25","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-25","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-25","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1574","cosponsors":[{"bioguideId":"D000631","fullName":"Rep. Dean, Madeleine [D-PA-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"R000614","fullName":"Rep. Roy, Chip [R-TX-21]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"J000288","fullName":"Rep. Johnson, Henry C. \"Hank\" [D-GA-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"R000305","fullName":"Rep. Ross, Deborah K. [D-NC-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T19:59:33+00:00","id":"hr1574-119","introducedDate":"2025-02-25","latestAction":{"actionDate":"2025-02-25","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"1574","originChamber":"House","policyArea":"Commerce","sponsors":[{"bioguideId":"M001224","district":1,"fullName":"Rep. Moran, Nathaniel [R-TX-1]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-02-25","actionDesc":"Introduced in House","text":"<p><strong>Realizing Engineering, Science, and Technology Opportunities by Restoring Exclusive Patent Rights Act of 2025 or the RESTORE Patent Rights Act of 2025</strong></p><p>This bill establishes a rebuttable presumption for injunctive relief in patent infringement cases. Specifically, if a court enters a final judgment finding infringement of a right secured by patent, the patent owner shall be entitled to a rebuttable presumption that the court should grant a permanent injunction with respect to that infringing conduct.</p><p>(In 2006, the U.S. Supreme Court held in&nbsp;<em>eBay&nbsp;v. MercExchange</em> that patent holders do not have an automatic right to a permanent injunction in a patent infringement case.)</p>","updateDate":"2025-06-16T16:09:45Z","versionCode":"00"}],"title":"RESTORE Patent Rights Act of 2025","type":"hr","updateDate":"2025-12-05T22:08:59Z","updateDateIncludingText":"2025-12-05T22:08:59Z"}
