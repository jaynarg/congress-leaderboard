orshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"N000190","fullName":"Rep. Norman, Ralph [R-SC-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-02","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"M001212","fullName":"Rep. Moore, Barry [R-AL-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-02","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"B001325","fullName":"Rep. Biggs, Sheri [R-SC-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-02","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"S001214","fullName":"Rep. Steube, W. Gregory [R-FL-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-03","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-10","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001205","fullName":"Rep. Miller, Carol D. [R-WV-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-10","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"B000740","fullName":"Rep. Bice, Stephanie I. [R-OK-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-16","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"M001213","fullName":"Rep. Moore, Blake D. [R-UT-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"H001101","fullName":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"E000246","fullName":"Rep. Edwards, Chuck [R-NC-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-18","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"G000603","fullName":"Rep. Gill, Brandon [R-TX-26]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T20:02:32+00:00","id":"hr1623-119","introducedDate":"2025-02-26","latestAction":{"actionDate":"2025-12-11","text":"Forwarded by Subcommittee to Full Committee in the Nature of a Substitute (Amended) by Voice Vote."},"laws":[],"number":"1623","originChamber":"House","policyArea":"Commerce","sponsors":[{"bioguideId":"M001211","district":15,"fullName":"Rep. Miller, Mary E. [R-IL-15]","party":"R","state":"IL"}],"summaries":[{"actionDate":"2025-02-26","actionDesc":"Introduced in House","text":"<p><strong>Shielding Children's Retinas from Egregious Exposure on the Net Act or the SCREEN Act</strong><br/><br/>This bill establishes age-verification requirements for commercial interactive computer services (e.g., websites) that make available content that is harmful to minors (e.g., content that appeals to the prurient interest in nudity or sex,  is obscene, or is child pornography).<br/><br/>Specifically, the bill requires such services to adopt and utilize technology verification measures to ensure that (1) users of the service are not minors, and (2) minors are prevented from accessing any content on the service that is harmful to minors.<br/><br/>Additionally, such services must (1) use the technology to verify a user's age; (2) publish the verification process that the service uses; and (3) subject users'&nbsp;Internet Protocol (IP) addresses, including known virtual proxy network (VPN) IP addresses, to the technology verification measures, unless the service determines a user is not located within the United States.<br/><br/>Covered services also must implement data security measures to protect information about individuals collected through the verification process.<br/><br/>The Federal Trade Commission must conduct regular audits of such services, issue guidance, and otherwise enforce the requirements of this bill.</p>","updateDate":"2025-09-11T18:51:58Z","versionCode":"00"}],"title":"SCREEN Act","type":"hr","updateDate":"2026-09-02T08:06:42Z","updateDateIncludingText":"2026-09-02T08:06:42Z"}
