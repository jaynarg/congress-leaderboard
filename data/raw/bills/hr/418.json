:null,"state":"TX"},{"bioguideId":"W000806","fullName":"Rep. Webster, Daniel [R-FL-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"V000133","fullName":"Rep. Van Drew, Jefferson [R-NJ-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"S001214","fullName":"Rep. Steube, W. Gregory [R-FL-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-20T13:58:29+00:00","id":"hr418-119","introducedDate":"2025-01-15","latestAction":{"actionDate":"2025-01-15","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"418","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"C001118","district":6,"fullName":"Rep. Cline, Ben [R-VA-6]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2025-01-15","actionDesc":"Introduced in House","text":"<p><strong>Ensuring Accountability in Agency Rulemaking Act</strong></p><p>This bill requires, subject to a limited exception, that any agency rule promulgated under notice and comment procedures must be (1) initiated by a senior appointee (e.g., an individual who was appointed by the President or is a non-career member of the Senior Executive Service), and&nbsp;(2) issued and signed by an individual who was appointed by the President and confirmed by the Senate.</p><p>The Office of Information and Regulatory Affairs must issue guidance for agencies to implement this requirement.</p>","updateDate":"2025-05-01T17:08:02Z","versionCode":"00"}],"title":"Ensuring Accountability in Agency Rulemaking Act","type":"hr","updateDate":"2026-09-19T23:07:34Z","updateDateIncludingText":"2026-09-19T23:07:34Z"}
