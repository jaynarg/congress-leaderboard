ponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"R000612","fullName":"Rep. Rose, John W. [R-TN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"V000139","fullName":"Rep. Van Epps, Matt [R-TN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-08","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"K000392","fullName":"Rep. Kustoff, David [R-TN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"S001199","fullName":"Rep. Smucker, Lloyd [R-PA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"M001235","fullName":"Rep. Moore, Riley M. [R-WV-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-24","sponsorshipWithdrawnDate":null,"state":"WV"}],"fetchedAt":"2026-09-25T15:15:24+00:00","id":"hr9701-119","introducedDate":"2026-07-15","latestAction":{"actionDate":"2026-07-15","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"9701","originChamber":"House","policyArea":"Congress","sponsors":[{"bioguideId":"C001118","district":6,"fullName":"Rep. Cline, Ben [R-VA-6]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2026-07-15","actionDesc":"Introduced in House","text":"<p><strong>Daughters of the American Revolution Membership Integrity Act</strong></p><p>This bill limits membership eligibility for the National Society of the Daughters of the American Revolution (commonly known as the Daughters of the American Revolution, or DAR) to biological women.&nbsp;(Under the bill, biological women are human females who naturally have, had, will have, or would have—if not for a congenital anomaly or intentional or unintentional disruption—a female reproductive system.)</p><p>Members must also satisfy any genealogical and membership qualifications the organization establishes, as under current law.</p><p>As background, DAR's federal charter provides that its purposes include perpetuating the memory and spirit of the men and women who achieved American independence.</p>","updateDate":"2026-08-31T18:58:16Z","versionCode":"00"}],"title":"Daughters of the American Revolution Membership Integrity Act.","type":"hr","updateDate":"2026-09-25T08:06:37Z","updateDateIncludingText":"2026-09-25T08:06:37Z"}
