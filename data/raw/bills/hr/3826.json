":false,"party":"D","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"K000376","fullName":"Rep. Kelly, Mike [R-PA-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"P000597","fullName":"Rep. Pingree, Chellie [D-ME-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-12","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-03","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"K000399","fullName":"Rep. Kiggans, Jennifer A. [R-VA-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-03","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-09","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"P000621","fullName":"Rep. Pou, Nellie [D-NJ-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000795","fullName":"Rep. Wilson, Joe [R-SC-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"R000622","fullName":"Rep. Riley, Josh [D-NY-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-14","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"R000305","fullName":"Rep. Ross, Deborah K. [D-NC-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-14","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-22","sponsorshipWithdrawnDate":null,"state":"DE"}],"fetchedAt":"2026-09-16T21:39:57+00:00","id":"hr3826-119","introducedDate":"2025-06-06","latestAction":{"actionDate":"2025-06-06","text":"Referred to the Committee on Energy and Commerce, and in addition to the Committee on Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"3826","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"S001216","district":8,"fullName":"Rep. Schrier, Kim [D-WA-8]","party":"D","state":"WA"}],"summaries":[{"actionDate":"2025-06-06","actionDesc":"Introduced in House","text":"<p><strong>Expanding Access to Diabetes Self-Management Training Act of </strong><strong>2025</strong></p><p>This bill expands Medicare coverage of diabetes outpatient self-management training. </p><p>Specifically, the bill specifies that in addition to physicians, other health care practitioners may also provide such services. It also specifies that coverage includes an initial 10 hours of training until used, as well as an additional 2 hours of training per year. The bill also prohibits the Centers for Medicare &amp; Medicaid Services from limiting training that is deemed medically necessary.&nbsp;</p><p>Additionally, the Center for Medicare and Medicaid Innovation must test a model in which such training is provided virtually and evaluate any effects on costs, services, and health outcomes.</p>","updateDate":"2025-07-25T15:50:16Z","versionCode":"00"}],"title":"Expanding Access to Diabetes Self-Management Training Act of 2025","type":"hr","updateDate":"2026-07-23T08:07:57Z","updateDateIncludingText":"2026-07-23T08:07:57Z"}
