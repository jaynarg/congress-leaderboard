awnDate":null,"state":"WI"},{"bioguideId":"M001237","fullName":"Rep. McDonald Rivet, Kristen [D-MI-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"C001059","fullName":"Rep. Costa, Jim [D-CA-21]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"R000622","fullName":"Rep. Riley, Josh [D-NY-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-10","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"V000129","fullName":"Rep. Valadao, David G. [R-CA-22]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000460","fullName":"Rep. Thompson, Mike [D-CA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S000929","fullName":"Rep. Spartz, Victoria [R-IN-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"IN"}],"fetchedAt":"2026-09-16T19:26:52+00:00","id":"hr914-119","introducedDate":"2025-02-04","latestAction":{"actionDate":"2025-02-04","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"914","originChamber":"House","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"H001090","district":9,"fullName":"Rep. Harder, Josh [D-CA-9]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-02-04","actionDesc":"Introduced in House","text":"<p><strong>American Consumer Awareness of National Source Act or the American CANS Act</strong></p><p>This bill revises country-of-origin labeling requirements for canned goods.</p><p>Under current country-of-origin labeling requirements, every article of foreign origin entering the United States must be legibly marked with the English name of the country of origin of the article (with certain exemptions). This bill requires country-of-origin labeling for any agricultural product packaged in a can to (1) appear on the front label of the can; or (2) be stamped, embossed, or printed on the top of the can.</p>","updateDate":"2025-06-26T14:40:12Z","versionCode":"00"}],"title":"American CANS Act","type":"hr","updateDate":"2026-09-01T08:05:51Z","updateDateIncludingText":"2026-09-01T08:05:51Z"}
