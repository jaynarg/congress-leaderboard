{"actions":[{"actionCode":"H11100","actionDate":"2025-02-12","source":"House floor actions","text":"Referred to the House Committee on Foreign Affairs.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-12","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-12","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1243","cosponsors":[{"bioguideId":"W000814","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001302","fullName":"Rep. Biggs, Andy [R-AZ-5]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"P000609","fullName":"Rep. Palmer, Gary J. [R-AL-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"R000619","fullName":"Rep. Rulli, Michael A. [R-OH-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"H001101","fullName":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-04","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-16T19:43:03+00:00","id":"hr1243-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2025-02-12","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"1243","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"D000626","district":8,"fullName":"Rep. Davidson, Warren [R-OH-8]","party":"R","state":"OH"}],"summaries":[{"actionDate":"2025-02-12","actionDesc":"Introduced in House","text":"<p><strong>United Nations Voting Accountability Act of 2025</strong></p><p>This bill prohibits giving assistance, such as various types of economic support or military training, to countries that shared U.S. positions on&nbsp;less than 50% of the recorded votes in the most recent United Nations session.</p><p>A country may be exempted from this prohibition if the Department of State determines that the country will no longer oppose U.S. positions due to a fundamental change in the country's leadership and policies.</p>","updateDate":"2025-05-28T14:15:24Z","versionCode":"00"}],"title":"United Nations Voting Accountability Act of 2025","type":"hr","updateDate":"2025-12-06T06:42:53Z","updateDateIncludingText":"2025-12-06T06:42:53Z"}
