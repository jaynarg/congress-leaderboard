{"actions":[{"actionCode":"H11100","actionDate":"2025-07-23","source":"House floor actions","text":"Referred to the House Committee on Education and Workforce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-07-23","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-07-23","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/4742","cosponsors":[{"bioguideId":"D000530","fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T22:18:49+00:00","id":"hr4742-119","introducedDate":"2025-07-23","latestAction":{"actionDate":"2025-07-23","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"4742","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"T000467","district":15,"fullName":"Rep. Thompson, Glenn [R-PA-15]","party":"R","state":"PA"}],"summaries":[{"actionDate":"2025-07-23","actionDesc":"Introduced in House","text":"<p><strong>Giving Increased Variety to Ensure Milk Into the Lives of Kids Act or the</strong> <strong>GIVE MILK Act </strong></p><p>This bill revises the Special Supplemental Nutrition Program for Women, Infants, and Children (WIC) to allow WIC participants (or the parent or guardian of such participants) to elect to be issued nonfat milk, 1% low-fat milk, 2% reduced-fat milk, or whole milk.&nbsp;Current WIC regulations restrict the milk choices for most women and children who are at least two years old&nbsp;to nonfat or 1% milk, with exceptions.</p>","updateDate":"2025-09-17T15:18:20Z","versionCode":"00"}],"title":"GIVE MILK Act","type":"hr","updateDate":"2026-07-18T00:02:53Z","updateDateIncludingText":"2026-07-18T00:02:53Z"}
