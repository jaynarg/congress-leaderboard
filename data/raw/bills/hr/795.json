"state":"NC"},{"bioguideId":"G000590","fullName":"Rep. Green, Mark E. [R-TN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-07","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"M001239","fullName":"Rep. McGuire, John J. [R-VA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-08","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T19:20:40+00:00","id":"hr795-119","introducedDate":"2025-01-28","latestAction":{"actionDate":"2025-01-28","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"795","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"M001211","district":15,"fullName":"Rep. Miller, Mary E. [R-IL-15]","party":"R","state":"IL"}],"summaries":[{"actionDate":"2025-01-28","actionDesc":"Introduced in House","text":"<p><strong>Pregnancy Is Not an Illness Act of 2025</strong></p><p>This bill prohibits the Food and Drug Administration (FDA) from treating pregnancy as an illness for the purposes of approving any abortion drug or imposing a risk evaluation and mitigation strategy for an abortion drug. The bill also nullifies FDA approval of any abortion drug that relied at all on the treatment of pregnancy as an illness, and specifically nullifies the FDA’s approval of the abortion drug&nbsp;mifepristone in effect before the bill is enacted.</p>","updateDate":"2025-04-24T21:00:42Z","versionCode":"00"}],"title":"Pregnancy Is Not an Illness Act of 2025","type":"hr","updateDate":"2025-05-09T08:06:05Z","updateDateIncludingText":"2025-05-09T08:06:05Z"}
