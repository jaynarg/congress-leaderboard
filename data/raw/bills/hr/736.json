"party":"R","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"S001213","fullName":"Rep. Steil, Bryan [R-WI-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"M001204","fullName":"Rep. Meuser, Daniel [R-PA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-07","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"D000634","fullName":"Rep. Downing, Troy [R-MT-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-07","sponsorshipWithdrawnDate":null,"state":"MT"}],"fetchedAt":"2026-09-16T19:17:48+00:00","id":"hr736-119","introducedDate":"2025-01-24","latestAction":{"actionDate":"2025-02-11","text":"Received in the Senate and Read twice and referred to the Committee on Banking, Housing, and Urban Affairs."},"laws":[],"number":"736","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"N000193","district":3,"fullName":"Rep. Nunn, Zachary [R-IA-3]","party":"R","state":"IA"}],"summaries":[{"actionDate":"2025-01-24","actionDesc":"Introduced in House","text":"<p><strong>Protect Small Businesses from Excessive Paperwork Act of 2025</strong></p><p>This bill extends the deadline for certain companies that are required to file beneficial ownership information with the Financial Crimes Enforcement Network (FinCEN). Specifically, the bill requires companies formed or registered before January 1, 2024, to submit this information to FinCEN by January 1, 2026, instead of by January 1, 2025,&nbsp;as required under current regulations.</p>","updateDate":"2025-02-10T17:32:47Z","versionCode":"00"}],"title":"Protect Small Businesses from Excessive Paperwork Act of 2025","type":"hr","updateDate":"2026-07-11T11:58:28Z","updateDateIncludingText":"2026-07-13T19:19:36Z"}
