e":null,"state":"KY"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-18","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"UT"}],"fetchedAt":"2026-09-16T22:09:02+00:00","id":"hr4500-119","introducedDate":"2025-07-17","latestAction":{"actionDate":"2025-07-18","text":"Referred to the Subcommittee on Highways and Transit."},"laws":[],"number":"4500","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"H001100","district":3,"fullName":"Rep. Hurd, Jeff [R-CO-3]","party":"R","state":"CO"}],"summaries":[{"actionDate":"2025-07-17","actionDesc":"Introduced in House","text":"<p><strong>Hauling Exemptions for Livestock Protection Act or the HELP Act</strong></p><p>This bill exempts livestock hauling vehicles and the vehicle operators from hours of service and electronic logging device (ELD) requirements. The&nbsp;exemption applies to a hauling vehicle carrying livestock (i.e., livestock, insects, or aquatic animals) and to a vehicle&nbsp;that is picking up or returning from delivering livestock (i.e., an unladen vehicle).</p><p>Under current law, Federal&nbsp;Motor Carrier Safety Administration&nbsp;rules limit how many hours most commercial truck drivers can drive and work and requires a vehicle to be equipped with an ELD, which tracks how long a vehicle has been driving.&nbsp;Limited exemptions exist, including for livestock hauling.</p>","updateDate":"2026-07-20T21:07:25Z","versionCode":"00"}],"title":"HELP Act","type":"hr","updateDate":"2026-07-20T21:08:18Z","updateDateIncludingText":"2026-07-20T21:08:18Z"}
