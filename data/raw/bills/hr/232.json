{"actions":[{"actionCode":"H11100","actionDate":"2025-01-07","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/232","cosponsors":[{"bioguideId":"S001207","fullName":"Rep. Sherrill, Mikie [D-NJ-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"S001223","fullName":"Rep. Sykes, Emilia Strong [D-OH-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"H001085","fullName":"Rep. Houlahan, Chrissy [D-PA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T18:48:13+00:00","id":"hr232-119","introducedDate":"2025-01-07","latestAction":{"actionDate":"2025-01-07","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"232","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"L000599","district":17,"fullName":"Rep. Lawler, Michael [R-NY-17]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-01-07","actionDesc":"Introduced in House","text":"<p><strong>SALT Fairness and Marriage Penalty Elimination Act</strong></p><p>This bill increases the limitation on the federal tax deduction for state and local taxes (commonly known as the SALT deduction cap) to $100,000 ($200,000