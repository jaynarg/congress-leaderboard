":"CA"},{"bioguideId":"T000491","fullName":"Rep. Tran, Derek [D-CA-45]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-09-16T22:52:54+00:00","id":"hr5584-119","introducedDate":"2025-09-26","latestAction":{"actionDate":"2026-06-25","text":"Ordered to be Reported (Amended) by the Yeas and Nays: 34 - 1."},"laws":[],"number":"5584","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"K000398","district":7,"fullName":"Rep. Kean, Thomas H. [R-NJ-7]","party":"R","state":"NJ"}],"summaries":[{"actionDate":"2025-09-26","actionDesc":"Introduced in House","text":"<p><strong>Literacy in Future Technologies Artificial Intelligence Act or the LIFT AI Act</strong></p><p>This bill authorizes the National Science Foundation&nbsp;to make merit-based grants to institutions of higher education, nonprofit organizations, and consortia of such entities to support artificial intelligence (AI) literacy for K-12 students and educators. Grants may be used for research and development of educational curricula, instructional material, professional development for teachers, and evaluation methods for AI literacy at the K-12 level.</p>","updateDate":"2026-08-27T19:34:37Z","versionCode":"00"}],"title":"LIFT AI Act","type":"hr","updateDate":"2026-08-27T19:35:38Z","updateDateIncludingText":"2026-08-27T19:35:38Z"}
