te":null,"state":"ID"},{"bioguideId":"B001295","fullName":"Rep. Bost, Mike [R-IL-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-26","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B000825","fullName":"Rep. Boebert, Lauren [R-CO-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-02","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"W000829","fullName":"Rep. Wied, Tony [R-WI-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-02","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"G000589","fullName":"Rep. Gooden, Lance [R-TX-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-02","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"L000596","fullName":"Rep. Luna, Anna Paulina [R-FL-13]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-02","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"C001120","fullName":"Rep. Crenshaw, Dan [R-TX-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-02","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001212","fullName":"Rep. Moore, Barry [R-AL-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M001240","fullName":"Rep. McDowell, Addison P. [R-NC-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-24","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001211","fullName":"Rep. Miller, Mary E. [R-IL-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-22","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-16T19:25:21+00:00","id":"hr885-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"885","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"R000614","district":21,"fullName":"Rep. Roy, Chip [R-TX-21]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><strong>Drug Cartel Terrorist Designation Act</strong></p><p>This bill directs the Department of State to designate four specified drug cartels as foreign terrorist organizations. (Among other things, such a designation allows the Department of the Treasury to require U.S. financial institutions to block transactions involving the organization.)</p><p>The four specified cartels in the bill are the Gulf Cartel, the Cartel Del Noreste, the Cartel de Sinaloa, and the Cartel de Jalisco Nueva Generacion.</p><p>The bill also requires the State Department to submit a detailed report on those four cartels and any other cartels it may identify. Based on this report, the State Department must designate as a foreign terrorist organization any such identified cartel (or faction thereof) that meets certain criteria for designation as a foreign terrorist organization.</p><p>The bill specifies that it may not be construed to expand eligibility for asylum.</p>","updateDate":"2025-03-17T20:52:12Z","versionCode":"00"}],"title":"Drug Cartel Terrorist Designation Act","type":"hr","updateDate":"2026-06-23T08:05:47Z","updateDateIncludingText":"2026-06-23T08:05:47Z"}
