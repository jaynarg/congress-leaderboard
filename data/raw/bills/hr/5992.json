":null,"state":"CA"},{"bioguideId":"R000622","fullName":"Rep. Riley, Josh [D-NY-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-02","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T23:09:34+00:00","id":"hr5992-119","introducedDate":"2025-11-10","latestAction":{"actionDate":"2025-11-17","text":"Referred to the Subcommittee on Economic Opportunity."},"laws":[],"number":"5992","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"C000059","district":41,"fullName":"Rep. Calvert, Ken [R-CA-41]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-11-10","actionDesc":"Introduced in House","text":"<p><strong>Stuck On Hold Act</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to implement automated systems for their customer phone lines that inform callers of the expected wait time and that offer callbacks for wait times of more than 10 minutes. The&nbsp;VA must also issue guidance to reduce the average wait time to no more than 10 minutes.</p>","updateDate":"2026-04-09T21:13:26Z","versionCode":"00"}],"title":"Stuck On Hold Act","type":"hr","updateDate":"2026-04-09T21:13:31Z","updateDateIncludingText":"2026-04-09T21:13:31Z"}
