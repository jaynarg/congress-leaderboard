{"actions":[{"actionCode":"H11000","actionDate":"2025-01-10","source":"House committee actions","text":"Referred to the Subcommittee on Railroads, Pipelines, and Hazardous Materials.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-01-09","source":"House floor actions","text":"Referred to the House Committee on Transportation and Infrastructure.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/265","cosponsors":[{"bioguideId":"C001125","fullName":"Rep. Carter, Troy A. [D-LA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-14","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"M001229","fullName":"Rep. McIver, LaMonica [D-NJ-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000822","fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"J000288","fullName":"Rep. Johnson, Henry C. \"Hank\" [D-GA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"T000468","fullName":"Rep. Titus, Dina [D-NV-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"M001196","fullName":"Rep. Moulton, Seth [D-MA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"MA"}],"fetchedAt":"2026-09-20T13:54:43+00:00","id":"hr265-119","introducedDate":"2025-01-09","latestAction":{"actionDate":"2025-01-10","text":"Referred to the Subcommittee on Railroads, Pipelines, and Hazardous Materials."},"laws":[],"number":"265","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"C001068","district":9,"fullName":"Rep. Cohen, Steve [D-TN-9]","party":"D","state":"TN"}],"summaries":[{"actionDate":"2025-01-09","actionDesc":"Introduced in House","text":"<p><strong>Train Furtherance of Outstanding Onboard Dining Act or the Train FOOD Act</strong></p><p>This bill directs Amtrak to establish an advisory committee to provide internal review for Amtrak's implementation of the Amtrak Food and Beverage Working Group (FBWG)&nbsp;recommendations to improve&nbsp;onboard food and beverage service.</p><p>The Amtrak advisory committee must submit an annual report to Congress on the status of Amtrak's implementation of each of the FBWG recommendations. The advisory committee's annual reports must be publicly available on an Amtrak website.</p><p>In addition, the Government Accountability Office must submit a report to Congress describing Amtrak's progress in implementing each&nbsp;FBWG report&nbsp;recommendation.</p>","updateDate":"2025-02-14T11:50:29Z","versionCode":"00"}],"title":"Train FOOD Act","type":"hr","updateDate":"2026-09-19T23:07:31Z","updateDateIncludingText":"2026-09-19T23:07:31Z"}
