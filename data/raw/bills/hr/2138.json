eId":"G000602","fullName":"Rep. Gillen, Laura [D-NY-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-10","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"P000614","fullName":"Rep. Pappas, Chris [D-NH-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-31","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"K000402","fullName":"Rep. Kennedy, Timothy M. [D-NY-26]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001234","fullName":"Rep. Morrison, Kelly [D-MN-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"R000622","fullName":"Rep. Riley, Josh [D-NY-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-14","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T20:26:23+00:00","id":"hr2138-119","introducedDate":"2025-03-14","latestAction":{"actionDate":"2025-03-26","text":"Subcommittee Hearings Held"},"laws":[],"number":"2138","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"L000603","district":8,"fullName":"Rep. Luttrell, Morgan [R-TX-8]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-03-14","actionDesc":"Introduced in House","text":"<p><strong>Veterans' Compensation Cost-of-Living Adjustment Act of 2025</strong><strong></strong></p><p>This bill requires the Department of Veterans Affairs (VA) to increase the amounts payable for wartime disability compensation, additional compensation for dependents, the clothing allowance for certain disabled veterans, and dependency and indemnity compensation for surviving spouses and children. Specifically, the VA must increase the amounts by the same percentage as the cost-of-living increase in benefits for Social Security recipients that is effective on December 1, 2025. The bill requires the VA to publish the amounts payable, as increased, in the Federal Register.</p><p>The VA is authorized to make a similar adjustment to the rates of disability compensation payable to persons who have not received compensation for service-connected disability or death.</p>","updateDate":"2025-06-17T16:56:54Z","versionCode":"00"}],"title":"Veterans’ Compensation Cost-of-Living Adjustment Act of 2025","type":"hr","updateDate":"2026-07-27T16:20:41Z","updateDateIncludingText":"2026-07-27T16:20:41Z"}
