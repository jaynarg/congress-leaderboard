30","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"D000629","fullName":"Rep. Davids, Sharice [D-KS-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-10","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"F000468","fullName":"Rep. Fletcher, Lizzie [D-TX-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-02","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001216","fullName":"Rep. Schrier, Kim [D-WA-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"D000635","fullName":"Rep. Dexter, Maxine [D-OR-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"B001278","fullName":"Rep. Bonamici, Suzanne [D-OR-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"S001200","fullName":"Rep. Soto, Darren [D-FL-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"T000486","fullName":"Rep. Torres, Ritchie [D-NY-15]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001223","fullName":"Rep. Magaziner, Seth [D-RI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-20","sponsorshipWithdrawnDate":null,"state":"RI"}],"fetchedAt":"2026-09-20T14:28:07+00:00","id":"hr3784-119","introducedDate":"2025-06-05","latestAction":{"actionDate":"2025-06-05","text":"Referred to the House Committee on Agriculture."},"laws":[],"number":"3784","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"S001226","district":6,"fullName":"Rep. Salinas, Andrea [D-OR-6]","party":"D","state":"OR"}],"summaries":[{"actionDate":"2025-06-05","actionDesc":"Introduced in House","text":"<p><strong>Farmers Feeding America Act of 2025</strong></p><p>This&nbsp;bill reauthorizes The Emergency Food Assistance Program (TEFAP),&nbsp;increases funding for the program,&nbsp;and provides additional delivery options for geographically isolated states (i.e., Hawaii, Alaska, Puerto Rico, the Northern Mariana Islands, the U.S. Virgin Islands, and Guam).</p><p>TEFAP is a federal program that helps supplement the diets of people with low income by providing them with emergency food assistance at no cost. Through TEFAP, the Department of Agriculture (USDA) purchases a variety of commodities and makes those food products (e.g., canned, frozen, dried, and fresh fruits and vegetables, eggs, meat, dairy, and whole-grain and enriched grain products) available to state distributing agencies.</p><p>The bill increases funding for purchasing commodities under&nbsp;the program.</p><p>Further, the bill directs USDA to coordinate with geographically isolated states to (1) establish alternative delivery options for allocated commodities, and (2) allow for the states to order commodities through the&nbsp;USDA Department of Defense Fresh Fruit and Vegetable Program.&nbsp;</p><p>USDA may also provide geographically isolated states the ability to directly purchase domestically grown food in lieu of receiving a portion of the commodities. Under this option, USDA may distribute as cash&nbsp;to the state up to 20% of the cash value of the commodities that are allocated to the state under TEFAP.&nbsp;</p><p>Further, USDA may consider additional factors beyond lowest price&nbsp;in determining winning bids for contracts for fresh produce packages&nbsp;(including product variety and transportation distance).&nbsp;</p>","updateDate":"2025-12-16T14:58:15Z","versionCode":"00"}],"title":"Farmers Feeding America Act of 2025","type":"hr","updateDate":"2026-09-19T23:17:38Z","updateDateIncludingText":"2026-09-19T23:17:38Z"}
