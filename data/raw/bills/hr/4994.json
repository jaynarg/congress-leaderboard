{"actions":[{"actionCode":"H11000","actionDate":"2025-08-20","source":"House committee actions","text":"Referred to the Subcommittee on Aviation.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-08-19","source":"House floor actions","text":"Referred to the House Committee on Transportation and Infrastructure.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-08-19","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-08-19","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/4994","cosponsors":[{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-08-19","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"G000559","fullName":"Rep. Garamendi, John [D-CA-8]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-08-19","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"F000477","fullName":"Rep. Foushee, Valerie P. [D-NC-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-09","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"F000454","fullName":"Rep. Foster, Bill [D-IL-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-11","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"S001226","fullName":"Rep. Salinas, Andrea [D-OR-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"D000635","fullName":"Rep. Dexter, Maxine [D-OR-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-09","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"P000614","fullName":"Rep. Pappas, Chris [D-NH-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-12","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-06","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"W000187","fullName":"Rep. Waters, Maxine [D-CA-43]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"J000310","fullName":"Rep. Johnson, Julie [D-TX-32]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"H001094","fullName":"Rep. Hoyle, Val T. [D-OR-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-18","sponsorshipWithdrawnDate":null,"state":"OR"}],"fetchedAt":"2026-09-16T22:29:30+00:00","id":"hr4994-119","introducedDate":"2025-08-19","latestAction":{"actionDate":"2025-08-20","text":"Referred to the Subcommittee on Aviation."},"laws":[],"number":"4994","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"F000476","district":10,"fullName":"Rep. Frost, Maxwell [D-FL-10]","party":"D","state":"FL"}],"summaries":[{"actionDate":"2025-08-19","actionDesc":"Introduced in House","text":"<p><strong>Safe Air on Airplanes Act</strong></p><p>This bill directs the Federal Aviation Administration (FAA) to update regulations to phase&nbsp;out and prohibit bleed air systems in certain types of aircraft.&nbsp;In general, a bleed air system uses compressed air that is taken from an aircraft engine that is upstream of the combustion chamber and provides pressurized air for the aircraft’s environmental control system (e.g., ventilation).</p><p>Under the bill, the FAA must&nbsp;</p><ul><li>prohibit new turbine and turboprop aircraft designs from using bleed air systems,</li><li>require (beginning seven years after the bill’s enactment) that any bleed air system in a newly manufactured aircraft is fitted with a filter&nbsp;(i.e., a device that removes gaseous and particulate components of oil fumes), and</li><li>provide for a phaseout (over a 30-year period) of the use of bleed air systems in existing turbine and turboprop aircraft designs.</li></ul>","updateDate":"2026-07-23T13:19:48Z","versionCode":"00"}],"title":"Safe Air on Airplanes Act","type":"hr","updateDate":"2026-07-23T13:19:56Z","updateDateIncludingText":"2026-07-23T13:19:56Z"}
