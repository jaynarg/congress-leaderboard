ll,"state":"TX"},{"bioguideId":"G000581","fullName":"Rep. Gonzalez, Vicente [D-TX-34]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T22:02:40+00:00","id":"hr4358-119","introducedDate":"2025-07-10","latestAction":{"actionDate":"2025-07-10","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"4358","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"V000131","district":33,"fullName":"Rep. Veasey, Marc A. [D-TX-33]","party":"D","state":"TX"}],"summaries":[{"actionDate":"2025-07-10","actionDesc":"Introduced in House","text":"<p><strong></strong><strong>Anti-Rigging Act of 2025</strong></p><p>This bill prohibits a state where the congressional districts have been redistricted after a decennial census from carrying out another redistricting until after the next apportionment of Representatives following a decennial census, unless a court requires the state to conduct a subsequent redistricting to comply with the Constitution or enforce the Voting Rights Act of 1965.</p><p>The bill is applicable to any congressional redistricting which occurs after the regular decennial census conducted during 2020.</p>","updateDate":"2026-03-31T11:07:20Z","versionCode":"00"}],"title":"Anti-Rigging Act of 2025","type":"hr","updateDate":"2026-03-31T11:07:25Z","updateDateIncludingText":"2026-03-31T11:07:25Z"}
