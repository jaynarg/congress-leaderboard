ll,"state":"AL"},{"bioguideId":"K000388","fullName":"Rep. Kelly, Trent [R-MS-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-06-25","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"F000481","fullName":"Rep. Figures, Shomari [D-AL-2]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-06-25","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"C001053","fullName":"Rep. Cole, Tom [R-OK-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-06-25","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"S001185","fullName":"Rep. Sewell, Terri A. [D-AL-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-06-25","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"S001148","fullName":"Rep. Simpson, Michael K. [R-ID-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-21","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"J000295","fullName":"Rep. Joyce, David P. [R-OH-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-01","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"D000628","fullName":"Rep. Dunn, Neal P. [R-FL-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-16T21:53:33+00:00","id":"hr4147-119","introducedDate":"2025-06-25","latestAction":{"actionDate":"2025-06-25","text":"Referred to the House Committee on Natural Resources."},"laws":[],"number":"4147","originChamber":"House","policyArea":"Native Americans","sponsors":[{"bioguideId":"R000575","district":3,"fullName":"Rep. Rogers, Mike D. [R-AL-3]","party":"R","state":"AL"}],"summaries":[{"actionDate":"2025-06-25","actionDesc":"Introduced in House","text":"<p><strong>Poarch Band of Creek Indians Parity Act</strong></p><p>This bill applies the Indian Reorganization Act (IRA) to the Poarch Band of Creek Indians. Additionally, the bill reaffirms previous decisions by the Department of the Interior to take land into trust for the tribe under the IRA.</p><p>A 2009 Supreme Court case,&nbsp;<em>Carcieri v. Salazar,</em> decided that Interior could not take land into trust for a specified tribe because that tribe had not been under federal jurisdiction when the IRA was enacted in 1934. This bill (1) affirms the applicability of the IRA to the Poarch Band of Creek Indians, thereby deeming the tribe to be under federal jurisdiction as of June 18, 1934, for purposes of the IRA; and (2) reaffirms prior decisions by Interior to take land into trust for the benefit of the tribe.</p>","updateDate":"2026-03-30T20:06:39Z","versionCode":"00"}],"title":"Poarch Band of Creek Indians Parity Act","type":"hr","updateDate":"2026-03-30T20:06:45Z","updateDateIncludingText":"2026-03-30T20:06:45Z"}
