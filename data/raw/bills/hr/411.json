{"actions":[{"actionCode":"H21000","actionDate":"2025-06-11","source":"House committee actions","text":"Subcommittee Hearings Held","type":"Committee"},{"actionCode":"H11000","actionDate":"2025-06-04","source":"House committee actions","text":"Referred to the Subcommittee on Indian and Insular Affairs.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-01-15","source":"House floor actions","text":"Referred to the House Committee on Natural Resources.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-15","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-15","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/411","cosponsors":[],"fetchedAt":"2026-09-16T19:01:33+00:00","id":"hr411-119","introducedDate":"2025-01-15","latestAction":{"actionDate":"2025-06-11","text":"Subcommittee Hearings Held"},"laws":[],"number":"411","originChamber":"House","policyArea":"Native Americans","sponsors":[{"bioguideId":"B001301","district":1,"fullName":"Rep. Bergman, Jack [R-MI-1]","party":"R","state":"MI"}],"summaries":[{"actionDate":"2025-01-15","actionDesc":"Introduced in House","text":"<p><strong>Keweenaw Bay Indian Community Land Claim Settlement Act of 2025</strong></p><p>This bill directs the Department of the Interior to transfer funds to the Keweenaw Bay Indian Community (KBIC) in Baraga County, Michigan, in order to settle the KBIC's land claims and clear title to those lands.</p><p>The KBIC may use these funds for any lawful purpose except to acquire land for gaming.</p>","updateDate":"2025-03-05T17:22:31Z","versionCode":"00"}],"title":"Keweenaw Bay Indian Community Land Claim Settlement Act of 2025","type":"hr","updateDate":"2026-08-08T19:26:19Z","updateDateIncludingText":"2026-08-08T19:26:19Z"}
