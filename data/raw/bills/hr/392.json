ponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-02-24","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"B001315","fullName":"Rep. Budzinski, Nikki [D-IL-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"T000468","fullName":"Rep. Titus, Dina [D-NV-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"B001318","fullName":"Rep. Balint, Becca [D-VT-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"W000830","fullName":"Rep. Whitesides, George [D-CA-27]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"MN"}],"fetchedAt":"2026-09-20T13:57:14+00:00","id":"hr392-119","introducedDate":"2025-01-14","latestAction":{"actionDate":"2025-01-14","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"392","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"K000399","district":2,"fullName":"Rep. Kiggans, Jennifer A. [R-VA-2]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2025-01-14","actionDesc":"Introduced in House","text":"<p><strong>Providing Real-world Education and Clinical Experience by Precepting Tomorrow's Nurses Act or the PRECEPT Nurses Act</strong></p><p>This bill establishes a new, nonrefundable tax credit for eligible nurse preceptors, subject to limitations. The bill also requires the Internal Revenue Service (IRS) to report to Congress certain information about the tax credit for nurse preceptors.</p><p>Under the bill, a nonrefundable tax credit of $2,000 is allowed for an eligible nurse preceptor through 2032. An <em>eligible nurse preceptor</em> is defined as an individual who provides at least 200 certified hours of supervision and personalized experiential learning, training, instruction, and mentoring in the clinical practice of nursing to a nursing student, advanced practice registered nursing student, or newly hired licensed nurse in a community designated as a health professional shortage area.&nbsp;</p><p>The bill also requires the IRS to report to Congress</p><ul><li>the number of taxpayers that claim the tax credit for nurse preceptors each year and the geographic distribution of such taxpayers,</li><li>aggregated and averaged data on the preceptorships served by taxpayers as an eligible nurse preceptor, and</li><li>the effectiveness of the tax credit  in increasing the number of nurse preceptors in the United States.</li></ul>","updateDate":"2025-04-24T13:04:59Z","versionCode":"00"}],"title":"PRECEPT Nurses Act","type":"hr","updateDate":"2026-09-19T23:41:06Z","updateDateIncludingText":"2026-09-19T23:41:06Z"}
