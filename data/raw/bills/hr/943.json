sponsor":false,"party":"R","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"H001098","fullName":"Rep. Hamadeh, Abraham J. [R-AZ-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-15","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"KS"}],"fetchedAt":"2026-09-16T19:28:18+00:00","id":"hr943-119","introducedDate":"2025-02-04","latestAction":{"actionDate":"2025-02-04","text":"Referred to the Committee on Ways and Means, and in addition to the Committee on the Judiciary, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"943","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"J000304","district":13,"fullName":"Rep. Jackson, Ronny [R-TX-13]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-02-04","actionDesc":"Introduced in House","text":"<p><strong>No User Fees for Gun Owners Act</strong></p><p>This bill prohibits a state or local government from imposing any insurance requirement, tax, user fee, or similar charge on the manufacture, import, acquisition, transfer, or continued ownership of a firearm or ammunition. The bill includes an exception for a generally applicable sales tax that is assessed against firearms or ammunition in the same proportion to which the tax applies to other goods or services.</p>","updateDate":"2025-07-25T13:34:27Z","versionCode":"00"}],"title":"No User Fees for Gun Owners Act","type":"hr","updateDate":"2025-10-18T08:05:33Z","updateDateIncludingText":"2025-10-18T08:05:33Z"}
