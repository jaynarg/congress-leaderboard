orshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"M001226","fullName":"Rep. Menendez, Robert [D-NJ-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"J000288","fullName":"Rep. Johnson, Henry C. \"Hank\" [D-GA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"C001117","fullName":"Rep. Casten, Sean [D-IL-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-30","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-17T03:19:33+00:00","id":"hr7751-119","introducedDate":"2026-03-02","latestAction":{"actionDate":"2026-03-03","text":"Referred to the Subcommittee on Highways and Transit."},"laws":[],"number":"7751","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"M001229","district":10,"fullName":"Rep. McIver, LaMonica [D-NJ-10]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2026-03-02","actionDesc":"Introduced in House","text":"<p><strong>Parks to People Active Transportation Act</strong></p><p>This bill requires the Department of Transportation (DOT) to establish a grant program for states, localities, and Indian tribes to support community greenway paths for walking, bicycling, and other motor vehicle alternatives.</p><p>DOT must designate eligible greenway paths that are considered regionally or nationally significant through a national greenway paths network; paths must cross multiple localities or states, reduce congestion, improve safety, benefit the environment, support communities, or meet other specified criteria. Eligible projects must support access to public parks, transportation, and other community needs.</p>","updateDate":"2026-05-06T14:34:14Z","versionCode":"00"}],"title":"Parks to People Active Transportation Act","type":"hr","updateDate":"2026-07-31T08:05:46Z","updateDateIncludingText":"2026-07-31T08:05:46Z"}
