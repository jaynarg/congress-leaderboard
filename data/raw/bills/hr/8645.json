{"actions":[{"actionCode":"H11100","actionDate":"2026-04-30","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2026-04-30","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2026-04-30","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/8645","cosponsors":[{"bioguideId":"V000081","fullName":"Rep. Velázquez, Nydia M. [D-NY-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-30","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"J000288","fullName":"Rep. Johnson, Henry C. \"Hank\" [D-GA-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-30","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-30","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"T000481","fullName":"Rep. Tlaib, Rashida [D-MI-12]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-30","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"D000096","fullName":"Rep. Davis, Danny K. [D-IL-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-30","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"M001229","fullName":"Rep. McIver, LaMonica [D-NJ-10]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-30","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"G000553","fullName":"Rep. Green, Al [D-TX-9]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-04-30","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-20T15:32:12+00:00","id":"hr8645-119","introducedDate":"2026-04-30","latestAction":{"actionDate":"2026-04-30","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"8645","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"W000822","district":12,"fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2026-04-30","actionDesc":"Introduced in House","text":"<p><b>New Pathways Act</b></p> <p>This bill revises existing requirements for the Bureau of Prisons (BOP) to help prisoners obtain identification documents prior to their release.</p> <p>With respect to U.S. citizens, the BOP must obtain and provide a Social Security card, a proof of U.S. citizenship document, and a photo identification card.</p> <p>With respect to noncitizens, the BOP must help obtain proof of lawful status and, if applicable, an employment authorization document.</p>","updateDate":"2026-06-29T21:04:05Z","versionCode":"00"}],"title":"New Pathways Act","type":"hr","updateDate":"2026-09-19T23:29:36Z","updateDateIncludingText":"2026-09-19T23:29:36Z"}
