{"actions":[{"actionCode":"H11100","actionDate":"2025-06-17","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-06-17","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-06-17","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/4022","cosponsors":[{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-06-17","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"L000593","fullName":"Rep. Levin, Mike [D-CA-49]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-01","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001285","fullName":"Rep. Brownley, Julia [D-CA-26]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-22","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001300","fullName":"Rep. Barragán, Nanette Diaz [D-CA-44]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000592","fullName":"Rep. Golden, Jared F. [D-ME-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"B001296","fullName":"Rep. Boyle, Brendan F. [D-PA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-27","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-20T14:29:25+00:00","id":"hr4022-119","introducedDate":"2025-06-17","latestAction":{"actionDate":"2025-06-17","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"4022","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"C001112","district":24,"fullName":"Rep. Carbajal, Salud O. [D-CA-24]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-06-17","actionDesc":"Introduced in House","text":"<p><strong>Increasing Behavioral Health Treatment Act</strong></p><p>This bill repeals restrictions that generally prohibit federal payment under Medicaid for services provided in institutions for mental diseases (IMDs) for individuals under the age of 65. (Currently, states may receive payment for such services through certain mechanisms, such as through a Medicaid demonstration waiver.)</p><p>The bill also requires state Medicaid programs that cover IMD services to improve patient access to outpatient and community-based behavioral health care, expand crisis stabilization services, facilitate care coordination between providers and first responders, and report specified information relating to IMD utilization and costs.</p>","updateDate":"2025-07-25T16:30:17Z","versionCode":"00"}],"title":"Increasing Behavioral Health Treatment Act","type":"hr","updateDate":"2026-09-19T23:23:41Z","updateDateIncludingText":"2026-09-19T23:23:41Z"}
