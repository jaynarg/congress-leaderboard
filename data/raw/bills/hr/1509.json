8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"M001213","fullName":"Rep. Moore, Blake D. [R-UT-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"F000468","fullName":"Rep. Fletcher, Lizzie [D-TX-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-01","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"L000593","fullName":"Rep. Levin, Mike [D-CA-49]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-01","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001229","fullName":"Rep. Shreve, Jefferson [R-IN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-01","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"R000622","fullName":"Rep. Riley, Josh [D-NY-19]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-05","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001237","fullName":"Rep. McDonald Rivet, Kristen [D-MI-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-09","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S001231","fullName":"Rep. Simon, Lateefah [D-CA-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-10","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001221","fullName":"Rep. Scholten, Hillary J. [D-MI-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"D000623","fullName":"Rep. DeSaulnier, Mark [D-CA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-25","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T14:08:50+00:00","id":"hr1509-119","introducedDate":"2025-02-21","latestAction":{"actionDate":"2025-02-21","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1509","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"T000482","district":3,"fullName":"Rep. Trahan, Lori [D-MA-3]","party":"D","state":"MA"}],"summaries":[{"actionDate":"2025-02-21","actionDesc":"Introduced in House","text":"<p><strong>Accelerating Kids’ Access to Care Act of 2025</strong></p><p>This bill requires states to establish a process through which qualifying out-of-state providers may temporarily treat children under Medicaid and the Children's Health Insurance Program (CHIP) without undergoing additional screening requirements.&nbsp;</p><p>Specifically, states must establish a process through which qualifying out-of-state providers may enroll for five years as participating providers to treat individuals under the age of 21 without undergoing additional screening requirements.</p><p>A qualifying out-of-state provider (1) must not have been excluded or terminated from participating in a federal health care program or state Medicaid program; and (2) must have been successfully enrolled in Medicare or a state Medicaid program based on a determination that the provider posed a limited risk of fraud, waste, or abuse.</p><p>The bill’s changes take effect three years after enactment.</p>","updateDate":"2025-08-05T21:29:49Z","versionCode":"00"}],"title":"Accelerating Kids’ Access to Care Act of 2025","type":"hr","updateDate":"2026-09-19T23:40:39Z","updateDateIncludingText":"2026-09-19T23:40:39Z"}
