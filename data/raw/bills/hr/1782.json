":null,"state":"CA"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"S001199","fullName":"Rep. Smucker, Lloyd [R-PA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"S001185","fullName":"Rep. Sewell, Terri A. [D-AL-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-07","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-01","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S000510","fullName":"Rep. Smith, Adam [D-WA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-01","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"F000481","fullName":"Rep. Figures, Shomari [D-AL-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"C001118","fullName":"Rep. Cline, Ben [R-VA-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"L000601","fullName":"Rep. Landsman, Greg [D-OH-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"C001068","fullName":"Rep. Cohen, Steve [D-TN-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"C001055","fullName":"Rep. Case, Ed [D-HI-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-09","sponsorshipWithdrawnDate":null,"state":"HI"}],"fetchedAt":"2026-09-16T20:10:13+00:00","id":"hr1782-119","introducedDate":"2025-03-03","latestAction":{"actionDate":"2025-03-28","text":"Referred to the Subcommittee on Nutrition and Foreign Agriculture."},"laws":[],"number":"1782","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"C001130","district":30,"fullName":"Rep. Crockett, Jasmine [D-TX-30]","party":"D","state":"TX"}],"summaries":[{"actionDate":"2025-03-03","actionDesc":"Introduced in House","text":"<p><strong>Supporting all Healthy Options when Purchasing Produce Act of 2025 or the SHOPP Act&nbsp;of 2025</strong></p><p>This bill modifies the&nbsp;Gus Schumacher Nutrition Incentive Program&nbsp;(GusNIP) to include fresh frozen fruits and vegetables.</p><p>GusNIP is&nbsp;a Department of Agriculture&nbsp;(USDA) program that provides grants for projects that increase low-income consumers' purchases of fruits and vegetables. It&nbsp;is made up of three competitive grant programs, including the GusNIP Nutrition Incentive Program, which provides grants for projects that provide incentives for Supplemental Nutrition Assistance Program (SNAP) participants to purchase&nbsp;fruits and vegetables.</p><p>The bill&nbsp;directs USDA, in awarding GusNIP Nutrition Incentive Program grants, to give priority to projects that&nbsp;increase year-round availability of nutrition incentives by offering fresh frozen fruits or vegetables in the program.</p><p>In addition, the bill amends another GusNIP program,&nbsp;the Produce Prescription Program, to include fresh frozen fruits and vegetables, as well as fresh and fresh frozen legumes. Currently, only fresh fruits and vegetables are covered under the program.</p><p>The&nbsp;GusNIP Produce Prescription Program supports projects that demonstrate and evaluate the impact of fruit and vegetable prescriptions on&nbsp;increasing procurement and consumption of fruits and vegetables, reducing individual and household food insecurity, and reducing healthcare usage and associated costs.</p>","updateDate":"2026-03-26T15:24:17Z","versionCode":"00"}],"title":"SHOPP Act of 2025","type":"hr","updateDate":"2026-07-10T08:06:11Z","updateDateIncludingText":"2026-07-10T08:06:11Z"}
