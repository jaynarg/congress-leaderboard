awnDate":null,"state":"TN"},{"bioguideId":"D000626","fullName":"Rep. Davidson, Warren [R-OH-8]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-06-10","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"C001132","fullName":"Rep. Crane, Elijah [R-AZ-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-11","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"W000816","fullName":"Rep. Williams, Roger [R-TX-25]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-11","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001224","fullName":"Rep. Self, Keith [R-TX-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M001224","fullName":"Rep. Moran, Nathaniel [R-TX-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-20","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"D000616","fullName":"Rep. DesJarlais, Scott [R-TN-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-20","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"M001211","fullName":"Rep. Miller, Mary E. [R-IL-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-20","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"M001236","fullName":"Rep. Moore, Tim [R-NC-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"V000134","fullName":"Rep. Van Duyne, Beth [R-TX-24]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-15","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"G000601","fullName":"Rep. Goldman, Craig A. [R-TX-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-01","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T21:41:14+00:00","id":"hr3859-119","introducedDate":"2025-06-10","latestAction":{"actionDate":"2025-06-10","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"3859","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"C001120","district":2,"fullName":"Rep. Crenshaw, Dan [R-TX-2]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-06-10","actionDesc":"Introduced in House","text":"<p><strong>Returning Illegals over Turmoil Act</strong></p><p>This bill establishes grounds for removal from, and future inadmissibility to, the United States for&nbsp;non-U.S. nationals (<em>aliens</em> under federal law) who incite violence, participate in a riot or civil disturbance, or commit certain other acts while in the United States.</p><p>Specifically, if, at the time of the offense, an individual is unlawfully present in the United States, a recipient of Deferred Action for Childhood Arrivals (DACA) status, or a lawful permanent resident, that individual is deportable and permanently inadmissible to the United States.</p><p>This applies to such individuals convicted of, or who have admitted to having committed acts that constitute</p><ul><li>incitement to violence or physical participation in a riot or civil disturbance under federal, state, or local law;</li><li>an actual or attempted assault, battery, or use of force against a law enforcement officer or a member of the Armed Forces of the United States; or</li><li>the willful destruction, defacement, or vandalism of property owned or operated by a federal, state, or local government.</li></ul><p>The Department of Homeland Security may designate such offenses as grounds for expedited removal during specified types of declared emergencies.</p><p>The bill also requires the detention of these individuals.&nbsp;</p>","updateDate":"2026-06-04T15:10:09Z","versionCode":"00"}],"title":"Returning Illegals over Turmoil Act","type":"hr","updateDate":"2026-06-04T15:10:16Z","updateDateIncludingText":"2026-06-04T15:10:16Z"}
