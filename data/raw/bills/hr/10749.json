{"actions":[{"actionCode":"H11100","actionDate":"2026-10-05","source":"House floor actions","text":"Referred to the House Committee on Agriculture.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2026-10-05","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2026-10-05","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/10749","cosponsors":[{"bioguideId":"F000472","fullName":"Rep. Franklin, Scott [R-FL-18]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-10-05","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001200","fullName":"Rep. Soto, Darren [D-FL-9]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-10-05","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"C001039","fullName":"Rep. Cammack, Kat [R-FL-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-10-05","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-10-21T14:49:10+00:00","id":"hr10749-119","introducedDate":"2026-10-05","latestAction":{"actionDate":"2026-10-05","text":"Referred to the House Committee on Agriculture."},"laws":[],"number":"10749","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"W000797","district":25,"fullName":"Rep. Wasserman Schultz, Debbie [D-FL-25]","party":"D","state":"FL"}],"summaries":[{"actionDate":"2026-10-05","actionDesc":"Introduced in House","text":"<p><strong>Restore Agricultural Investment, Stability, and Expansion Act of 2026 or the RAISE Act of 2026</strong></p><p>This bill allows the Department of Agriculture (USDA) to provide payments to producers of high-value crops (including citrus) for revenue losses or losses of crop quality or production that are a consequence of specific events. These events include a drought, wildfire, hurricane, flood, tornado, winter storm, and smoke exposure. USDA may implement this program by providing block grants to states and territories.&nbsp;&nbsp;</p>","updateDate":"2026-10-20T18:43:54Z","versionCode":"00"}],"title":"RAISE Act of 2026","type":"hr","updateDate":"2026-10-20T18:45:01Z","updateDateIncludingText":"2026-10-20T18:45:01Z"}
