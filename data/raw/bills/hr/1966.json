37+00:00","id":"hr1966-119","introducedDate":"2025-03-06","latestAction":{"actionDate":"2025-03-06","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1966","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"W000187","district":43,"fullName":"Rep. Waters, Maxine [D-CA-43]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-03-06","actionDesc":"Introduced in House","text":"<p><strong>Mamas and Babies in Underserved Communities Act of 2025</strong></p><p>This bill establishes Department of Health and Human Services grants for public or nonprofit private health care providers to expand and improve maternal health care services (including prenatal, postnatal, and postpartum care) and reduce disparities in access to such care. Health care providers are eligible to apply if they serve one or more minority, low-income, or medically&nbsp;underserved communities.</p>","updateDate":"2025-08-27T21:04:46Z","versionCode":"00"}],"title":"Mamas and Babies in Underserved Communities Act of 2025","type":"hr","updateDate":"2026-09-19T23:25:17Z","updateDateIncludingText":"2026-09-19T23:25:17Z"}
