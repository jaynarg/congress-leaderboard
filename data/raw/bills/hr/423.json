{"actions":[{"actionCode":"H11100","actionDate":"2025-01-15","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-15","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-15","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/423","cosponsors":[{"bioguideId":"D000096","fullName":"Rep. Davis, Danny K. [D-IL-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"S001193","fullName":"Rep. Swalwell, Eric [D-CA-14]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001160","fullName":"Rep. Moore, Gwen [D-WI-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"B001285","fullName":"Rep. Brownley, Julia [D-CA-26]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000389","fullName":"Rep. Khanna, Ro [D-CA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-01","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T13:58:44+00:00","id":"hr423-119","introducedDate":"2025-01-15","latestAction":{"actionDate":"2025-01-15","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"423","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"C001068","district":9,"fullName":"Rep. Cohen, Steve [D-TN-9]","party":"D","state":"TN"}],"summaries":[{"actionDate":"2025-01-15","actionDesc":"Introduced in House","text":"<p><strong>Private Student Loan Bankruptcy Fairness Act of 2025 </strong></p><p>This bill modifies the treatment of certain student loans in bankruptcy.</p><p>Specifically, it allows&nbsp;private student loans to be discharged in bankruptcy&nbsp;regardless of whether&nbsp;a debtor&nbsp;demonstrates&nbsp;undue hardship.&nbsp;Under current law,&nbsp;student loans may be discharged in bankruptcy only if the loans impose an undue hardship on the debtor.</p>","updateDate":"2025-03-28T15:27:01Z","versionCode":"00"}],"title":"Private Student Loan Bankruptcy Fairness Act of 2025","type":"hr","updateDate":"2026-09-19T23:07:39Z","updateDateIncludingText":"2026-09-19T23:07:39Z"}
