rshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"A000370","fullName":"Rep. Adams, Alma S. [D-NC-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-02","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-17T04:45:50+00:00","id":"hr9831-119","introducedDate":"2026-07-22","latestAction":{"actionDate":"2026-07-22","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"9831","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"B001300","district":44,"fullName":"Rep. Barragán, Nanette Diaz [D-CA-44]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2026-07-22","actionDesc":"Introduced in House","text":"<p><strong>Medicaid Dental Benefit Act</strong> <strong>of </strong><strong>2026</strong></p><p>This bill requires state Medicaid programs to cover dental and oral health services for adults. It also increases the Federal Medical Assistance Percentage (i.e., federal matching rate) for such services.</p><p>The Centers for Medicare &amp; Medicaid Services must develop oral health quality and equity measures and conduct outreach relating to such coverage. Additionally, the Medicaid and Children's Health Insurance Program (CHIP) Payment and Access Commission must report on specified information relating to adult oral health care.</p>","updateDate":"2026-08-25T20:30:36Z","versionCode":"00"}],"title":"Medicaid Dental Benefit Act of 2026","type":"hr","updateDate":"2026-09-03T08:06:24Z","updateDateIncludingText":"2026-09-03T08:06:24Z"}
