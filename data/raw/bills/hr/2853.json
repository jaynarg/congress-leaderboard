deId":"R000609","fullName":"Rep. Rutherford, John H. [R-FL-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-20","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"P000620","fullName":"Rep. Pettersen, Brittany [D-CO-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-22","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"M001234","fullName":"Rep. Morrison, Kelly [D-MN-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-22","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"N000193","fullName":"Rep. Nunn, Zachary [R-IA-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-22","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"J000302","fullName":"Rep. Joyce, John [R-PA-13]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-27","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"M001235","fullName":"Rep. Moore, Riley M. [R-WV-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-30","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"K000397","fullName":"Rep. Kim, Young [R-CA-40]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-30","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T14:20:47+00:00","id":"hr2853-119","introducedDate":"2025-04-10","latestAction":{"actionDate":"2026-05-13","text":"Received in the Senate and Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"2853","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"J000295","district":14,"fullName":"Rep. Joyce, David P. [R-OH-14]","party":"R","state":"OH"}],"summaries":[{"actionDate":"2026-01-30","actionDesc":"Reported to House","text":"<p><strong>Combating Organized Retail Crime Act of 2025<br/></strong></p><p>This bill expands federal enforcement of criminal offenses related to organized retail and supply chain crime. The term <em>organized retail and supply chain crime</em> includes criminal offenses involving the interstate transportation of stolen property, the sale or receipt of stolen goods, or theft from an interstate or foreign shipment&nbsp;that is committed by, in coordination with, or at the instruction of an organization.</p><p>First, with respect to criminal offenses involving the interstate transportation of stolen property or the sale or receipt of stolen goods, the bill broadens the scope of conduct that qualifies as offenses by allowing prosecutions to be based on the aggregate value of stolen items over a 12-month period. Additionally, the bill makes the offenses predicate offenses (i.e., underlying offenses) for prosecutions under the federal money laundering statute and authorizes the criminal forfeiture of any property obtained from the proceeds of an offense.</p><p>Second, with respect to criminal offenses involving theft from an interstate or foreign shipment, the bill also makes an offense an underlying offense for prosecution under the federal money laundering statute and authorizes the criminal forfeiture of any associated&nbsp;property.</p><p>Third, the bill expands the federal money laundering statute to include offenses involving general-use prepaid cards, gift certificates, or store&nbsp;gift cards.</p><p>Finally, the bill temporarily establishes a center&nbsp;within the Department of Homeland Security to coordinate federal law enforcement activities related to organized retail and supply chain crime.</p>","updateDate":"2026-04-08T16:43:22Z","versionCode":"07"}],"title":"Combating Organized Retail Crime Act of 2025","type":"hr","updateDate":"2026-09-19T23:34:29Z","updateDateIncludingText":"2026-09-19T23:34:29Z"}
