"fullName":"Rep. Pingree, Chellie [D-ME-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"H001081","fullName":"Rep. Hayes, Jahana [D-CT-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"CT"}],"fetchedAt":"2026-09-17T14:40:26+00:00","id":"hr6199-119","introducedDate":"2025-11-20","latestAction":{"actionDate":"2025-11-20","text":"Referred to the Committee on Energy and Commerce, and in addition to the Committee on Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"6199","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"K000385","district":2,"fullName":"Rep. Kelly, Robin L. [D-IL-2]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-11-20","actionDesc":"Introduced in House","text":"<p><strong>Medical Nutrition Therapy Act of </strong><strong>2025</strong></p><p>This bill expands Medicare coverage of medical nutrition therapy services.</p><p>Currently, Medicare covers such services for individuals with diabetes or kidney disease under certain circumstances; such services must also be provided by a registered dietitian or nutrition professional pursuant to a physician referral. The bill extends coverage to individuals with other diseases and conditions, including obesity, eating disorders, cancer, and HIV/AIDS; such services may also be referred by a physician assistant, nurse practitioner, clinical nurse specialist, or (for eating disorders) a clinical psychologist.</p>","updateDate":"2026-01-26T16:35:04Z","versionCode":"00"}],"title":"Medical Nutrition Therapy Act of 2025","type":"hr","updateDate":"2026-09-17T08:07:46Z","updateDateIncludingText":"2026-09-17T08:07:46Z"}
