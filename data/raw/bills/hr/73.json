{"actions":[{"actionCode":"H11100","actionDate":"2025-01-03","source":"House floor actions","text":"Referred to the House Committee on Ways and Means.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-03","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-03","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/73","cosponsors":[{"bioguideId":"A000372","fullName":"Rep. Allen, Rick W. [R-GA-12]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-03","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"M001212","fullName":"Rep. Moore, Barry [R-AL-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-03","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"J000302","fullName":"Rep. Joyce, John [R-PA-13]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-03","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"C001116","fullName":"Rep. Clyde, Andrew S. [R-GA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-16T18:40:11+00:00","id":"hr73-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-01-03","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"73","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"B001302","district":5,"fullName":"Rep. Biggs, Andy [R-AZ-5]","party":"R","state":"AZ"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>Abortion Is Not Health Care Act of 2025</strong></p><p>This bill excludes amounts paid for an abortion from the itemized tax deduction for qualified medical and dental expenses.&nbsp;</p><p>Under current law, individuals who itemize their tax deductions may deduct qualified medical and dental expenses to the extent that such expenses exceed 7.5% of the individual’s adjusted gross income for the tax year. Further, under current law, the calculation of the itemized tax deduction for medical and dental expenses may include amounts paid for a legal abortion.&nbsp;</p>","updateDate":"2025-02-04T14:42:44Z","versionCode":"00"}],"title":"Abortion Is Not Health Care Act of 2025","type":"hr","updateDate":"2026-04-14T08:05:42Z","updateDateIncludingText":"2026-04-14T08:05:42Z"}
