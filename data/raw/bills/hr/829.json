{"actions":[{"actionCode":"H11100","actionDate":"2025-01-31","source":"House floor actions","text":"Referred to the House Committee on the Budget.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/829","cosponsors":[{"bioguideId":"F000246","fullName":"Rep. Fallon, Pat [R-TX-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"W000806","fullName":"Rep. Webster, Daniel [R-FL-11]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"N000193","fullName":"Rep. Nunn, Zachary [R-IA-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"C001055","fullName":"Rep. Case, Ed [D-HI-1]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-18","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"S001225","fullName":"Rep. Sorensen, Eric [D-IL-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-07","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-06","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T19:22:34+00:00","id":"hr829-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on the Budget."},"laws":[],"number":"829","originChamber":"House","policyArea":"Economics and Public Finance","sponsors":[{"bioguideId":"P000614","district":1,"fullName":"Rep. Pappas, Chris [D-NH-1]","party":"D","state":"NH"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><b>Fighting Presidential Budget Waste Act</b></p> <p>This bill requires the President and the Office of Management and Budget (OMB) to consider the Government Accountability Office's (GAO's) annual report on ways to improve the efficiency and effectiveness of the federal government when preparing the President's annual budget. </p> <p>Specifically, the President and OMB must consider the information and recommendations contained in the most recent GAO report titled<i> Additional Opportunities to Reduce Fragmentation, Overlap, and Duplication and Achieve Billions of Dollars in Financial Benefits. </i></p>","updateDate":"2025-05-02T15:28:17Z","versionCode":"00"}],"title":"Fighting Budget Waste Act","type":"hr","updateDate":"2026-09-08T19:31:27Z","updateDateIncludingText":"2026-09-08T19:31:27Z"}
