sorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"B001323","fullName":"Rep. Begich, Nicholas J. [R-AK-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-21","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"H001090","fullName":"Rep. Harder, Josh [D-CA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-21","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001212","fullName":"Rep. Stauber, Pete [R-MN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-22","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M001240","fullName":"Rep. McDowell, Addison P. [R-NC-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-08","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"F000469","fullName":"Rep. Fulcher, Russ [R-ID-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"E000301","fullName":"Rep. Elfreth, Sarah [D-MD-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-05","sponsorshipWithdrawnDate":null,"state":"MD"}],"fetchedAt":"2026-09-16T18:51:57+00:00","id":"hr301-119","introducedDate":"2025-01-09","latestAction":{"actionDate":"2026-05-20","text":"Placed on the Union Calendar, Calendar No. 568."},"laws":[],"number":"301","originChamber":"House","policyArea":"Energy","sponsors":[{"bioguideId":"M001228","district":2,"fullName":"Rep. Maloy, Celeste [R-UT-2]","party":"R","state":"UT"}],"summaries":[{"actionDate":"2025-01-09","actionDesc":"Introduced in House","text":"<p><strong>Geothermal Energy Opportunity Act or the GEO Act</strong></p><p>This bill expands the Geothermal Steam Act of 1970 to establish a deadline for the Department of the Interior to process applications related to geothermal leases. Specifically, Interior must process each application for a geothermal drilling permit or other authorization under a valid existing geothermal lease within 60 days after completing all requirements under applicable federal laws and regulations (including the National Environmental Policy Act of 1969, the Endangered Species Act of 1973, and the National Historic Preservation Act) unless a U.S. federal court vacates or provides injunctive relief for the underlying lease. &nbsp;</p>","updateDate":"2025-03-12T12:53:45Z","versionCode":"00"}],"title":"GEO Act","type":"hr","updateDate":"2026-07-23T23:06:20Z","updateDateIncludingText":"2026-07-23T23:06:20Z"}
