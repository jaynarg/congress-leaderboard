oguideId":"G000587","fullName":"Rep. Garcia, Sylvia R. [D-TX-29]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"P000617","fullName":"Rep. Pressley, Ayanna [D-MA-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"G000586","fullName":"Rep. García, Jesús G. \"Chuy\" [D-IL-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"C001067","fullName":"Rep. Clarke, Yvette D. [D-NY-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-03","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001231","fullName":"Rep. Simon, Lateefah [D-CA-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-09","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001220","fullName":"Rep. McGarvey, Morgan [D-KY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"C001080","fullName":"Rep. Chu, Judy [D-CA-28]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-12","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001188","fullName":"Rep. Meng, Grace [D-NY-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-03","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"E000296","fullName":"Rep. Evans, Dwight [D-PA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"J000298","fullName":"Rep. Jayapal, Pramila [D-WA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-16","sponsorshipWithdrawnDate":null,"state":"WA"}],"fetchedAt":"2026-09-16T22:16:20+00:00","id":"hr4682-119","introducedDate":"2025-07-23","latestAction":{"actionDate":"2025-07-23","text":"Referred to the Committee on the Judiciary, and in addition to the Committee on Oversight and Government Reform, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"4682","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"K000400","district":37,"fullName":"Rep. Kamlager-Dove, Sydney [D-CA-37]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-07-23","actionDesc":"Introduced in House","text":"<p><strong>End Solitary Confinement Act</strong></p><p>This bill restricts the use of solitary confinement and establishes minimum standards for incarceration at the federal, state, and local levels.</p><p>At the federal level, the bill generally prohibits the use of solitary confinement in federal facilities with limited exceptions, such as if necessary to de-escalate an emergency situation. The bill also establishes minimum standards for incarceration,&nbsp;including at least 14 hours per day of out-of-cell congregate interaction in a shared space that is conducive to meaningful group interaction.</p><p>The bill requires state and local governments to implement laws, policies, and programs that substantially comply with the restrictions on solitary confinement and minimum standards for incarceration in order to receive full funding under the Edward Byrne Memorial Justice Assistance Grant program.</p><p>The bill establishes an independent community monitoring body, as well as an advisory body of stakeholders, to help provide oversight.</p><p>Finally, the bill allows a prisoner to file a federal civil action for mental or emotional injury suffered if there is a prior showing of placement in solitary confinement or an alternative unit.</p>","updateDate":"2026-06-01T21:45:45Z","versionCode":"00"}],"title":"End Solitary Confinement Act","type":"hr","updateDate":"2026-07-18T00:02:29Z","updateDateIncludingText":"2026-07-18T00:02:29Z"}
