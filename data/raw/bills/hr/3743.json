ty":"D","sponsorshipDate":"2025-11-12","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"M001227","fullName":"Rep. McClellan, Jennifer L. [D-VA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-20","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"W000788","fullName":"Rep. Williams, Nikema [D-GA-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-21","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"V000129","fullName":"Rep. Valadao, David G. [R-CA-22]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-01","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001315","fullName":"Rep. Budzinski, Nikki [D-IL-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-12","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"M001208","fullName":"Rep. McBath, Lucy [D-GA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-17","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"L000582","fullName":"Rep. Lieu, Ted [D-CA-36]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-17","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001193","fullName":"Rep. Swalwell, Eric [D-CA-14]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001157","fullName":"Rep. Scott, David [D-GA-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-16","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-16T21:36:31+00:00","id":"hr3743-119","introducedDate":"2025-06-04","latestAction":{"actionDate":"2025-06-04","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"3743","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"V000138","district":7,"fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","party":"D","state":"VA"}],"summaries":[{"actionDate":"2025-06-04","actionDesc":"Introduced in House","text":"<p><strong>Supporting Healthy Mothers and Infants Act of 2025</strong></p><p>This bill modifies the Special Supplemental Nutrition Program for Women, Infants, and Children (WIC) to add requirements for supporting individuals impacted by a substance use disorder.</p><p>Specifically, the bill requires the Department of Agriculture to</p><ul><li>collaborate with the Department of Health and Human Services (HHS) to develop and disseminate nutrition education materials for individuals impacted by a substance use disorder, including materials for infants impacted by prenatal substance exposure and neonatal abstinence syndrome;</li><li>conduct outreach to individuals who are potentially eligible for the WIC program and who are impacted by such a disorder; and</li><li>make available to states through an online clearinghouse any nutrition education and training materials related to nutrition for individuals impacted by a substance use disorder or neonatal abstinence syndrome.</li></ul><p>In addition, the nutrition education materials developed in collaboration with HHS must be included in (1) Center for Substance Abuse Prevention-developed education materials, and (2) HHS guidance on improving care for infants with neonatal abstinence syndrome and their families.</p><p>Under current law, the WIC program includes certain education&nbsp;related to drug abuse. This bill replaces references to drug abuse with substance use disorder.</p>","updateDate":"2025-07-25T14:33:09Z","versionCode":"00"}],"title":"Supporting Healthy Mothers and Infants Act of 2025","type":"hr","updateDate":"2026-01-17T09:05:58Z","updateDateIncludingText":"2026-01-17T09:05:58Z"}
