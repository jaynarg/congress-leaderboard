y":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"N000189","fullName":"Rep. Newhouse, Dan [R-WA-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"R000619","fullName":"Rep. Rulli, Michael A. [R-OH-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"G000558","fullName":"Rep. Guthrie, Brett [R-KY-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"M001239","fullName":"Rep. McGuire, John [R-VA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"N000193","fullName":"Rep. Nunn, Zachary [R-IA-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"IA"},{"bioguideId":"D000634","fullName":"Rep. Downing, Troy [R-MT-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"H001082","fullName":"Rep. Hern, Kevin [R-OK-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"T000165","fullName":"Rep. Tiffany, Thomas P. [R-WI-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-14","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"C001118","fullName":"Rep. Cline, Ben [R-VA-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-14","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-20T13:51:46+00:00","id":"hr28-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-01-15","text":"Received in the Senate."},"laws":[],"number":"28","originChamber":"House","policyArea":"Civil Rights and Liberties, Minority Issues","sponsors":[{"bioguideId":"S001214","district":17,"fullName":"Rep. Steube, W. Gregory [R-FL-17]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>Protection of Women and Girls in Sports Act of 2025</strong></p><p>This bill generally prohibits school athletic programs from allowing individuals whose biological sex at birth was male to participate in programs that are for women or girls.</p><p>Specifically, the bill provides that it is a violation of Title IX of the Education Amendments of 1972 for federally funded education programs or activities to operate, sponsor, or facilitate athletic programs or activities that allow individuals of the male sex to participate in programs or activities that are designated for women or girls. (Title IX prohibits discrimination on the basis of sex in federally funded education programs or activities, including in public elementary and secondary schools and in colleges and universities.) Under the bill,<em> sex</em> is based on an individual's reproductive biology and genetics at birth.</p><p>The bill does not prohibit male individuals from training or practicing with programs or activities for women or girls as long as such training or practice does not deprive any female of corresponding opportunities or benefits.</p><p>The Government Accountability Office must report on the benefits for women or girls in single-sex sports that would be lost as a result of male participation. In particular, the report must document the negative psychological, developmental, participatory, and sociological effects of male participation on girls.</p>","updateDate":"2025-01-15T22:50:04Z","versionCode":"00"}],"title":"Protection of Women and Girls in Sports Act of 2025","type":"hr","updateDate":"2026-09-19T23:06:49Z","updateDateIncludingText":"2026-09-19T23:06:49Z"}
