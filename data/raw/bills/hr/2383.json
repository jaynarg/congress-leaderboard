drawnDate":null,"state":"CA"},{"bioguideId":"B001327","fullName":"Rep. Bresnahan, Robert P. [R-PA-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-11-05T17:46:01+00:00","id":"hr2383-119","introducedDate":"2025-03-26","latestAction":{"actionDate":"2025-03-26","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"2383","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"N000191","district":2,"fullName":"Rep. Neguse, Joe [D-CO-2]","party":"D","state":"CO"}],"summaries":[{"actionDate":"2025-03-26","actionDesc":"Introduced in House","text":"<p><strong>Protecting Kids from Fentanyl Act of 2025</strong></p><p>This bill permits the use of the Preventive Health and Health Services Block Grant to address fentanyl in educational institutions. Specifically, grant funds may be used to (1) purchase naloxone or other opioid overdose reversal drugs for educational institutions, (2) train school nurses and other personnel on how to administer&nbsp;them, and (3) provide fentanyl awareness classes or materials to students.</p>","updateDate":"2026-11-04T22:55:34Z","versionCode":"00"}],"title":"Protecting Kids from Fentanyl Act of 2025","type":"hr","updateDate":"2026-11-04T22:56:17Z","updateDateIncludingText":"2026-11-04T22:56:17Z"}
