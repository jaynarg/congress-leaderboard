{"actions":[{"actionCode":"H11100","actionDate":"2025-01-13","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-13","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-13","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/350","cosponsors":[{"bioguideId":"W000814","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"V000134","fullName":"Rep. Van Duyne, Beth [R-TX-24]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"E000071","fullName":"Rep. Ellzey, Jake [R-TX-6]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"J000302","fullName":"Rep. Joyce, John [R-PA-13]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"I000056","fullName":"Rep. Issa, Darrell [R-CA-48]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"L000583","fullName":"Rep. Loudermilk, Barry [R-GA-11]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-13","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"L000585","fullName":"Rep. LaHood, Darin [R-IL-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"K000398","fullName":"Rep. Kean, Thomas H. [R-NJ-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-31","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-16T18:58:31+00:00","id":"hr350-119","introducedDate":"2025-01-13","latestAction":{"actionDate":"2025-01-13","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"350","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"M000317","district":11,"fullName":"Rep. Malliotakis, Nicole [R-NY-11]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-01-13","actionDesc":"Introduced in House","text":"<p><b>Prosecutors Need to Prosecute Act</b></p> <p>This bill requires certain state and local prosecutors to report data on criminal referrals and outcomes of cases involving murder or non-negligent manslaughter, forcible rape, robbery, aggravated assault, burglary, larceny, motor vehicle theft, arson, or any offense involving the illegal use or possession of a firearm. </p> <p>The reporting requirement applies to state and local prosecutors in a jurisdiction with 380,000 or more persons that receives funding under the Edward Byrne Memorial Justice Assistance Grant program. The report must contain data on</p> <ul> <li>cases referred for prosecution, </li> <li>cases declined for prosecution,</li> <li>cases resulting in a plea agreement with the defendant,</li> <li>cases initiated against defendants with previous arrests or convictions, and</li> <li>defendants charged who were released or eligible for bail. </li> </ul>","updateDate":"2025-04-22T20:06:53Z","versionCode":"00"}],"title":"Prosecutors Need to Prosecute Act","type":"hr","updateDate":"2025-11-01T08:05:40Z","updateDateIncludingText":"2025-11-01T08:05:40Z"}
