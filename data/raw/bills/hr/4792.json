sOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001216","fullName":"Rep. Schrier, Kim [D-WA-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"L000600","fullName":"Rep. Langworthy, Nicholas A. [R-NY-23]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-25","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"J000302","fullName":"Rep. Joyce, John [R-PA-13]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-16T22:20:58+00:00","id":"hr4792-119","introducedDate":"2025-07-29","latestAction":{"actionDate":"2025-07-29","text":"Referred to the Committee on Energy and Commerce, and in addition to the Committee on Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"4792","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"E000298","district":4,"fullName":"Rep. Estes, Ron [R-KS-4]","party":"R","state":"KS"}],"summaries":[{"actionDate":"2025-07-29","actionDesc":"Introduced in House","text":"<p><strong>Protecting Air Ambulance Services for Americans Act of 2025</strong></p><p>This bill authorizes payment changes under Medicare for air ambulance services based on certain collected data and requires additional reporting from providers of these services.</p><p>Current law requires providers of air ambulance services to report certain information regarding general costs and utilization to the Department of Health and Human Services; private health insurers are also required to report information relating to coverage of these services. The bill authorizes the Centers for Medicare &amp; Medicaid Services to revise payment rates under Medicare for air ambulance services based on this data, and it requires providers of air ambulance services to specifically report information relating to costs and utilization under Medicare.</p><p>The bill also requires the Government Accountability Office to report on the data that is collected under current law requirements and to recommend changes to Medicare payment rates accordingly.</p>","updateDate":"2025-12-02T16:47:04Z","versionCode":"00"}],"title":"Protecting Air Ambulance Services for Americans Act of 2025","type":"hr","updateDate":"2026-09-02T08:06:43Z","updateDateIncludingText":"2026-09-02T08:06:43Z"}
