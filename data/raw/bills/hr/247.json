uideId":"S001157","fullName":"Rep. Scott, David [D-GA-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"V000081","fullName":"Rep. Velázquez, Nydia M. [D-NY-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"H001047","fullName":"Rep. Himes, James A. [D-CT-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"S000510","fullName":"Rep. Smith, Adam [D-WA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-14","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-14","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"F000110","fullName":"Rep. Fields, Cleo [D-LA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-06","sponsorshipWithdrawnDate":null,"state":"LA"}],"fetchedAt":"2026-09-16T18:49:02+00:00","id":"hr247-119","introducedDate":"2025-01-09","latestAction":{"actionDate":"2025-01-09","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"247","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"U000040","district":14,"fullName":"Rep. Underwood, Lauren [D-IL-14]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-01-09","actionDesc":"Introduced in House","text":"<p><strong>Health Care Affordability Act of 2025</strong></p><p>This bill makes permanent temporary changes enacted by the American Rescue Plan Act of 2021 (ARPA) and the Inflation Reduction Act of 2022 (IRA) that generally expand eligibility for and increase the amount of the premium tax credit.</p><p>Currently, eligible taxpayers may be able to claim the premium tax credit, which applies toward the cost of obtaining health insurance through health insurance exchanges. To be eligible for the premium tax credit, a taxpayer’s household income must meet or exceed 100% of the federal poverty level (FPL) and, after 2025, may not exceed 400% of the FPL (maximum income limit). For 2021-2025, the ARPA and IRA eliminated the maximum income limit, which generally expands eligibility for the premium tax credit.</p><p>Further, under current law, the amount of the premium tax credit is (1) generally the plan premium (conditions apply), minus (2) the taxpayer’s household income multiplied by the applicable percentage. The applicable percentage is a specific percentage that varies depending on which of six income ranges (adjusted for inflation after 2025) the taxpayer’s household income falls within. For 2021-2025, the ARPA and IRA lowered the applicable percentages and eliminated the adjustment of the applicable percentages for inflation, which generally increases the amount of the premium tax credit.</p><p>The bill makes permanent the elimination of the 400% maximum income limit, the lower applicable percentages, and the elimination of the inflation adjustment for the applicable percentages.</p>","updateDate":"2025-09-18T19:05:04Z","versionCode":"00"}],"title":"Health Care Affordability Act of 2025","type":"hr","updateDate":"2026-07-18T00:01:20Z","updateDateIncludingText":"2026-07-18T00:01:20Z"}
