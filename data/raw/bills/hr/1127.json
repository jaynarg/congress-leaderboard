{"actions":[{"actionCode":"H11100","actionDate":"2025-02-07","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1127","cosponsors":[{"bioguideId":"B001315","fullName":"Rep. Budzinski, Nikki [D-IL-13]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-07","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"H001086","fullName":"Rep. Harshbarger, Diana [R-TN-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"D000230","fullName":"Rep. Davis, Donald G. [D-NC-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-10-07T17:06:28+00:00","id":"hr1127-119","introducedDate":"2025-02-07","latestAction":{"actionDate":"2025-02-07","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1127","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"K000392","district":8,"fullName":"Rep. Kustoff, David [R-TN-8]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-02-07","actionDesc":"Introduced in House","text":"<p><strong>Rural America Health Corps Act</strong></p><p>This bill establishes a student loan repayment demonstration program for eligible providers who agree to work for five years in a rural area with a shortage of primary, dental, or mental health care providers. For each year of this service, the Department of Health and Human Services must pay one-fifth of the principal and interest on a provider's qualifying