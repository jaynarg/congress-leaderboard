ame":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-27","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"G000581","fullName":"Rep. Gonzalez, Vicente [D-TX-34]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-22","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M000317","fullName":"Rep. Malliotakis, Nicole [R-NY-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-26","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T19:20:57+00:00","id":"hr801-119","introducedDate":"2025-01-28","latestAction":{"actionDate":"2025-01-28","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"801","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"M001213","district":1,"fullName":"Rep. Moore, Blake D. [R-UT-1]","party":"R","state":"UT"}],"summaries":[{"actionDate":"2025-01-28","actionDesc":"Introduced in House","text":"<p><strong>Charitable Act</strong></p><p>This bill allows an individual taxpayer who does not itemize their tax deductions to claim a tax deduction for charitable contributions and eliminates the tax penalty for overstating charitable contributions. (Some limitations apply).</p><p>Under the bill, for tax years beginning in 2026 or 2027, an individual taxpayer who does not itemize their tax deductions may deduct charitable contributions of up to one-third of the standard deduction allowed to such individual. (Under current law, an individual taxpayer generally must itemize their tax deductions to deduct charitable contributions.)</p><p>The bill also eliminates the tax penalty for an underpayment of taxes attributable to overstated charitable contributions by taxpayers who do not itemize deductions. (Under current law, taxpayers who claim a deduction under this bill may be assessed a tax penalty in the amount of 50% of the portion of an understatement of tax liability attributable to overstated charitable contributions.)</p>","updateDate":"2025-05-29T18:00:15Z","versionCode":"00"}],"title":"Charitable Act","type":"hr","updateDate":"2025-12-05T21:59:15Z","updateDateIncludingText":"2025-12-05T21:59:15Z"}
