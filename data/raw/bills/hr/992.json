orshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"S001224","fullName":"Rep. Self, Keith [R-TX-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-07","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001325","fullName":"Rep. Biggs, Sheri [R-SC-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-12","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-27","sponsorshipWithdrawnDate":null,"state":"MD"}],"fetchedAt":"2026-09-16T19:30:52+00:00","id":"hr992-119","introducedDate":"2025-02-05","latestAction":{"actionDate":"2025-02-05","text":"Referred to the Subcommittee on Highways and Transit."},"laws":[],"number":"992","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"C001115","district":27,"fullName":"Rep. Cloud, Michael [R-TX-27]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-02-05","actionDesc":"Introduced in House","text":"<p><strong>Preventing Aliens Through Rivers or Land Act or the PATROL Act</strong></p><p>This bill prohibits the Department of Justice (DOJ) from bringing certain civil actions against a state for building a physical structure impacting navigable waters along the U.S. border for security purposes. Specifically, the&nbsp;DOJ is prohibited from bringing an action for (1) the construction of a bridge, causeway, dam, dike, or other structure over or in a port, harbor, or other navigable water of the United States without federal approval; or (2) the creation of any obstruction to the navigable capacity of waters of the United States without federal approval.</p>","updateDate":"2025-07-30T18:15:49Z","versionCode":"00"}],"title":"PATROL Act","type":"hr","updateDate":"2025-07-30T18:16:37Z","updateDateIncludingText":"2025-07-30T18:16:37Z"}
