-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001227","fullName":"Rep. McClellan, Jennifer L. [D-VA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-10","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"M001163","fullName":"Rep. Matsui, Doris O. [D-CA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-10","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"D000530","fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"K000375","fullName":"Rep. Keating, William R. [D-MA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-11","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-11","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"W000788","fullName":"Rep. Williams, Nikema [D-GA-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-02","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"T000482","fullName":"Rep. Trahan, Lori [D-MA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-13","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"R000621","fullName":"Rep. Randall, Emily [D-WA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-23","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"S001230","fullName":"Rep. Subramanyam, Suhas [D-VA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-09","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"K000402","fullName":"Rep. Kennedy, Timothy M. [D-NY-26]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-17","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-20T14:27:19+00:00","id":"hr3644-119","introducedDate":"2025-05-29","latestAction":{"actionDate":"2025-05-29","text":"Referred to the Committee on Education and Workforce, and in addition to the Committees on the Judiciary, Financial Services, Energy and Commerce, Transportation and Infrastructure, Ways and Means, and the Budget, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"3644","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"M001188","district":6,"fullName":"Rep. Meng, Grace [D-NY-6]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-05-29","actionDesc":"Introduced in House","text":"<p><strong>Menstrual Equity For All Act of 2025</strong></p><p>This bill expands access to menstrual products (e.g., tampons) in certain locations and for particular groups, such as in schools and for low-income individuals, through federal programs and requirements. It also prohibits state or local sales taxes for these products.&nbsp;</p><p>The bill expands access to menstrual products through federal programs by</p><ul><li>requiring Medicaid to cover such products,</li><li>establishing grants within the Temporary Assistance for Needy Families (TANF)&nbsp;program to provide benefits to ensure access to such products,</li><li>authorizing the Emergency Food and Shelter Program to provide menstrual products to homeless individuals, and</li><li>increasing Social Services Block Grant funding to provide such products to low-income individuals.</li></ul><p>Also, the bill sets out requirements to make free menstrual products available in federal and state correctional facilities (including Department of Homeland Security detention facilities) and restrooms in federal buildings that are open to the public.</p><p>Further, the bill (1) establishes grants to provide free menstrual products to students at institutions of higher education, and (2) permits elementary and secondary schools to use certain grant funds to provide menstrual products to students.</p><p>In addition, the bill requires employers with at least 100 employees to provide free menstrual products for employees.</p><p>Finally, the bill prohibits states and local governments from taxing retail sales of menstrual products.</p>","updateDate":"2026-04-16T21:09:37Z","versionCode":"00"}],"title":"Menstrual Equity For All Act of 2025","type":"hr","updateDate":"2026-09-19T23:21:38Z","updateDateIncludingText":"2026-09-19T23:21:38Z"}
