isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-10","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"D000623","fullName":"Rep. DeSaulnier, Mark [D-CA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-12","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001246","fullName":"Rep. Mejia, Analilia [D-NJ-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"T000460","fullName":"Rep. Thompson, Mike [D-CA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"E000301","fullName":"Rep. Elfreth, Sarah [D-MD-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-08","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"W000808","fullName":"Rep. Wilson, Frederica S. [D-FL-24]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001066","fullName":"Rep. Horsford, Steven [D-NV-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-15","sponsorshipWithdrawnDate":null,"state":"NV"}],"fetchedAt":"2026-09-16T19:19:24+00:00","id":"hr768-119","introducedDate":"2025-01-28","latestAction":{"actionDate":"2025-01-28","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"768","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"G000583","district":5,"fullName":"Rep. Gottheimer, Josh [D-NJ-5]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2025-01-28","actionDesc":"Introduced in House","text":"<p><b>Holocaust Education and Antisemitism Lessons Act</b></p> <p>This bill directs the U.S. Holocaust Memorial Museum to study and report on Holocaust education efforts in states, local educational agencies (LEAs), and public elementary and secondary schools. Among other elements, the study must (1) determine whether states and LEAs require Holocaust education as part of the curriculum taught in public elementary and secondary schools, (2) identify the standards and requirements relating to Holocaust education, and (3) identify the types of instructional material used to teach students about the Holocaust.</p>","updateDate":"2025-03-21T17:54:21Z","versionCode":"00"}],"title":"Holocaust Education and Antisemitism Lessons Act","type":"hr","updateDate":"2026-09-16T08:09:27Z","updateDateIncludingText":"2026-09-16T08:09:27Z"}
