,"state":"CA"},{"bioguideId":"C001068","fullName":"Rep. Cohen, Steve [D-TN-9]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"M001206","fullName":"Rep. Morelle, Joseph D. [D-NY-25]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"D000623","fullName":"Rep. DeSaulnier, Mark [D-CA-10]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001117","fullName":"Rep. Casten, Sean [D-IL-6]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"K000389","fullName":"Rep. Khanna, Ro [D-CA-17]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M000312","fullName":"Rep. McGovern, James P. [D-MA-2]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"E000297","fullName":"Rep. Espaillat, Adriano [D-NY-13]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S000344","fullName":"Rep. Sherman, Brad [D-CA-32]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001231","fullName":"Rep. Simon, Lateefah [D-CA-12]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-17","sponsorshipWithdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-09-16T23:14:45+00:00","id":"hr6116-119","introducedDate":"2025-11-18","latestAction":{"actionDate":"2025-11-18","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"6116","originChamber":"House","policyArea":"Environmental Protection","sponsors":[{"bioguideId":"S001145","district":9,"fullName":"Rep. Schakowsky, Janice D. [D-IL-9]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-11-18","actionDesc":"Introduced in House","text":"<p><strong>Safe Hydration is an American Right in Energy Development Act of 2025</strong></p><p>This bill requires hydraulic fracturing operations to test for and report on&nbsp;underground sources of drinking water that are contaminated by&nbsp;such operations. Hydraulic fracturing, or fracking, is a process to extract underground resources such as oil or gas from a geologic formation by injecting water, a propping agent (e.g., sand), and chemical additives into a well under enough pressure to fracture the geological formation.</p><p>Specifically, this bill modifies&nbsp;requirements governing state underground injection control programs. In order to obtain primary enforcement responsibility for&nbsp;such&nbsp;programs, states must prohibit the underground injection of fluids or propping agents pursuant to hydraulic fracturing operations related to oil, gas, or geothermal production activities unless the hydraulic fracturing operations agree to test for and report on contamination of drinking water.</p><p>Hydraulic fracturing operations are exempted from those testing and reporting requirements if there is no accessible underground source of drinking water within a radius of one mile of the site where the operations occur.</p><p>The Environmental&nbsp;Protection Agency&nbsp;must establish and maintain a publicly accessible and searchable database of the testing results.</p>","updateDate":"2026-04-10T11:59:34Z","versionCode":"00"}],"title":"Safe Hydration is an American Right in Energy Development Act of 2025","type":"hr","updateDate":"2026-04-10T11:59:48Z","updateDateIncludingText":"2026-04-10T11:59:48Z"}
