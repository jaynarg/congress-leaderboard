0578","fullName":"Rep. LaMalfa, Doug [R-CA-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"G000576","fullName":"Rep. Grothman, Glenn [R-WI-6]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"W000816","fullName":"Rep. Williams, Roger [R-TX-25]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"G000597","fullName":"Rep. Garbarino, Andrew R. [R-NY-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-19","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-20T14:19:29+00:00","id":"hr2702-119","introducedDate":"2025-04-08","latestAction":{"actionDate":"2025-06-20","text":"Placed on the Union Calendar, Calendar No. 131."},"laws":[],"number":"2702","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"B001282","district":6,"fullName":"Rep. Barr, Andy [R-KY-6]","party":"R","state":"KY"}],"summaries":[{"actionDate":"2025-04-08","actionDesc":"Introduced in House","text":"<p><strong>Financial Integrity and Regulation Management Act or the FIRM Act</strong></p><p>This bill prohibits the consideration of&nbsp;reputational risk by federal banking agencies when regulating, examining, or supervising a depository institution or credit union. The bill defines <em>reputational risk</em> as the potential for negative publicity or public attention to decrease confidence in the institution, lead to litigation, reduce revenues, or result in other adverse impacts to the institution.&nbsp;</p><p>Agencies must report on the implementation of this bill.&nbsp;</p>","updateDate":"2026-04-13T15:06:16Z","versionCode":"00"}],"title":"FIRM Act","type":"hr","updateDate":"2026-09-19T23:16:44Z","updateDateIncludingText":"2026-09-19T23:16:44Z"}
