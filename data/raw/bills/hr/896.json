{"actions":[{"actionCode":"H11100","actionDate":"2025-01-31","source":"House floor actions","text":"Referred to the House Committee on Education and Workforce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/896","cosponsors":[{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"S001157","fullName":"Rep. Scott, David [D-GA-13]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"D000230","fullName":"Rep. Davis, Donald G. [D-NC-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001225","fullName":"Rep. Sorensen, Eric [D-IL-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-06","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"H001090","fullName":"Rep. Harder, Josh [D-CA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T19:25:50+00:00","id":"hr896-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"896","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"S001207","district":11,"fullName":"Rep. Sherrill, Mikie [D-NJ-11]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><strong>Expanding Access to High-Impact Tutoring Act of 2025</strong></p><p>This bill directs the Department of Education (ED) to award grants to state educational agencies and, through them, subgrants to local educational agencies (LEAs) for implementing, administering, and evaluating tutoring programs in elementary and secondary schools.</p><p>Additionally, the bill directs ED to establish an advisory board. Among its duties, the advisory board must (1) evaluate and approve plans to ensure that LEAs will meet tutoring program requirements, (2) provide technical assistance and guidance to grant recipients, and (3) develop a nationwide tutoring workforce.</p>","updateDate":"2025-03-24T16:35:38Z","versionCode":"00"}],"title":"Expanding Access to High-Impact Tutoring Act of 2025","type":"hr","updateDate":"2025-07-21T19:44:15Z","updateDateIncludingText":"2025-07-21T19:44:15Z"}
