deId":"B001316","fullName":"Rep. Burlison, Eric [R-MO-7]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"L000600","fullName":"Rep. Langworthy, Nicholas A. [R-NY-23]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S000250","fullName":"Rep. Sessions, Pete [R-TX-17]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"H001077","fullName":"Rep. Higgins, Clay [R-LA-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"LA"},{"bioguideId":"B000825","fullName":"Rep. Boebert, Lauren [R-CO-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"T000480","fullName":"Rep. Timmons, William R. [R-SC-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-13","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"P000048","fullName":"Rep. Pfluger, August [R-TX-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M000194","fullName":"Rep. Mace, Nancy [R-SC-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"M001239","fullName":"Rep. McGuire, John [R-VA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"G000565","fullName":"Rep. Gosar, Paul A. [R-AZ-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"AZ"}],"fetchedAt":"2026-09-16T19:45:39+00:00","id":"hr1295-119","introducedDate":"2025-02-13","latestAction":{"actionDate":"2026-01-27","text":"Placed on the Union Calendar, Calendar No. 397."},"laws":[],"number":"1295","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"C001108","district":1,"fullName":"Rep. Comer, James [R-KY-1]","party":"R","state":"KY"}],"summaries":[{"actionDate":"2025-02-13","actionDesc":"Introduced in House","text":"<p><strong>Reorganizing Government Act of 2025</strong><br/>&nbsp;<br/>This bill revives expedited congressional consideration of certain Presidential plans to reorganize the executive branch, expands permissible plan purposes, and changes the prohibitions on plan content.<br/>&nbsp;<br/>The bill reauthorizes through 2026 a currently expired authority that requires expedited congressional consideration of certain executive branch reorganization plans submitted by the President.&nbsp;<br/>&nbsp;<br/>The bill also expands the purposes for which such reorganization plans may be undertaken, to include</p><ul><li>reducing the number of federal employees;</li><li>eliminating unnecessary and burdensome rules, regulations, and other requirements; and</li><li>eliminating government operations that do not serve the public interest.</li></ul><p>The bill removes the following prohibitions on the contents of such plans:&nbsp;</p><ul><li>creating new executive departments or renaming existing executive departments;&nbsp;</li><li>abolishing or transferring executive departments or independent regulatory agencies or all of their functions; and</li><li>consolidating executive departments or independent regulatory agencies or all of their functions.</li></ul><p>The bill also adds a new prohibition on content, specifying that any such plan may not create a net increase in federal workers or expenditures.</p>","updateDate":"2026-01-21T23:55:26Z","versionCode":"00"}],"title":"Reorganizing Government Act of 2025","type":"hr","updateDate":"2026-06-11T23:26:36Z","updateDateIncludingText":"2026-06-11T23:26:36Z"}
