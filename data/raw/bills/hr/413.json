drawnDate":null,"state":"MI"},{"bioguideId":"V000133","fullName":"Rep. Van Drew, Jefferson [R-NJ-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-14","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-16T19:01:40+00:00","id":"hr413-119","introducedDate":"2025-01-15","latestAction":{"actionDate":"2025-01-15","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"413","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"B000740","district":5,"fullName":"Rep. Bice, Stephanie I. [R-OK-5]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2025-01-15","actionDesc":"Introduced in House","text":"<p><strong>Combating High Inflation Limiting Daycare Act of 2025 or the CHILD Act of 2025</strong></p><p>This bill increases the maximum annual amount that may be contributed to a dependent care assistance program (generally known as a dependent care flexible spending account [FSA]).</p><p>Under the bill, the maximum annual amount that may be contributed to a dependent care&nbsp;FSA increases from $5,000 ($2,500 for married taxpayers who file separate federal tax returns) to $10,000 ($5,000 for married taxpayers who file separate federal tax returns) and is adjusted annually for inflation.</p>","updateDate":"2025-03-24T14:17:13Z","versionCode":"00"}],"title":"CHILD Act of 2025","type":"hr","updateDate":"2026-07-18T00:05:34Z","updateDateIncludingText":"2026-07-18T00:05:34Z"}
