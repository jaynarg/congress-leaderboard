nsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"W000830","fullName":"Rep. Whitesides, George [D-CA-27]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000483","fullName":"Rep. Friedman, Laura [D-CA-30]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001232","fullName":"Rep. McClain Delaney, April [D-MD-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"T000469","fullName":"Rep. Tonko, Paul [D-NY-20]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"H001068","fullName":"Rep. Huffman, Jared [D-CA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"M001227","fullName":"Rep. McClellan, Jennifer L. [D-VA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"F000468","fullName":"Rep. Fletcher, Lizzie [D-TX-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-01","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-01","sponsorshipWithdrawnDate":null,"state":"CO"}],"fetchedAt":"2026-09-16T20:29:39+00:00","id":"hr2210-119","introducedDate":"2025-03-18","latestAction":{"actionDate":"2025-03-18","text":"Referred to the House Committee on Science, Space, and Technology."},"laws":[],"number":"2210","originChamber":"House","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"L000397","district":18,"fullName":"Rep. Lofgren, Zoe [D-CA-18]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-03-18","actionDesc":"Introduced in House","text":"<p><strong>Saving NASA’s Workforce Act</strong></p><p>This bill prohibits the National Aeronautics and Space Administration (NASA) from initiating or implementing any reduction in its workforce until FY2026 full-year appropriations for NASA have been enacted. During this period, NASA is also prohibited from conducting involuntary separations for employees in the competitive service, career employees in the excepted service, and career appointees in the Senior Executive Service, except in cases of misconduct, delinquency, or inefficiency. &nbsp;</p><p>On January 20, 2025, President Donald Trump issued an executive order titled <em>Ending Radical and Wasteful Government DEI Programs and Preferencing</em>, which required executive branch agencies to terminate diversity, equity, and inclusion offices and positions. Further, on February 11, 2025, President Trump issued an executive order titled <em>Implementing the President’s “Department of Government Efficiency” Workforce Optimization Initiative</em>, which required executive branch agencies to initiate large-scale reductions in force.</p><p>On March 10, 2025, NASA announced that it would close certain offices and lay off associated staff in compliance with these executive orders. NASA ultimately closed the Office of Technology, Policy, and Strategy; the Office of the Chief Scientist; and the Diversity, Equity, Inclusion, and Accessibility Branch of the Office of Diversity, Equity, and Inclusion.</p>","updateDate":"2026-07-13T19:39:21Z","versionCode":"00"}],"title":"Saving NASA’s Workforce Act","type":"hr","updateDate":"2026-07-13T19:41:33Z","updateDateIncludingText":"2026-07-13T19:41:33Z"}
