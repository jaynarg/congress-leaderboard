hipWithdrawnDate":null,"state":"MI"},{"bioguideId":"D000530","fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-17","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-17","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"G000602","fullName":"Rep. Gillen, Laura [D-NY-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001260","fullName":"Rep. Buchanan, Vern [R-FL-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000829","fullName":"Rep. Wied, Tony [R-WI-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"L000598","fullName":"Rep. LaLota, Nick [R-NY-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"N000002","fullName":"Rep. Nadler, Jerrold [D-NY-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"F000471","fullName":"Rep. Fitzgerald, Scott [R-WI-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-01","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-01","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T20:20:39+00:00","id":"hr2011-119","introducedDate":"2025-03-10","latestAction":{"actionDate":"2025-03-10","text":"Referred to the Subcommittee on Highways and Transit."},"laws":[],"number":"2011","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"R000606","district":8,"fullName":"Rep. Raskin, Jamie [D-MD-8]","party":"D","state":"MD"}],"summaries":[{"actionDate":"2025-03-10","actionDesc":"Introduced in House","text":"<p><strong>Sarah Debbink Langenkamp Active Transportation Safety Act</strong></p><p>This bill expands the Highway Safety Improvement Program (HSIP) to include additional bicyclist and pedestrian&nbsp;safety measures and increases the federal cost share for certain safety projects.</p><p>Specifically, the bill allows HSIP to fund projects (1) for the connection of two or more segments of existing bicyclist or pedestrian infrastructure, or (2) that are based on a state's plan to improve the safety of vulnerable road users (e.g., bicyclists or pedestrians) in areas identified as high-risk. In addition, the bill allows an increased federal cost share of up to 100% for these projects.</p><p>The bill also allows an increased federal cost share of up to 100% for transportation projects that meet certain criteria, including&nbsp;(1) the project includes a Federal Highway Administration Proven Safety Countermeasure for bicyclists or pedestrians (e.g., bicycle lanes, walkways, and crosswalk visibility enhancements), or (2) the relevant state strategic highway safety plan includes an emphasis area that is related to vulnerable road users.</p>","updateDate":"2026-05-01T17:45:43Z","versionCode":"00"}],"title":"Sarah Debbink Langenkamp Active Transportation Safety Act","type":"hr","updateDate":"2026-07-01T20:12:28Z","updateDateIncludingText":"2026-07-01T20:12:28Z"}
