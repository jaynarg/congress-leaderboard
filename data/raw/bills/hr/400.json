NE"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"S001214","fullName":"Rep. Steube, W. Gregory [R-FL-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-20T13:57:37+00:00","id":"hr400-119","introducedDate":"2025-01-14","latestAction":{"actionDate":"2025-01-14","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"400","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"R000614","district":21,"fullName":"Rep. Roy, Chip [R-TX-21]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-01-14","actionDesc":"Introduced in House","text":"<p><strong>No taxpayer funding for United Nations Human Rights Council Act</strong></p><p>This bill requires the Department of State to withhold from the U.S. contribution to the United Nations (U.N.) the amount that would be allocated to the U.N. Human Rights Council. Such withheld funds must be rescinded and must not be considered arrears to be repaid to any U.N. entity.</p><p>The bill also prohibits the State Department from making voluntary contributions to the U.N. Human Rights Council.</p>","updateDate":"2025-02-27T20:32:59Z","versionCode":"00"}],"title":"No taxpayer funding for United Nations Human Rights Council Act","type":"hr","updateDate":"2026-09-19T23:06:45Z","updateDateIncludingText":"2026-09-19T23:06:45Z"}
