thdrawnDate":null,"state":"TX"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-12","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"B001278","fullName":"Rep. Bonamici, Suzanne [D-OR-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"K000391","fullName":"Rep. Krishnamoorthi, Raja [D-IL-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"IL"}],"fetchedAt":"2026-09-16T19:05:18+00:00","id":"hr486-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-01-16","text":"Referred to the Committee on Financial Services, and in addition to the Committee on Education and Workforce, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"486","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"C001072","district":7,"fullName":"Rep. Carson, André [D-IN-7]","party":"D","state":"IN"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in House","text":"<p><strong>Young Americans Financial Literacy Act</strong></p><p>This bill requires the Consumer Financial Protection Bureau to award competitive grants to eligible&nbsp;institutions for the establishment of financial literacy education programs for young people and families.</p><p>An&nbsp;<em>eligible institution</em> is a partnership among two or more of the following:</p><ul><li>an institution of higher education;</li><li>a state or local government agency specializing in financial education;</li><li>a nonprofit agency, organization, or association;</li><li>a financial institution; or</li><li>another small organization.</li></ul><p>Authorized grant funded activities shall include</p><ul><li>developing and implementing comprehensive, research based, financial-literacy education programs for young people;</li><li>developing and supporting the delivery of professional development programs in financial literacy education;</li><li>developing educational programs to reduce student loan default rates; and</li><li>conducting ongoing research and evaluation of financial literacy education programs.</li></ul><p>The&nbsp;grant program&nbsp;shall terminate&nbsp;after FY2029.</p>","updateDate":"2025-04-02T17:55:42Z","versionCode":"00"}],"title":"Young Americans Financial Literacy Act","type":"hr","updateDate":"2026-07-17T23:30:02Z","updateDateIncludingText":"2026-07-17T23:30:02Z"}
