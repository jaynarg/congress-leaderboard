state":"TN"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-17","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"B001309","fullName":"Rep. Burchett, Tim [R-TN-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-22","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"C001118","fullName":"Rep. Cline, Ben [R-VA-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-03","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"V000136","fullName":"Rep. Vasquez, Gabe [D-NM-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-08","sponsorshipWithdrawnDate":null,"state":"NM"},{"bioguideId":"M001239","fullName":"Rep. McGuire, John J. [R-VA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"C001087","fullName":"Rep. Crawford, Eric A. \"Rick\" [R-AR-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-01-12","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"G000601","fullName":"Rep. Goldman, Craig A. [R-TX-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-16","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001314","fullName":"Rep. Bean, Aaron [R-FL-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-13","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"K000399","fullName":"Rep. Kiggans, Jennifer A. [R-VA-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"E000300","fullName":"Rep. Evans, Gabe [R-CO-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-06","sponsorshipWithdrawnDate":null,"state":"CO"}],"fetchedAt":"2026-09-20T14:15:48+00:00","id":"hr2314-119","introducedDate":"2025-03-25","latestAction":{"actionDate":"2025-03-25","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"2314","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"H001086","district":1,"fullName":"Rep. Harshbarger, Diana [R-TN-1]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-03-25","actionDesc":"Introduced in House","text":"<p><strong>Fair Access In Residency Act of 2025 or the FAIR Act of 2025</strong></p><p>This bill requires hospitals that receive graduate medical education (GME) payments under Medicare to report certain information about the composition of their medical residency training programs.</p><p>Specifically, hospitals must provide to the Centers for Medicare &amp; Medicaid Services (CMS) (1) the number of applicants for residencies who are from osteopathic medical schools and from allopathic medical schools, (2) the number of applicants who are accepted from each of these types of medical schools, and (3) an affirmation that the hospital considers applicants from each of these types of medical schools and accepts specified related examination results, as appropriate. Hospitals that do not provide this information are subject to a 2% reduction in their GME payments.</p><p>The CMS must post the information it receives on a public website.</p>","updateDate":"2026-07-24T21:59:52Z","versionCode":"00"}],"title":"FAIR Act","type":"hr","updateDate":"2026-09-19T23:35:27Z","updateDateIncludingText":"2026-09-19T23:35:27Z"}
