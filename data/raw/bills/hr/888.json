{"actions":[{"actionCode":"H11100","actionDate":"2025-01-31","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/888","cosponsors":[{"bioguideId":"M001229","fullName":"Rep. McIver, LaMonica [D-NJ-10]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"H001094","fullName":"Rep. Hoyle, Val T. [D-OR-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"M001223","fullName":"Rep. Magaziner, Seth [D-RI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"G000599","fullName":"Rep. Goldman, Daniel S. [D-NY-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-23","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"D000530","fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-23","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-20T14:03:05+00:00","id":"hr888-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"888","originChamber":"House","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"R000579","district":18,"fullName":"Rep. Ryan, Patrick [D-NY-18]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><strong>Stop Sports Blackouts Act of 2025</strong></p><p>This bill requires cable and satellite broadcast providers to issue rebates to customers who are denied access to video programming included in their subscription because of programming negotiations.&nbsp;</p><p>Specifically, where a provider’s negotiations related to the retransmission or carriage of video programming result in the provider failing to offer access to programming included in a customer’s subscription, the customer must be issued a rebate for the affected period. The Federal Communications Commission is directed to issue rules to this effect, including to establish the appropriate amount for such a rebate. &nbsp;</p>","updateDate":"2025-03-13T15:51:27Z","versionCode":"00"}],"title":"Stop Sports Blackouts Act of 2025","type":"hr","updateDate":"2026-09-19T23:22:16Z","updateDateIncludingText":"2026-09-19T23:22:16Z"}
