,{"bioguideId":"B001291","fullName":"Rep. Babin, Brian [R-TX-36]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-14","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001323","fullName":"Rep. Begich, Nicholas J. [R-AK-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"P000605","fullName":"Rep. Perry, Scott [R-PA-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-22","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-16T18:37:58+00:00","id":"hr34-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2026-02-10","text":"Subcommittee Hearings Held"},"laws":[],"number":"34","originChamber":"House","policyArea":"Public Lands and Natural Resources","sponsors":[{"bioguideId":"G000565","district":9,"fullName":"Rep. Gosar, Paul A. [R-AZ-9]","party":"R","state":"AZ"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>Land And Social Security Optimization Act or the LASSO Act</strong></p><p>This bill requires 10% of revenue generated by public lands, including submerged lands on the Outer Continental Shelf, under the jurisdiction of the Department of the Interior and the Forest Service to be deposited into the Federal Old-Age and Survivors Insurance Trust Fund, which is used to pay Social Security benefits to retirees and their families and to survivors of deceased workers.</p>","updateDate":"2025-02-24T22:18:00Z","versionCode":"00"}],"title":"LASSO Act","type":"hr","updateDate":"2026-07-23T08:07:52Z","updateDateIncludingText":"2026-07-23T08:07:52Z"}
