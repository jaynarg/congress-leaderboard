inalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"L000397","fullName":"Rep. Lofgren, Zoe [D-CA-18]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-25","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000490","fullName":"Rep. Taylor, David J. [R-OH-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-09-17T03:18:42+00:00","id":"hr7730-119","introducedDate":"2026-02-26","latestAction":{"actionDate":"2026-08-27","text":"Placed on the Union Calendar, Calendar No. 684."},"laws":[],"number":"7730","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"C001118","district":6,"fullName":"Rep. Cline, Ben [R-VA-6]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2026-02-26","actionDesc":"Introduced in House","text":"<p><strong>Bankruptcy Threshold Adjustment Act of 2026</strong></p><p>This bill restores changes that expired in 2024 applicable to debt limits for Subchapter V (small business reorganization) and Chapter 13 (the wage earner's plan) bankruptcies.</p><p>Specifically, the bill increases the debt limit under Subchapter&nbsp;V from approximately $3.4 million to $7.5 million and increases the cumulative debt limit under Chapter 13 from approximately $2.1 million to $2.75 million.</p><p>The bill also applies both secured and unsecured debt towards the Chapter 13 limit. (Currently, separate limits apply to secured and unsecured debt under Chapter 13 bankruptcy.)</p>","updateDate":"2026-08-25T17:27:26Z","versionCode":"00"}],"title":"Bankruptcy Threshold Adjustment Act","type":"hr","updateDate":"2026-09-09T19:41:22Z","updateDateIncludingText":"2026-09-09T19:41:22Z"}
