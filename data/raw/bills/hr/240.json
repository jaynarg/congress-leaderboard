{"actions":[{"actionCode":"H11100","actionDate":"2025-01-07","source":"House floor actions","text":"Referred to the House Committee on Education and Workforce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/240","cosponsors":[{"bioguideId":"L000600","fullName":"Rep. Langworthy, Nicholas A. [R-NY-23]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-07","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"L000578","fullName":"Rep. LaMalfa, Doug [R-CA-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001196","fullName":"Rep. Stefanik, Elise M. [R-NY-21]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T18:48:37+00:00","id":"hr240-119","introducedDate":"2025-01-07","latestAction":{"actionDate":"2025-01-07","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"240","originChamber":"House","policyArea":"Labor and Employment","sponsors":[{"bioguideId":"T000478","district":24,"fullName":"Rep. Tenney, Claudia [R-NY-24]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-01-07","actionDesc":"Introduced in House","text":"<p><strong>Protect Local Farms Act</strong></p><p>This bill provides that the Fair Labor Standards Act (FLSA) preempts any state law that establishes a maximum workweek (i.e., the maximum number of hours an employee is permitted to work without receiving overtime pay) of less than 60 hours for agricultural employees. </p><p>Under the FLSA, agricultural employees are generally exempt from&nbsp;federal overtime requirements.&nbsp;However, federal overtime requirements currently do not preempt state&nbsp;laws that provide greater protections to employees.</p>","updateDate":"2025-04-14T16:07:30Z","versionCode":"00"}],"title":"Protect Local Farms Act","type":"hr","updateDate":"2025-07-21T19:44:15Z","updateDateIncludingText":"2025-07-21T19:44:15Z"}
