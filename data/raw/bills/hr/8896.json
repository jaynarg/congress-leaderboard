026-05-19","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"D000623","fullName":"Rep. DeSaulnier, Mark [D-CA-10]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001110","fullName":"Rep. Correa, J. Luis [D-CA-46]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001231","fullName":"Rep. Simon, Lateefah [D-CA-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000481","fullName":"Rep. Tlaib, Rashida [D-MI-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"P000597","fullName":"Rep. Pingree, Chellie [D-ME-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-04","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"H001085","fullName":"Rep. Houlahan, Chrissy [D-PA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-11","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"M001226","fullName":"Rep. Menendez, Robert [D-NJ-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-06","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-17T04:08:22+00:00","id":"hr8896-119","introducedDate":"2026-05-19","latestAction":{"actionDate":"2026-05-19","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"8896","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"L000273","district":3,"fullName":"Rep. Leger Fernandez, Teresa [D-NM-3]","party":"D","state":"NM"}],"summaries":[{"actionDate":"2026-05-19","actionDesc":"Introduced in House","text":"<p><strong>Loan Forgiveness for Educators Act of 2026</strong></p><p>This bill expands loan forgiveness for educators by revising the Teacher Loan Forgiveness Program. The program provides loan forgiveness (up to $17,500) for teachers who are highly qualified, teach full-time in a low-income elementary or secondary school or educational service agency, and complete five years of consecutive service.</p><p>Specifically, the bill renames the program as the Educator Loan Forgiveness Programs.</p><p>Additionally, the bill expands the program by making additional loan types eligible for benefits under the program (e.g., Parent PLUS Loans).</p><p>Further, the bill expands program eligibility to early childhood educators and program directors serving in early childhood education programs and school leaders serving in public high-need schools.</p><p>The bill requires the Department of Education to</p><ul><li>make monthly student loan payments on behalf of the educator during qualifying service (i.e., employment as a full-time qualifying educator in a high-need school or an early childhood education program),</li><li>provide complete loan forgiveness after five years of qualifying service (which does not have to be consecutive), and</li><li>take steps to notify borrowers about changes to the program.</li></ul>","updateDate":"2026-07-06T15:51:45Z","versionCode":"00"}],"title":"Loan Forgiveness for Educators Act of 2026","type":"hr","updateDate":"2026-08-07T08:05:39Z","updateDateIncludingText":"2026-08-07T08:05:39Z"}
