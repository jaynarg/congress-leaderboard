eId":"F000472","fullName":"Rep. Franklin, Scott [R-FL-18]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001322","fullName":"Rep. Baumgartner, Michael [R-WA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"R000579","fullName":"Rep. Ryan, Patrick [D-NY-18]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"W000821","fullName":"Rep. Westerman, Bruce [R-AR-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"H001072","fullName":"Rep. Hill, J. French [R-AR-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"N000189","fullName":"Rep. Newhouse, Dan [R-WA-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"G000602","fullName":"Rep. Gillen, Laura [D-NY-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001235","fullName":"Rep. Moore, Riley [R-WV-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"WV"},{"bioguideId":"H001099","fullName":"Rep. Haridopolos, Mike [R-FL-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"M001233","fullName":"Rep. Messmer, Mark [R-IN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"F000482","fullName":"Rep. Fedorchak, Julie [R-ND-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"G000601","fullName":"Rep. Goldman, Craig [R-TX-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"B001282","fullName":"Rep. Barr, Andy [R-KY-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"K000401","fullName":"Rep. Kiley, Kevin [R-CA-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001239","fullName":"Rep. McGuire, John [R-VA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"B001323","fullName":"Rep. Begich, Nicholas [R-AK-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"AK"}],"fetchedAt":"2026-09-16T18:37:34+00:00","id":"hr27-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-02-10","text":"Received in the Senate and Read twice and referred to the Committee on the Judiciary."},"laws":[],"number":"27","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"G000568","district":9,"fullName":"Rep. Griffith, H. Morgan [R-VA-9]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>Halt All Lethal Trafficking of Fentanyl Act or the HALT Fentanyl Act</strong></p><p>This bill permanently places fentanyl-related substances as a class into schedule I of the Controlled Substances Act. A schedule I controlled substance is a drug, substance, or chemical that has a high potential for abuse; has no currently accepted medical value; and is subject to regulatory controls and administrative, civil, and criminal penalties under the Controlled Substances Act.</p><p>Under the bill, offenses involving fentanyl-related substances are triggered by the same quantity thresholds and subject to the same penalties as offenses involving fentanyl analogues (e.g., offenses involving 100 grams or more trigger a 10-year mandatory minimum prison term).</p><p>Additionally, the bill establishes a new, alternative registration process for certain schedule I research.</p><p>The bill also makes several other changes to registration requirements for conducting research with controlled substances, including</p><ul><li>permitting a single registration for related research sites in certain circumstances,</li><li>waiving the requirement for a new inspection in certain situations, and</li><li>allowing a registered researcher to perform certain manufacturing activities with small quantities of a substance without obtaining a manufacturing registration.</li></ul><p>Finally, the bill expresses the sense that Congress agrees with the interpretation of Controlled Substances Act in <em>United States v. McCray</em>, a 2018 case decided by the U.S. District Court for the Western District of New York. In that case, the court held that butyryl fentanyl, a controlled substance, can be considered an analogue of fentanyl even though, under the Controlled Substances Act, the term <em>controlled substance analogue</em> specifically excludes a controlled substance.</p>","updateDate":"2025-01-30T21:27:42Z","versionCode":"00"}],"title":"HALT Fentanyl Act","type":"hr","updateDate":"2026-08-10T11:51:27Z","updateDateIncludingText":"2026-08-10T11:51:27Z"}
