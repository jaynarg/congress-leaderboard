"},{"bioguideId":"I000056","fullName":"Rep. Issa, Darrell [R-CA-48]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-05","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"L000590","fullName":"Rep. Lee, Susie [D-NV-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"O000019","fullName":"Rep. Obernolte, Jay [R-CA-23]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"H001072","fullName":"Rep. Hill, J. French [R-AR-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"AR"},{"bioguideId":"W000816","fullName":"Rep. Williams, Roger [R-TX-25]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-05","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"F000470","fullName":"Rep. Fischbach, Michelle [R-MN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-06","sponsorshipWithdrawnDate":null,"state":"MN"}],"fetchedAt":"2026-09-16T19:45:06+00:00","id":"hr1286-119","introducedDate":"2025-02-13","latestAction":{"actionDate":"2025-05-20","text":"Received in the Senate and Read twice and referred to the Committee on Veterans' Affairs."},"laws":[],"number":"1286","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"B001327","district":8,"fullName":"Rep. Bresnahan, Robert [R-PA-8]","party":"R","state":"PA"}],"summaries":[{"actionDate":"2025-02-13","actionDesc":"Introduced in House","text":"<p><strong>Simplifying Forms for Veterans Claims Act</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to seek to enter an agreement with a federally funded research and development center to assess the forms that the VA sends to claimants. The center must submit a written assessment to the VA that includes recommendations on how the VA may make the forms clearer and more organized.</p><p>The VA must implement certain recommendations in the assessment within two years after the assessment is received.</p>","updateDate":"2025-03-21T13:45:22Z","versionCode":"00"}],"title":"Simplifying Forms for Veterans Claims Act","type":"hr","updateDate":"2026-07-10T20:43:22Z","updateDateIncludingText":"2026-07-13T19:44:12Z"}
