lCosponsor":false,"party":"D","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"K000403","fullName":"Rep. Kennedy, Mike [R-UT-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"M001224","fullName":"Rep. Moran, Nathaniel [R-TX-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001199","fullName":"Rep. Smucker, Lloyd [R-PA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"R000619","fullName":"Rep. Rulli, Michael A. [R-OH-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"C001103","fullName":"Rep. Carter, Earl L. \"Buddy\" [R-GA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-19","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-28","sponsorshipWithdrawnDate":null,"state":"UT"}],"fetchedAt":"2026-09-20T14:15:01+00:00","id":"hr2191-119","introducedDate":"2025-03-18","latestAction":{"actionDate":"2025-03-18","text":"Referred to the Committee on Energy and Commerce, and in addition to the Committee on Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"2191","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"G000568","district":9,"fullName":"Rep. Griffith, H. Morgan [R-VA-9]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2025-03-18","actionDesc":"Introduced in House","text":"<p><strong>Physician Led and Rural Access to Quality Care Act</strong></p><p>This bill expands flexibilities for physicians and physician-owned hospitals under the Stark law (i.e., the Physician Self-Referral Law).&nbsp;</p><p>The Stark law generally prohibits physicians from referring patients to receive services that are payable under Medicare or Medicaid from entities in which the physician or an immediate family member has a financial relationship. The bill allows physicians or their immediate family members to have financial interests in rural hospitals that are located more than 35 miles (or 15 miles in certain mountainous areas or areas with only secondary roads) from a hospital or critical access hospital.</p><p>The Stark law also generally prohibits physician-owned hospitals from expanding the number of operating rooms, procedure rooms, or beds beyond the number in existence as of March 23, 2010, in order to be excepted under the Stark law. The bill removes this restriction.</p>","updateDate":"2026-03-20T19:15:11Z","versionCode":"00"}],"title":"Physician Led and Rural Access to Quality Care Act","type":"hr","updateDate":"2026-09-19T23:25:03Z","updateDateIncludingText":"2026-09-19T23:25:03Z"}
