":"TX"},{"bioguideId":"P000609","fullName":"Rep. Palmer, Gary J. [R-AL-6]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-14","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"T000478","fullName":"Rep. Tenney, Claudia [R-NY-24]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-14","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"F000482","fullName":"Rep. Fedorchak, Julie [R-ND-At Large]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-02-14","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"G000601","fullName":"Rep. Goldman, Craig [R-TX-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-27","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"W000816","fullName":"Rep. Williams, Roger [R-TX-25]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-27","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T19:49:16+00:00","id":"hr1367-119","introducedDate":"2025-02-14","latestAction":{"actionDate":"2025-02-14","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"1367","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"A000375","district":19,"fullName":"Rep. Arrington, Jodey C. [R-TX-19]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-02-14","actionDesc":"Introduced in House","text":"<p><strong>Eliminate Lavish Incentives To Electric Vehicles Act or the ELITE Vehicles Act</strong></p><p>This bill eliminates federal tax credits for the purchase of certain clean vehicles (generally electric vehicles and plug-in hybrid vehicles) and electric&nbsp;vehicle recharging stations.</p><p>Specifically, the bill repeals the federal tax credits for</p><ul><li>the purchase of a qualified used clean vehicle (tax credit of up to $4,000 for the purchase of a previously-owned clean vehicle before 2033),</li><li>the purchase of a qualified new clean vehicle (tax credit of up to $7,500 for the purchase of a new clean vehicle before 2033),</li><li>the purchase of a qualified commercial clean vehicle (business tax credit of up to $40,000 for the purchase of a commercial clean vehicle before 2033), and</li><li>alternative fuel vehicle refueling property used to recharge electric vehicles (tax credit of up to $1,000 for individuals or up to $100,000 for businesses for the installation of property before 2033 that is used to recharge electric vehicles).</li></ul>","updateDate":"2025-09-23T15:48:22Z","versionCode":"00"}],"title":"ELITE Vehicles Act","type":"hr","updateDate":"2025-12-05T21:54:36Z","updateDateIncludingText":"2025-12-05T21:54:36Z"}
