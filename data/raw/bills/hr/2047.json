ate":null,"state":"IN"},{"bioguideId":"M001232","fullName":"Rep. McClain Delaney, April [D-MD-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"M001234","fullName":"Rep. Morrison, Kelly [D-MN-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"J000288","fullName":"Rep. Johnson, Henry C. \"Hank\" [D-GA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-24","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-21","sponsorshipWithdrawnDate":null,"state":"DE"}],"fetchedAt":"2026-09-16T20:22:19+00:00","id":"hr2047-119","introducedDate":"2025-03-11","latestAction":{"actionDate":"2025-03-11","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"2047","originChamber":"House","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"F000468","district":7,"fullName":"Rep. Fletcher, Lizzie [D-TX-7]","party":"D","state":"TX"}],"summaries":[{"actionDate":"2025-03-11","actionDesc":"Introduced in House","text":"<p><strong>Pink Tariffs Study Act</strong></p><p>This bill requires the Department of the Treasury to study and report to Congress on whether the U.S. tariff system is regressive (e.g., tariffs are higher on mass-market consumer goods compared to analogous luxury goods) or demonstrates a gender bias (e.g., tariffs are higher on women's clothing compared to men's clothing).</p><p>For this study and report, Treasury must (1) coordinate with U.S. Customs and Border Protection, and (2) consult&nbsp;with the U.S. International Trade Commission and the Office of the U.S. Trade Representative.</p>","updateDate":"2025-08-07T15:51:16Z","versionCode":"00"}],"title":"Pink Tariffs Study Act","type":"hr","updateDate":"2