:null,"state":"VA"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-17","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-11-11T17:35:25+00:00","id":"hr1466-119","introducedDate":"2025-02-21","latestAction":{"actionDate":"2025-02-21","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1466","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"F000472","district":18,"fullName":"Rep. Franklin, Scott [R-FL-18]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-02-21","actionDesc":"Introduced in House","text":"<p><strong>Cardiac Arrest Survival Act of </strong><strong>2025</strong></p><p>This bill expands immunity from civil liability related to emergency use of automated external defibrillator devices (AEDs).</p><p>In particular, the bill specifies that immunity applies regardless of whether the person who used the AED complied with signage, received training, or was assisted or supervised by another person, such as a licensed physician. It also specifies that immunity applies to an entity that owns, leases, or manages a premises on which an&nbsp;AED is used but does&nbsp;not own or use the AED.&nbsp;Additionally, the bill limits the liability of the person who owns or acquires an AED for harm resulting from its use unless that person fails to appropriately maintain the AED.</p>","updateDate":"2026-11-10T22:36:21Z","versionCode":"00"}],"title":"Cardiac Arrest Survival Act of 2025","type":"hr","updateDate":"2026-11-10T22:37:29Z","updateDateIncludingText":"2026-11-10T22:37:29Z"}
