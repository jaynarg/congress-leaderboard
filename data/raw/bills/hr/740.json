hipWithdrawnDate":null,"state":"OH"},{"bioguideId":"C000059","fullName":"Rep. Calvert, Ken [R-CA-41]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-09","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000482","fullName":"Rep. Fedorchak, Julie [R-ND-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"B000825","fullName":"Rep. Boebert, Lauren [R-CO-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-22","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"G000591","fullName":"Rep. Guest, Michael [R-MS-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-28","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"O000175","fullName":"Rep. Ogles, Andrew [R-TN-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-28","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"W000798","fullName":"Rep. Walberg, Tim [R-MI-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"M001230","fullName":"Rep. Mackenzie, Ryan [R-PA-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-19","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"R000612","fullName":"Rep. Rose, John W. [R-TN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-11","sponsorshipWithdrawnDate":null,"state":"TN"}],"fetchedAt":"2026-09-16T19:18:02+00:00","id":"hr740-119","introducedDate":"2025-01-28","latestAction":{"actionDate":"2025-07-23","text":"Ordered to be Reported (Amended) by Voice Vote."},"laws":[],"number":"740","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"B001295","district":12,"fullName":"Rep. Bost, Mike [R-IL-12]","party":"R","state":"IL"}],"summaries":[{"actionDate":"2025-01-28","actionDesc":"Introduced in House","text":"<p><strong>Veterans' Assuring Critical Care Expansions to Support&nbsp;Servicemembers Act of 2025 or the Veterans' ACCESS Act of 2025</strong></p><p>This bill addresses the administration of the Veterans Community Care Program (VCCP) and other Department of Veterans Affairs (VA) health care matters.</p><p>Among other provisions regarding the VCCP, the bill</p><ul><li>establishes in statute access standards that determine when a veteran is eligible to receive non-VA care through the VCCP,</li><li>requires the VA to notify veterans regarding their eligibility for care within two business days after the VA is aware the veteran is seeking care, and</li><li>extends the deadline for the submittal of claims under the&nbsp;VCCP by health care entities and providers.</li></ul><p>The VA must address its mental health treatment programs by</p><ul><li>establishing a standardized screening process to determine whether a veteran satisfies criteria for priority or routine admission to a mental health residential rehabilitation treatment program or a program for residential care for mental health and substance abuse disorders,</li><li>tracking the performance of medical facilities and Veterans Integrated Service Networks in meeting the requirements for mental health treatment screenings and timely admission to treatment programs under such screenings, and</li><li>establishing an appeal process for when a veteran is denied admission to a covered treatment program or is accepted into a program but not offered bed placement in a timely manner.</li></ul><p>Additionally, the VA must establish an online self-service module for veterans to request and manage appointments, track referrals, and appeal and track decisions related to requests for care.</p>","updateDate":"2025-12-30T18:20:15Z","versionCode":"00"}],"title":"Veterans’ ACCESS Act of 2025","type":"hr","updateDate":"2026-07-18T00:02:57Z","updateDateIncludingText":"2026-07-18T00:02:57Z"}
