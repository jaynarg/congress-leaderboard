ginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-05","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"B001318","fullName":"Rep. Balint, Becca [D-VT-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"L000397","fullName":"Rep. Lofgren, Zoe [D-CA-18]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-02","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-02-17","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"M001160","fullName":"Rep. Moore, Gwen [D-WI-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"L000601","fullName":"Rep. Landsman, Greg [D-OH-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"S001221","fullName":"Rep. Scholten, Hillary J. [D-MI-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-17","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"W000831","fullName":"Rep. Walkinshaw, James R. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-24","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T21:36:24+00:00","id":"hr3740-119","introducedDate":"2025-06-04","latestAction":{"actionDate":"2025-06-04","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"3740","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"S001193","district":14,"fullName":"Rep. Swalwell, Eric [D-CA-14]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-06-04","actionDesc":"Introduced in House","text":"<p><strong>Equal Access to Justice for Victims of Gun Violence Act of 2025</strong></p><p>This bill removes limitations on the civil liability of gun manufacturers and the disclosure of gun trace data in civil actions.</p><p>Specifically, the bill repeals the Protection of Lawful Commerce in Arms Act, which prohibits civil actions against a firearm or ammunition manufacturer, seller, importer, dealer, or trade association for damages resulting from the criminal or unlawful misuse of a firearm.</p><p>Additionally, the bill states that firearms trace data maintained by the Bureau of Alcohol, Tobacco, Firearms and Explosives is not immune from legal process. Such data is subject to discovery; is admissible as evidence; and may be used, relied on, or disclosed in a civil action or administrative proceeding.</p>","updateDate":"2026-04-14T20:41:10Z","versionCode":"00"}],"title":"Equal Access to Justice for Victims of Gun Violence Act of 2025","type":"hr","updateDate":"2026-07-17T23:59:55Z","updateDateIncludingText":"2026-07-17T23:59:55Z"}
