{"actions":[{"actionCode":"H11100","actionDate":"2025-03-05","source":"House floor actions","text":"Referred to the House Committee on Energy and Commerce.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-03-05","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-03-05","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1875","cosponsors":[{"bioguideId":"M001206","fullName":"Rep. Morelle, Joseph D. [D-NY-25]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-03-05","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M000317","fullName":"Rep. Malliotakis, Nicole [R-NY-11]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-03-05","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"D000230","fullName":"Rep. Davis, Donald G. [D-NC-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-16T20:14:15+00:00","id":"hr1875-119","introducedDate":"2025-03-05","latestAction":{"actionDate":"2025-03-05","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"1875","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"L000600","district":23,"fullName":"Rep. Langworthy, Nicholas A. [R-NY-23]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-03-05","actionDesc":"Introduced in House","text":"<p><strong>Medicaid Provider Screening Accountability Act</strong></p><p>This bill requires state Medicaid programs to check, as part of the provider enrollment and reenrollment process, whether providers were terminated from participating in the Medicare program, any other state Medicaid program, or the Children's Health Insurance Program (CHIP) using certain databases (e.g., the Data EXchange system). The bill requires states to continue to check these databases on at least a monthly basis after providers are enrolled.</p>","updateDate":"2025-04-02T15:22:38Z","versionCode":"00"}],"title":"Medicaid Provider Screening Accountability Act","type":"hr","updateDate":"2025-05-30T23:51:55Z","updateDateIncludingText":"2025-05-30T23:51:55Z"}
