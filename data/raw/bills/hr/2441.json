e":"Rep. Pettersen, Brittany [D-CO-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"W000812","fullName":"Rep. Wagner, Ann [R-MO-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"M001136","fullName":"Rep. McClain, Lisa C. [R-MI-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-29","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-29","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T20:39:49+00:00","id":"hr2441-119","introducedDate":"2025-03-27","latestAction":{"actionDate":"2025-06-04","text":"Placed on the Union Calendar, Calendar No. 105."},"laws":[],"number":"2441","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"H001058","district":4,"fullName":"Rep. Huizenga, Bill [R-MI-4]","party":"R","state":"MI"}],"summaries":[{"actionDate":"2025-06-04","actionDesc":"Reported to House","text":"<p><strong>Improving Disclosure for Investors Act of 2025 </strong></p><p>This bill requires the Securities and Exchange Commission (SEC) to propose and finalize rules to allow entities to deliver regulatory documents to investors electronically. The SEC must establish a mechanism for investors to opt out of electronic delivery and receive paper documents instead. If the SEC does not finalize rules within one year after enactment, the bill allows for electronic delivery of these documents.</p>","updateDate":"2025-09-02T21:02:28Z","versionCode":"07"}],"title":"Improving Disclosure for Investors Act of 2025","type":"hr","updateDate":"2025-10-29T19:05:16Z","updateDateIncludingText":"2025-10-29T19:05:16Z"}
