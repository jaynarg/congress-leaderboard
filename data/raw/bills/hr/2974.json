{"actions":[{"actionCode":"H11100","actionDate":"2025-04-21","source":"House floor actions","text":"Referred to the House Committee on Agriculture.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-04-21","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-04-21","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/2974","cosponsors":[{"bioguideId":"B001327","fullName":"Rep. Bresnahan, Robert [R-PA-8]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"A000370","fullName":"Rep. Adams, Alma S. [D-NC-12]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001222","fullName":"Rep. Miller, Max L. [R-OH-7]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-21","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-02","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-06","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"L000601","fullName":"Rep. Landsman, Greg [D-OH-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-28","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-10","sponsorshipWithdrawnDate":null,"state":"DC"}],"fetchedAt":"2026-09-16T21:03:27+00:00","id":"hr2974-119","introducedDate":"2025-04-21","latestAction":{"actionDate":"2025-04-21","text":"Referred to the House Committee on Agriculture."},"laws":[],"number":"2974","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"E000297","district":13,"fullName":"Rep. Espaillat, Adriano [D-NY-13]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-04-21","actionDesc":"Introduced in House","text":"<p><strong>Training and Nutrition Stability Act</strong></p><p>This bill excludes specific employment and training program funds from income when determining eligibility for the Supplemental Nutrition Assistance Program (SNAP).</p><p>As background, a&nbsp;household must have an income below a certain level to qualify for SNAP program benefits.&nbsp;Certain allowances, earnings, and payments do not count towards a household's income.</p><p>Under this bill, examples&nbsp;of programs excluded from income&nbsp;include Workforce Innovation and Opportunity Act (WIOA) programs, vocational rehabilitation programs, and refugee employment programs.</p><p>This bill also removes the requirement that earnings from on-the-job training be considered earned income for purposes of determining SNAP eligibility.</p>","updateDate":"2025-08-05T12:58:35Z","versionCode":"00"}],"title":"Training and Nutrition Stability","type":"hr","updateDate":"2026-06-11T08:06:44Z","updateDateIncludingText":"2026-06-11T08:06:44Z"}
