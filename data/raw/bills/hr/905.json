":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"A000381","fullName":"Rep. Ansari, Yassamin [D-AZ-3]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"M001237","fullName":"Rep. McDonald Rivet, Kristen [D-MI-8]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"W000808","fullName":"Rep. Wilson, Frederica S. [D-FL-24]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"K000400","fullName":"Rep. Kamlager-Dove, Sydney [D-CA-37]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M000687","fullName":"Rep. Mfume, Kweisi [D-MD-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"F000477","fullName":"Rep. Foushee, Valerie P. [D-NC-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001313","fullName":"Rep. Brown, Shontel M. [D-OH-11]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"M001227","fullName":"Rep. McClellan, Jennifer L. [D-VA-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"T000487","fullName":"Rep. Tokuda, Jill N. [D-HI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"HI"}],"fetchedAt":"2026-09-16T19:26:18+00:00","id":"hr905-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"905","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"W000822","district":12,"fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><strong>EITC Modernization Act</strong></p><p>This bill expands eligibility for the earned income tax credit (EITC), provides a minimum EITC amount of $1,200 (subject to limitations), and allows an individual to receive the EITC as monthly payments. The bill also establishes a grant program for tax return preparation assistance for low-income individuals.</p><p>Under the bill, EITC eligibility is expanded to include a student who meets certain requirements and an individual with a qualifying dependent, which includes a</p><ul><li>qualifying child,</li><li>dependent who attains the age of 65 within the tax year and for whom the individual may claim a&nbsp;tax deduction for a&nbsp;personal exemption, and</li><li>dependent or spouse who is physically or mentally incapable of caring for themselves and meets certain residency requirements.</li></ul><p>Further, for an individual who does not have a qualifying dependent, the bill lowers the EITC eligibility age to 18 years (from 25 years) and eliminates the maximum age limit.</p><p>The bill allows an individual who meets certain requirements to receive the EITC in monthly payments and provides for a one-time increase in the first monthly payment. The bill also provides a new parent (through birth or adoption) an increase in their monthly EITC payments (subject to limitations).</p><p>Finally, the bill establishes a grant program, which is similar to the existing Volunteer Income Tax Assistance  program&nbsp;and provides funding for tax&nbsp;return preparation assistance for&nbsp;low-income taxpayers and members of underserved populations.</p>","updateDate":"2026-05-01T13:02:44Z","versionCode":"00"}],"title":"EITC Modernization Act","type":"hr","updateDate":"2026-05-01T13:06:24Z","updateDateIncludingText":"2026-05-01T13:06:24Z"}
