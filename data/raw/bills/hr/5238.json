{"actions":[{"actionCode":"H11100","actionDate":"2025-09-09","source":"House floor actions","text":"Referred to the House Committee on House Administration.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-09-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-09-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/5238","cosponsors":[{"bioguideId":"M001225","fullName":"Rep. Mullin, Kevin [D-CA-15]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-09-09","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"T000481","fullName":"Rep. Tlaib, Rashida [D-MI-12]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-09-09","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"M001143","fullName":"Rep. McCollum, Betty [D-MN-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-10","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"L000602","fullName":"Rep. Lee, Summer L. [D-PA-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001300","fullName":"Rep. Barragán, Nanette Diaz [D-CA-44]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"J000288","fullName":"Rep. Johnson, Henry C. \"Hank\" [D-GA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-15","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"B001285","fullName":"Rep. Brownley, Julia [D-CA-26]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-17","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000477","fullName":"Rep. Foushee, Valerie P. [D-NC-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-22","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-16T22:39:14+00:00","id":"hr5238-119","introducedDate":"2025-09-09","latestAction":{"actionDate":"2025-09-09","text":"Referred to the House Committee on House Administration."},"laws":[],"number":"5238","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"R000617","district":3,"fullName":"Rep. Ramirez, Delia C. [D-IL-3]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-09-09","actionDesc":"Introduced in House","text":"<p><strong>Stop Super PAC-Candidate Coordination Act</strong></p><p>This bill treats certain payments for coordinated expenditures as campaign contributions for purposes of disclosure and reporting requirements.</p><p>The bill generally defines a&nbsp;<em>coordinated expenditure</em> as a payment made by any person in cooperation with a candidate, an authorized committee of a candidate, a political committee of a political party, or an agent of a candidate or committee. Further, the bill sets forth penalties for willfully violating limits related to making contributions to a candidate for coordinated expenditures.</p><p>The bill also prohibits a candidate or an individual holding federal office from soliciting, receiving, directing, or transferring funds to or on behalf of certain types of political committees.</p>","updateDate":"2026-04-01T01:16:58Z","versionCode":"00"}],"title":"Stop Super PAC-Candidate Coordination Act","type":"hr","updateDate":"2026-07-17T23:37:33Z","updateDateIncludingText":"2026-07-17T23:37:33Z"}
