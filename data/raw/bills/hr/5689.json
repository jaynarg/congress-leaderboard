7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"W000822","fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-28","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"F000468","fullName":"Rep. Fletcher, Lizzie [D-TX-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-31","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"K000375","fullName":"Rep. Keating, William R. [D-MA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-31","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"T000468","fullName":"Rep. Titus, Dina [D-NV-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-12","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"S001226","fullName":"Rep. Salinas, Andrea [D-OR-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-06","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"H001081","fullName":"Rep. Hayes, Jahana [D-CT-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"CT"}],"fetchedAt":"2026-09-17T14:39:34+00:00","id":"hr5689-119","introducedDate":"2025-10-03","latestAction":{"actionDate":"2025-10-03","text":"Referred to the Committee on Financial Services, and in addition to the Committee on the Budget, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"5689","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"S001230","district":10,"fullName":"Rep. Subramanyam, Suhas [D-VA-10]","party":"D","state":"VA"}],"summaries":[{"actionDate":"2025-10-03","actionDesc":"Introduced in House","text":"<p><strong>Shutdown Guidance for Financial Institutions Act </strong></p><p>This bill directs financial regulators—including the Federal Reserve Board, the Consumer Financial Protection Bureau, the Office of the Comptroller of the Currency, the Federal Deposit Insurance Corporation, and the National Credit Union Administration—to jointly issue guidance relating to a government shutdown.</p><p>Specifically, financial regulators must issue guidance encouraging financial institutions to</p><ul><li>work with consumers and businesses affected by a shutdown,</li><li>recognize that consumers and businesses affected by a shutdown may lose access to credit and face temporary hardship in making payments on debts,</li><li>consider efforts to modify terms on existing loans or extend new credit to assist consumers and businesses affected by a shutdown, and</li><li>take steps to prevent adverse credit information from being reported in a manner that harms consumers affected by a shutdown.</li></ul><p>In addition, financial regulators must jointly issue a press release to notify financial institutions, consumers, and businesses&nbsp;of this guidance in the event of a government shutdown.</p><p>Financial regulators must also complete a report after a government shutdown regarding the guidance's effectiveness and update the guidance if any shortcoming are identified in the report.&nbsp;</p>","updateDate":"2025-10-17T18:22:44Z","versionCode":"00"}],"title":"Shutdown Guidance for Financial Institutions Act","type":"hr","updateDate":"2026-09-17T08:07:30Z","updateDateIncludingText":"2026-09-17T08:07:30Z"}
