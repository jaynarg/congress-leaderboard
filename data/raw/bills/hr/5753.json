or":false,"party":"D","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"K000009","fullName":"Rep. Kaptur, Marcy [D-OH-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-20","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-09-16T22:59:59+00:00","id":"hr5753-119","introducedDate":"2025-10-14","latestAction":{"actionDate":"2025-10-14","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"5753","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"M000312","district":2,"fullName":"Rep. McGovern, James P. [D-MA-2]","party":"D","state":"MA"}],"summaries":[{"actionDate":"2025-10-14","actionDesc":"Introduced in House","text":"<p><strong>Healthy Meals Help Kids Learn Act of 2025</strong></p><p>This bill permanently increases the federal reimbursement rates for the school lunch and breakfast programs of the Department of Agriculture.</p><p>Specifically, beginning&nbsp;November 1, 2025,&nbsp;the bill provides an additional 45 cents per lunch served in the National School Lunch Program and an additional 28 cents per breakfast served in the School Breakfast Program. These amounts must be adjusted annually for inflation beginning July 1, 2026.</p>","updateDate":"2026-03-16T13:11:08Z","versionCode":"00"}],"title":"Healthy Meals Help Kids Learn Act of 2025","type":"hr","updateDate":"2026-08-21T08:05:43Z","updateDateIncludingText":"2026-08-21T08:05:43Z"}
