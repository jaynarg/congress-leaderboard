ipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001313","fullName":"Rep. Brown, Shontel M. [D-OH-11]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"F000477","fullName":"Rep. Foushee, Valerie P. [D-NC-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"D000617","fullName":"Rep. DelBene, Suzan K. [D-WA-1]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"S001205","fullName":"Rep. Scanlon, Mary Gay [D-PA-5]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"K000391","fullName":"Rep. Krishnamoorthi, Raja [D-IL-8]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"T000488","fullName":"Rep. Thanedar, Shri [D-MI-13]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"E000296","fullName":"Rep. Evans, Dwight [D-PA-3]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"W000822","fullName":"Rep. Watson Coleman, Bonnie [D-NJ-12]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"M001196","fullName":"Rep. Moulton, Seth [D-MA-6]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"M001241","fullName":"Rep. Min, Dave [D-CA-47]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-02-21","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"D000631","fullName":"Rep. Dean, Madeleine [D-PA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-26","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"A000148","fullName":"Rep. Auchincloss, Jake [D-MA-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"T000482","fullName":"Rep. Trahan, Lori [D-MA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"L000606","fullName":"Rep. Latimer, George [D-NY-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"W000831","fullName":"Rep. Walkinshaw, James R. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T19:54:02+00:00","id":"hr1456-119","introducedDate":"2025-02-21","latestAction":{"actionDate":"2025-02-21","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"1456","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"C001117","district":6,"fullName":"Rep. Casten, Sean [D-IL-6]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-02-21","actionDesc":"Introduced in House","text":"<p><strong>Gun Trafficker Detection Act</strong></p><p>This bill requires individual gun owners to report lost or stolen firearms to law enforcement.</p><p>Specifically, the bill requires gun owners to report a lost or stolen firearm to the Bureau of Alcohol, Tobacco, Firearms and Explosives (ATF) or local law enforcement within 48 hours of discovery. A gun owner who fails to report a lost or stolen firearm is subject to a civil penalty of up to $1,000 for the first violation; a civil penalty of up to $5,000 and a one-year prohibition on receiving a firearm for the second violation; and a civil penalty of up to $5,000 and a five-year prohibition on receiving a firearm for the third or subsequent violation. Further, a gun owner who receives a firearm while subject to a one-year or five-year prohibition on such receipt is subject to criminal penalties—a fine, a prison term of up to one year, or both.&nbsp;</p><p>Additionally, the bill prohibits making false statements or misrepresentations with respect to the information required in a report of a lost or stolen firearm. A violation is subject to criminal penalties—a fine, a prison term of up to five years, or both.&nbsp;</p><p>The bill directs the ATF to create a web-based portal where individuals can report lost or stolen firearms. It also requires states to use at least 5% of funds under the Edward Byrne Memorial Justice Assistance Grant program to collect and manage data about lost or stolen firearms reported to local law enforcement.&nbsp;</p>","updateDate":"2026-02-03T23:11:31Z","versionCode":"00"}],"title":"Gun Trafficker Detection Act","type":"hr","updateDate":"2026-02-03T23:12:18Z","updateDateIncludingText":"2026-02-03T23:12:18Z"}
