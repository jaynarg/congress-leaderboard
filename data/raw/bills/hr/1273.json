:"2025-06-24","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001287","fullName":"Rep. Bera, Ami [D-CA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-27","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001188","fullName":"Rep. Meng, Grace [D-NY-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-25","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001241","fullName":"Rep. Min, Dave [D-CA-47]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-25","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000404","fullName":"Del. King-Hinds, Kimberlyn [R-MP-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-12","sponsorshipWithdrawnDate":null,"state":"MP"},{"bioguideId":"K000399","fullName":"Rep. Kiggans, Jennifer A. [R-VA-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-02","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"M001219","fullName":"Del. Moylan, James C. [R-GU-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-10","sponsorshipWithdrawnDate":null,"state":"GU"},{"bioguideId":"W000831","fullName":"Rep. Walkinshaw, James R. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-31","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T19:44:29+00:00","id":"hr1273-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2025-02-12","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"1273","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"S001230","district":10,"fullName":"Rep. Subramanyam, Suhas [D-VA-10]","party":"D","state":"VA"}],"summaries":[{"actionDate":"2025-02-12","actionDesc":"Introduced in House","text":"<p><strong>Korean American Divided Families National Registry Act</strong></p><p>This bill establishes a national registry of Korean American families who wish to be reunited with family members living in North Korea. The bill also requires the Department of State to include reunions of such families in any direct dialogue with North Korea.</p><p>Specifically, the bill requires the State Department to (1) collect information on Korean American families, divided from North Korean family members after the Korean War armistice,&nbsp;who wish to be reunited with such family members; and (2) establish a national registry of information on those families to facilitate future reunions. The State Department must&nbsp;ensure that any direct dialogue with North Korea includes progress towards holding such reunions.</p><p>The State Department must report to Congress periodically on the registry, previous reunions, and on certain North Korean actions related to reunions.</p>","updateDate":"2025-07-18T20:02:31Z","versionCode":"00"}],"title":"Korean American Divided Families National Registry Act","type":"hr","updateDate":"2025-11-01T08:05:39Z","updateDateIncludingText":"2025-11-01T08:05:39Z"}
