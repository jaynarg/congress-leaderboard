ll,"state":"OK"},{"bioguideId":"D000032","fullName":"Rep. Donalds, Byron [R-FL-19]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"L000583","fullName":"Rep. Loudermilk, Barry [R-GA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-16T19:17:09+00:00","id":"hr723-119","introducedDate":"2025-01-24","latestAction":{"actionDate":"2025-01-24","text":"Referred to the House Committee on House Administration."},"laws":[],"number":"723","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"C001053","district":4,"fullName":"Rep. Cole, Tom [R-OK-4]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2025-01-24","actionDesc":"Introduced in House","text":"<p><strong>Protect American Election Administration Act of </strong><strong>2025</strong></p><p>This bill generally prohibits a state from soliciting, receiving, or expending any payment or donation of funds, property, or personal services from a private entity for the purpose of administering a federal election. For example, the bill prohibits the use of these payments or donations for programs related to voter education, outreach, and registration.</p><p>The prohibition shall not apply to a state's acceptance and use of a private entity's donation of space to be used for a polling place or an early voting site.</p>","updateDate":"2025-05-06T00:56:06Z","versionCode":"00"}],"title":"Protect American Election Administration Act of 2025","type":"hr","updateDate":"2025-06-13T18:05:42Z","updateDateIncludingText":"2025-06-13T18:05:42Z"}
