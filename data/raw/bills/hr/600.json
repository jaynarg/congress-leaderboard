{"actions":[{"actionCode":"H11100","actionDate":"2025-01-22","source":"House floor actions","text":"Referred to the House Committee on Foreign Affairs.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-22","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-22","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/600","cosponsors":[{"bioguideId":"C001120","fullName":"Rep. Crenshaw, Dan [R-TX-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"E000298","fullName":"Rep. Estes, Ron [R-KS-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"S001214","fullName":"Rep. Steube, W. Gregory [R-FL-17]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-22","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"L000596","fullName":"Rep. Luna, Anna Paulina [R-FL-13]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-23","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000603","fullName":"Rep. Gill, Brandon [R-TX-26]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-07","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-10","sponsorshipWithdrawnDate":null,"state":"MD"}],"fetchedAt":"2026-09-16T19:11:00+00:00","id":"hr600-119","introducedDate":"2025-01-22","latestAction":{"actionDate":"2025-01-22","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"600","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"A000375","district":19,"fullName":"Rep. Arrington, Jodey C. [R-TX-19]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-01-22","actionDesc":"Introduced in House","text":"<p><strong>WHO is Accountable Act</strong></p><p>This bill prohibits the use of federal funds to seek U.S. membership in the World Health Organization (WHO), or to make contributions to the WHO, until the Department of State makes certain certifications to Congress.</p><p>Specifically, these prohibitions shall apply until the State Department certifies that the WHO has met certain conditions, including that the WHO (1) has adopted reforms to ensure that humanitarian assistance is not politicized; (2) is not under the control of the Chinese Communist Party (CCP) and is not involved in a cover-up of the CCP's response to the COVID-19 pandemic; (3) has granted observer status to Taiwan; and (4) has ceased engagement on certain issues, such as climate change, access to abortion, and gender identity.</p>","updateDate":"2025-03-03T12:56:00Z","versionCode":"00"}],"title":"WHO is Accountable Act","type":"hr","updateDate":"2025-03-11T08:06:50Z","updateDateIncludingText":"2025-03-11T08:06:50Z"}
