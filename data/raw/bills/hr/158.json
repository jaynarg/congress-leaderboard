{"actions":[{"actionCode":"H11100","actionDate":"2025-01-03","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-03","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-03","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/158","cosponsors":[{"bioguideId":"D000530","fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-21","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-08","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"L000601","fullName":"Rep. Landsman, Greg [D-OH-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"OH"}],"fetchedAt":"2026-09-20T13:53:24+00:00","id":"hr158-119","introducedDate":"2025-01-03","latestAction":{"actionDate":"2025-01-03","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"158","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"F000466","district":1,"fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","party":"R","state":"PA"}],"summaries":[{"actionDate":"2025-01-03","actionDesc":"Introduced in House","text":"<p><strong>Citizen Legislature Anti-Corruption Reform of Elections Act or the CLEAN Elections Act</strong></p><p>This bill establishes requirements for nonpartisan redistricting.</p><p>States must conduct congressional redistricting using a plan developed by a nonpartisan independent redistricting commission, beginning with the 2020 census.</p><p>A state may not use federal funds provided for election administration purposes unless it certifies to the Election Assistance Commission that it conducts redistricting for its state legislative districts using a plan developed by a nonpartisan independent redistricting commission.</p>","updateDate":"2025-02-20T16:34:18Z","versionCode":"00"}],"title":"CLEAN Elections Act","type":"hr","updateDate":"2026-09-19T23:07:40Z","updateDateIncludingText":"2026-09-19T23:07:40Z"}
