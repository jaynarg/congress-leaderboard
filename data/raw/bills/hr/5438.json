nsorshipDate":"2026-02-11","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"E000300","fullName":"Rep. Evans, Gabe [R-CO-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-03","sponsorshipWithdrawnDate":null,"state":"CO"}],"fetchedAt":"2026-09-23T14:33:29+00:00","id":"hr5438-119","introducedDate":"2025-09-17","latestAction":{"actionDate":"2026-02-04","text":"Ordered to be Reported (Amended) by the Yeas and Nays: 25 - 19."},"laws":[],"number":"5438","originChamber":"House","policyArea":"Economics and Public Finance","sponsors":[{"bioguideId":"M001218","district":7,"fullName":"Rep. McCormick, Richard [R-GA-7]","party":"R","state":"GA"}],"summaries":[{"actionDate":"2025-09-17","actionDesc":"Introduced in House","text":"<p><strong>Incentivize Savings Act</strong></p><p>This bill establishes requirements for allocating unexpended appropriations for federal agencies.</p><p>If appropriations are provided to a federal agency for a definite period and the agency does not spend the funds during the period of availability, the bill requires</p><ul><li>49% of the funds to remain available for an additional fiscal year,</li><li>49% of the funds to&nbsp;be used for payments of principal and interest on the public debt, and</li><li>2% of the funds to be used for retention bonuses within&nbsp;the agency that do not exceed 10% of an employee's basic pay.</li></ul><p>If an agency's unexpended appropriations are allocated under this bill, the agency's budget request for the fiscal year following the fiscal&nbsp;year in which the funds expired may not exceed the prior year's budget request with an adjustment for inflation.</p>","updateDate":"2026-09-22T14:05:07Z","versionCode":"00"}],"title":"Incentivize Savings Act","type":"hr","updateDate":"2026-09-22T14:06:36Z","updateDateIncludingText":"2026-09-22T14:06:36Z"}
