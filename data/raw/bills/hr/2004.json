te":"NM"},{"bioguideId":"M001226","fullName":"Rep. Menendez, Robert [D-NJ-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"W000795","fullName":"Rep. Wilson, Joe [R-SC-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"B001281","fullName":"Rep. Beatty, Joyce [D-OH-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-14","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"M001204","fullName":"Rep. Meuser, Daniel [R-PA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"M001236","fullName":"Rep. Moore, Tim [R-NC-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-21","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-16T20:20:19+00:00","id":"hr2004-119","introducedDate":"2025-03-10","latestAction":{"actionDate":"2026-09-15","actionTime":"19:31:07","text":"Motion to reconsider laid on the table Agreed to without objection."},"laws":[],"number":"2004","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"L000582","district":36,"fullName":"Rep. Lieu, Ted [D-CA-36]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-03-10","actionDesc":"Introduced in House","text":"<p><strong>Tyler’s Law</strong></p><p>This bill requires the Department of Health and Human Services (HHS) to complete, within one year after the bill’s enactment, a study on how frequently Medicare-participating hospital emergency departments test for fentanyl in patients experiencing an overdose, the costs associated with such testing, and how such testing may impact patients.&nbsp;</p><p>Within six months after the study’s completion and based on its results,&nbsp;HHS must issue guidance regarding (1) whether hospital emergency departments should implement fentanyl testing as a routine procedure for patients experiencing an overdose, (2) how to ensure clinicians know which substances they are testing for in routine drug tests, and (3) how fentanyl testing may affect the future risk of overdose and other health outcomes.</p>","updateDate":"2026-09-03T14:54:46Z","versionCode":"00"}],"title":"Tyler’s Law","type":"hr","updateDate":"2026-09-16T15:22:45Z","updateDateIncludingText":"2026-09-16T15:22:45Z"}
