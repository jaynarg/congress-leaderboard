ponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"K000009","fullName":"Rep. Kaptur, Marcy [D-OH-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-20","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"D000635","fullName":"Rep. Dexter, Maxine [D-OR-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-08","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"R000305","fullName":"Rep. Ross, Deborah K. [D-NC-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"C001112","fullName":"Rep. Carbajal, Salud O. [D-CA-24]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001257","fullName":"Rep. Bilirakis, Gus M. [R-FL-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-10-01","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"R000621","fullName":"Rep. Randall, Emily [D-WA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-10-13","sponsorshipWithdrawnDate":null,"state":"WA"}],"fetchedAt":"2026-10-24T13:43:40+00:00","id":"hr5439-119","introducedDate":"2025-09-17","latestAction":{"actionDate":"2026-09-16","text":"Ordered to be Reported in the Nature of a Substitute by the Yeas and Nays: 39 - 0."},"laws":[],"number":"5439","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"M000312","district":2,"fullName":"Rep. McGovern, James P. [D-MA-2]","party":"D","state":"MA"}],"summaries":[{"actionDate":"2025-09-17","actionDesc":"Introduced in House","text":"<p><strong>Medically Tailored Home-Delivered Meals Program Pilot Act</strong></p><p>This bill requires the Centers for Medicare &amp; Medicaid Services (CMS) to establish a temporary program through which certain Medicare beneficiaries with diet-impacted diseases may receive medically tailored meals at home to reduce their rate of hospital readmissions.</p><p>Specifically, the CMS must select, upon application, at least 40 hospitals to participate in a six-year program to deliver medically tailored meals to qualifying individuals' homes. Participating hospitals must meet specified program integrity and quality of care metrics and certify that they are able to provide the required meals and associated medical nutrition therapy. Hospitals must have a physician, registered dietitian or nutrition professional, advanced practice nurse, or clinical social worker screen inpatients upon discharge from the hospital and every 12 weeks thereafter to determine whether these individuals qualify for the meal program.&nbsp;</p><p>In order to qualify for the program, individuals must have a diet-impacted disease (e.g., kidney disease), live at home, not be receiving extended care services or hospice care, be limited with respect to at least two activities of daily living, and meet any other criteria for high-risk readmissions (as determined by the CMS).</p>","updateDate":"2026-10-23T21:06:35Z","versionCode":"00"}],"title":"Medically Tailored Home-Delivered Meals Program Pilot Act","type":"hr","updateDate":"2026-10-23T21:07:40Z","updateDateIncludingText":"2026-10-23T21:07:40Z"}
