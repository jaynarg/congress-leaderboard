{"actions":[{"actionCode":"H11100","actionDate":"2025-02-07","source":"House floor actions","text":"Referred to the House Committee on Foreign Affairs.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-02-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-02-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/1139","cosponsors":[{"bioguideId":"W000814","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-10","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-09-16T19:37:52+00:00","id":"hr1139-119","introducedDate":"2025-02-07","latestAction":{"actionDate":"2025-02-07","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"1139","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"R000614","district":21,"fullName":"Rep. Roy, Chip [R-TX-21]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-02-07","actionDesc":"Introduced in House","text":"<p><strong>Passport Sanity Act</strong></p> <p>This bill prohibits the Department of State from issuing a passport, passport card, or Consular Report of Birth Abroad with an unspecified (X) gender designation. The State Department must also ensure that applications for such documents include only male and female gender designations.</p>","updateDate":"2026-02-26T16:37:38Z","versionCode":"00"}],"title":"Passport Sanity Act","type":"hr","updateDate":"2026-02-26T16:37:44Z","updateDateIncludingText":"2026-02-26T16:37:44Z"}
