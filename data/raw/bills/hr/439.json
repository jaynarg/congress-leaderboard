nsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"M000317","fullName":"Rep. Malliotakis, Nicole [R-NY-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-26","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001216","fullName":"Rep. Schrier, Kim [D-WA-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-07","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"K000402","fullName":"Rep. Kennedy, Timothy M. [D-NY-26]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"C001123","fullName":"Rep. Cisneros, Gilbert Ray [D-CA-31]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T13:59:33+00:00","id":"hr439-119","introducedDate":"2025-01-15","latestAction":{"actionDate":"2025-02-20","text":"Referred to the Subcommittee on Health."},"laws":[],"number":"439","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"L000598","district":1,"fullName":"Rep. LaLota, Nick [R-NY-1]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-01-15","actionDesc":"Introduced in House","text":"<p><strong>Veterans Foreign Medical Coverage Equality and Modernization Act of 2025</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to furnish hospital care and medical services abroad (i.e., outside any state) to a veteran with a service-connected disability rated as permanent and total who is otherwise eligible for such care if the VA determines certain requirements are met. Specifically, the VA must furnish such care to an eligible veteran if it determines (1) the hospital care or medical services are consistent with the standard medical practice in the United States, and (2) any prescription medication furnished is approved by the Food and Drug Administration.</p><p>For any care provided abroad, the VA must ensure (1) reimbursements made to veterans and medical providers can be made by direct deposit; and (2) the VA’s mobile applications provide for digital submission, real-time tracking of required forms, and the availability of specified documents associated with care or services, such as a benefits authorization letter.</p>","updateDate":"2025-02-18T21:56:14Z","versionCode":"00"}],"title":"Veterans Foreign Medical Coverage Equality and Modernization Act of 2025","type":"hr","updateDate":"2026-09-19T23:07:31Z","updateDateIncludingText":"2026-09-19T23:07:31Z"}
