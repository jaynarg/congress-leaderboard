oguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"G000568","fullName":"Rep. Griffith, H. Morgan [R-VA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-03","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"A000380","fullName":"Rep. Amo, Gabe [D-RI-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"RI"}],"fetchedAt":"2026-09-16T19:11:48+00:00","id":"hr617-119","introducedDate":"2025-01-22","latestAction":{"actionDate":"2025-04-29","text":"Received in the Senate. Read twice. Placed on Senate Legislative Calendar under General Orders. Calendar No. 59."},"laws":[],"number":"617","originChamber":"House","policyArea":"Arts, Culture, Religion","sponsors":[{"bioguideId":"H001086","district":1,"fullName":"Rep. Harshbarger, Diana [R-TN-1]","party":"R","state":"TN"}],"summaries":[{"actionDate":"2025-01-22","actionDesc":"Introduced in House","text":"<p><strong>American Music Tourism Act of 2025</strong></p><p>This bill directs the National Travel and Tourism Office (NTTO) of the Department of Commerce to promote tourism to music-related and sports attractions.</p><p>The bill requires NTTO to promote domestic and international travel and tourism to&nbsp;U.S. music festivals, concert venues, and other music-related attractions and locations. The bill also expands NTTO's current mandate to facilitate sports and recreation events and activities to include the&nbsp;promotion of international travel and tourism to such activities in the United States.</p><p>NTTO must report its activities and findings to Congress within one year after the bill's enactment and, thereafter, every two years.&nbsp;</p>","updateDate":"2025-03-03T13:39:30Z","versionCode":"00"}],"title":"American Music Tourism Act of 2025","type":"hr","updateDate":"2026-07-11T14:08:20Z","updateDateIncludingText":"2026-07-13T19:00:04Z"}
