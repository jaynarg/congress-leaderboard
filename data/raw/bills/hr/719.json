thdrawnDate":null,"state":"IN"},{"bioguideId":"G000590","fullName":"Rep. Green, Mark E. [R-TN-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"TN"}],"fetchedAt":"2026-09-16T19:16:55+00:00","id":"hr719-119","introducedDate":"2025-01-24","latestAction":{"actionDate":"2025-01-24","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"719","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"B001317","district":2,"fullName":"Rep. Brecheen, Josh [R-OK-2]","party":"R","state":"OK"}],"summaries":[{"actionDate":"2025-01-24","actionDesc":"Introduced in House","text":"<p><strong>No Abortion Coverage for Medicaid Act</strong></p><p>This bill prohibits the Centers for Medicare &amp; Medicaid Services from approving experimental, pilot, or demonstration projects under Medicaid (also known as Section 1115 Demonstrations) if the project provides federal financial assistance for abortions or for health benefits that include abortions, including expenses for related travel or lodging.</p><p>The bill's restrictions do not apply to abortions&nbsp;in the cases of rape or incest; treatments to address life-threatening physical disorders, injuries, or illnesses; or treatments for miscarriages or ectopic pregnancies.</p>","updateDate":"2025-04-18T18:49:01Z","versionCode":"00"}],"title":"No Abortion Coverage for Medicaid Act","type":"hr","updateDate":"2025-04-22T15:57:46Z","updateDateIncludingText":"2025-04-22T15:57:46Z"}
