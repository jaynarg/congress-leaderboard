"DC"},{"bioguideId":"M000687","fullName":"Rep. Mfume, Kweisi [D-MD-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"S000510","fullName":"Rep. Smith, Adam [D-WA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"D000096","fullName":"Rep. Davis, Danny K. [D-IL-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-23","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"S001205","fullName":"Rep. Scanlon, Mary Gay [D-PA-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"F000481","fullName":"Rep. Figures, Shomari [D-AL-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M001223","fullName":"Rep. Magaziner, Seth [D-RI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-08","sponsorshipWithdrawnDate":null,"state":"RI"},{"bioguideId":"D000635","fullName":"Rep. Dexter, Maxine [D-OR-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-22","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"G000598","fullName":"Rep. Garcia, Robert [D-CA-42]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-22","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"H001090","fullName":"Rep. Harder, Josh [D-CA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T22:04:55+00:00","id":"hr4405-119","introducedDate":"2025-07-15","latestAction":{"actionDate":"2025-11-19","text":"Became Public Law No: 119-38."},"laws":[{"number":"119-38","type":"Public Law"}],"number":"4405","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"K000389","district":17,"fullName":"Rep. Khanna, Ro [D-CA-17]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-07-15","actionDesc":"Introduced in House","text":"<p><strong>Epstein Files Transparency Act</strong></p><p>This bill requires the Department of Justice (DOJ) to publish (in a searchable and downloadable format) all&nbsp;unclassified records, documents, communications, and investigative materials in DOJ's possession that relate to the investigation and prosecution of Jeffrey Epstein.</p><p>This includes (1) materials&nbsp;that relate to Ghislaine Maxwell, (2) flight logs and travel records, and (3) individuals named or referenced (including government officials) in connection with the investigation and prosecution of Jeffrey Epstein.</p><p>DOJ is permitted to withhold certain information such as the personal information of victims and materials that would jeopardize an active federal investigation.</p><p>Additionally, not later than 15 days after the required publication, DOJ must report to Congress (1) all categories of information released and withheld, (2) a summary of any redactions made, and (3) a list of all government officials and politically exposed individuals named or referenced in the published materials.</p>","updateDate":"2025-09-08T17:37:36Z","versionCode":"00"},{"actionDate":"2025-11-19","actionDesc":"Public Law","text":"<p><strong>Epstein Files Transparency Act</strong></p><p>This act requires the Department of Justice (DOJ) to publish (in a searchable and downloadable format) all&nbsp;unclassified records, documents, communications, and investigative materials in DOJ's possession that relate to the investigation and prosecution of Jeffrey Epstein.</p><p>This includes (1) materials&nbsp;that relate to Ghislaine Maxwell, (2) flight logs and travel records, and (3) individuals named or referenced (including government officials) in connection with the investigation and prosecution of Jeffrey Epstein.</p><p>DOJ is permitted to withhold certain information such as the personal information of victims and materials that would jeopardize an active federal investigation.</p><p>Additionally, not later than 15 days after the required publication, DOJ must report to Congress (1) all categories of information released and withheld, (2) a summary of any redactions made, and (3) a list of all government officials and politically exposed individuals named or referenced in the published materials.</p>","updateDate":"2026-06-02T20:03:43Z","versionCode":"49"}],"title":"Epstein Files Transparency Act","type":"hr","updateDate":"2026-07-18T00:01:51Z","updateDateIncludingText":"2026-07-18T00:01:51Z"}
