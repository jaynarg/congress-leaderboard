{"actions":[{"actionCode":"H11100","actionDate":"2025-04-10","source":"House floor actions","text":"Referred to the House Committee on Agriculture.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-04-10","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-04-10","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/2868","cosponsors":[{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-10","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"L000606","fullName":"Rep. Latimer, George [D-NY-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"C001059","fullName":"Rep. Costa, Jim [D-CA-21]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-01","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T20:59:00+00:00","id":"hr2868-119","introducedDate":"2025-04-10","latestAction":{"actionDate":"2025-04-10","text":"Referred to the House Committee on Agriculture."},"laws":[],"number":"2868","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"M001238","district":null,"fullName":"Rep. McBride, Sarah [D-DE-At Large]","party":"D","state":"DE"}],"summaries":[{"actionDate":"2025-04-10","actionDesc":"Introduced in House","text":"<p><strong>Supporting Avian Virus Eradication Act or the SAVE Our Poultry Act</strong></p><p>This bill includes research on highly pathogenic avian influenza (HPAI) as a Department of Agriculture (USDA) high-priority research and extension area.</p><p>Under the bill, USDA may award grants to land-grant colleges and universities to study HPAI for the purposes of (1) developing and improving the efficacy of vaccines for poultry, and (2) enhancing biosecurity procedures for poultry producers.</p>","updateDate":"2025-08-26T12:40:40Z","versionCode":"00"}],"title":"SAVE Our Poultry Act","type":"hr","updateDate":"2026-06-11T05:06:22Z","updateDateIncludingText":"2026-06-11T05:06:22Z"}
