nsor":false,"party":"D","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001225","fullName":"Rep. Mullin, Kevin [D-CA-15]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-31","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"D000530","fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"S001225","fullName":"Rep. Sorensen, Eric [D-IL-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-15","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"R000579","fullName":"Rep. Ryan, Patrick [D-NY-18]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"T000472","fullName":"Rep. Takano, Mark [D-CA-39]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T14:16:30+00:00","id":"hr2368-119","introducedDate":"2025-03-26","latestAction":{"actionDate":"2025-03-26","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"2368","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"I000058","district":4,"fullName":"Rep. Ivey, Glenn [D-MD-4]","party":"D","state":"MD"}],"summaries":[{"actionDate":"2025-03-26","actionDesc":"Introduced in House","text":"<p><strong>Raise the Age Act of 2025</strong></p><p>This bill establishes new restrictions on the sale or transfer of certain semiautomatic firearms to individuals under 21 years of age.</p><p>Specifically, this bill makes it unlawful for a licensed gun dealer, importer, manufacturer, or collector to sell or deliver a semiautomatic center-fire rifle or semiautomatic center-fire shotgun that has (or has the capacity to accept) an ammunition feeding device with a capacity of more than five rounds to an individual who the licensee knows or has reasonable cause to believe is under age 21.</p><p>The prohibition does not apply if the individual under age 21 is a full-time law enforcement officer or active-duty member of the Armed Forces.</p><p>The bill also requires the Federal Bureau of Investigation to report on the operation of its public access line, including a description of information sharing protocols and recommendations for improving such protocols.</p>","updateDate":"2026-05-07T20:48:33Z","versionCode":"00"}],"title":"Raise the Age Act of 2025","type":"hr","updateDate":"2026-09-19T23:37:14Z","updateDateIncludingText":"2026-09-19T23:37:14Z"}
