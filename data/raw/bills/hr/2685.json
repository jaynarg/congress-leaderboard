{"actions":[{"actionCode":"H11000","actionDate":"2025-04-07","source":"House committee actions","text":"Referred to the Subcommittee on Transportation and Maritime Security.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-04-07","source":"House floor actions","text":"Referred to the House Committee on Homeland Security.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-04-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-04-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/2685","cosponsors":[{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-20","sponsorshipWithdrawnDate":null,"state":"OK"}],"fetchedAt":"2026-09-16T20:51:21+00:00","id":"hr2685-119","introducedDate":"2025-04-07","latestAction":{"actionDate":"2025-04-07","text":"Referred to the Subcommittee on Transportation and Maritime Security."},"laws":[],"number":"2685","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"M000317","district":11,"fullName":"Rep. Malliotakis, Nicole [R-NY-11]","party":"R","state":"NY"}],"summaries":[{"actionDate":"2025-04-07","actionDesc":"Introduced in House","text":"<p><strong>Crime Doesn't Fly Act of 2025</strong></p><p>This bill prohibits the use of Immigration and Customs Enforcement warrants for the arrest, removal, or deportation of a non-U.S. national (<em>alien</em> under federal law) as proof of identity at an airport security checkpoint unless the non-U.S. national is being removed from the United States pursuant to immigration laws.</p>","updateDate":"2025-05-06T10:20:44Z","versionCode":"00"}],"title":"Crime Doesn’t Fly Act of 2025","type":"hr","updateDate":"2025-11-21T12:04:34Z","updateDateIncludingText":"202