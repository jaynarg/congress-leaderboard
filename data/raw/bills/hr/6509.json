sorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"B001314","fullName":"Rep. Bean, Aaron [R-FL-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-17","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"K000376","fullName":"Rep. Kelly, Mike [R-PA-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-03-18","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001307","fullName":"Rep. Baird, James R. [R-IN-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-13","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"H001093","fullName":"Rep. Houchin, Erin [R-IN-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"F000480","fullName":"Rep. Fong, Vince [R-CA-20]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001229","fullName":"Rep. Shreve, Jefferson [R-IN-6]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-12","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"M001233","fullName":"Rep. Messmer, Mark B. [R-IN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"E000246","fullName":"Rep. Edwards, Chuck [R-NC-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001214","fullName":"Rep. Mrvan, Frank J. [D-IN-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-09","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"S001188","fullName":"Rep. Stutzman, Marlin A. [R-IN-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"D000230","fullName":"Rep. Davis, Donald G. [D-NC-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-21","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"V000135","fullName":"Rep. Van Orden, Derrick [R-WI-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-16","sponsorshipWithdrawnDate":null,"state":"WI"}],"fetchedAt":"2026-09-20T14:53:20+00:00","id":"hr6509-119","introducedDate":"2025-12-09","latestAction":{"actionDate":"2025-12-09","text":"Referred to the House Committee on Energy and Commerce."},"laws":[],"number":"6509","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"Y000067","district":2,"fullName":"Rep. Yakym, Rudy [R-IN-2]","party":"R","state":"IN"}],"summaries":[{"actionDate":"2025-12-09","actionDesc":"Introduced in House","text":"<p><strong>Safeguarding Americans from Fraudulent and Experimental Drugs Act of 2025 or the SAFE Drugs Act of 2025</strong></p><p>This bill provides for increased oversight of drug compounding and imposes statutory limits on compounded drugs that are essentially copies of commercially available drugs.</p><p>Currently, subject to certain requirements, compounded drugs (i.e., drugs that are mixed or altered to meet patient needs) do not require Food and Drug Administration (FDA) approval. Additional limits apply to the compounding of drugs that are essentially copies of commercially available drug products.</p><p>Under the bill, a compounded drug is <em>essentially a copy of a commercially available drug product</em> if (1) the compounded drug contains any active ingredient found in a commercially available drug product, and (2) there is no change made for an individual patient that results in a significant difference between the compounded drug and the commercially available drug. (The FDA’s current definition of the term also addresses dosage strength and route of administration.)&nbsp;</p><p>The bill increases the frequency at which a licensed pharmacist or physician may compound a drug that is essentially a copy of a commercially available drug to 20 times per month. Current FDA policy allows four such prescriptions per month.</p><p>The bill also imposes annual reporting requirements on physicians, facilities, and pharmacies (except hospital-based pharmacies) that compound certain drug products for out-of-state patients more than 20 times per month. Further, the bill subjects certain large-scale outsourcing facilities (i.e., FDA-registered facilities that compound in bulk) to regular inspection and reporting requirements.</p>","updateDate":"2026-06-16T14:39:16Z","versionCode":"00"}],"title":"SAFE Drugs Act of 2025","type":"hr","updateDate":"2026-09-19T23:34:01Z","updateDateIncludingText":"2026-09-19T23:34:01Z"}
