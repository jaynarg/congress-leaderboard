{"actions":[{"actionCode":"H11100","actionDate":"2025-11-10","source":"House floor actions","text":"Referred to the House Committee on Agriculture.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-11-10","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-11-10","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/6018","cosponsors":[{"bioguideId":"B001301","fullName":"Rep. Bergman, Jack [R-MI-1]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"M001230","fullName":"Rep. Mackenzie, Ryan [R-PA-7]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"G000591","fullName":"Rep. Guest, Michael [R-MS-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"MS"},{"bioguideId":"H001101","fullName":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001232","fullName":"Rep. McClain Delaney, April [D-MD-6]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-11-10","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-09","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"F000471","fullName":"Rep. Fitzgerald, Scott [R-WI-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-04-29","sponsorshipWithdrawnDate":null,"state":"WI"}],"fetchedAt":"2026-09-16T23:10:40+00:00","id":"hr6018-119","introducedDate":"2025-11-10","latestAction":{"actionDate":"2025-11-10","text":"Referred to the House Committee on Agriculture."},"laws":[],"number":"6018","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"W000829","district":8,"fullName":"Rep. Wied, Tony [R-WI-8]","party":"R","state":"WI"}],"summaries":[{"actionDate":"2025-11-10","actionDesc":"Introduced in House","text":"<p><strong>Bringing Assistance for Rural Needs During Shutdowns Act</strong></p><p>This bill&nbsp;requires Farm Service Agency (FSA) officers and employees to continue to work during a government shutdown.</p><p>As background, under an exception in the Antideficiency Act, an employee whose duties involve the safety of human life or the protection of property may be required to work during a government shutdown (i.e., lapse in appropriations).</p><p>Under this bill, any services by an FSA officer or employee are deemed to be for an emergency involving the safety of human life or the protection of property. Thus, if a lapse in FSA appropriations occurs, FSA officers and employees may be required to continue working.&nbsp;</p>","updateDate":"2026-04-28T14:58:55Z","versionCode":"00"}],"title":"Bringing Assistance for Rural Needs During Shutdowns Act","type":"hr","updateDate":"2026-07-17T23:43:22Z","updateDateIncludingText":"2026-07-17T23:43:22Z"}
