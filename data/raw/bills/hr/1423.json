sponsors":[{"bioguideId":"L000593","district":49,"fullName":"Rep. Levin, Mike [D-CA-49]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-02-18","actionDesc":"Introduced in House","text":"<p><strong>Guard and Reserve GI Bill Parity Act of 2025</strong></p><p>This bill expands eligibility for Post-9/11 educational assistance for members of the reserve components of the Armed Forces and members of the National Guard. Specifically, the bill expands the types of activities that count towards Post-9/11 GI Bill eligibility to include active duty, inactive-duty training, annual training duty, and full-time National Guard duty or active duty. (Generally, under current law, only federal active duty counts towards educational assistance eligibility.)</p>","updateDate":"2026-01-05T20:47:29Z","versionCode":"00"}],"title":"Guard and Reserve GI Bill Parity Act of 2025","type":"hr","updateDate":"2026-09-19T23:31:57Z","updateDateIncludingText":"2026-09-19T23:31:57Z"}
