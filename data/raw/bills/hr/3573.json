lse,"party":"D","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"T000474","fullName":"Rep. Torres, Norma J. [D-CA-35]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001226","fullName":"Rep. Salinas, Andrea [D-OR-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"T000487","fullName":"Rep. Tokuda, Jill N. [D-HI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-10","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"C001080","fullName":"Rep. Chu, Judy [D-CA-28]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"H001047","fullName":"Rep. Himes, James A. [D-CT-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"P000617","fullName":"Rep. Pressley, Ayanna [D-MA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-09-14","sponsorshipWithdrawnDate":null,"state":"MA"}],"fetchedAt":"2026-09-16T21:29:16+00:00","id":"hr3573-119","introducedDate":"2025-05-21","latestAction":{"actionDate":"2025-05-21","text":"Referred to the House Committee on Financial Services."},"laws":[],"number":"3573","originChamber":"House","policyArea":"Finance and Financial Sector","sponsors":[{"bioguideId":"W000187","district":43,"fullName":"Rep. Waters, Maxine [D-CA-43]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-05-21","actionDesc":"Introduced in House","text":"<p><strong>Stop Trading, Retention, and Unfair Market Payoffs in Crypto Act of 2025 or the Stop TRUMP in Crypto Act of 2025</strong></p><p>This bill prohibits certain government officials and their families from engaging in specified activities involving digital assets (including financial contracts, products, or instruments that derive their value from a digital asset).&nbsp;</p><p>Specifically, the President, the Vice President, and Members of Congress (and their spouses, children, and children's spouses) are prohibited from</p><ul><li>owning a proportion of such an asset that allows the individual to unilaterally make changes to the asset;</li><li>serving as an officer, director, or owner of an asset issuer;</li><li>issuing, sponsoring, promoting, or receiving any direct or indirect compensation for the sale, marketing, or mining of such an asset in the United States or to a person in the United States; or</li><li>trading assets while the official is in office if the individual has material non-public information about such assets.</li></ul><p>The bill also prohibits indirect engagement in such activities through intermediaries such as trusts or corporations or through other arrangements intended to conceal the individual’s beneficial ownership or control.</p><p>Individuals who violate this bill are subject to penalties including fines and imprisonment.</p>","updateDate":"2026-05-26T19:34:28Z","versionCode":"00"}],"title":"Stop TRUMP in Crypto Act of 2025","type":"hr","updateDate":"2026-09-15T08:06:08Z","updateDateIncludingText":"2026-09-15T08:06:08Z"}
