lse,"party":"D","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"R000617","fullName":"Rep. Ramirez, Delia C. [D-IL-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-04","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"F000483","fullName":"Rep. Friedman, Laura [D-CA-30]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-03","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"N000188","fullName":"Rep. Norcross, Donald [D-NJ-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-13","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-16T22:58:03+00:00","id":"hr5705-119","introducedDate":"2025-10-08","latestAction":{"actionDate":"2025-10-08","text":"Referred to the House Committee on Education and Workforce."},"laws":[],"number":"5705","originChamber":"House","policyArea":"Agriculture and Food","sponsors":[{"bioguideId":"A000380","district":1,"fullName":"Rep. Amo, Gabe [D-RI-1]","party":"D","state":"RI"}],"summaries":[{"actionDate":"2025-10-08","actionDesc":"Introduced in House","text":"<p>This bill requires the federal government to reimburse state agencies that use state funds to carry out operations necessary to maintain participation in the Special Supplemental Nutrition Program for Women, Infants, and Children (WIC) during a lapse in discretionary appropriations (i.e., government shutdown). WIC&nbsp;provides nutrition-rich foods, nutrition education, and health care and social services referrals to eligible low-income women, infants, and children.</p>","updateDate":"2025-10-20T14:06:32Z","versionCode":"00"}],"title":"To authorize the reimbursement by the Federal Government of State funds used to maintain participation in the Special Supplemental Nutrition Program for Women, Infants, and Children in the event of a Government shutdown.","type":"hr","updateDate":"2026-01-14T09:07:17Z","updateDateIncludingText":"2026-01-14T09:07:17Z"}
