sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"K000392","fullName":"Rep. Kustoff, David [R-TN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"M001210","fullName":"Rep. Murphy, Gregory F. [R-NC-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"C001126","fullName":"Rep. Carey, Mike [R-OH-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-25","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"L000585","fullName":"Rep. LaHood, Darin [R-IL-16]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-03","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"A000369","fullName":"Rep. Amodei, Mark E. [R-NV-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"C001116","fullName":"Rep. Clyde, Andrew S. [R-GA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"B001314","fullName":"Rep. Bean, Aaron [R-FL-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-25","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"E000298","fullName":"Rep. Estes, Ron [R-KS-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-02","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"Y000067","fullName":"Rep. Yakym, Rudy [R-IN-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"L000595","fullName":"Rep. Letlow, Julia [R-LA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-03","sponsorshipWithdrawnDate":null,"state":"LA"}],"fetchedAt":"2026-09-20T14:00:08+00:00","id":"hr451-119","introducedDate":"2025-01-15","latestAction":{"actionDate":"2025-01-15","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"451","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"S001172","district":3,"fullName":"Rep. Smith, Adrian [R-NE-3]","party":"R","state":"NE"}],"summaries":[{"actionDate":"2025-01-15","actionDesc":"Introduced in House","text":"<p><strong>Fostering Autonomy in Independent Returns by Prohibiting Redundant and Extralegal Programs Act of 2025 or the FAIR PREP Act of 2025</strong></p><p>This bill prohibits the Internal Revenue Service (IRS) from preparing federal tax returns or refund claims, with some exceptions. The bill specifically prohibits the preparation of federal income tax returns or refund claims through the IRS’s Direct File program. (The Direct File program currently allows qualified taxpayers in 25 participating states to prepare and electronically file free federal tax returns through a portal on the IRS’s website.)</p><p>The bill defines <em>prepare</em> with respect to federal tax returns and refund claims as (1) the completion (in whole or in part) of any form or schedule for the purpose of calculating federal taxes or refunds, and (2) the filing (either electronically or on paper) of such federal tax returns or refund claims.</p><p>However, under the bill, federal and state tax returns and refund claims may be prepared through the IRS’s Free File program (a program that allows certain taxpayers to prepare and file free federal and state income tax returns&nbsp;using third-party tax-preparation software) or the Volunteer Income Tax Assistance grant program (through which the IRS partners with local community organizations to help low-income and disabled individuals and persons with limited English proficiency prepare and file free federal and state&nbsp;income tax returns).</p><p> Further, the Department of the Treasury may not award grants or enter into contracts&nbsp;or other transactions for the development or operation of an electronic tax preparation service.&nbsp;&nbsp;</p>","updateDate":"2025-03-24T17:01:26Z","versionCode":"00"}],"title":"FAIR PREP Act of 2025","type":"hr","updateDate":"2026-09-19T23:07:18Z","updateDateIncludingText":"2026-09-19T23:07:18Z"}
