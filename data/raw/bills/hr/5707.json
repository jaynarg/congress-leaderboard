,"sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"S001185","fullName":"Rep. Sewell, Terri A. [D-AL-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"C001072","fullName":"Rep. Carson, André [D-IN-7]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-10","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-10","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"R000617","fullName":"Rep. Ramirez, Delia C. [D-IL-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-10","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"T000481","fullName":"Rep. Tlaib, Rashida [D-MI-12]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-14","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"J000310","fullName":"Rep. Johnson, Julie [D-TX-32]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"R000621","fullName":"Rep. Randall, Emily [D-WA-6]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-17","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"S001159","fullName":"Rep. Strickland, Marilyn [D-WA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-18","sponsorshipWithdrawnDate":null,"state":"WA"}],"fetchedAt":"2026-09-16T22:58:09+00:00","id":"hr5707-119","introducedDate":"2025-10-08","latestAction":{"actionDate":"2025-10-08","text":"Referred to the House Committee on House Administration."},"laws":[],"number":"5707","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"B001281","district":3,"fullName":"Rep. Beatty, Joyce [D-OH-3]","party":"D","state":"OH"}],"summaries":[{"actionDate":"2025-10-08","actionDesc":"Introduced in House","text":"<p><strong>Voter Purge Protection Act </strong></p><p>This bill prohibits a state from removing registrants from the official list of eligible voters unless it meets certain verification and notice requirements.</p><p>Specifically, the bill prohibits a state from removing a registrant from the official list of eligible voters unless it verifies, on the basis of objective and reliable evidence, that the registrant is ineligible to vote in federal elections. Further, a state is prohibited from considering failure to vote in an election or failure to respond to a notice as evidence of ineligibility to vote.</p><p>Additionally, the bill requires a state to provide individual registrants who are removed with a notice, which must include the grounds for the removal and information on contesting the removal. Public notice must be provided after conducting any general program to remove the names of ineligible voters.</p>","updateDate":"2026-04-08T13:05:49Z","versionCode":"00"}],"title":"Voter Purge Protection Act","type":"hr","updateDate":"2026-06-19T08:06:11Z","updateDateIncludingText":"2026-06-19T08:06:11Z"}
