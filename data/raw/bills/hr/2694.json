{"actions":[{"actionCode":"H11100","actionDate":"2025-04-07","source":"House floor actions","text":"Referred to the House Committee on House Administration.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-04-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-04-07","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/2694","cosponsors":[{"bioguideId":"C000059","fullName":"Rep. Calvert, Ken [R-CA-41]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000401","fullName":"Rep. Kiley, Kevin [R-CA-3]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000480","fullName":"Rep. Fong, Vince [R-CA-20]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"V000129","fullName":"Rep. Valadao, David G. [R-CA-22]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"I000056","fullName":"Rep. Issa, Darrell [R-CA-48]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001177","fullName":"Rep. McClintock, Tom [R-CA-5]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000397","fullName":"Rep. Kim, Young [R-CA-40]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001103","fullName":"Rep. Carter, Earl L. \"Buddy\" [R-GA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"C001039","fullName":"Rep. Cammack, Kat [R-FL-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001101","fullName":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-08","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"F000478","fullName":"Rep. Fry, Russell [R-SC-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-22","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"G000607","fullName":"Rep. Gallagher, James [R-CA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T20:51:44+00:00","id":"hr2694-119","introducedDate":"2025-04-07","latestAction":{"actionDate":"2025-04-07","text":"Referred to the House Committee on House Administration."},"laws":[],"number":"2694","originChamber":"House","policyArea":"Government Operations and Politics","sponsors":[{"bioguideId":"O000019","district":23,"fullName":"Rep. Obernolte, Jay [R-CA-23]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-04-07","actionDesc":"Introduced in House","text":"<p><strong>Election Results Accountability Act</strong></p><p>This bill establishes deadlines for states to count ballots and certify results in federal elections.&nbsp;</p><p>Specifically, the bill requires a state to count not less than 90% of the ballots cast in a federal election held in the state not later than 72 hours after polls close and make the result of the count publicly available. Further, the state must certify and make publicly available the complete election results not later than two weeks after the election.&nbsp;</p><p>The bill provides exceptions to these deadlines, including for bona fide emergencies (e.g., major disasters) or technical difficulties (e.g., malfunctioning election equipment or software).</p><p>The bill prohibits a state from receiving federal election administration funds for subsequent elections if the state does not comply with the deadlines established by the bill. However, a state may regain eligibility for these funds if (1) the state submits a compliance plan to the Election Assistance Commission (EAC) and the Department of Justice (DOJ), and (2) the EAC and DOJ each certify that the state has taken actions to comply with the plan.</p>","updateDate":"2026-05-18T13:09:43Z","versionCode":"00"}],"title":"Election Results Accountability Act","type":"hr","updateDate":"2026-08-04T08:08:02Z","updateDateIncludingText":"2026-08-04T08:08:02Z"}
