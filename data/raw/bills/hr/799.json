{"bioguideId":"W000814","fullName":"Rep. Weber, Randy K. Sr. [R-TX-14]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-28","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-04","sponsorshipWithdrawnDate":null,"state":"NC"}],"fetchedAt":"2026-09-16T19:20:52+00:00","id":"hr799-119","introducedDate":"2025-01-28","latestAction":{"actionDate":"2025-01-28","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"799","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"M001211","district":15,"fullName":"Rep. Miller, Mary E. [R-IL-15]","party":"R","state":"IL"}],"summaries":[{"actionDate":"2025-01-28","actionDesc":"Introduced in House","text":"<p><strong><strong>Parental Notification and Intervention Act of 2025</strong></strong></p><p>This bill restricts the performance of an abortion on an unemancipated minor under 18 years of age.</p><p>Specifically, it prohibits a person or organization from performing, facilitating, or assisting with an abortion on an unemancipated minor without first complying with certain requirements, including parental notification and a 96-hour waiting period.</p><p>It establishes penalties—a fine, up to one year in prison, or both—for each willful violation.</p><p>A parent who is required to be notified of an abortion of an unemancipated minor may sue in federal court to prohibit the abortion.</p><p>Parental notification requirements may be waived in a medical emergency or in a case of physical abuse.</p>","updateDate":"2025-04-17T16:04:53Z","versionCode":"00"}],"title":"Parental Notification and Intervention Act of 2025","type":"hr","updateDate":"2025-04-17T16:05:48Z","updateDateIncludingText":"2025-04-17T16:05:48Z"}
