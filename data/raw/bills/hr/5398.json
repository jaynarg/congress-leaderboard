hdrawnDate":null,"state":"MS"},{"bioguideId":"B001321","fullName":"Rep. Barrett, Tom [R-MI-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-03","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"S001200","fullName":"Rep. Soto, Darren [D-FL-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001196","fullName":"Rep. Stefanik, Elise M. [R-NY-21]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-08","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001212","fullName":"Rep. Stauber, Pete [R-MN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-10","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M001216","fullName":"Rep. Mills, Cory [R-FL-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-16T22:45:33+00:00","id":"hr5398-119","introducedDate":"2025-09-16","latestAction":{"actionDate":"2025-09-16","text":"Referred to the House Committee on Appropriations."},"laws":[],"number":"5398","originChamber":"House","policyArea":"Economics and Public Finance","sponsors":[{"bioguideId":"H001058","district":4,"fullName":"Rep. Huizenga, Bill [R-MI-4]","party":"R","state":"MI"}],"summaries":[{"actionDate":"2025-09-16","actionDesc":"Introduced in House","text":"<p><strong>Pay Our Homeland Defenders Act of 2026</strong></p><p>This bill provides continuing appropriations for the salaries of certain Department of Homeland Security (DHS) employees during any period in which interim or full-year appropriations for FY2026 or FY2027 are not in effect (i.e., a government shutdown).</p><p>If there is a government shutdown in FY2026 or FY2027, the bill provides continuing appropriations to provide pay and allowances to&nbsp;</p><ul><li>DHS law enforcement personnel;</li><li>DHS employees or contractors who are necessary to carry out this bill, including employees or contractors involved in the administrative, payroll, distribution, accounting, and commercial accounts functions; and</li><li>members, civilian personnel, and contractors of the&nbsp;U.S. Coast Guard.</li></ul><p>The bill provides the appropriations until the earlier of (1) the enactment of specified appropriations legislation, or (2) January 1, 2027.</p>","updateDate":"2025-10-01T17:43:34Z","versionCode":"00"}],"title":"Pay Our Homeland Defenders Act of 2026","type":"hr","updateDate":"2025-10-25T08:05:45Z","updateDateIncludingText":"2025-10-25T08:05:45Z"}
