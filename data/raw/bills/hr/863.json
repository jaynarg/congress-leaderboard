{"actions":[{"actionCode":"H11100","actionDate":"2025-01-31","source":"House floor actions","text":"Referred to the House Committee on the Judiciary.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-31","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/863","cosponsors":[{"bioguideId":"J000288","fullName":"Rep. Johnson, Henry C. \"Hank\" [D-GA-4]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"H001096","fullName":"Rep. Hageman, Harriet M. [R-WY-At Large]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-31","sponsorshipWithdrawnDate":null,"state":"WY"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-02-05","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"G000599","fullName":"Rep. Goldman, Daniel S. [D-NY-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-03","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"N000026","fullName":"Rep. Nehls, Troy E. [R-TX-22]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-11","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"G000602","fullName":"Rep. Gillen, Laura [D-NY-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001241","fullName":"Rep. Min, Dave [D-CA-47]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-16T19:24:17+00:00","id":"hr863-119","introducedDate":"2025-01-31","latestAction":{"actionDate":"2025-01-31","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"863","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"K000401","district":3,"fullName":"Rep. Kiley, Kevin [R-CA-3]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-01-31","actionDesc":"Introduced in House","text":"<p><strong>National Human Trafficking Database Act</strong></p><p>This bill establishes a framework to collect comprehensive data on human trafficking.</p><p>At the federal level, the bill requires the Office for Victims of Crime (OVC) within the Department of Justice to establish an online database that includes human trafficking data for each state.</p><p>At the state level, the bill authorizes grants for covered state agencies (e.g., a state bureau of investigation or similar law enforcement agency) to collect and report human trafficking data to the OVC.</p>","updateDate":"2025-06-04T18:42:38Z","versionCode":"00"}],"title":"National Human Trafficking Database Act","type":"hr","updateDate":"2025-12-19T09:08:04Z","updateDateIncludingText":"2025-12-19T09:08:04Z"}
