:null,"state":"TX"},{"bioguideId":"F000459","fullName":"Rep. Fleischmann, Charles J. \"Chuck\" [R-TN-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-11","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"T000463","fullName":"Rep. Turner, Michael R. [R-OH-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"K000389","fullName":"Rep. Khanna, Ro [D-CA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-29","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001216","fullName":"Rep. Mills, Cory [R-FL-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-05-14","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001098","fullName":"Rep. Hamadeh, Abraham J. [R-AZ-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-30","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"R000395","fullName":"Rep. Rogers, Harold [R-KY-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-22","sponsorshipWithdrawnDate":null,"state":"KY"},{"bioguideId":"B000740","fullName":"Rep. Bice, Stephanie I. [R-OK-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-12","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"L000590","fullName":"Rep. Lee, Susie [D-NV-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-15","sponsorshipWithdrawnDate":null,"state":"NV"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-18","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"B000490","fullName":"Rep. Bishop, Sanford D. [D-GA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-19","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-16T19:16:45+00:00","id":"hr715-119","introducedDate":"2025-01-23","latestAction":{"actionDate":"2025-01-23","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"715","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"W000809","district":3,"fullName":"Rep. Womack, Steve [R-AR-3]","party":"R","state":"AR"}],"summaries":[{"actionDate":"2025-01-23","actionDesc":"Introduced in House","text":"<p><strong>BNA Fairness Ac</strong>t</p><p>This bill excludes from gross income (for federal income tax purposes) the basic needs allowance received by eligible members of the Armed Forces.</p><p>Under current law, members of the Armed Forces may be eligible to receive the basic needs allowance (additional monthly payment) if (1) they have completed initial training, (2) they have at least one dependent, and (3) their total household income does not exceed 200% of the federal poverty level (based on the location and number of individuals in the household). Further, under current law, certain qualified military benefits may be excluded from gross income. However, the basic needs allowance is not included within the definition of <em>qualified military benefits</em> and must be included in gross income for federal tax purposes.</p><p>Under the bill, the definition of <em>qualified military benefits</em> that may be excluded from gross income is expanded to include the basic needs allowance.</p>","updateDate":"2025-04-23T13:03:24Z","versionCode":"00"}],"title":"BNA Fairness Act","type":"hr","updateDate":"2026-07-18T00:00:29Z","updateDateIncludingText":"2026-07-18T00:00:29Z"}
