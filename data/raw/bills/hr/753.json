rshipWithdrawnDate":null,"state":"OR"},{"bioguideId":"K000391","fullName":"Rep. Krishnamoorthi, Raja [D-IL-8]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-20","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"H001068","fullName":"Rep. Huffman, Jared [D-CA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-20","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001059","fullName":"Rep. Costa, Jim [D-CA-21]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"H001090","fullName":"Rep. Harder, Josh [D-CA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-25","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"N000147","fullName":"Del. Norton, Eleanor Holmes [D-DC-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-26","sponsorshipWithdrawnDate":null,"state":"DC"},{"bioguideId":"N000191","fullName":"Rep. Neguse, Joe [D-CO-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-06-26","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"C001123","fullName":"Rep. Cisneros, Gilbert Ray [D-CA-31]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-29","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"C001055","fullName":"Rep. Case, Ed [D-HI-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-05","sponsorshipWithdrawnDate":null,"state":"HI"},{"bioguideId":"L000582","fullName":"Rep. Lieu, Ted [D-CA-36]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-26","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"L000557","fullName":"Rep. Larson, John B. [D-CT-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-24","sponsorshipWithdrawnDate":null,"state":"CT"}],"fetchedAt":"2026-09-16T19:18:41+00:00","id":"hr753-119","introducedDate":"2025-01-28","latestAction":{"actionDate":"2025-01-28","text":"Referred to the House Committee on Science, Space, and Technology."},"laws":[],"number":"753","originChamber":"House","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"C001080","district":28,"fullName":"Rep. Chu, Judy [D-CA-28]","party":"D","state":"CA"}],"summaries":[{"actionDate":"2025-01-28","actionDesc":"Introduced in House","text":"<p><strong>Fire Information and Reaction Enhancement Act of 2025 or the FIRE Act of 2025</strong></p><p>This bill establishes certain programs to improve wildfire forecasting and detection within the National Oceanic and Atmospheric Administration (NOAA).</p><p>Specifically, NOAA is directed to establish one or more weather research testbeds with industry and academic partners. (Testbeds are collaborative spaces where researchers and forecasters work together to integrate new observation systems into models, test and streamline data assimilation methods, and otherwise improve weather products and services for the benefit of the public.)</p><p>Further, NOAA is directed to establish an additional program to develop and extend accurate wildfire forecasts and warnings in order to reduce injury, loss of life, and property damage. Through this program, NOAA may develop, test, and deploy satellite detection, fuel moisture and danger assessments, and atmosphere and fire modeling, among other tools.&nbsp;</p>","updateDate":"2025-03-19T19:27:10Z","versionCode":"00"}],"title":"FIRE Act of 2025","type":"hr","updateDate":"2025-10-25T08:05:31Z","updateDateIncludingText":"2025-10-25T08:05:31Z"}
