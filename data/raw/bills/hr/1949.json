"sponsorshipDate":"2025-06-12","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"D000628","fullName":"Rep. Dunn, Neal P. [R-FL-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"B001321","fullName":"Rep. Barrett, Tom [R-MI-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-15","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"T000467","fullName":"Rep. Thompson, Glenn [R-PA-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-21","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"O000177","fullName":"Rep. Onder, Robert F. [R-MO-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-22","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"B001322","fullName":"Rep. Baumgartner, Michael [R-WA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-15","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"M001204","fullName":"Rep. Meuser, Daniel [R-PA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-15","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001298","fullName":"Rep. Bacon, Don [R-NE-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-08-26","sponsorshipWithdrawnDate":null,"state":"NE"},{"bioguideId":"L000597","fullName":"Rep. Lee, Laurel M. [R-FL-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-02","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"A000379","fullName":"Rep. Alford, Mark [R-MO-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-04","sponsorshipWithdrawnDate":null,"state":"MO"}],"fetchedAt":"2026-09-16T20:17:46+00:00","id":"hr1949-119","introducedDate":"2025-03-06","latestAction":{"actionDate":"2025-12-08","text":"Read the second time. Placed on Senate Legislative Calendar under General Orders. Calendar No. 286."},"laws":[],"number":"1949","originChamber":"House","policyArea":"Energy","sponsors":[{"bioguideId":"P000048","district":11,"fullName":"Rep. Pfluger, August [R-TX-11]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-03-06","actionDesc":"Introduced in House","text":"<p><strong>Unlocking our Domestic LNG Potential Act of 2025</strong></p><p>This bill repeals certain restrictions on the import and export of natural gas under the Natural Gas Act, including requirements for Department of Energy (DOE) approval and related provisions that address free trade agreements.</p><p>In addition, the bill grants the Federal Energy Regulatory Commission (FERC) the exclusive authority to approve or deny applications to authorize the siting, construction, expansion, or operation of facilities (e.g., liquefied natural gas terminals) to export natural gas to foreign countries or import natural gas from foreign countries. (Currently, DOE authorizes the export or import of natural gas, and FERC authorizes related facilities.)</p><p>In determining whether to approve or deny an application, FERC must deem the exportation or importation of natural gas to be consistent with the public interest.</p>","updateDate":"2025-11-17T13:08:29Z","versionCode":"00"}],"title":"Unlocking our Domestic LNG Potential Act of 2025","type":"hr","updateDate":"2026-07-17T23:59:48Z","updateDateIncludingText":"2026-07-17T23:59:48Z"}
