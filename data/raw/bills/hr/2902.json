shipDate":"2026-06-10","sponsorshipWithdrawnDate":null,"state":"OH"},{"bioguideId":"P000607","fullName":"Rep. Pocan, Mark [D-WI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"A000379","fullName":"Rep. Alford, Mark [R-MO-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"P000597","fullName":"Rep. Pingree, Chellie [D-ME-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"ME"},{"bioguideId":"T000467","fullName":"Rep. Thompson, Glenn [R-PA-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-06","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"S001221","fullName":"Rep. Scholten, Hillary J. [D-MI-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-06","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"J000298","fullName":"Rep. Jayapal, Pramila [D-WA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-07-27","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"K000375","fullName":"Rep. Keating, William R. [D-MA-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-03","sponsorshipWithdrawnDate":null,"state":"MA"},{"bioguideId":"K000397","fullName":"Rep. Kim, Young [R-CA-40]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"K000398","fullName":"Rep. Kean, Thomas H. [R-NJ-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-09-01","sponsorshipWithdrawnDate":null,"state":"NJ"}],"fetchedAt":"2026-09-20T14:21:03+00:00","id":"hr2902-119","introducedDate":"2025-04-10","latestAction":{"actionDate":"2025-04-10","text":"Referred to the Committee on Energy and Commerce, and in addition to the Committee on Ways and Means, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"laws":[],"number":"2902","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"V000129","district":22,"fullName":"Rep. Valadao, David G. [R-CA-22]","party":"R","state":"CA"}],"summaries":[{"actionDate":"2025-04-10","actionDesc":"Introduced in House","text":"<p><strong>Supplemental Oxygen Access Reform Act of 2025&nbsp;or the SOAR Act of 2025</strong></p><p>This bill establishes certain requirements with respect to the payment and provision of supplemental oxygen and related services under Medicare.</p><p>For example, the bill provides for separate payments, indexed to inflation, of oxygen and related equipment, supplies, and services under Medicare (rather than under the competitive acquisition program). It also specifically covers services that are provided by respiratory therapists under Medicare and provides for an additional payment adjustment for these services.</p><p>Additionally, the bill (1) requires the Centers for Medicare &amp; Medicaid Services to develop an electronic template for providers to use when prescribing oxygen and related equipment, supplies, and services; and (2) establishes certain rights for beneficiaries receiving these items and services, such as the right to choose their suppliers and to receive clear communications and be informed about the services provided.</p>","updateDate":"2025-05-21T20:36:22Z","versionCode":"00"}],"title":"SOAR Act of 2025","type":"hr","updateDate":"2026-09-19T23:41:20Z","updateDateIncludingText":"2026-09-19T23:41:20Z"}
