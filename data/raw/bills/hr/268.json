{"actions":[{"actionCode":"H11100","actionDate":"2025-01-09","source":"House floor actions","text":"Referred to the House Committee on Foreign Affairs.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-01-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-01-09","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/268","cosponsors":[{"bioguideId":"W000797","fullName":"Rep. Wasserman Schultz, Debbie [D-FL-25]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S000522","fullName":"Rep. Smith, Christopher H. [R-NJ-4]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"G000593","fullName":"Rep. Gimenez, Carlos A. [R-FL-28]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S000168","fullName":"Rep. Salazar, Maria Elvira [R-FL-27]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"S001200","fullName":"Rep. Soto, Darren [D-FL-9]","isOriginalCosponsor":true,"party":"D","sponsorshipDate":"2025-01-09","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-15","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"S001212","fullName":"Rep. Stauber, Pete [R-MN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-28","sponsorshipWithdrawnDate":null,"state":"MN"}],"fetchedAt":"2026-09-16T18:50:07+00:00","id":"hr268-119","introducedDate":"2025-01-09","latestAction":{"actionDate":"2025-01-09","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"268","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"D000600","district":26,"fullName":"Rep. Diaz-Balart, Mario [R-FL-26]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-01-09","actionDesc":"Introduced in House","text":"<p><strong>Securing Timely Opportunities for Payment and Maximizing Awards for Detaining Unlawful Regime Officials Act of 2025 or the STOP MADURO Act</strong></p><p>This bill authorizes the Department of State to pay a reward of up to $100 million for certain information directly leading to the arrest and conviction of Nicolas&nbsp;Maduro Moros.&nbsp;</p><p>For example,&nbsp;under the bill, the State Department may pay such a reward to one or more individuals who furnish information directly leading to Maduro's arrest and conviction in any country for specified narcotics-related offenses.&nbsp;</p><p>The bill also requires that any such payment come solely from the liquidation of assets that the U.S. President or the Department of the Treasury's Office of Foreign Assets Control has withheld pursuant to specified laws and executive orders from Maduro, officials of the Maduro regime, and their co-conspirators.</p>","updateDate":"2025-04-23T20:51:43Z","versionCode":"00"}],"title":"STOP MADURO Act","type":"hr","updateDate":"2026-07-18T00:05:42Z","updateDateIncludingText":"2026-07-18T00:05:42Z"}
