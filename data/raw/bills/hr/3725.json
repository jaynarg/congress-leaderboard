sponsorshipWithdrawnDate":null,"state":"MT"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-09","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"H001099","fullName":"Rep. Haridopolos, Mike [R-FL-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"K000403","fullName":"Rep. Kennedy, Mike [R-UT-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-10","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"G000603","fullName":"Rep. Gill, Brandon [R-TX-26]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"S001228","fullName":"Rep. Schmidt, Derek [R-KS-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-24","sponsorshipWithdrawnDate":null,"state":"KS"},{"bioguideId":"F000478","fullName":"Rep. Fry, Russell [R-SC-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-07-22","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"B001317","fullName":"Rep. Brecheen, Josh [R-OK-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-11-19","sponsorshipWithdrawnDate":null,"state":"OK"},{"bioguideId":"M001212","fullName":"Rep. Moore, Barry [R-AL-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-21","sponsorshipWithdrawnDate":null,"state":"AL"}],"fetchedAt":"2026-09-16T21:35:49+00:00","id":"hr3725-119","introducedDate":"2025-06-04","latestAction":{"actionDate":"2025-06-04","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"3725","originChamber":"House","policyArea":"Immigration","sponsors":[{"bioguideId":"M001240","district":6,"fullName":"Rep. McDowell, Addison P. [R-NC-6]","party":"R","state":"NC"}],"summaries":[{"actionDate":"2025-06-04","actionDesc":"Introduced in House","text":"<p><strong>Preventing the Abuse of Immigration Parole Act</strong></p><p>This bill places limits on the authority of the Department of Homeland Security (DHS) to parole individuals into the United States.</p><p>Currently,&nbsp;DHS is allowed to parole non-U.S. nationals (<em>aliens</em> under federal law) temporarily into the United States on public benefit or urgent humanitarian grounds.</p><p>Under the bill, the total number of parolees allowed annually is capped at 3,000. Additionally, parole may not be granted to nationals of China, Russia, Iran, North Korea, Cuba, or Syria without a waiver from the Department of State. The bill also eliminates&nbsp;DHS’s authority to parole refugees into the United States on separate public interest grounds.&nbsp;</p>","updateDate":"2026-06-01T21:13:29Z","versionCode":"00"}],"title":"Preventing the Abuse of Immigration Parole Act","type":"hr","updateDate":"2026-07-18T00:00:22Z","updateDateIncludingText":"2026-07-18T00:00:22Z"}
