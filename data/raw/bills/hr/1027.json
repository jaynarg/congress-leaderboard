:false,"party":"D","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"M001234","fullName":"Rep. Morrison, Kelly [D-MN-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-07-14","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"G000583","fullName":"Rep. Gottheimer, Josh [D-NJ-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-08","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"D000530","fullName":"Rep. Deluzio, Christopher R. [D-PA-17]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-08-29","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"E000299","fullName":"Rep. Escobar, Veronica [D-TX-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-07","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"G000606","fullName":"Rep. Grijalva, Adelita S. [D-AZ-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-20","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"A000381","fullName":"Rep. Ansari, Yassamin [D-AZ-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-11-25","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"S001230","fullName":"Rep. Subramanyam, Suhas [D-VA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-12-16","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"B001327","fullName":"Rep. Bresnahan, Robert P. [R-PA-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-12-18","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"L000606","fullName":"Rep. Latimer, George [D-NY-16]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-13","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T19:32:35+00:00","id":"hr1027-119","introducedDate":"2025-02-05","latestAction":{"actionDate":"2025-02-06","text":"Sponsor introductory remarks on measure. (CR H519)"},"laws":[],"number":"1027","originChamber":"House","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"S001225","district":17,"fullName":"Rep. Sorensen, Eric [D-IL-17]","party":"D","state":"IL"}],"summaries":[{"actionDate":"2025-02-05","actionDesc":"Introduced in House","text":"<p><strong>Quashing Unwanted and Interruptive Electronic Telecommunications Act or the QUIET Act</strong></p><p>This bill establishes a disclosure requirement for robocalls that use artificial intelligence (AI) to emulate a human being and increases forfeiture and fine amounts for certain violations of the Telephone Consumer Protection Act (TCPA). (The TCPA prohibits certain telemarketing calls made without the recipient’s consent and using specified automated technologies.)</p><p>Specifically, any robocall that uses AI to emulate a human being must include a disclosure at the beginning of the message indicating that AI is being used. Under the bill, <em>robocalls</em> are defined as calls made or text messages sent (1) using automatic dialing technology, or (2) using an artificially generated message or an artificial or prerecorded voice. Calls or texts that are made or sent using equipment that requires substantial human intervention are excluded.&nbsp;</p><p>Further, the bill doubles the maximum forfeiture penalty and criminal fine that may be imposed for certain violations of the TCPA involving the use of AI to impersonate an individual or entity with the intent to defraud, cause harm, or wrongfully obtain anything of value. This provision applies to violations that occur after the bill’s enactment.&nbsp;</p>","updateDate":"2025-04-11T15:04:13Z","versionCode":"00"}],"title":"QUIET Act","type":"hr","updateDate":"2026-07-17T23:52:13Z","updateDateIncludingText":"2026-07-17T23:52:13Z"}
