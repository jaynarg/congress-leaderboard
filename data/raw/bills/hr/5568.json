nDate":null,"state":"MO"},{"bioguideId":"C001080","fullName":"Rep. Chu, Judy [D-CA-28]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-14","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001221","fullName":"Rep. Scholten, Hillary J. [D-MI-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-14","sponsorshipWithdrawnDate":null,"state":"MI"}],"fetchedAt":"2026-09-16T22:52:14+00:00","id":"hr5568-119","introducedDate":"2025-09-26","latestAction":{"actionDate":"2025-09-26","text":"Referred to the House Committee on Appropriations."},"laws":[],"number":"5568","originChamber":"House","policyArea":"Commerce","sponsors":[{"bioguideId":"C001136","district":3,"fullName":"Rep. Conaway, Herbert C. [D-NJ-3]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2025-09-26","actionDesc":"Introduced in House","text":"<p><strong>Funding Small Businesses During Shutdown Act</strong></p><p>This bill provides FY2026 appropriations to continue servicing loans made under certain Small Business Administration (SBA) loan programs if there is a lapse in discretionary appropriations (i.e., government shutdown) in FY2026.</p><p>If there is a lapse in FY2026 appropriations for the SBA, the bill provides specified appropriations to pay for the salaries and expenses necessary to continue servicing any loans made under several loan programs authorized by the Small Business Act and the Small Business Investment Act of 1958.</p><p>The bill provides the appropriations for any 30-day period in which there is a lapse in SBA appropriations and on a pro-rated basis if the lapse is less than 30 days.</p>","updateDate":"2025-10-09T15:31:48Z","versionCode":"00"}],"title":"Funding Small Businesses During Shutdown Act","type":"hr","updateDate":"2025-10-15T08:05:32Z","updateDateIncludingText":"2025-10-15T08:05:32Z"}
