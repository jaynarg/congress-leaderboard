ionDate":"2026-04-23","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2026-04-23","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/8476","cosponsors":[{"bioguideId":"T000478","fullName":"Rep. Tenney, Claudia [R-NY-24]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2026-04-23","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"B001322","fullName":"Rep. Baumgartner, Michael [R-WA-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-05-11","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"S000522","fullName":"Rep. Smith, Christopher H. [R-NJ-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-09","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000795","fullName":"Rep. Wilson, Joe [R-SC-2]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-09","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"G000593","fullName":"Rep. Gimenez, Carlos A. [R-FL-28]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-10","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"A000372","fullName":"Rep. Allen, Rick W. [R-GA-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-10","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"M001233","fullName":"Rep. Messmer, Mark B. [R-IN-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-11","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"M001211","fullName":"Rep. Miller, Mary E. [R-IL-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-22","sponsorshipWithdrawnDate":null,"state":"IL"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-22","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"M001216","fullName":"Rep. Mills, Cory [R-FL-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"O000086","fullName":"Rep. Owens, Burgess [R-UT-4]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"UT"},{"bioguideId":"T000467","fullName":"Rep. Thompson, Glenn [R-PA-15]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"H001102","fullName":"Rep. Harris, Mark [R-NC-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"F000450","fullName":"Rep. Foxx, Virginia [R-NC-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"M001219","fullName":"Del. Moylan, James C. [R-GU-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-30","sponsorshipWithdrawnDate":null,"state":"GU"},{"bioguideId":"B001257","fullName":"Rep. Bilirakis, Gus M. [R-FL-12]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-22","sponsorshipWithdrawnDate":null,"state":"FL"}],"fetchedAt":"2026-09-17T03:48:41+00:00","id":"hr8476-119","introducedDate":"2026-04-23","latestAction":{"actionDate":"2026-08-20","text":"Placed on the Union Calendar, Calendar No. 660."},"laws":[],"number":"8476","originChamber":"House","policyArea":"Education","sponsors":[{"bioguideId":"F000484","district":6,"fullName":"Rep. Fine, Randy [R-FL-6]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2026-08-20","actionDesc":"Reported to House","text":"<p><strong>No Antisemitism in Education Act of 2026</strong></p><p>This bill requires local educational agencies (LEAs) and institutions of higher education (IHEs), as a condition of receiving federal funds, to&nbsp;treat discrimination that is motivated by antisemitism as vigorously as the LEA or IHE treats all other forms of discrimination prohibited by Title VI of the Civil Rights Act of 1964. (Title VI of the Civil Rights Act of 1964 prohibits discrimination based on race, color, or national origin in federally funded programs or activities.)</p><p>The bill requires federal agencies, LEAs, and IHEs to consider the definition of <em>antisemitism</em> contained in a December 11, 2019, <a href=\"https://www.federalregister.gov/documents/2019/12/16/2019-27217/combating-anti-semitism\">executive order</a> when reviewing or investigating whether a&nbsp;discriminatory act&nbsp;or omission was motivated by discriminatory antisemitic intent. The executive order incorporates the International Holocaust Remembrance Alliance's (IHRA's) working definition of <em>antisemitism</em>. According to the&nbsp;IHRA's working definition, <em>antisemitism</em> is a certain perception of Jews, which may be expressed as hatred toward Jews.</p>","updateDate":"2026-09-14T15:22:52Z","versionCode":"07"}],"title":"No Antisemitism in Education Act of 2026","type":"hr","updateDate":"2026-09-14T15:28:32Z","updateDateIncludingText":"2026-09-14T15:28:32Z"}
