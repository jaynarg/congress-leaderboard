ponsor":false,"party":"D","sponsorshipDate":"2025-08-08","sponsorshipWithdrawnDate":null,"state":"NH"},{"bioguideId":"P000048","fullName":"Rep. Pfluger, August [R-TX-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-11","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M000317","fullName":"Rep. Malliotakis, Nicole [R-NY-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-30","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-06","sponsorshipWithdrawnDate":null,"state":"VA"}],"fetchedAt":"2026-09-16T19:11:57+00:00","id":"hr620-119","introducedDate":"2025-01-22","latestAction":{"actionDate":"2025-02-28","text":"Referred to the Subcommittee on Nutrition and Foreign Agriculture."},"laws":[],"number":"620","originChamber":"House","policyArea":"Foreign Trade and International Finance","sponsors":[{"bioguideId":"J000304","district":13,"fullName":"Rep. Jackson, Ronny [R-TX-13]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-01-22","actionDesc":"Introduced in House","text":"<p><strong>Foreign Adversary Risk Management Act or the FARM Act</strong></p><p>This bill places the Secretary of Agriculture on the Committee on Foreign Investment in the United States (CFIUS). It also requires CFIUS to review any investment that could result in foreign control of any U.S. agricultural business.</p><p>Further, the bill includes agricultural systems and supply chains in the definitions of <em>critical infrastructure</em> and <em>critical technologies</em> for the purposes of reviewing such investments.</p><p>The Department of Agriculture and the Government Accountability Office must each annually analyze and report on foreign influence in the U.S. agricultural industry.</p>","updateDate":"2025-03-18T13:03:21Z","versionCode":"00"}],"title":"FARM Act","type":"hr","updateDate":"2026-04-09T15:17:13Z","updateDateIncludingText":"2026-07-30T16:27:18Z"}
