te":null,"state":"DC"},{"bioguideId":"H001068","fullName":"Rep. Huffman, Jared [D-CA-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S001200","fullName":"Rep. Soto, Darren [D-FL-9]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-20","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"W000831","fullName":"Rep. Walkinshaw, James R. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-05-26","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"K000397","fullName":"Rep. Kim, Young [R-CA-40]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-02","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001324","fullName":"Rep. Bell, Wesley [D-MO-1]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-18","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"P000607","fullName":"Rep. Pocan, Mark [D-WI-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-18","sponsorshipWithdrawnDate":null,"state":"WI"},{"bioguideId":"C001123","fullName":"Rep. Cisneros, Gilbert Ray [D-CA-31]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-18","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"B001318","fullName":"Rep. Balint, Becca [D-VT-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-06-24","sponsorshipWithdrawnDate":null,"state":"VT"},{"bioguideId":"B001323","fullName":"Rep. Begich, Nicholas J. [R-AK-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"AK"},{"bioguideId":"W000830","fullName":"Rep. Whitesides, George [D-CA-27]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-08-27","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001230","fullName":"Rep. Mackenzie, Ryan [R-PA-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-08-27","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-20T14:20:53+00:00","id":"hr2878-119","introducedDate":"2025-04-10","latestAction":{"actionDate":"2026-01-21","text":"Subcommittee Hearings Held"},"laws":[],"number":"2878","originChamber":"House","policyArea":"Armed Forces and National Security","sponsors":[{"bioguideId":"N000193","district":3,"fullName":"Rep. Nunn, Zachary [R-IA-3]","party":"R","state":"IA"}],"summaries":[{"actionDate":"2025-04-10","actionDesc":"Introduced in House","text":"<p><strong>Daniel J. Harvey, Jr. and Adam Lambert Improving Servicemember Transition to Reduce Veteran Suicide Act</strong></p><p>This bill requires the Department of Veterans Affairs (VA) and Department of Defense (DOD) to provide additional information and assistance related to mental health care to veterans in the Solid Start program and members of the Armed Forces in the Transition Assistance Program.</p><p>Specifically, the bill requires that counseling provided under DOD’s Transition Assistance Program include additional mental health information, including information about the risk of suicide and other potential&nbsp;stressors associated with separation from the Armed Forces.</p><p>The bill also expands the activities that must be carried out by the VA under the Solid Start program, which is an outreach program for veterans in their first year of separation from service. Specifically, under the program, the VA must (1) assist eligible veterans who elect to enroll in the VA health care system, and (2) educate veterans about mental health and counseling services available through the Veterans Health Administration.</p>","updateDate":"2025-07-02T19:49:06Z","versionCode":"00"}],"title":"Daniel J. Harvey, Jr. and Adam Lambert Improving Servicemember Transition to Reduce Veteran Suicide Act","type":"hr","updateDate":"2026-09-19T23:35:39Z","updateDateIncludingText":"2026-09-19T23:35:39Z"}
