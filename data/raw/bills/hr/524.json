"FL"},{"bioguideId":"G000593","fullName":"Rep. Gimenez, Carlos A. [R-FL-28]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"E000071","fullName":"Rep. Ellzey, Jake [R-TX-6]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"P000609","fullName":"Rep. Palmer, Gary J. [R-AL-6]","isOriginalCosponsor":true,"party":"R","sponsorshipDate":"2025-01-16","sponsorshipWithdrawnDate":null,"state":"AL"},{"bioguideId":"M001136","fullName":"Rep. McClain, Lisa C. [R-MI-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"MI"},{"bioguideId":"G000600","fullName":"Rep. Perez, Marie Gluesenkamp [D-WA-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-01-21","sponsorshipWithdrawnDate":null,"state":"WA"},{"bioguideId":"L000599","fullName":"Rep. Lawler, Michael [R-NY-17]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-10","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001196","fullName":"Rep. Stefanik, Elise M. [R-NY-21]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"S001201","fullName":"Rep. Suozzi, Thomas R. [D-NY-3]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-05-15","sponsorshipWithdrawnDate":null,"state":"NY"}],"fetchedAt":"2026-09-16T19:07:15+00:00","id":"hr524-119","introducedDate":"2025-01-16","latestAction":{"actionDate":"2025-01-16","text":"Referred to the House Committee on Ways and Means."},"laws":[],"number":"524","originChamber":"House","policyArea":"Taxation","sponsors":[{"bioguideId":"M001194","district":2,"fullName":"Rep. Moolenaar, John R. [R-MI-2]","party":"R","state":"MI"}],"summaries":[{"actionDate":"2025-01-16","actionDesc":"Introduced in House","text":"<p><strong>No Official Giveaways Of Taxpayers’ Income to Oppressive Nations Act or the NO GOTION Act</strong></p><p>This bill prohibits an entity that is created in, organized in, or controlled (in the aggregate) by China, Russia, Iran, or North Korea, or an entity controlled (in the aggregate) by one or more of such entities, from claiming multiple energy-related federal tax credits and incentives.</p><p>Specifically, the bill prohibits such entities from claiming the federal tax credits for</p><ul><li>alternative fuel vehicle refueling property,</li><li>second-generation&nbsp;biofuel,</li><li>biodiesel fuel,</li><li>sustainable aviation fuel,</li><li>renewable electricity production,</li><li>carbon sequestration,</li><li>zero-emission nuclear power production,</li><li>clean hydrogen production,</li><li>clean commercial vehicles,</li><li>advanced manufacturing production,</li><li>clean electricity production,</li><li>clean fuel production,</li><li>investments in energy property,</li><li>advanced energy projects,</li><li>clean electricity investment,</li><li>biodiesel mixtures,</li><li>alternative fuel, and</li><li>alternative fuel mixtures.</li></ul><p>Further, such entities are prohibited from claiming the federal tax deduction for energy efficient improvements to commercial buildings.</p><p>Finally, such entities are not entitled to a credit or refund of federal excise taxes paid&nbsp;on biodiesel, alternative fuel, or sustainable aviation fuel mixtures produced by the entities.</p>","updateDate":"2026-05-11T13:13:30Z","versionCode":"00"}],"title":"NO GOTION Act","type":"hr","updateDate":"2026-05-11T13:15:13Z","updateDateIncludingText":"2026-05-11T13:15:13Z"}
