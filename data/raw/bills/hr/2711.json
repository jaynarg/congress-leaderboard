-08","latestAction":{"actionDate":"2025-04-08","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"2711","originChamber":"House","policyArea":"Crime and Law Enforcement","sponsors":[{"bioguideId":"G000583","district":5,"fullName":"Rep. Gottheimer, Josh [D-NJ-5]","party":"D","state":"NJ"}],"summaries":[{"actionDate":"2025-04-08","actionDesc":"Introduced in House","text":"<p><strong>Invest to Protect Act of 2025</strong></p><p>This bill directs the Office of Community Oriented Policing Services within the Department of Justice to award grants to local and tribal governments that employ fewer than 175 law enforcement officers. Grant funds may be used for various activities, including to provide de-escalation training and improve recruitment and retention.</p>","updateDate":"2026-09-25T16:32:08Z","versionCode":"00"}],"title":"Invest to Protect Act of 2025","type":"hr","updateDate":"2026-09-25T16:32:50Z","updateDateIncludingText":"2026-09-25T16:32:50Z"}
