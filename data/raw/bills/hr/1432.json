:"OH"},{"bioguideId":"N000190","fullName":"Rep. Norman, Ralph [R-SC-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-24","sponsorshipWithdrawnDate":null,"state":"SC"},{"bioguideId":"H001052","fullName":"Rep. Harris, Andy [R-MD-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-02-27","sponsorshipWithdrawnDate":null,"state":"MD"},{"bioguideId":"F000469","fullName":"Rep. Fulcher, Russ [R-ID-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"ID"}],"fetchedAt":"2026-10-07T17:06:53+00:00","id":"hr1432-119","introducedDate":"2025-02-18","latestAction":{"actionDate":"2025-02-18","text":"Referred to the House Committee on the Judiciary."},"laws":[],"number":"1432","originChamber":"House","policyArea":"Health","sponsors":[{"bioguideId":"R000614","district":21,"fullName":"Rep. Roy, Chip [R-TX-21]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-02-18","actionDesc":"Introduced in House","text":"<p><strong>Let Injured Americans Be Legally Empowered Act or the LIABLE Act</strong></p><p>This bill prohibits COVID-19 vaccine manufacturers from being immune under federal law from lawsuits relating to their vaccines.</p><p>Specifically, the bill prohibits any federal law from providing immunity for COVID-19 vaccine manufacturers from civil suits or liability, or limiting liability, with respect to the administration or use of their vaccines. Additionally, individuals may not be precluded from bringing a civil suit against a COVID-19 vaccine manufacturer because the individual sought or received compensation through specified federal vaccine injury compensation programs, nor does the bill preclude individuals from seeking compensation through these programs.</p><p>The bill applies to vaccine administrations that occur before, on, or after the bill's date of enactment.</p>","updateDate":"2026-10-06T21:22:44Z","versionCode":"00"}],"title":"LIABLE Act","type":"hr","updateDate":"2026-10-06T21:23:53Z","updateDateIncludingText":"2026-10-06T21:23:53Z"}
