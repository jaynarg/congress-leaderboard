e":"Rep. Onder, Robert F. [R-MO-3]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-23","sponsorshipWithdrawnDate":null,"state":"MO"},{"bioguideId":"P000048","fullName":"Rep. Pfluger, August [R-TX-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"E000300","fullName":"Rep. Evans, Gabe [R-CO-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"CO"},{"bioguideId":"F000485","fullName":"Rep. Fuller, Clay [R-GA-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"O000019","fullName":"Rep. Obernolte, Jay [R-CA-23]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-02","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"S000929","fullName":"Rep. Spartz, Victoria [R-IN-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-09","sponsorshipWithdrawnDate":null,"state":"IN"},{"bioguideId":"F000469","fullName":"Rep. Fulcher, Russ [R-ID-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-09","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"M001236","fullName":"Rep. Moore, Tim [R-NC-14]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-13","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"K000398","fullName":"Rep. Kean, Thomas H. [R-NJ-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-15","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"W000816","fullName":"Rep. Williams, Roger [R-TX-25]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-20","sponsorshipWithdrawnDate":null,"state":"TX"}],"fetchedAt":"2026-11-12T17:50:02+00:00","id":"hr5549-119","introducedDate":"2025-09-23","latestAction":{"actionDate":"2026-11-11","actionTime":"17:15:56","text":"Motion to reconsider laid on the table Agreed to without objection."},"laws":[],"number":"5549","originChamber":"House","policyArea":"Energy","sponsors":[{"bioguideId":"G000568","district":9,"fullName":"Rep. Griffith, H. Morgan [R-VA-9]","party":"R","state":"VA"}],"summaries":[{"actionDate":"2025-09-23","actionDesc":"Introduced in House","text":"<p><strong>Efficient Nuclear Licensing Hearings Act</strong></p><p>This bill expedites the process of reviewing certain uncontested permits and licenses&nbsp;for nuclear power plants (e.g., construction permits and operating licenses) by removing a requirement for the Nuclear Regulatory Commission (NRC) to hold a public hearing at the end of the process. The bill applies to the licenses and permits if a hearing has not been requested by a person whose interest may be affected. The bill also&nbsp;directs the NRC to use informal adjudicatory procedures if such a hearing is&nbsp;held.</p><p>Additionally,&nbsp;the bill directs the NRC to hold an adjudicatory hearing regarding the licensing of the construction and operation of a uranium enrichment facility only if the person whose interest may be affected by such construction and operation has requested the hearing.</p>","updateDate":"2026-11-04T16:01:03Z","versionCode":"00"}],"title":"Efficient Nuclear Licensing Hearings Act","type":"hr","updateDate":"2026-11-12T16:20:01Z","updateDateIncludingText":"2026-11-12T16:20:01Z"}
