oguideId":"W000816","fullName":"Rep. Williams, Roger [R-TX-25]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"M000317","fullName":"Rep. Malliotakis, Nicole [R-NY-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"E000246","fullName":"Rep. Edwards, Chuck [R-NC-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"C001112","fullName":"Rep. Carbajal, Salud O. [D-CA-24]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000466","fullName":"Rep. Fitzpatrick, Brian K. [R-PA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-24","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"B001327","fullName":"Rep. Bresnahan, Robert [R-PA-8]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"PA"},{"bioguideId":"H001101","fullName":"Rep. Harrigan, Pat [R-NC-10]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"L000598","fullName":"Rep. LaLota, Nick [R-NY-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"F000469","fullName":"Rep. Fulcher, Russ [R-ID-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-03-31","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"M001238","fullName":"Rep. McBride, Sarah [D-DE-At Large]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-01","sponsorshipWithdrawnDate":null,"state":"DE"},{"bioguideId":"G000589","fullName":"Rep. Gooden, Lance [R-TX-5]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-01","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001063","fullName":"Rep. Cuellar, Henry [D-TX-28]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"TX"},{"bioguideId":"C001119","fullName":"Rep. Craig, Angie [D-MN-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"MN"},{"bioguideId":"O000019","fullName":"Rep. Obernolte, Jay [R-CA-23]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"F000482","fullName":"Rep. Fedorchak, Julie [R-ND-At Large]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-08","sponsorshipWithdrawnDate":null,"state":"ND"},{"bioguideId":"M001230","fullName":"Rep. Mackenzie, Ryan [R-PA-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-04-09","sponsorshipWithdrawnDate":null,"state":"PA"}],"fetchedAt":"2026-09-16T19:12:37+00:00","id":"hr633-119","introducedDate":"2025-01-22","latestAction":{"actionDate":"2025-04-28","text":"Placed on the Union Calendar, Calendar No. 59."},"laws":[],"number":"633","originChamber":"House","policyArea":"Science, Technology, Communications","sponsors":[{"bioguideId":"S000168","district":27,"fullName":"Rep. Salazar, Maria Elvira [R-FL-27]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-01-22","actionDesc":"Introduced in House","text":"<p><strong>Tools to Address Known Exploitation by Immobilizing Technological Deepfakes On Websites and Networks Act or the TAKE IT DOWN Act</strong></p><p>This bill generally prohibits the nonconsensual online publication of intimate visual depictions of individuals, both authentic and computer-generated, and requires&nbsp;certain&nbsp;online platforms to promptly remove such depictions upon&nbsp;receiving&nbsp;notice of their existence.&nbsp;</p><p>Specifically, the bill prohibits the online publication of intimate visual depictions of</p><ul><li>an adult subject where publication is intended to cause or does cause harm to the subject, and where the depiction was published without the subject’s consent or, in the case of an authentic depiction, was created or obtained under circumstances where the adult had a reasonable expectation of privacy; or</li><li>a minor subject where publication is intended to abuse or harass the minor or to arouse or gratify the sexual desire of any person.&nbsp;</li></ul><p>Violators are subject to mandatory restitution and&nbsp;criminal penalties, including prison, a fine, or both. Threats to publish intimate visual depictions of a subject are similarly prohibited under the bill and subject to criminal penalties. &nbsp;</p><p>Separately, covered platforms must establish a process through which subjects of intimate visual depictions may notify the platform of the existence of, and request removal of, an intimate visual depiction including the subject that was published without the subject’s consent. Covered platforms must remove such depictions within 48 hours of notification. Under the bill,&nbsp;<em>covered platforms</em> are defined as public websites, online services, or applications that primarily provide a forum for user-generated content.</p>","updateDate":"2025-04-28T10:33:55Z","versionCode":"00"}],"title":"TAKE IT DOWN Act","type":"hr","updateDate":"2026-07-27T16:11:10Z","updateDateIncludingText":"2026-07-27T16:11:10Z"}
