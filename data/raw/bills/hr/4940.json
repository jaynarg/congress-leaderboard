{"actions":[{"actionCode":"H11000","actionDate":"2025-08-11","source":"House committee actions","text":"Referred to the Subcommittee on Transportation and Maritime Security.","type":"Committee"},{"actionCode":"H11100","actionDate":"2025-08-08","source":"House floor actions","text":"Referred to the House Committee on Homeland Security.","type":"IntroReferral"},{"actionCode":"Intro-H","actionDate":"2025-08-08","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"},{"actionCode":"1000","actionDate":"2025-08-08","source":"Library of Congress","text":"Introduced in House","type":"IntroReferral"}],"congress":119,"congressGovUrl":"https://www.congress.gov/bill/119th-congress/house-bill/4940","cosponsors":[{"bioguideId":"V000138","fullName":"Rep. Vindman, Eugene Simon [D-VA-7]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-09-10","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"M001229","fullName":"Rep. McIver, LaMonica [D-NJ-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2025-10-21","sponsorshipWithdrawnDate":null,"state":"NJ"},{"bioguideId":"T000491","fullName":"Rep. Tran, Derek [D-CA-45]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-01-07","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"M001216","fullName":"Rep. Mills, Cory [R-FL-7]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-15","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"G000593","fullName":"Rep. Gimenez, Carlos A. [R-FL-28]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"FL"},{"bioguideId":"F000469","fullName":"Rep. Fulcher, Russ [R-ID-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-06-29","sponsorshipWithdrawnDate":null,"state":"ID"},{"bioguideId":"F000480","fullName":"Rep. Fong, Vince [R-CA-20]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2026-07-06","sponsorshipWithdrawnDate":null,"state":"CA"}],"fetchedAt":"2026-09-20T14:37:27+00:00","id":"hr4940-119","introducedDate":"2025-08-08","latestAction":{"actionDate":"2025-08-11","text":"Referred to the Subcommittee on Transportation and Maritime Security."},"laws":[],"number":"4940","originChamber":"House","policyArea":"Transportation and Public Works","sponsors":[{"bioguideId":"S001214","district":17,"fullName":"Rep. Steube, W. Gregory [R-FL-17]","party":"R","state":"FL"}],"summaries":[{"actionDate":"2025-08-08","actionDesc":"Introduced in House","text":"<p><strong>Accommodating Individuals Requesting Familial Assistance in Riding Efficiently Act or the AIRFARE Act</strong></p><p>This bill directs the Transportation Security Administration (TSA) to allow caregivers, parents, and guardians to accompany minors and passengers needing assistance to their flights.</p><p>Specifically, the TSA must establish a system to expedite gate passes and flight access procedures for these individuals.</p><p>The system must ensure that</p><ul><li>air carriers may offer up to two gate passes to caregivers, parents, and guardians who are accompanying a minor or a passenger needing assistance to a departing flight; and</li><li>these individuals may apply their existing&nbsp;TSA PreCheck privileges to such gate passes.</li></ul><p>The&nbsp;TSA&nbsp;PreCheck&nbsp;program expedites traveler screening through participating&nbsp;TSA security checkpoints.</p>","updateDate":"2026-04-07T15:24:14Z","versionCode":"00"}],"title":"AIRFARE Act","type":"hr","updateDate":"2026-09-19T23:39:35Z","updateDateIncludingText":"2026-09-19T23:39:35Z"}
