ginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"TN"},{"bioguideId":"S001211","fullName":"Rep. Stanton, Greg [D-AZ-4]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-03-04","sponsorshipWithdrawnDate":null,"state":"AZ"},{"bioguideId":"H001081","fullName":"Rep. Hayes, Jahana [D-CT-5]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-09","sponsorshipWithdrawnDate":null,"state":"CT"},{"bioguideId":"E000297","fullName":"Rep. Espaillat, Adriano [D-NY-13]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"NY"},{"bioguideId":"W000831","fullName":"Rep. Walkinshaw, James R. [D-VA-11]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"S001230","fullName":"Rep. Subramanyam, Suhas [D-VA-10]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-14","sponsorshipWithdrawnDate":null,"state":"VA"},{"bioguideId":"G000604","fullName":"Rep. Goodlander, Maggie [D-NH-2]","isOriginalCosponsor":false,"party":"D","sponsorshipDate":"2026-04-15","sponsorshipWithdrawnDate":null,"state":"NH"}],"fetchedAt":"2026-09-23T14:47:00+00:00","id":"hconres40-119","introducedDate":"2025-06-23","latestAction":{"actionDate":"2026-04-16","actionTime":"12:06:50","text":"Motion to reconsider laid on the table Agreed to without objection."},"laws":[],"number":"40","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"M001137","district":5,"fullName":"Rep. Meeks, Gregory W. [D-NY-5]","party":"D","state":"NY"}],"summaries":[{"actionDate":"2025-06-23","actionDesc":"Introduced in House","text":"<p>This concurrent resolution directs the President to remove U.S. Armed Forces from hostilities against Iran unless explicitly authorized by a declaration of war or a congressional authorization for use of military force against Iran.</p><p>Elements of the U.S. Armed Forces needed to defend the United States, an ally, or a partner from imminent attack are not covered by this requirement provided the President complies with a specified provision of the War Powers Resolution. (The provision generally requires the President to remove U.S. Armed Forces from hostilities no more than 60 days after the President notifies or is required to notify Congress of such involvement, unless Congress authorizes such use. For more information on the War Powers Resolution, see&nbsp;<a href=\"https://www.congress.gov/crs-product/IF13134\">CRS In Focus 13134</a>.)</p>","updateDate":"2026-06-23T15:49:58Z","versionCode":"00"}],"title":"Directing the President, pursuant to section 5(c) of the War Powers Resolution, to remove United States Armed Forces from hostilities with Iran.","type":"hconres","updateDate":"2026-09-22T21:22:34Z","updateDateIncludingText":"2026-09-22T21:22:34Z"}
