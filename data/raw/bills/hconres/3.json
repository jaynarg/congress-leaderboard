":"2025-02-11","sponsorshipWithdrawnDate":null,"state":"NC"},{"bioguideId":"C001116","fullName":"Rep. Clyde, Andrew S. [R-GA-9]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-20","sponsorshipWithdrawnDate":null,"state":"GA"},{"bioguideId":"L000578","fullName":"Rep. LaMalfa, Doug [R-CA-1]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-06-23","sponsorshipWithdrawnDate":null,"state":"CA"},{"bioguideId":"L000583","fullName":"Rep. Loudermilk, Barry [R-GA-11]","isOriginalCosponsor":false,"party":"R","sponsorshipDate":"2025-09-18","sponsorshipWithdrawnDate":null,"state":"GA"}],"fetchedAt":"2026-09-17T17:35:27+00:00","id":"hconres3-119","introducedDate":"2025-01-13","latestAction":{"actionDate":"2025-01-13","text":"Referred to the House Committee on Foreign Affairs."},"laws":[],"number":"3","originChamber":"House","policyArea":"International Affairs","sponsors":[{"bioguideId":"J000304","district":13,"fullName":"Rep. Jackson, Ronny [R-TX-13]","party":"R","state":"TX"}],"summaries":[{"actionDate":"2025-01-13","actionDesc":"Introduced in House","text":"<p>This concurrent resolution affirms the commitments in the Geneva Consensus Declaration on Promoting Women's Health and Strengthening the Family and applauds the signatory countries for their dedication to advancing women's health, protecting life at every stage while affirming that there is no international right to abortion, and upholding the importance of the family as foundational to society.</p><p>The resolution also states that Congress will work with the executive branch to ensure that the United States does not conduct or fund abortions, abortion lobbying, or coercive family planning in foreign countries.</p>","updateDate":"2025-02-04T13:36:12Z","versionCode":"00"}],"title":"Expressing support for the Geneva Consensus Declaration on Promoting Women's Health and Strengthening the Family and urging that the United States rejoin this historic declaration.","type":"hconres","updateDate":"2026-07-18T00:04:49Z","updateDateIncludingText":"2026-07-18T00:04:49Z"}
