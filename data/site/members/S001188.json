y.","type":"hres","url":"https://www.congress.gov/bill/119th-congress/house-resolution/252"},{"bipartisan":false,"cosponsors":2,"crossPartyCosponsors":0,"id":"hr1226-119","introducedDate":"2025-02-12","latestAction":{"actionDate":"2025-02-12","text":"Referred to the Committee on Oversight and Government Reform, and in addition to the Committee on the Judiciary, for a period to be subsequently determined by the Speaker, in each case for consideration of such provisions as fall within the jurisdiction of the committee concerned."},"number":"HR 1226","policyArea":"Government Operations and Politics","ranked":true,"stage":"introduced","summary":"Restoring Checks and Balances Act This bill requires any covered rule issued by a federal agency after this bill's enactment to sunset five years after its effective date unless the rule is specifically reauthorized by Congress. A covered rule generally means a rule under the Administrative Procedure Act, but does not include a rule issued in accordance with specified formal rulemaking provisions...","summarySource":"crs","title":"Restoring Checks and Balances Act","type":"hr","url":"https://www.congress.gov/bill/119th-congress/house-bill/1226"}],"state":"IN","topCrossPartyCollaborators":[{"bioguideId":"S001157","caucus":null,"count":2,"name":"David Scott"},{"bioguideId":"S000344","caucus":"D","count":1,"name":"Brad Sherman"},{"bioguideId":"P000620","caucus":"D","count":1,"name":"Brittany Pettersen"},{"bioguideId":"V000138","caucus":"D","count":1,"name":"Eugene Simon Vindman"},{"bioguideId":"R000622","caucus":"D","count":1,"name":"Josh Riley"}]}
