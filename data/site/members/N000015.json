d","title":"Washington, D.C. Admission Act","url":"https://www.congress.gov/bill/119th-congress/house-bill/51"}],"cosponsoredBillsShown":98,"crossPartyCosponsorPct":10.8,"district":1,"former":false,"name":"Richard E. Neal","party":"Democrat","passedBothChambers":0,"passedOneChamber":0,"photoUrl":"https://unitedstates.github.io/images/congress/225x275/N000015.jpg","reachingAcrossPct":19.4,"reported":0,"resolutionsSponsored":0,"sponsored":5,"sponsoredBills":[{"bipartisan":false,"cosponsors":18,"crossPartyCosponsors":0,"id":"hr10060-119","introducedDate":"2026-08-06","latestAction":{"actionDate":"2026-08-06","text":"Referred to the House Committee on Ways and Means."},"number":"HR 10060","policyArea":"Taxation","ranked":true,"stage":"introduced","summary":"Amends the Internal Revenue Code to prohibit the Secretary of the Treasury from entering into or enforcing agreements or orders affecting federal tax matters involving the President, their relatives, or related persons during the President's term. Requires public reporting of any such covered instruments and extends the assessment period for affected taxpayers by three years after the President's term concludes.","summarySource":"ai","title":"Presidential Tax Accountability and Audit Integrity Act","type":"hr","url":"https://www.congress.gov/bill/119th-congress/house-bill/10060"},{"bipartisan":false,"cosponsors":0,"crossPartyCosponsors":0,"id":"hr9813-119","introducedDate":"2026-07-21","latestAction":{"actionDate":"2026-07-21","text":"Referred to the House Committee on Ways and Means."},"number":"HR 9813","policyArea":"Taxation","ranked":true,"stage":"introduced","summary":"Amends the Internal Revenue Code to limit annual contributions to individual retirement plans for high-income taxpayers with retirement account balances exceeding $10 million, imposes an excise tax on excess contributions, and increases minimum required distributions for affected high-income taxpayers.","summarySource":"ai","title":"To amend the I