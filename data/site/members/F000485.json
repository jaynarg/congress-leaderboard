ttee concerned."},"number":"HR 9667","policyArea":"Social Welfare","ranked":true,"stage":"introduced","summary":"Amends the Personal Responsibility and Work Opportunity Reconciliation Act of 1996 to restrict eligibility for federal welfare programs to U.S. citizens, eliminating benefits for noncitizens while preserving exceptions for emergency medical treatment, disaster relief, and immunizations.","summarySource":"ai","title":"Securing Healthcare and Income Entitlements for Lawfully Domiciled Citizens (SHIELD Citizens) Act","type":"hr","url":"https://www.congress.gov/bill/119th-congress/house-bill/9667"},{"bipartisan":false,"cosponsors":0,"crossPartyCosponsors":0,"id":"hr9577-119","introducedDate":"2026-07-02","latestAction":{"actionDate":"2026-07-02","text":"Referred to the House Committee on House Administration."},"number":"HR 9577","policyArea":"Government Operations and Politics","ranked":true,"stage":"introduced","summary":"Amends the Help America Vote Act of 2002 to clarify that congressional election observers have access to primary elections for federal office, while excluding party conventions and caucuses from this requirement.","summarySource":"ai","title":"COCOA-VIP Act","type":"hr","url":"https://www.congress.gov/bill/119th-congress/house-bill/9577"},{"bipartisan":false,"cosponsors":0,"crossPartyCosponsors":0,"id":"hr9545-119","introducedDate":"2026-06-30","latestAction":{"actionDate":"2026-06-30","text":"Referred to the House Committee on the Judiciary."},"number":"HR 9545","policyArea":"Crime and Law Enforcement","ranked":true,"stage":"introduced","summary":"Amends federal criminal law to impose increased penalties, including possible death or life imprisonment, for sex offenses committed by federal officers and Members of Congress. Creates a new federal adultery offense punishable by fine and up to one year imprisonment for such officials.","summarySource":"ai","title":"HONEST Act of 2026","type":"hr","url":"https://www.congress.gov/bill/119th-congress/house-bill/9545"},{"bipartisan":false,"cosponsors":4,"crossPartyCosponsors":0,"id":"hres1346-119","introducedDate":"2026-06-08","latestAction":{"actionDate":"2026-06-08","text":"Referred to the House Committee on the Judiciary."},"number":"HRES 1346","policyArea":"Law","ranked":false,"stage":"introduced","summary":null,"summarySource":null,"title":"Impeaching Eleanor L. Ross, Judge of the United States District Court for the Northern District of Georgia, for high crimes and misdemeanors.","type":"hres","url":"https://www.congress.gov/bill/119th-congress/house-resolution/1346"},{"bipartisan":false,"cosponsors":6,"crossPartyCosponsors":0,"id":"hr9146-119","introducedDate":"2026-06-04","latestAction":{"actionDate":"2026-06-04","text":"Referred to the House Committee on the Judiciary."},"number":"HR 9146","policyArea":"Crime and Law Enforcement","ranked":true,"stage":"introduced","summary":"Increases criminal penalties for sexual exploitation of children by adding potential death penalty sentences to existing federal offenses including child sex trafficking, production and distribution of child sexual abuse material, and related crimes.","summarySource":"ai","title":"Millstone Act","type":"hr","url":"https://www.congress.gov/bill/119th-congress/house-bill/9146"},{"bipartisan":false,"cosponsors":6,"crossPartyCosponsors":0,"id":"hjres172-119","introducedDate":"2026-05-04","latestAction":{"actionDate":"2026-05-04","text":"Referred to the House Committee on the Judiciary."},"number":"HJRES 172","policyArea":"Immigration","ranked":true,"stage":"introduced","summary":null,"summarySource":null,"title":"Proposing an amendment to the Constitution of the United States to protect United States citizenship.","type":"hjres","url":"https://www.congress.gov/bill/119th-congress/house-joint-resolution/172"},{"bipartisan":false,"cosponsors":0,"crossPartyCosponsors":0,"id":"hr8594-119","introducedDate":"2026-04-30","latestAction":{"actionDate":"2026-04-30","text":"Referred to the House Committee on Financial Services."},"number":"HR 8594","policyArea":"Crime and Law Enforcement","ranked":true,"stage":"introduced","summary":"Authorizes the award of Congressional Gold Medals to President Donald John Trump, the United States Secret Service, and local law enforcement partners in recognition of their protection efforts during specified security incidents.","summarySource":"ai","title":"Congressional Gold Medal For Inspiring Great Heroism and Tenacity (FIGHT) Act","type":"hr","url":"https://www.congress.gov/bill/119th-congress/house-bill/8594"},{"bipartisan":false,"cosponsors":0,"crossPartyCosponsors":0,"id":"hres1182-119","introducedDate":"2026-04-16","latestAction":{"actionDate":"2026-04-22","actionTime":"16:39:51","text":"Motion to reconsider laid on the table Agreed to without objection."},"number":"HRES 1182","policyArea":"Commerce","ranked":false,"stage":"passed_one_chamber","summary":"This resolution states that the House of Representatives has demonstrated support for U.S. prosperity and economic growth, especially in rural communities, through policies related to energy, health care, manufacturing, and broadband connectivity.","summarySource":"crs","title":"Expressing support for rural communities across the United States as stewards of the environment, major suppliers of United States energy resources, critical providers of food production and manufacturing capacity, and drivers of national economic stability, and recognizing the work of the House of Representatives in the 119th Congress in support of those vital communities.","type":"hres","url":"https://www.congress.gov/bill/119th-congress/house-resolution/1182"}],"state":"GA","topCrossPartyCollaborators":[{"bioguideId":"O000172","caucus":"D","count":1,"name":"Alexandria Ocasio-Cortez"},{"bioguideId":"S000344","caucus":"D","count":1,"name":"Brad Sherman"},{"bioguideId":"F000481","caucus":"D","count":1,"name":"Shomari Figures"}]}
